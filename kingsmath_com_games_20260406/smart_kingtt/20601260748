    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>KingTris Mobile</title>
    <meta name="description" content="Solve math puzzles to get bombs! Strategy Puzzle Game." id="meta-desc">
    <link href="https://fonts.googleapis.com/css2?family=Jua&display=swap" rel="stylesheet">
    
    <style>
        /* --- [1] 기본 설정 (다크 네온 테마) --- */
        :root {
            --bg-color: #121212;        
            --bg-pattern: #1e1e1e;        
            --main-accent: #00d2d3;      /* Cyan */
            --soft-accent: #48dbfb;          
            --neon-pink: #ff6b6b;          
            --neon-yellow: #feca57;          
            --neon-green: #1dd1a1;       
            --text-color: #ffffff;       
            --box-shadow: 0 4px 15px rgba(0, 210, 211, 0.3);
            --block-size: 24px;
        }

        * { box-sizing: border-box; touch-action: manipulation; user-select: none; -webkit-user-select: none; }

        body {
            margin: 0; padding: 0;
            background-color: var(--bg-color);
            background-image: linear-gradient(var(--bg-pattern) 1px, transparent 1px),
            linear-gradient(90deg, var(--bg-pattern) 1px, transparent 1px);
            background-size: 20px 20px;
            color: var(--text-color);
            font-family: 'Jua', sans-serif;
            overflow: hidden; /* 스크롤 방지 */
            height: 100vh;
            height: 100dvh; 
        }

        /* 공통 유틸리티 */
        .hidden { display: none !important; }
        .flex-center { display: flex; justify-content: center; align-items: center; }
        button { font-family: 'Jua', sans-serif; cursor: pointer; border: none; outline: none; }
        
        /* 모바일 컨테이너 */
        #app-container {
            width: 100%;
            max-width: 600px;
            height: 100%;
            margin: 0 auto;
            position: relative;
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(5px);
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.8);
            display: flex;
            flex-direction: column;
            border-left: 2px solid #333;
            border-right: 2px solid #333;
            padding-bottom: env(safe-area-inset-bottom, 10px);
        }

        /* --- [2] 시작 화면 --- */
        #start-screen {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 20px;
            padding-top: 60px;
            text-align: center;
            width: 100%;
            height: 100%;
            overflow-y: auto;
        }

        .top-link {
            position: absolute;
            top: 15px;
            left: 20px;
            color: var(--main-accent);
            text-decoration: none;
            font-size: 16px;
            z-index: 100;
            border-bottom: 2px dashed var(--main-accent);
        }

        /* 언어 선택기 */
        .lang-selector { position: absolute; top: 15px; right: 20px; z-index: 101; text-align: right; }
        .lang-btn {
            background: transparent; border: 2px solid var(--main-accent); color: white;
            border-radius: 15px; padding: 5px 10px; font-size: 20px; cursor: pointer;
        }
        .lang-dropdown {
            display: none; position: absolute; top: 45px; right: 0;
            background: #2d3436; border: 2px solid var(--main-accent);
            border-radius: 10px; overflow: hidden; width: 160px; z-index: 200;
            max-height: 300px; overflow-y: auto;
        }
        .lang-dropdown.show { display: block; }
        .lang-option {
            padding: 8px 10px; display: flex; align-items: center; gap: 8px;
            cursor: pointer; font-size: 14px; border-bottom: 1px solid #444; color: white;
            justify-content: flex-start;
        }
        .lang-option:hover { background: #333; }
        .lang-flag { font-size: 18px; width: 25px; text-align: center; }

        .main-title {
            font-size: 45px; color: var(--main-accent);
            text-shadow: 0 0 10px var(--main-accent);
            margin-bottom: 5px; width: 100%; line-height: 1.2;
            word-break: keep-all;
        }
        /* 긴 제목 대응 */
        body[data-lang="ru"] .main-title,
        body[data-lang="fr"] .main-title, 
        body[data-lang="es"] .main-title { font-size: 32px; }

        .sub-desc {
            font-size: 16px; color: #ccc; background: rgba(255,255,255,0.1);
            padding: 5px 15px; border-radius: 20px; margin-bottom: 15px;
            display: inline-block;
        }

        /* QR 코드 */
        .qr-section { display: flex; flex-direction: column; align-items: center; margin-bottom: 25px; cursor: pointer; }
        #qr-small {
            width: 80px; height: 80px; 
            border: 2px solid var(--main-accent); background: white; padding: 5px;
        }
        .qr-hint { font-size: 12px; color: var(--main-accent); margin-top: 5px; }

        #qr-modal {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.9); z-index: 9999; cursor: pointer;
        }
        #qr-large { width: 80vw; max-width: 300px; }
        
        .input-group { width: 100%; display: flex; flex-direction: column; align-items: center; gap: 15px; }
        input#nickname {
            width: 90%; padding: 15px; font-size: 22px; text-align: center;
            border: 2px solid var(--main-accent);
            background: #2d3436; color: white; font-family: 'Jua', sans-serif;
        }
        input#nickname::placeholder { color: #636e72; }
        
        .btn-start {
            width: 90%; padding: 15px; font-size: 24px; border-radius: 10px;
            background: var(--main-accent); color: #2d3436; font-weight: bold;
            box-shadow: 0 4px 0 #00b894; transition: transform 0.1s;
        }
        .btn-start:active { transform: translateY(4px); box-shadow: 0 0 0; }
        /* 긴 텍스트 대응 버튼 폰트 */
        body[data-lang="ru"] .btn-start, 
        body[data-lang="fr"] .btn-start { font-size: 18px; }

        #btn-other { font-size: 14px; color: #888; text-decoration: none; padding: 5px; }

        #ranking-area {
            width: 95%; margin-top: 30px; background: rgba(255,255,255,0.05);
            border-radius: 10px; border: 1px solid #444; padding: 15px;
        }
        .rank-header { font-size: 20px; color: var(--neon-yellow); margin-bottom: 10px; border-bottom: 1px solid #444; padding-bottom: 5px; }
        #ranking-list { height: 200px; overflow-y: auto; text-align: left; }
        .rank-row { display: flex; justify-content: space-between; padding: 8px 5px; border-bottom: 1px solid #333; font-size: 15px; }
        .rank-num { display: inline-block; width: 20px; height: 20px; background: #444; border-radius: 50%; text-align: center; font-size: 12px; line-height: 20px; }

        /* --- [3] 게임 화면 --- */
        #game-screen {
            flex: 1; position: relative; display: flex; flex-direction: column;
            overflow: hidden; height: 100%;
        }

        /* Top Bar */
        .game-top-bar {
            flex: 0 0 auto;
            display: flex; justify-content: space-between; align-items: center;
            padding: 5px 10px;
            background: rgba(0,0,0,0.5); z-index: 50;
            border-bottom: 1px solid #333;
            height: 65px; 
        }
   .btn-mini {
    /* padding: 5px 12px; */
    font-size: 20px;
    /* border-radius: 5px; */
    /* color: white; */
    background: #2d343600;
    /* border: 1px solid #636e72; */
}

        /* Next Preview Area */
        .next-block-area {
            display: flex; 
            flex-direction: row; 
            align-items: center;
            justify-content: center;
            background: rgba(0,0,0,0.3); 
            padding: 2px 8px; 
            border-radius: 5px;
            border: 1px solid #444;
            margin-right: 5px;
            gap: 5px;
        }
        #next-canvas { background: transparent; }

        /* Math Display */
        .math-display {
            flex: 1; 
            background: #2d3436; border: 2px solid var(--neon-yellow);
            border-radius: 8px; padding: 2px 5px; display: flex;
            flex-direction: column;
            align-items: center; justify-content: center;
            height: 100%; position: relative;
            box-shadow: 0 0 10px rgba(254, 202, 87, 0.2);
            transition: transform 0.1s;
            margin: 0 5px;
        }
        .math-display.pulse { transform: scale(1.05); border-color: #fff; }
        
        .math-content { display: flex; align-items: center; gap: 5px; }

        .math-q { font-size: 20px; color: white; font-weight: bold; }
        .math-ans { 
            background: white; color: black; padding: 0 8px; 
            border-radius: 4px; font-size: 20px; font-weight: bold; min-width: 30px; text-align: center;
            height: 26px; line-height: 26px;
        }
        .math-msg {
            position: absolute; width: 100%; height: 100%; top:0; left:0;
            background: rgba(0,0,0,0.85); display: flex; align-items: center; justify-content: center;
            font-size: 18px; font-weight: bold; border-radius: 6px; display: none; z-index: 10;
        }
        
        .score-box {
            display: flex; flex-direction: column; align-items: flex-end;
            color: var(--main-accent); font-weight: bold; font-size: 14px;
        }
        #ui-score { font-size: 18px; }

        /* 게임 메인 영역 */
        .game-main-area {
            flex: 1; 
            display: flex;
            align-items: stretch;
            justify-content: center;
            padding: 5px 0;
            overflow: hidden;
            width: 100%;
        }

        /* 사이드 숫자 패드 */
        .side-pad {
            flex: 1; 
            display: flex;
            flex-direction: column;
            gap: 5px;
            padding: 0 5px;
            justify-content: center;
            z-index: 60;
            min-width: 40px; 
        }
        .num-btn {
            flex: 1; 
            width: 100%; 
            background: #333;
            border: 1px solid #555;
            border-radius: 8px;
            color: white;
            font-size: 20px;
            font-weight: bold;
            box-shadow: 0 2px 0 #111;
            transition: background 0.1s;
            touch-action: manipulation;
        }
        .num-btn:active, .num-btn.pressed {
            background: var(--main-accent);
            color: black;
            transform: translateY(2px);
            box-shadow: none;
        }

        /* 캔버스 영역 */
        #canvas-wrapper {
            height: 100%; 
            aspect-ratio: 10 / 20;
            position: relative;
            background: rgba(0,0,0,0.5);
            border: 2px solid #444;
            display: flex; justify-content: center; align-items: center;
            overflow: hidden;
        }
        #canvas-wrapper.hammer-mode {
            border-color: var(--neon-pink);
            box-shadow: inset 0 0 30px var(--neon-pink);
            animation: pulse-border 1s infinite;
        }
        @keyframes pulse-border {
            0% { border-color: var(--neon-pink); }
            50% { border-color: white; }
            100% { border-color: var(--neon-pink); }
        }

        canvas { display: block; box-shadow: 0 0 20px rgba(0,0,0,0.5); width: 100%; height: 100%; }
        
        /* 망치 아이콘 */
        #hammer-cursor {
            position: absolute; pointer-events: none;
            font-size: 40px; text-shadow: 0 0 10px red;
            z-index: 500; display: none;
            transform: translate(-50%, -50%);
        }

        /* 컨트롤러 (하단 5버튼) */
        .controls-area {
            height: 85px; 
            flex: 0 0 auto; 
            display: flex;
            justify-content: space-between;
            gap: 4px;
            padding: 5px;
            padding-bottom: 5px; 
            background: #1e1e1e;
        }
        .ctrl-btn {
            flex: 1;
            background: #2d3436; border: none; border-radius: 8px;
            color: white; font-size: 20px; box-shadow: 0 4px 0 #000;
            display: flex; flex-direction: column; 
            align-items: center; justify-content: center;
            line-height: 1.2;
        }
        .ctrl-btn:active { transform: translateY(4px); box-shadow: none; }
        .key-hint { font-size: 11px; color: rgba(255,255,255,0.6); margin-top: 2px; }
        
        .btn-rot { background: #6c5ce7; } /* 회전 */
        .btn-move { background: #0984e3; } /* 이동 */
        .btn-drop { background: #ff7675; } /* 다운 */
        
        /* 카운트다운 오버레이 */
        #countdown-overlay {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: #121212; 
            z-index: 300;
            flex-direction: column; color: var(--main-accent);
            font-size: 80px; font-weight: bold;
        }
        
        /* 폭격 모드 안내 오버레이 */
        #hammer-msg {
            position: absolute; top: 20%; left: 50%; transform: translateX(-50%);
            background: rgba(255, 0, 0, 0.8); color: white; padding: 10px 20px;
            border-radius: 20px; font-size: 18px; z-index: 250;
            white-space: nowrap; display: none; animation: pop-in 0.3s;
        }
        @keyframes pop-in { from {transform: translateX(-50%) scale(0);} to {transform: translateX(-50%) scale(1);} }

        /* --- [4] 결과 화면 --- */
        #result-screen {
            position: absolute; top:0; left:0; width:100%; height:100%;
            background: rgba(18, 18, 18, 0.95); z-index: 200;
            flex-direction: column; align-items: center; justify-content: center;
        }
        .res-title { font-size: 36px; margin-bottom: 10px; color: var(--neon-pink); }
        .res-score { font-size: 60px; color: var(--main-accent); font-weight: bold; margin-bottom: 20px; }
        .res-msg { color: #888; margin-bottom: 30px; font-size: 18px; }

        /* 결과 화면 - 상위 랭킹 표시 영역 */
        #top-rankers {
            width: 80%; background: rgba(0,0,0,0.5); border-radius: 10px; padding: 10px;
            margin-bottom: 20px; border: 1px solid #444; min-height: 100px;
        }
        .top-rank-title { color: var(--neon-yellow); font-size: 18px; margin-bottom: 10px; border-bottom: 1px solid #555; padding-bottom: 5px; }
        .top-rank-row { display: flex; justify-content: space-between; padding: 5px 0; border-bottom: 1px solid #333; font-size: 16px; color: #ddd; }

        /* 결과 화면 - 버튼 그룹 */
        .res-btn-group {
            display: flex; gap: 20px; justify-content: center; width: 100%;
        }
        .res-btn {
            width: 70px; height: 70px; font-size: 35px; border-radius: 15px;
            display: flex; align-items: center; justify-content: center;
            border: 2px solid #555; cursor: pointer; box-shadow: 0 4px 0 #222;
            transition: transform 0.1s;
        }
        .res-btn:active { transform: translateY(4px); box-shadow: none; }
        .btn-retry { background: var(--neon-green); color: #2d3436; }
        .btn-home { background: #636e72; color: white; }

    </style>
</head>
<body oncontextmenu="return false" onselectstart="return false">

<div id="qr-modal" class="hidden flex-center" onclick="closeQrModal()">
    <div class="qr-modal-content" style="text-align: center;">
        <img id="qr-large" src="" alt="QR Code Large">
        <div id="modal-close-hint" style="color:white; margin-top:20px; font-size:20px;">Touch to close</div>
    </div>
</div>

<div id="app-container">

    <div id="start-screen">
        <a href="" target="_self" id="top-link-anchor" class="top-link">KingsMath.com</a>
        
        <div class="lang-selector">
            <button class="lang-btn" onclick="toggleLangMenu()" id="cur-lang-btn">🇺🇸</button>
            <div class="lang-dropdown" id="lang-dropdown">
                <div class="lang-option" onclick="changeLang('ko')"><span class="lang-flag">🇰🇷</span> 한국어</div>
                <div class="lang-option" onclick="changeLang('en')"><span class="lang-flag">🇺🇸</span> English</div>
                <div class="lang-option" onclick="changeLang('cn')"><span class="lang-flag">🇨🇳</span> 中文</div>
                <div class="lang-option" onclick="changeLang('jp')"><span class="lang-flag">🇯🇵</span> 日本語</div>
                <div class="lang-option" onclick="changeLang('es')"><span class="lang-flag">🇪🇸</span> Español</div>
                <div class="lang-option" onclick="changeLang('fr')"><span class="lang-flag">🇫🇷</span> Français</div>
                <div class="lang-option" onclick="changeLang('ru')"><span class="lang-flag">🇷🇺</span> Русский</div>
            </div>
        </div>

        <div style="margin-top: 20px;">
            <div class="main-title" id="main-title" data-lang-key="title">👑KingTris Mobile</div>
            <div class="sub-desc" id="sub-desc" data-lang-key="desc">Solve math to get bombs!</div>
            
            <div class="qr-section" onclick="openQrModal()">
                <img id="qr-small" src="" alt="QR Code">
                <div class="qr-hint" id="qr-hint" data-lang-key="invite">Invite friends via QR</div>
            </div>
        </div>

        <div class="input-group">
            <input type="text" id="nickname" maxlength="8" placeholder="Nickname">
            <button class="btn-start" onclick="startGame()" id="btn-start" data-lang-key="start">GAME START</button>
            <a href="/" id="btn-other" data-lang-key="other_games">🎮 More Games</a>
        </div>

        <div id="ranking-area">
            <div class="rank-header" id="rank-header" data-lang-key="ranking">🏆 Hall of Fame (Top 100)</div>
            <div id="ranking-list">
                <div style="padding:20px; color:#aaa;" id="loading-text" data-lang-key="loading">Loading...</div>
            </div>
        </div>
    </div>

    <div id="game-screen" class="hidden">
        <div id="countdown-overlay" class="hidden flex-center">3</div>

        <div class="game-top-bar">
            <button class="btn-mini" onclick="goHome()" id="btn-home" data-lang-key="home">🏠</button>
            
            <div class="next-block-area">
                <canvas id="next-canvas" width="80" height="40"></canvas>
            </div>

            <div class="math-display" id="math-box">
                <div class="math-content">
                    <div class="math-q" id="ui-q">3 + 5 =</div>
                    <div class="math-ans" id="ui-ans">?</div>
                </div>
                <div class="math-msg" id="ui-msg">Good!</div>
            </div>

            <div class="score-box">
                <span>SCORE</span>
                <span id="ui-score">0</span>
            </div>
        </div>

        <div class="game-main-area">
            <div class="side-pad left">
                <button class="num-btn" onpointerdown="handleNumBtn('1')">1</button>
                <button class="num-btn" onpointerdown="handleNumBtn('2')">2</button>
                <button class="num-btn" onpointerdown="handleNumBtn('3')">3</button>
                <button class="num-btn" onpointerdown="handleNumBtn('4')">4</button>
                <button class="num-btn" onpointerdown="handleNumBtn('5')">5</button>
            </div>

            <div id="canvas-wrapper">
                <div id="hammer-msg" data-lang-key="hammer_msg">💣 Touch to Explode!</div>
                <div id="hammer-cursor">🔨</div>
                <canvas id="game-canvas"></canvas>
            </div>

            <div class="side-pad right">
                <button class="num-btn" onpointerdown="handleNumBtn('6')">6</button>
                <button class="num-btn" onpointerdown="handleNumBtn('7')">7</button>
                <button class="num-btn" onpointerdown="handleNumBtn('8')">8</button>
                <button class="num-btn" onpointerdown="handleNumBtn('9')">9</button>
                <button class="num-btn" onpointerdown="handleNumBtn('0')">0</button>
            </div>
        </div>

        <div class="controls-area">
            <button class="ctrl-btn btn-rot" id="btn-ccw">↺<span class="key-hint">(D)</span></button>
            <button class="ctrl-btn btn-move" id="btn-left">◀</button>
            <button class="ctrl-btn btn-drop" id="btn-down">▼<span class="key-hint">(Space)</span></button>
            <button class="ctrl-btn btn-move" id="btn-right">▶</button>
            <button class="ctrl-btn btn-rot" id="btn-cw">↻<span class="key-hint">(F, ↑)</span></button>
        </div>
    </div>

    <div id="result-screen" class="hidden flex-center">
        <div class="res-title" id="res-title" data-lang-key="game_over">GAME OVER</div>
        <div class="res-score" id="res-final-score">0</div>
        <div class="res-msg" id="res-msg" data-lang-key="saving">Saving...</div>

        <div id="top-rankers">
            <div class="top-rank-title">🏆 TOP 3 RANKERS</div>
            <div id="top-rank-content">Loading...</div>
        </div>

        <div class="res-btn-group">
            <button class="res-btn btn-retry" onclick="resetGame()" id="res-btn-retry" title="Retry">🔄</button>
            <button class="res-btn btn-home" onclick="goHome()" id="res-btn-home" title="Home">🏠</button>
        </div>
    </div>

</div>


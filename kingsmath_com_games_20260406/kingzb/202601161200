<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>좀비킹 수학 전쟁</title>
    <link href="https://fonts.googleapis.com/css2?family=Black+Han+Sans&family=Do+Hyeon&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --wood-dark: #3e2723;
            --wood-light: #5d4037;
            --wood-border: #281813;
            --ui-font: 'Do Hyeon', sans-serif;
            --title-font: 'Black Han Sans', sans-serif;
            --num-font: 'Verdana', 'Arial', sans-serif;
            
            --p1-color: #00f3ff;
            --p2-color: #ff007f;
            --p3-color: #39ff14;
            --p4-color: #ffaa00;
        }

        body {
            margin: 0; padding: 0;
            background: #000;
            overflow: hidden;
            font-family: var(--ui-font);
            user-select: none;
            -webkit-user-select: none;
            touch-action: none;
            color: white;
        }

        /* === 3D 게임 씬 === */
        #game-scene {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            perspective: 1000px;
            overflow: hidden;
            background: radial-gradient(circle at center, #2a2a2a 0%, #000000 100%);
            z-index: 1;
        }

        .fog {
            position: absolute; bottom: 0; width: 100%; height: 50%;
            background: linear-gradient(to top, rgba(10, 5, 0, 0.9), transparent);
            pointer-events: none; z-index: 10;
        }

        /* === 좀비 컨테이너 === */
        .zombie-container {
            position: absolute;
            bottom: 0; 
            transform-style: preserve-3d;
            will-change: transform, opacity;
            display: flex; flex-direction: column; align-items: center;
        }

        /* UI 위치 및 레이아웃 */
        .zombie-ui {
            position: absolute; 
            bottom: 285px; /* 기본(서 있을 때) 이마 높이 */
            display: flex; 
            flex-direction: column-reverse; /* 아래: 문제, 위: 카운트다운 */
            align-items: center;
            width: 250px; text-align: center;
            z-index: 200;
            transition: bottom 0.3s;
            pointer-events: none;
        }

        .zombie-container.low-pos .zombie-ui { bottom: 300px; }
        .zombie-container.lowest-pos .zombie-ui { bottom: 300px; }

        .math-bubble {
            background: rgba(0, 0, 0, 0.85);
            border: 3px solid #fff;
            color: #fff;
            font-size: 32px; 
            font-family: var(--num-font);
            font-weight: bold;
            padding: 2px 12px;
            border-radius: 12px;
            text-shadow: 2px 2px 0 #000;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.8);
            transition: transform 0.1s;
            margin-bottom: 0px; 
        }
        .math-bubble.changed {
            transform: scale(1.5);
            background: #ff0000;
        }

        .danger-countdown {
            font-size: 26px; 
            color: #ff0000;
            font-weight: bold;
            text-shadow: 0 0 5px yellow;
            animation: pulse 0.5s infinite alternate;
            display: none; 
            margin-bottom: 5px;
        }
        @keyframes pulse { from { transform: scale(1); opacity: 0.8; } to { transform: scale(1.1); opacity: 1; } }

        /* === 좀비 스타일 === */
        .zombie {
            position: relative;
            width: 140px; height: 280px;
            animation: shamble 1.5s ease-in-out infinite alternate;
            transition: transform 0.3s;
        }

        .zombie-container {
            --skin: #7da35e;
            --clothes: #5d4037;
        }

        .head, .arm, .leg, .ear, .rip {
            background-color: var(--skin) !important;
            box-shadow: inset 5px 5px 15px rgba(0,0,0,0.3); 
            position: absolute;
            transition: opacity 0.2s, visibility 0.2s;
        }
        .torso {
            background-color: var(--clothes) !important;
            position: absolute;
            transition: opacity 0.2s, visibility 0.2s;
        }

        .part-hidden { visibility: hidden; opacity: 0; }

        .head {
            top: -10px; left: 50%; transform: translateX(-50%);
            width: 80px; height: 95px;
            border-radius: 20px 20px 30px 25px;
            z-index: 5;
        }

        .hair-strand {
            position: absolute; background: #222; width: 2px; height: 15px;
            top: -10px; border-radius: 50%; transform-origin: bottom center;
        }
        .ear { top: 40px; width: 15px; height: 20px; border-radius: 50%; z-index: -1; }
        .ear.left { left: -5px; transform: rotate(-10deg); }
        .ear.right { right: -5px; transform: rotate(10deg); }

        .eye-socket {
            position: absolute; top: 35px; width: 26px; height: 26px;
            background: rgba(0,0,0,0.4); border-radius: 50%;
            box-shadow: inset 2px 2px 5px rgba(0,0,0,0.5);
        }
        .eye-socket.left { left: 10px; }
        .eye-socket.right { right: 10px; }

        .eye {
            position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
            background: #fff; border-radius: 50%; width: 20px; height: 20px;
            overflow: hidden; box-shadow: 0 0 2px rgba(0,0,0,0.5);
        }
        .eye::before {
            content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: radial-gradient(circle at 30% 30%, transparent 60%, rgba(255,0,0,0.2) 100%),
                        linear-gradient(45deg, transparent 45%, rgba(255,0,0,0.3) 50%, transparent 55%);
            opacity: 0.7;
        }
        .pupil {
            position: absolute; background: #000; border-radius: 50%;
            width: 5px; height: 5px; top: 7px; left: 7px;
            animation: crazyEye 3s infinite;
        }

        .nose {
            position: absolute; top: 60px; left: 50%; transform: translateX(-50%);
            width: 12px; height: 8px;
        }
        .nostril {
            position: absolute; top: 0; width: 4px; height: 6px;
            background: #1a1a1a; border-radius: 50%;
        }
        .nostril.left { left: 0; transform: rotate(-10deg); }
        .nostril.right { right: 0; transform: rotate(10deg); }

        .mouth {
            position: absolute; bottom: 12px; left: 50%; transform: translateX(-50%);
            width: 36px; height: 12px; background: #2a1a1a;
            border-radius: 5px 5px 10px 10px; overflow: visible;
            animation: bite 2s infinite;
        }
        .tooth {
            position: absolute; top: 0; width: 6px; height: 7px;
            background: #ddd; border-radius: 2px 2px 4px 4px; border: 1px solid #aaa;
        }

        .torso {
            top: 80px; left: 50%; transform: translateX(-50%);
            width: 90px; height: 110px; border-radius: 15px 15px 10px 10px;
            z-index: 3; overflow: hidden;
            box-shadow: inset 0 0 20px rgba(0,0,0,0.5);
        }
        .rip {
            position: absolute; background: var(--skin); border-radius: 50%;
            box-shadow: inset 2px 2px 5px rgba(0,0,0,0.3);
        }

        .arm {
            top: 90px; width: 28px; height: 100px; border-radius: 10px;
            z-index: 4; transform-origin: top center;
        }
        .hand {
            position: absolute; bottom: -5px; left: 0; width: 100%; height: 20px;
            background: inherit; border-radius: 50%;
        }

        .leg {
            top: 175px; width: 32px; height: 100px; border-radius: 5px;
            z-index: 2; transform-origin: top center; background-color: #3e2723;
        }
        .leg-skin {
            position: absolute; bottom: 0; width: 100%; height: 20px; background: inherit;
        }
        .foot {
            position: absolute; bottom: -8px; width: 40px; height: 18px;
            background: #111; border-radius: 8px 10px 2px 2px;
        }
        .leg.left { left: 35px; animation: walkLeg 0.8s ease-in-out infinite alternate; }
        .leg.right { right: 35px; animation: walkLeg 0.8s ease-in-out infinite alternate-reverse; }

        .z1 .arm.left { transform: rotate(40deg); animation: armSwayLeft1 1.5s ease-in-out infinite alternate; left: 10px; }
        .z1 .arm.right { transform: rotate(-10deg); animation: armSwayRight1 2s ease-in-out infinite alternate; right: 10px; }
        .z1 .drool { position: absolute; top: 10px; right: 5px; width: 4px; height: 20px; background: rgba(200, 255, 100, 0.6); border-radius: 2px; animation: droolDrop 2s infinite; }
        .z1 .scar { position: absolute; top: 20px; left: 15px; width: 25px; height: 2px; background: #4a0000; transform: rotate(15deg); box-shadow: 0 1px 0 rgba(255,255,255,0.2); }

        .z2 .arm.left { transform: rotate(80deg); animation: armRaise2 2s ease-in-out infinite alternate; left: 10px; }
        .z2 .arm.right { transform: rotate(-75deg); animation: armRaise2 2.2s ease-in-out infinite alternate-reverse; right: 10px; }
        .z2 .head { border-top-left-radius: 10px; }
        .z2 .brain { position: absolute; top: -8px; left: 10px; width: 30px; height: 15px; background: #e57373; border-radius: 10px 10px 0 0; z-index: -1; box-shadow: inset -2px -2px 5px #b71c1c; }
        .z2 .eye.left { background: #ccc; }
        .z2 .eye.left .pupil { background: #aaa; width: 3px; height: 3px; animation: none; }
        .z2 .eye.right { width: 16px; height: 16px; top: 48%; }

        .z3 .arm.left { transform: rotate(5deg); animation: armDangle3 3s ease-in-out infinite alternate; left: 10px; }
        .z3 .arm.right { transform: rotate(-10deg); animation: armDangle3 2.5s ease-in-out infinite alternate-reverse; right: 10px; }
        .z3 .head { background-image: radial-gradient(circle at 20% 80%, rgba(0,0,0,0.2) 5px, transparent 6px), radial-gradient(circle at 80% 20%, rgba(0,0,0,0.2) 8px, transparent 9px); }
        .z3 .eye-socket.right { width: 32px; height: 32px; right: 6px; top: 32px; background: rgba(0,0,0,0.3); }
        .z3 .eye.right { width: 28px; height: 28px; box-shadow: 0 0 5px red; }
        .z3 .eye.right .pupil { width: 2px; height: 2px; }
        .z3 .mouth { background: #4a0000; width: 40px; border-radius: 10px; }
        .z3 .blood-stain { position: absolute; bottom: -5px; right: 10px; width: 15px; height: 15px; background: #8a0b0b; border-radius: 50%; filter: blur(2px); opacity: 0.8; }

        .zombie.crawling { animation: crawl 1.2s ease-in-out infinite alternate; }
        .zombie.rolling { animation: rollHead 0.8s linear infinite; }

        @keyframes shamble { 0% { transform: rotate(-4deg); } 100% { transform: rotate(4deg); } }
        @keyframes crawl { 0% { transform: rotate(-10deg) translateY(0); } 100% { transform: rotate(10deg) translateY(5px); } }
        @keyframes rollHead { 
            0% { transform: rotate(0deg) translateY(0); } 
            25% { transform: rotate(10deg) translateY(-10px); }
            50% { transform: rotate(0deg) translateY(0); }
            75% { transform: rotate(-10deg) translateY(-10px); }
            100% { transform: rotate(0deg) translateY(0); }
        }
        @keyframes walkLeg { 0% { transform: rotate(-20deg); } 100% { transform: rotate(20deg); } }
        @keyframes crazyEye { 0%,100% { transform: translate(0,0); } 20% { transform: translate(2px, -2px); } 60% { transform: translate(-2px, 2px); } }
        @keyframes bite { 0%, 100% { height: 12px; } 50% { height: 20px; } }
        @keyframes droolDrop { 0% { height: 10px; opacity: 0.8; } 50% { height: 25px; opacity: 0.6; } 100% { height: 10px; opacity: 0.8; } }
        
        @keyframes armSwayLeft1 { 0% { transform: rotate(30deg); } 100% { transform: rotate(50deg); } }
        @keyframes armSwayRight1 { 0% { transform: rotate(-5deg); } 100% { transform: rotate(-20deg); } }
        @keyframes armRaise2 { 0% { transform: rotate(70deg); } 100% { transform: rotate(85deg); } }
        @keyframes armDangle3 { 0% { transform: rotate(5deg); } 100% { transform: rotate(15deg); } }

        .hit-effect { animation: shake 0.2s; }
        @keyframes shake { 0% { transform: translateX(0); } 25% { transform: translateX(-10px); } 75% { transform: translateX(10px); } 100% { transform: translateX(0); } }

        /* === 총알 이펙트 === */
        .bullet {
            position: absolute;
            width: 10px; height: 10px;
            background: #ffff00;
            border-radius: 50%;
            box-shadow: 0 0 10px #fff, 0 0 20px #ffaa00;
            z-index: 500;
            pointer-events: none;
            transition: transform 0.6s linear;
        }

        /* === UI 레이아웃 === */
        #ui-layer {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            display: flex; flex-direction: column;
            z-index: 100; pointer-events: none; 
        }

        .top-bar {
            height: 100px;
            background: rgba(0,0,0,0); 
            border-bottom: none; 
            box-shadow: none; 
            display: flex; justify-content: space-between; align-items: center;
            padding: 0 40px; pointer-events: auto;
        }

        .wave-info { font-size: 30px; color: #ffaa00; text-shadow: 2px 2px 0 #000; font-family: var(--num-font); font-weight: bold; }
        
        .timer-box {
            background: rgba(0,0,0,0.5); border: 2px solid #666; padding: 5px 20px;
            border-radius: 10px; text-align: center;
        }
        .timer-label { font-size: 14px; color: #aaa; display: block; }
        .timer-val { font-size: 40px; font-family: var(--num-font); color: #00f3ff; font-weight: bold; }

        .life-box { font-size: 40px; letter-spacing: 5px; text-shadow: 2px 2px 0 #000; }

        .bottom-controls {
            margin-top: auto;
            height: 280px;
            background: linear-gradient(0deg, #1a0f0a, #3e2723);
            border-top: 5px solid #1a0f0a;
            display: flex; pointer-events: auto;
            box-shadow: 0 -10px 30px rgba(0,0,0,0.8);
        }

        .player-panel {
            flex: 1; border-right: 2px solid rgba(0,0,0,0.5);
            display: flex; flex-direction: column; align-items: center; padding: 10px;
            position: relative;
        }
        
        .player-panel::before {
            content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background-image: url("data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M0 0h40v40H0V0zm20 20h20v20H20V20zM0 20h20v20H0V20z' fill='%235d4037' fill-opacity='0.1' fill-rule='evenodd'/%3E%3C/svg%3E");
            opacity: 0.3; pointer-events: none;
        }

        .p1 { border-top: 5px solid var(--p1-color); } .p1 .score { color: var(--p1-color); }
        .p2 { border-top: 5px solid var(--p2-color); } .p2 .score { color: var(--p2-color); }
        .p3 { border-top: 5px solid var(--p3-color); } .p3 .score { color: var(--p3-color); }
        .p4 { border-top: 5px solid var(--p4-color); } .p4 .score { color: var(--p4-color); }

        .score-display { 
            width: 180px; display: flex; justify-content: space-between; font-size: 20px; 
            margin-bottom: 5px; font-weight: bold; text-shadow: 1px 1px 2px black; z-index: 1;
            flex-shrink: 0;
        }
        .score { font-family: var(--num-font); }
        
        .input-screen {
            width: 180px; height: 40px;
            background: #111; border: 2px solid #555;
            border-radius: 5px; margin-bottom: 8px;
            color: white; font-size: 28px; text-align: center; line-height: 36px;
            font-family: var(--num-font); font-weight: bold;
            box-shadow: inset 0 2px 5px #000; z-index: 1;
            flex-shrink: 0;
        }

        .keypad {
            display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px;
            width: 180px; 
            height: 160px;
            min-height: 160px;
            z-index: 1;
            flex-shrink: 0;
        }

        .key {
            background: linear-gradient(145deg, #4e342e, #3e2723);
            border: 1px solid #281813;
            border-radius: 6px;
            color: #d7ccc8; font-size: 24px; font-weight: bold;
            font-family: var(--num-font);
            display: flex; justify-content: center; align-items: center;
            cursor: pointer; box-shadow: 0 4px 0 #1a0f0a;
            transition: transform 0.1s, box-shadow 0.1s;
        }
        .key:active { transform: translateY(4px); box-shadow: 0 0 0 #1a0f0a; background: #5d4037; }
        .key-enter { grid-column: 3; background: linear-gradient(145deg, #8d6e63, #6d4c41); color: white; }
        .key-clear { background: #3e2723; color: #ff5555; }

        /* === 오버레이 === */
        .overlay {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.9);
            z-index: 999;
            display: flex; flex-direction: column; justify-content: center; align-items: center;
            backdrop-filter: blur(5px);
            pointer-events: auto;
        }
        .hidden { display: none !important; }

        .top-link {
            font-size: 20px; color: #4fc3f7; text-decoration: none; margin-bottom: 5px;
            font-family: var(--ui-font);
        }
        .top-link:hover { text-decoration: underline; color: #fff; }

        .game-title {
            font-family: 'Black Han Sans'; font-size: 80px;
            background: linear-gradient(to bottom, #ff0000, #550000);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            text-shadow: 0 0 20px rgba(255,0,0,0.5);
            margin-bottom: 5px;
        }
        
        .game-intro {
            font-size: 24px; color: #ccc; margin-bottom: 25px;
        }

        .btn-group { display: flex; gap: 20px; margin-top: 20px; }
        .btn {
            padding: 15px 40px; font-size: 24px; font-family: var(--ui-font);
            border: none; border-radius: 10px; cursor: pointer;
            transition: transform 0.2s;
            box-shadow: 0 0 15px rgba(255,255,255,0.2);
        }
        .btn-start { background: #8a0b0b; color: white; }
        .btn-start:hover { background: #ff1111; transform: scale(1.1); }
        .btn-diff { background: #333; color: #aaa; border: 2px solid #555; }
        .btn-diff.selected { border-color: #ff0000; color: white; background: #550000; }
        
        .other-game-link {
            margin-top: 30px; font-size: 22px; color: #ffeb3b; text-decoration: none;
            border: 1px solid #ffeb3b; padding: 10px 20px; border-radius: 30px;
            transition: background 0.2s, color 0.2s;
        }
        .other-game-link:hover { background: #ffeb3b; color: #000; }

        .floating-text {
            position: absolute; font-size: 40px; font-weight: bold;
            font-family: var(--num-font);
            text-shadow: 2px 2px 0 #000; pointer-events: none;
            animation: floatUp 1s forwards; z-index: 600; 
        }
        @keyframes floatUp { 0% { opacity: 1; transform: translateY(0) scale(1); } 100% { opacity: 0; transform: translateY(-100px) scale(1.5); } }

        .level-popup {
            position: absolute; 
            top: 50%; left: 50%; 
            transform: translate(-50%, -50%);
            font-size: 100px;
            font-family: 'Black Han Sans', sans-serif;
            color: #ffaa00;
            text-shadow: 
                0 0 20px rgba(255, 170, 0, 0.8), 
                4px 4px 0 #000,
                -2px -2px 0 #000;
            z-index: 800;
            pointer-events: none;
            animation: popIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            text-align: center;
            line-height: 1.2;
            white-space: nowrap;
        }
        @keyframes popIn { 
            from { transform: translate(-50%, -50%) scale(0); opacity: 0; } 
            to { transform: translate(-50%, -50%) scale(1); opacity: 1; } 
        }

        /* 하단 버튼 (홈, 전체화면) */
        .nav-btn {
            position: fixed; bottom: 10px; z-index: 1000;
            background: rgba(0,0,0,0.5); color: white;
            border: 2px solid #555; border-radius: 10px;
            width: 50px; height: 50px; font-size: 24px;
            display: flex; justify-content: center; align-items: center;
            cursor: pointer; pointer-events: auto;
        }
        .btn-home { left: 10px; }
        .btn-full { right: 10px; }

        /* ========================================= */
        /* [수정됨] 이벤트 아이템(구급차, 폭탄) 스타일 */
        /* ========================================= */
        .special-container {
            position: absolute;
            z-index: 600;
            display: flex; flex-direction: column; align-items: center;
            will-change: transform, left, bottom;
        }
        .special-emoji { font-size: 60px; line-height: 1; text-shadow: 0 0 10px rgba(255,255,255,0.5); }
        .special-bubble {
            padding: 5px 12px;
            border-radius: 10px;
            font-weight: bold;
            font-family: var(--num-font);
            font-size: 28px;
            margin-bottom: 5px;
            border: 3px solid white;
            box-shadow: 0 0 10px rgba(0,0,0,0.5);
            white-space: nowrap;
        }
        
        /* 구급차 스타일 */
        .ambulance-bubble { background: #ff0000; color: white; }
        .ambulance-move-r { animation: driveLeft 5s linear forwards;  }
        .ambulance-move-l { animation: driveRight 5s linear forwards; }
        .flip-h { transform: scaleX(-1); } /* 이모지 좌우반전 */

        @keyframes driveRight { from { left: -10%; } to { left: 110%; } }
        @keyframes driveLeft { from { left: 110%; } to { left: -10%; } }

        /* 폭탄 스타일 */
        .bomb-bubble { background: #800080; color: white; } /* 보라색 배경 */
        .bomb-move { animation: flyBomb 6s linear forwards; }

        @keyframes flyBomb { 
            0% { bottom: 0%; transform: scale(1); } 
            100% { bottom: 70%; transform: scale(0.3); opacity: 0; } 
        }
/* === [수정] 폭탄 전용 크기 키우기 === */
        
        /* 1. 폭탄 문제 말풍선 크기 */
        .bomb-bubble { 
            font-size: 50px !important;  /* 글자 크기 (기존 28px -> 50px) */
            padding: 10px 25px !important; /* 말풍선 여백 */
            border-width: 5px !important; /* 테두리 두께 */
        }

        /* 2. 폭탄 이모지 크기 */
        .bomb-move .special-emoji {
            font-size: 120px !important; /* 이모지 크기 (기존 60px -> 120px) */
            margin-top: 10px; /* 말풍선과 이모지 사이 간격 */
        }
    </style>
</head>
<body>

    <div id="game-scene">
        <div class="fog"></div>
    </div>

    <div id="ui-layer">
        <div class="top-bar">
            <div class="wave-info" id="wave-display">좀비 파워 1</div>
            <div class="timer-box">
                <span class="timer-label">생존 시간</span>
                <span class="timer-val" id="timer-display">00:00</span>

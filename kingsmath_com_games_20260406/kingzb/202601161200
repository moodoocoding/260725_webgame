<script>
    // === 안전 설정 ===
    document.addEventListener('contextmenu', event => event.preventDefault());
    document.addEventListener('dragstart', event => event.preventDefault());
    
    // === 오디오 매니저 ===
    const AudioContext = window.AudioContext || window.webkitAudioContext;
    const audioCtx = new AudioContext();

    function playTone(freq, type, duration, vol = 0.1) {
        if(audioCtx.state === 'suspended') audioCtx.resume();
        const osc = audioCtx.createOscillator();
        const gainNode = audioCtx.createGain();
        osc.type = type;
        osc.frequency.value = freq;
        osc.connect(gainNode);
        gainNode.connect(audioCtx.destination);
        gainNode.gain.setValueAtTime(vol, audioCtx.currentTime);
        gainNode.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + duration);
        osc.start();
        osc.stop(audioCtx.currentTime + duration);
    }

    function sndShoot() { playTone(800, 'square', 0.1, 0.1); setTimeout(() => playTone(600, 'sawtooth', 0.1, 0.1), 50); }
    function sndWrong() { playTone(150, 'sawtooth', 0.3, 0.2); }
    function sndHit() { playTone(200, 'square', 0.1, 0.2); playTone(100, 'sawtooth', 0.2, 0.2); }
    function sndWarning() { playTone(600, 'sine', 0.1, 0.2); }
    function sndStart() { 
        playTone(400, 'square', 0.1); 
        setTimeout(() => playTone(500, 'square', 0.1), 100); 
        setTimeout(() => playTone(800, 'square', 0.4), 200); 
    }
    function sndLevelUp() {
        playTone(300, 'sine', 0.1);
        setTimeout(() => playTone(450, 'sine', 0.1), 100);
        setTimeout(() => playTone(600, 'square', 0.4), 200);
    }
    function sndGameOver() { 
        playTone(300, 'sawtooth', 0.5); 
        setTimeout(() => playTone(250, 'sawtooth', 0.5), 400); 
        setTimeout(() => playTone(200, 'sawtooth', 1.0), 800); 
    }
    // [추가] 이벤트 아이템 효과음
    function sndHeal() { playTone(400, 'sine', 0.1); setTimeout(() => playTone(600, 'sine', 0.2), 100); setTimeout(() => playTone(800, 'sine', 0.3), 200); }
    function sndBomb() { playTone(100, 'sawtooth', 0.5); setTimeout(() => playTone(50, 'square', 0.8), 100); }


    // === 좀비 랜덤 색상 팔레트 ===
    const ZOMBIE_COLORS = [
        { skin: '#7da35e', clothes: '#5d4037' },
        { skin: '#5e8ba3', clothes: '#37474f' },
        { skin: '#8d6e63', clothes: '#3e2723' },
        { skin: '#a39f5e', clothes: '#4e342e' },
        { skin: '#757575', clothes: '#212121' }
    ];

    // === 게임 설정 ===
    
    // 난이도별 설정
    const DIFFICULTY_SETTINGS = {
        easy: { speedBase: 0.05, speedInc: 0.005 },
        normal: { speedBase: 0.08, speedInc: 0.008 },
        hard: { speedBase: 0.12, speedInc: 0.01 }
    };

    // 문제 생성 함수들
    const PROBLEMS = {
        tier1: function() {
            let a, b, text, ans;
            if(Math.random() > 0.4) {
                if (Math.random() > 0.5) { a = Math.floor(Math.random()*9)+1; b = Math.floor(Math.random()*9)+1; } 
                else { a = Math.floor(Math.random()*15)+5; b = Math.floor(Math.random()*5)+1; }
                ans = a + b; text = `${a} + ${b}`;
            } else {
                a = Math.floor(Math.random()*15)+5; b = Math.floor(Math.random()*9)+1;
                if(a<b) [a,b]=[b,a];
                ans = a - b; text = `${a} - ${b}`;
            }
            return { text, ans };
        },
        tier2: function() {
            let a, b, text, ans;
            const r = Math.random();
            if (r < 0.4) {
                a = Math.floor(Math.random()*40)+10; b = Math.floor(Math.random()*40)+10;
                if(Math.random() > 0.5) { ans=a+b; text=`${a} + ${b}`; }
                else { if(a<b)[a,b]=[b,a]; ans=a-b; text=`${a} - ${b}`; }
            } else {
                a = Math.floor(Math.random()*8)+2; b = Math.floor(Math.random()*9)+1;
                ans = a * b; text = `${a} × ${b}`;
            }
            return { text, ans };
        },
        tier3: function() {
            let a, b, text, ans;
            const r = Math.random();
            if (r < 0.3) {
                b = Math.floor(Math.random()*8)+2; ans = Math.floor(Math.random()*9)+2;
                a = b * ans; 
                text = `${a} ÷ ${b}`;
            } else if (r < 0.6) {
                a = Math.floor(Math.random()*12)+10; b = Math.floor(Math.random()*5)+2;
                ans = a * b; text = `${a} × ${b}`;
            } else {
                a = Math.floor(Math.random()*80)+20; b = Math.floor(Math.random()*50)+10;
                if(a<b)[a,b]=[b,a];
                ans = a - b; text = `${a} - ${b}`;
            }
            return { text, ans };
        }
    };

    // 난이도/웨이브별 수학 문제 혼합 로직
    const MATH_SETTINGS = {
        generate: function(diff, wave) {
            let pType = 1;
            if (diff === 'easy') {
                if (Math.random() < 0.1 * wave) pType = 1; 
                else pType = 1;
            } 
            else if (diff === 'normal') {
                let tier2Chance = 0.1 * wave; 
                if (Math.random() < tier2Chance) pType = 2;
                else pType = 1;
            } 
            else { 
                let tier3Chance = 0.1 * wave;
                let tier2Chance = 0.3 + (0.1 * wave);
                const r = Math.random();
                if (r < tier3Chance) pType = 3;
                else if (r < tier2Chance) pType = 2;
                else pType = 1;
            }
            if (pType === 1) return PROBLEMS.tier1();
            if (pType === 2) return PROBLEMS.tier2();
            return PROBLEMS.tier3();
        }
    };

    const ZOMBIE_SPAWN_SETTINGS = {
        getHpAndSpeed: function(diff, wave) {
            let hp, speedMult;
            speedMult = 0.8 + Math.random() * 0.4; 
            if(diff === 'easy') {
                if (Math.random() < 0.2) { hp = 6; } 
                else {
                    if(wave <= 2) hp = 1; 
                    else if(wave <= 4) hp = 2; 
                    else if(wave <= 6) hp = Math.floor(Math.random() * 2) + 3; 
                    else { hp = 6; speedMult += (wave - 6) * 0.1; }
                }
            } else if(diff === 'normal') {
                if(wave <= 3) hp = Math.floor(Math.random() * 2) + 3; 
                else hp = 6;
            } else { hp = 6; }
            return { hp, speedMult };
        }
    };

    let gameState = {
        active: false,
        difficulty: 'easy',
        wave: 1,
        time: 0,
        hearts: 3,
        zombies: [], 
        specials: [], // [추가] 이벤트 아이템 관리 (구급차, 폭탄)
        nextZombieId: 0,
        nextSpecialId: 0, // [추가]
        spawnRate: 3000,
        lastSpawnTime: 0
    };

    let players = [
        { id: 1, score: 0, input: "", color: '#00f3ff' },
        { id: 2, score: 0, input: "", color: '#ff007f' },
        { id: 3, score: 0, input: "", color: '#39ff14' },
        { id: 4, score: 0, input: "", color: '#ffaa00' }
    ];

    let loopId;
    let timerId;
    let eventTimerId; // [추가] 이벤트 발생 타이머

    // === 유틸리티 ===
    function toggleFullScreen() {
        if (!document.fullscreenElement) document.documentElement.requestFullscreen();
        else if (document.exitFullscreen) document.exitFullscreen();
    }

    function shuffle(array) {
        let currentIndex = array.length, randomIndex;
        while (currentIndex != 0) {
            randomIndex = Math.floor(Math.random() * currentIndex);
            currentIndex--;
            [array[currentIndex], array[randomIndex]] = [array[randomIndex], array[currentIndex]];
        }
        return array;
    }

    // === 초기화 ===
    function initKeypads() {
        for(let i=1; i<=4; i++) {
            const pad = document.getElementById(`p${i}-pad`);
            const nums = ['1','2','3','4','5','6','7','8','9','C','0','E'];
            nums.forEach(n => {
                const btn = document.createElement('div');
                btn.className = 'key' + (n === 'E' ? ' key-enter' : (n==='C' ? ' key-clear' : ''));
                btn.innerText = n === 'E' ? '발사' : (n === 'C' ? '취소' : n);
                btn.onpointerdown = (e) => { e.preventDefault(); handleInput(i, n); };
                pad.appendChild(btn);
            });
        }
    }

    function selectDifficulty(diff) {
        gameState.difficulty = diff;
        document.querySelectorAll('.btn-diff').forEach(b => b.classList.remove('selected'));
        if(event.target.classList.contains('btn-diff')) event.target.classList.add('selected');
    }

    function startGame() {
        if(audioCtx.state === 'suspended') audioCtx.resume();
        sndStart();

        document.getElementById('start-screen').classList.add('hidden');
        gameState.active = true;
        gameState.hearts = 3;
        gameState.time = 0;
        gameState.wave = 1;
        gameState.zombies = [];
        gameState.specials = []; // [추가]
        updateHeartUI();
        updateWaveUI();

        players.forEach(p => { p.score = 0; p.input = ""; updatePlayerUI(p.id); });

        timerId = setInterval(() => {
            gameState.time++;
            const m = Math.floor(gameState.time / 60).toString().padStart(2,'0');
            const s = (gameState.time % 60).toString().padStart(2,'0');
            document.getElementById('timer-display').innerText = `${m}:${s}`;
            
            if(gameState.time > 0 && gameState.time % 20 === 0) {
                gameState.wave++;
                showLevelPopup(`좀비 파워 ${gameState.wave}`); 
                updateWaveUI();
            }
        }, 1000);

        scheduleNextSpecialEvent(); // [추가] 첫 이벤트 스케줄링
        gameLoop();
    }

    function restartGame() {
        document.getElementById('game-over-screen').classList.add('hidden');
        gameState.zombies.forEach(z => z.el.remove());
        gameState.specials.forEach(s => s.el.remove()); // [추가]
        gameState.zombies = [];
        gameState.specials = [];
        clearInterval(timerId);
        clearTimeout(eventTimerId); // [추가]
        cancelAnimationFrame(loopId);
        document.getElementById('timer-display').innerText = "00:00";
        startGame();
    }

function scheduleNextSpecialEvent() {
        // [수정 1] 이벤트 등장 간격 늘리기
        // 기존: 5000(5초) ~ 20000(20초) 
        // 변경: 10000(10초) ~ 30000(30초) -> 너무 자주 뜨는 것 방지
        const delay = Math.random() * 20000 + 10000;
        
        eventTimerId = setTimeout(() => {
            if(gameState.active) {
                // [수정 2] 폭탄 확률 확 낮추기 (구급차 위주로)
                // Math.random() < 0.8 : 80% 확률로 구급차
                // else : 나머지 20% 확률로 폭탄
                if(Math.random() < 0.8) spawnAmbulance();
                else spawnBomb();
                
                scheduleNextSpecialEvent();
            }
        }, delay);
    }

    // 구급차 생성
    function spawnAmbulance() {
        const id = gameState.nextSpecialId++;
        const prob = MATH_SETTINGS.generate(gameState.difficulty, gameState.wave);
        
        const container = document.createElement('div');
        container.className = 'special-container';
        
        // 방향 결정 (0: 왼쪽->오른쪽, 1: 오른쪽->왼쪽)
        const direction = Math.random() > 0.5 ? 'R' : 'L';
        
        // 애니메이션 및 스타일 설정
        if (direction === 'R') {
            container.classList.add('ambulance-move-r');
            // 이모지는 정방향
            container.innerHTML = `
                <div class="special-bubble ambulance-bubble">${prob.text}</div>
                <div class="special-emoji">🚑</div>
            `;
        } else {
            container.classList.add('ambulance-move-l');
            // 이모지 좌우 반전
            container.innerHTML = `
                <div class="special-bubble ambulance-bubble">${prob.text}</div>
                <div class="special-emoji flip-h">🚑</div>
            `;
        }
        
        // Y축 위치 랜덤 (하늘에 떠다니도록 상단 10~40% 영역)
        container.style.top = (10 + Math.random() * 30) + '%';
        
        document.getElementById('game-scene').appendChild(container);

        const obj = {
            id: id,
            type: 'ambulance',
            el: container,
            answer: prob.ans,
            active: true
        };
        gameState.specials.push(obj);

        // 애니메이션 끝나면 제거 (5초 뒤)
        setTimeout(() => {
            if(obj.active) {
                removeSpecial(id);
            }
        }, 5000);
    }

    // 폭탄 생성
    function spawnBomb() {
        const id = gameState.nextSpecialId++;
        const prob = MATH_SETTINGS.generate(gameState.difficulty, gameState.wave);
        
        const container = document.createElement('div');
        container.className = 'special-container bomb-move';
        
        // 폭탄 HTML
        container.innerHTML = `
            <div class="special-bubble bomb-bubble">${prob.text}</div>
            <div class="special-emoji">💣</div>
        `;
        
        // X축 위치 랜덤 (좌우 20~80% 영역)
        container.style.left = (20 + Math.random() * 60) + '%';
        
        document.getElementById('game-scene').appendChild(container);

        const obj = {
            id: id,
            type: 'bomb',
            el: container,
            answer: prob.ans,
            active: true
        };
        gameState.specials.push(obj);

        // 애니메이션 끝나면 제거 (6초 뒤)
        setTimeout(() => {
            if(obj.active) {
                removeSpecial(id);
            }
        }, 6000);
    }

    function removeSpecial(id) {
        const idx = gameState.specials.findIndex(s => s.id === id);
        if(idx !== -1) {
            gameState.specials[idx].active = false;
            if(gameState.specials[idx].el) gameState.specials[idx].el.remove();
            gameState.specials.splice(idx, 1);
        }
    }

    function applyHeal(x, y) {
        gameState.hearts++;
        updateHeartUI();
        showFloatingText(x, y, "♥", "red");
        showLevelPopup("치료 완료!");
        sndHeal();
    }

function applyNuke(x, y) {
        // 1. 효과음 재생
        sndBomb();
        
        // 2. "폭탄 투하!" 자막 표시 (기존 레벨업 팝업 스타일 활용)
        showLevelPopup("폭탄 투하!");
        
        // 3. 화면 흔들림 효과 제거 (키패드 들썩임 방지)
        // document.body.style.animation = "shake 0.5s";  <-- 이 줄을 지웠습니다.

        // 4. 모든 좀비 즉시 제거
        gameState.zombies.forEach(z => {
            z.el.remove();
        });
        gameState.zombies = [];
    }

    // === 게임 루프 ===
    function gameLoop(timestamp) {
        if(!gameState.active) return;

        let currentCount = gameState.zombies.length;
        let forceSpawn = currentCount < 4;
        let timeToSpawn = timestamp - gameState.lastSpawnTime > gameState.spawnRate;

        if(forceSpawn || (timeToSpawn && currentCount < 7)) {
            if (forceSpawn && (timestamp - gameState.lastSpawnTime < 300)) {
                // 대기
            } else {
                spawnZombie();
                gameState.spawnRate = Math.max(800, 2500 - (gameState.wave * 100)); 
                gameState.lastSpawnTime = timestamp;
            }
        }

        const settings = DIFFICULTY_SETTINGS[gameState.difficulty];
        const baseSpeed = settings.speedBase + (gameState.wave * settings.speedInc);

        gameState.zombies.forEach((z, index) => {
            const currentSpeed = baseSpeed * z.speedMultiplier;
            z.progress += currentSpeed;

            const scale = 0.6 + (z.progress / 100) * 0.9;
            
            let baseY = 70 - (z.progress * 0.55);
            let finalBottom = baseY + z.yOffset;
            
            const wobble = Math.sin(timestamp / 500 + z.id) * 20;

            z.el.style.transform = `translateX(-50%) translate3d(${wobble}px, 0, 0) scale(${scale})`;
            z.el.style.bottom = `${finalBottom}%`;
            z.el.style.zIndex = Math.floor(z.progress);

            const remainingDist = 130 - z.progress;
            const framesLeft = remainingDist / currentSpeed;
            const secondsLeft = Math.ceil(framesLeft / 60);

            const countdownEl = z.el.querySelector('.danger-countdown');
            if(secondsLeft <= 5 && secondsLeft > 0) {
                countdownEl.style.display = 'block';
                countdownEl.innerText = `${secondsLeft}초 전`;
                
                if (z.lastWarningSec !== secondsLeft) {
                    sndWarning();
                    z.lastWarningSec = secondsLeft;
                }
            } else {
                countdownEl.style.display = 'none';
            }

            if(z.progress >= 130) {
                removeZombie(index);
                gameState.hearts--;
                sndHit(); 
                updateHeartUI();
                showFloatingText(window.innerWidth/2, window.innerHeight/2, "피격!", "red");
                document.body.style.boxShadow = "inset 0 0 100px red";
                setTimeout(() => document.body.style.boxShadow = "none", 200);

                if(gameState.hearts <= 0) endGame();
            }
        });

        loopId = requestAnimationFrame(gameLoop);
    }

    function getZombieTemplate(type) {
        const commonTorso = `
            <div class="torso">
                <div class="rip" style="top:20px; left:10px; width:20px; height:20px;"></div>
                <div class="rip" style="bottom:20px; right:15px; width:15px; height:15px;"></div>
            </div>`;
        const commonLimbs = `
            <div class="arm left"><div class="hand"></div></div>
            <div class="arm right"><div class="hand"></div></div>
            <div class="leg left"><div class="leg-skin"></div><div class="foot"></div></div>
            <div class="leg right"><div class="leg-skin"></div><div class="foot"></div></div>`;

        if (type === 'z1') {
            return `
                <div class="head">
                    <div class="hair-strand" style="left:20px; transform:rotate(-20deg);"></div>
                    <div class="hair-strand" style="left:40px; top:-15px;"></div>
                    <div class="hair-strand" style="left:60px; transform:rotate(20deg);"></div>
                    <div class="scar"></div>
                    <div class="ear left"></div><div class="ear right"></div>
                    <div class="eye-socket left"><div class="eye"><div class="pupil"></div></div></div>
                    <div class="eye-socket right"><div class="eye"><div class="pupil"></div></div></div>
                    <div class="nose"><div class="nostril left"></div><div class="nostril right"></div></div>
                    <div class="mouth">
                        <div class="tooth" style="left:5px;"></div>
                        <div class="tooth" style="left:15px; top:2px;"></div>
                        <div class="tooth" style="right:5px;"></div>
                        <div class="drool"></div>
                    </div>
                </div>
                ${commonTorso}
                ${commonLimbs}
            `;
        } else if (type === 'z2') {
            return `
                <div class="head">
                    <div class="brain"></div>
                    <div class="ear left"></div><div class="ear right"></div>
                    <div class="eye-socket left"><div class="eye left"><div class="pupil"></div></div></div>
                    <div class="eye-socket right"><div class="eye right"><div class="pupil"></div></div></div>
                    <div class="nose"><div class="nostril left"></div><div class="nostril right"></div></div>
                    <div class="mouth">
                        <div class="tooth" style="left:8px; height:4px;"></div>
                        <div class="tooth" style="left:20px; background:gold;"></div>
                    </div>
                </div>
                ${commonTorso}
                ${commonLimbs}
            `;
        } else {
            return `
                <div class="head">
                    <div class="ear left"></div><div class="ear right"></div>
                    <div class="eye-socket left"><div class="eye"><div class="pupil"></div></div></div>
                    <div class="eye-socket right"><div class="eye right"><div class="pupil"></div></div></div>
                    <div class="nose"><div class="nostril left"></div><div class="nostril right"></div></div>
                    <div class="mouth">
                        <div class="tooth" style="left:3px; transform:rotate(-10deg);"></div>
                        <div class="tooth" style="left:14px; top:3px;"></div>
                        <div class="tooth" style="right:5px; height:4px;"></div>
                        <div class="blood-stain"></div>
                    </div>
                    <div class="blood-stain" style="top:70px; left:10px; width:20px; height:30px; border-radius:30%;"></div>
                </div>
                ${commonTorso}
                ${commonLimbs}
            `;
        }
    }

    function spawnZombie() {
        const id = gameState.nextZombieId++;
        
        const prob = MATH_SETTINGS.generate(gameState.difficulty, gameState.wave);
        const stats = ZOMBIE_SPAWN_SETTINGS.getHpAndSpeed(gameState.difficulty, gameState.wave);
        
        const types = ['z1', 'z2', 'z3'];
        const randomType = types[Math.floor(Math.random() * types.length)];
        const palette = ZOMBIE_COLORS[Math.floor(Math.random() * ZOMBIE_COLORS.length)];

        const container = document.createElement('div');
        container.className = 'zombie-container';
        container.style.setProperty('--skin', palette.skin);
        container.style.setProperty('--clothes', palette.clothes);

        container.innerHTML = `
            <div class="zombie-ui">
                <div class="danger-countdown"></div>
                <div class="math-bubble">${prob.text}</div>
            </div>
            <div class="zombie ${randomType}">
                ${getZombieTemplate(randomType)}
            </div>
        `;
        
        const leftPos = 10 + Math.random() * 80;
        container.style.left = leftPos + '%';
        
        document.getElementById('game-scene').appendChild(container);

        const limbOrder = shuffle(['.arm.left', '.arm.right', '.leg.left', '.leg.right']);

        const zombieObj = {
            id: id,
            el: container,
            hp: stats.hp,
            maxHp: stats.hp, 
            answer: prob.ans,
            progress: 0,
            limbOrder: limbOrder, 
            yOffset: 0,
            lastWarningSec: 0,
            speedMultiplier: stats.speedMult
        };

        updateZombieAppearance(zombieObj);
        gameState.zombies.push(zombieObj);
    }

    function updateZombieAppearance(z) {
        const zombieEl = z.el.querySelector('.zombie');
        
        z.el.querySelectorAll('.arm, .leg, .torso').forEach(el => el.classList.remove('part-hidden'));
        zombieEl.classList.remove('crawling', 'rolling');
        z.el.classList.remove('low-pos', 'lowest-pos');

        const partsToHide = 6 - z.hp;

        for(let i=0; i < Math.min(partsToHide, 4); i++) {
            const selector = z.limbOrder[i];
            const part = z.el.querySelector(selector);
            if(part) part.classList.add('part-hidden');
        }

        if(partsToHide >= 5) {
            z.el.querySelector('.torso').classList.add('part-hidden');
        }

        let legsGoneCount = 0;
        if(z.el.querySelector('.leg.left').classList.contains('part-hidden')) legsGoneCount++;
        if(z.el.querySelector('.leg.right').classList.contains('part-hidden')) legsGoneCount++;

        z.yOffset = 0; 

        if (z.hp === 1) {
            zombieEl.classList.add('rolling');
            z.el.classList.add('lowest-pos');
            z.yOffset = -5; 
        } else if (z.hp === 2) {
            zombieEl.classList.add('crawling');
            z.el.classList.add('low-pos');
            z.yOffset = -6;
        } else {
            if (legsGoneCount === 2) {
                zombieEl.classList.add('crawling');
                z.el.classList.add('low-pos');
                z.yOffset = -6;
            }
        }
    }

    function removeZombie(index) {
        const z = gameState.zombies[index];
        z.el.remove();
        gameState.zombies.splice(index, 1);
    }

    // === 입력 및 정답 처리 ===
    function handleInput(playerId, value) {
        if(!gameState.active) return;
        const p = players[playerId-1];

        if(value === 'C') {
            p.input = "";
        } else if(value === 'E') {
            if(p.input !== "") {
                checkAnswer(p);
                p.input = "";
            }
        } else {
            if(p.input.length < 3) p.input += value;
        }
        updatePlayerUI(playerId);
    }

function shootBullet(playerId, targetEl, callback) {
        const startEl = document.getElementById(`p${playerId}-pad`);
        const rectStart = startEl.getBoundingClientRect();
        
        const bullet = document.createElement('div');
        bullet.className = 'bullet';
        
        const startX = rectStart.left + (rectStart.width / 2);
        const startY = rectStart.top; 

        bullet.style.left = startX + 'px';
        bullet.style.top = startY + 'px';
        
        document.body.appendChild(bullet);

        requestAnimationFrame(() => {
            // 타겟이 머리(.head)를 가지고 있는지, 아니면 그냥 이벤트 아이템인지 확인
            const headEl = targetEl.querySelector('.head');
            const targetRect = headEl ? headEl.getBoundingClientRect() : targetEl.getBoundingClientRect();

            const targetX = targetRect.left + targetRect.width/2;
            const targetY = targetRect.top + targetRect.height/2; 
            
            const distX = targetX - startX;
            const distY = targetY - startY;

            bullet.style.transform = `translate(${distX}px, ${distY}px)`;
        });

        setTimeout(() => {
            bullet.remove();
            if(callback) callback(); // 총알 도착 후 실행
        }, 600);
    }

    function checkAnswer(player) {
        const ans = parseInt(player.input);
        
        // 1. 이벤트 아이템(구급차, 폭탄) 먼저 확인
        const specialTarget = gameState.specials.find(s => s.answer === ans && s.active);
        
        if (specialTarget) {
            sndShoot();
            shootBullet(player.id, specialTarget.el, () => {
                // 총알 도착 후 실행
                if (!specialTarget.active) return; // 이미 없어졌으면 패스
                
                const rect = specialTarget.el.getBoundingClientRect();
                const textX = rect.left + rect.width / 2;
                const textY = rect.top;

                if (specialTarget.type === 'ambulance') {
                    applyHeal(textX, textY);
                } else if (specialTarget.type === 'bomb') {
                    applyNuke(textX, textY);
                }
                
                removeSpecial(specialTarget.id);
                player.score += 50; // 이벤트 점수
                updatePlayerUI(player.id);
            });
            return; // 이벤트 맞췄으면 좀비 확인 안함
        }

        // 2. 좀비 확인
        const targets = gameState.zombies.filter(z => z.answer === ans).sort((a,b) => b.progress - a.progress);

        if(targets.length > 0) {
            const z = targets[0];
            sndShoot(); 
            shootBullet(player.id, z.el, () => {
                // 총알 도착 시 실행 로직
                const currentZombie = gameState.zombies.find(item => item.id === z.id);
                if (!currentZombie) return;

                z.hp--;
                sndHit(); 
                
                const zombieBody = z.el.querySelector('.zombie');
                zombieBody.classList.remove('hit-effect');
                void zombieBody.offsetWidth;
                zombieBody.classList.add('hit-effect');

                updateZombieAppearance(z);

                player.score += 10;
                
                const rect = z.el.getBoundingClientRect();
                const textX = (rect.left + rect.width / 2)-40 ;
                const textY = rect.top; 
                showFloatingText(textX, textY, "HIT!", players[player.id-1].color || '#fff');

                if(z.hp <= 0) {
                    player.score += (z.maxHp * 10); 
                    showFloatingText(textX, textY - 50, "KILL!", "red");
                    
                    const idx = gameState.zombies.findIndex(item => item.id === z.id);
                    if(idx !== -1) removeZombie(idx);
                } else {
                    const newProb = MATH_SETTINGS.generate(gameState.difficulty, gameState.wave);
                    z.answer = newProb.ans;
                    const bubble = z.el.querySelector('.math-bubble');
                    bubble.innerText = newProb.text;
                    
                    bubble.classList.add('changed');
                    setTimeout(()=> bubble.classList.remove('changed'), 200);
                }
                updatePlayerUI(player.id);
            }); 

        } else {
            sndWrong(); 
        }
    }

    function updatePlayerUI(id) {
        const p = players[id-1];
        document.getElementById(`p${id}-input`).innerText = p.input;
        document.getElementById(`p${id}-score`).innerText = p.score;
    }

    function updateHeartUI() {
        let h = "";
        for(let i=0; i<gameState.hearts; i++) h += "♥";
        document.getElementById('heart-display').innerText = h;
        document.getElementById('heart-display').style.color = gameState.hearts <= 1 ? "red" : "white";
    }
    
    function updateWaveUI() {
        document.getElementById('wave-display').innerText = `좀비 파워 ${gameState.wave}`;
    }

    function showFloatingText(x, y, text, color) {
        const el = document.createElement('div');
        el.className = 'floating-text';
        el.innerText = text;
        el.style.left = (x) + 'px'; 
        el.style.top = (y) + 'px';
        el.style.transform = 'translate(-50%, -50%)'; 
        el.style.color = color;
        document.body.appendChild(el);
        setTimeout(() => el.remove(), 1000);
    }

    function showLevelPopup(text) {
        sndLevelUp(); 

        const el = document.createElement('div');
        el.className = 'level-popup';
        el.innerText = text;
        document.body.appendChild(el);

        setTimeout(() => {
            el.remove();
        }, 2000);
    }

    function endGame() {
        sndGameOver();
        gameState.active = false;
        clearInterval(timerId);
        clearTimeout(eventTimerId); // [추가]
        cancelAnimationFrame(loopId);
        document.getElementById('game-over-screen').classList.remove('hidden');
        document.getElementById('final-time').innerText = document.getElementById('timer-display').innerText;
    }

    initKeypads();

</script>
</body>
</html>
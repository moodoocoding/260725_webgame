<!DOCTYPE html>
<html lang="ko">
<head>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-5YW0T2C109"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-5YW0T2C109');
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title id="seo-title">킹타자 디펜스 모바일</title>
    <meta name="description" id="seo-desc" content="지구를 지키는 타자 용사여, 키보드를 잡아라!">
    <meta name="keywords" id="seo-keywords" content="타자, 게임, 킹수학, 디펜스, 모바일, typing, game, defense, mobile">
    
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

    <style>
        @import url('https://cdn.jsdelivr.net/npm/galmuri@latest/dist/galmuri.css');
        @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&display=swap');

        :root {
            --dos-bg: #000000;
            --dos-green: #55FF55;
            --dos-cyan: #55FFFF;
            --dos-red: #FF5555;
            --dos-white: #FFFFFF;
            --dos-yellow: #FFFF55;
        }

        body {
            margin: 0; padding: 0; background-color: #111;
            display: flex; justify-content: center; align-items: center;
            width: 100vw; height: 100vh; height: 100dvh;
            font-family: 'Galmuri11', 'Courier New', monospace;
            overflow: hidden; color: var(--dos-white); touch-action: none;
        }

        #game-container {
            position: relative; width: 100%; height: 100%;
            background-color: var(--dos-bg); box-shadow: 0 0 20px rgba(85, 255, 85, 0.2);
            overflow: hidden; image-rendering: pixelated;
        }

        #game-container::after {
            content: " "; display: block; position: absolute;
            top: 0; left: 0; bottom: 0; right: 0;
            background: linear-gradient(to bottom, rgba(255,255,255,0), rgba(255,255,255,0) 50%, rgba(0,0,0,0.1) 50%, rgba(0,0,0,0.1));
            background-size: 100% 4px; pointer-events: none; z-index: 100;
        }

        canvas { display: block; width: 100%; height: 100%; }

        .screen {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            display: flex; flex-direction: column; justify-content: center; align-items: center;
            background-color: rgba(0, 0, 0, 0.85); z-index: 10;
        }
        .hidden { display: none !important; }

        /* 타이틀 디자인 변경 적용 */
        h1 { color: var(--dos-yellow); font-size: 42px; text-shadow: 4px 4px 0px var(--dos-red); margin-bottom: 20px; letter-spacing: 2px; text-align: center; width: 90%; white-space: nowrap; line-height: 1.2; }

        button.main-btn {
            background-color: var(--dos-bg); color: var(--dos-green); border: 4px solid var(--dos-green);
            padding: 12px 25px; font-family: inherit; font-size: 22px; cursor: pointer; transition: all 0.2s; text-transform: uppercase;
            max-width: 90%; white-space: nowrap; overflow: hidden; border-radius: 8px;
        }
        button.main-btn:hover { background-color: var(--dos-green); color: var(--dos-bg); box-shadow: 0 0 15px var(--dos-green); }

        .other-link { color: var(--dos-cyan); font-size: 16px; margin-top: 15px; text-decoration: none; border-bottom: 1px dashed var(--dos-cyan); z-index: 11; pointer-events: auto; }
        .other-link:hover { color: var(--dos-white); border-bottom: 1px dashed var(--dos-white); }

        #nickname-input {
            background: #000; color: var(--dos-yellow); border: 2px solid var(--dos-white); padding: 8px;
            font-family: inherit; font-size: 18px; text-align: center; outline: none; text-transform: uppercase; margin-bottom: 10px; width: 220px; z-index: 11; border-radius: 6px;
        }
        #nickname-input:focus { border-color: var(--dos-green); }

        .ranking-board-vertical {
            width: 80%; max-width: 400px; height: 150px; overflow-y: auto; background-color: rgba(0, 30, 0, 0.7);
            border: 2px solid var(--dos-cyan); margin-top: 15px; padding: 10px; box-sizing: border-box; z-index: 11; border-radius: 8px;
        }
        .ranking-board-vertical::-webkit-scrollbar { width: 12px; }
        .ranking-board-vertical::-webkit-scrollbar-track { background: #000; border-left: 1px solid var(--dos-cyan); }
        .ranking-board-vertical::-webkit-scrollbar-thumb { background: var(--dos-cyan); border: 1px solid #000; }
        .ranking-board-vertical::-webkit-scrollbar-thumb:hover { background: var(--dos-white); }

        .rank-row { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px dashed rgba(85, 255, 255, 0.3); padding: 5px 0; font-size: 16px; }
        .rank-row:last-child { border-bottom: none; }
        .t-rank { width: 50px; color: var(--dos-cyan); font-weight: bold; }
        .t-name { flex-grow: 1; color: var(--dos-yellow); text-align: center; }
        .t-score { width: 90px; color: var(--dos-green); text-align: right; }

        #submit-msg { height: 20px; font-size: 16px; color: var(--dos-yellow); margin-bottom: 15px; z-index: 11; text-align: center; width: 90%; }

        /* 게임 화면 HUD 2줄 레이아웃 */
        #hud {
            position: absolute; top: 0; left: 0; width: 100%; 
            padding: env(safe-area-inset-top, 15px) 15px 10px 15px; 
            box-sizing: border-box; 
            display: flex; justify-content: space-between; align-items: center; gap: 10px;
            pointer-events: none; z-index: 5; border-bottom: 2px solid var(--dos-green); 
            background: linear-gradient(to bottom, rgba(0,0,0,0.95), rgba(0,0,0,0.7));
        }
        
        .small-header-btn {
            width: 36px; height: 36px; font-size: 18px; background: rgba(0,0,0,0.7); border: 2px solid var(--dos-cyan);
            color: var(--dos-white); border-radius: 8px; display: flex; justify-content: center; align-items: center;
            cursor: pointer; pointer-events: auto; transition: 0.2s all; user-select: none; flex-shrink: 0;
        }
        .small-header-btn:hover { background: var(--dos-cyan); color: #000; transform: scale(1.1); }

        .hud-center-group { display: flex; flex-direction: column; align-items: center; gap: 6px; flex-grow: 1; pointer-events: none; }
        .hud-center-top { display: flex; justify-content: center; align-items: center; gap: 15px; font-size: 15px; font-weight: bold; width: 100%; }
        #level-text { color: var(--dos-yellow); }
        .score-display { color: var(--dos-cyan); display: flex; align-items: center; gap: 4px; }
        
        .hp-bar-container { width: 100%; max-width: 240px; height: 12px; border: 2px solid var(--dos-white); background-color: #333; border-radius: 6px; overflow: hidden; }
        #hp-bar { width: 100%; height: 100%; background-color: var(--dos-green); transition: width 0.3s, background-color 0.3s; }

        #qrcode-wrapper { background-color: #ffffff; padding: 8px; border-radius: 8px; margin-bottom: 12px; box-shadow: 0 0 10px rgba(85, 255, 85, 0.3); display: inline-block; }

        /* =========================================
           [스마트폰 기본 배열 완벽 구현: 모바일 키보드]
           ========================================= */
        #virtual-keyboard {
            position: absolute; bottom: 0; left: 0; width: 100%;
            background: #1a1a1a;
            padding: 8px 4px env(safe-area-inset-bottom, 8px) 4px;
            box-sizing: border-box;
            display: none; flex-direction: column; gap: 6px; z-index: 50;
            border-top: 1px solid #333;
        }
        .vk-row { display: flex; justify-content: center; width: 100%; gap: 5px; }
        .vk-btn {
            flex: 1; height: 48px; background: #444; color: #fff;
            border: none; border-radius: 5px; font-size: 18px; font-weight: bold;
            cursor: pointer; outline: none; user-select: none; -webkit-user-select: none;
            display: flex; justify-content: center; align-items: center; padding: 0;
            box-shadow: 0 2px 2px rgba(0,0,0,0.5);
            font-family: 'Noto Sans KR', sans-serif;
            -webkit-tap-highlight-color: transparent;
        }
        .vk-btn:active { background: var(--dos-cyan); color: #000; transform: scale(0.95); }
        .vk-btn.locked { background: #222; color: #555; pointer-events: none; box-shadow: none; }
        
        /* 모바일 키보드 엇갈림(지그재그) 배치를 위한 투명 스페이서 */
        .vk-spacer { flex: 0.5; }
        .vk-spacer-lg { flex: 1.5; }

        /* =========================================
           [다국어 모달 및 버튼 UI 독립 CSS]
           ========================================= */
        #langTriggerBtnContainer { position: fixed; top: 15px; right: 15px; z-index: 99999 !important; font-family: 'Noto Sans KR', sans-serif; }
        #langTriggerBtn {
            display: flex; align-items: center; gap: 6px; background-color: rgba(55, 65, 81, 0.85); border: 1px solid #4b5563; border-radius: 9999px; 
            padding: 6px 12px; color: #f3f4f6; font-size: 13px; font-weight: 500; cursor: pointer; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.5); transition: all 0.2s;
        }
        #langTriggerBtn:hover { background-color: rgba(55, 65, 81, 1); }
        #langModalOverlay {
            position: fixed; inset: 0; z-index: 99999 !important; background-color: rgba(0, 0, 0, 0.6); backdrop-filter: blur(4px);
            display: flex; align-items: center; justify-content: center; opacity: 0; visibility: hidden; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        #langModalOverlay.active { opacity: 1; visibility: visible; }
        #langModal, #langModal * { box-sizing: border-box !important; }
        #langModal *:not(i) { font-family: 'Noto Sans KR', sans-serif; }
        #langModal {
            background-color: #111827; border: 1px solid #374151; border-radius: 16px; width: 100%; max-width: 800px;
            max-height: 85vh; display: flex; flex-direction: column; overflow: hidden; transform: scale(0.95) translateY(-10px);
            opacity: 0; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5); margin: 0 16px;
        }
        #langModalOverlay.active #langModal { transform: scale(1) translateY(0); opacity: 1; }
        #langModalHeader { display: flex; align-items: center; justify-content: space-between; padding: 15px 20px; border-bottom: 1px solid #1f2937; background-color: rgba(17, 24, 39, 0.95); }
        #langModalHeader h2 { margin: 0; font-size: 18px; font-weight: 700; color: #fff; display: flex; align-items: center; gap: 8px; }
        #closeModalBtn { width: 36px; height: 36px; border-radius: 50%; background-color: #1f2937; border: none; color: #9ca3af; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: 0.2s; }
        #closeModalBtn:hover { background-color: #374151; color: #fff; }
        #langModalSearchArea { padding: 15px; padding-bottom: 5px; background-color: #111827; position: relative; }
        #searchInput { width: 100%; background-color: #1f2937; border: 1px solid #374151; color: #fff; font-size: 14px; border-radius: 12px; padding: 12px 12px 12px 40px; outline: none; }
        #searchInput:focus { border-color: #eab308; box-shadow: 0 0 0 2px rgba(234, 179, 8, 0.2); }
        .search-icon-pos { position: absolute; left: 28px; top: 50%; transform: translateY(-50%); color: #9ca3af; }
        #langModalListArea { padding: 15px; overflow-y: auto; flex: 1; }
        #langModalListArea::-webkit-scrollbar { width: 6px; }
        #langModalListArea::-webkit-scrollbar-track { background: rgba(31, 41, 55, 0.5); border-radius: 3px; }
        #langModalListArea::-webkit-scrollbar-thumb { background: #4b5563; border-radius: 3px; }
        #languageGrid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 10px; }
        .lang-item { display: flex; align-items: center; gap: 10px; padding: 10px; border-radius: 10px; border: 1px solid #374151; background-color: rgba(31, 41, 55, 0.4); cursor: pointer; transition: 0.2s; }
        .lang-item.selected { background-color: #1f2937; border-color: #eab308; box-shadow: 0 0 0 1px rgba(234, 179, 8, 0.5); }
        .lang-flag { width: 28px; height: 20px; border-radius: 3px; overflow: hidden; flex-shrink: 0; }
        .lang-flag img { width: 100%; height: 100%; object-fit: cover; }
        .lang-text { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; }
        .lang-text-main { font-size: 13px; font-weight: 500; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; width: 100%; text-align: left; }
        .lang-item.selected .lang-text-main { color: #facc15; }
        .lang-text-sub { font-size: 11px; color: #9ca3af; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; width: 100%; text-align: left; }
        .check-icon { color: #eab308; font-size: 16px; margin-left: 4px; }
        #noResult { display: none; flex-direction: column; align-items: center; justify-content: center; padding: 40px 0; color: #6b7280; }
        #toastNotification {
            position: fixed; bottom: 20px; right: 20px; background-color: #1f2937; border: 1px solid #374151;
            border-radius: 10px; padding: 12px 16px; display: flex; align-items: center; gap: 10px; z-index: 99999 !important;
            transform: translateY(150%); opacity: 0; transition: all 0.3s ease; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.5);
            font-family: 'Noto Sans KR', sans-serif;
        }
        #toastNotification.show { transform: translateY(0); opacity: 1; }
        .toast-icon { width: 28px; height: 28px; border-radius: 50%; background-color: rgba(34, 197, 94, 0.2); display: flex; align-items: center; justify-content: center; color: #4ade80; }
        .toast-msg { font-size: 13px; font-weight: 500; color: #fff; margin: 0; }
        .toast-lang { font-size: 11px; color: #9ca3af; margin: 0; }
    </style>
</head>
<body>

<div id="langTriggerBtnContainer">
    <button id="langTriggerBtn">
        <i class="fa-solid fa-globe" style="color: #9ca3af;"></i>
        <img id="currentFlag" src="https://flagcdn.com/w40/kr.png" alt="KR" style="width: 18px; height: auto; border-radius: 2px;">
        <span id="currentLangName" style="display: inline-block;">한국어</span>
        <i class="fa-solid fa-chevron-down" style="color: #9ca3af; font-size: 10px; margin-left: 2px;"></i>
    </button>
</div>

<div id="langModalOverlay">
    <div id="langModal">
        <div id="langModalHeader">
            <h2><i class="fa-solid fa-language" style="color: #eab308;"></i><span data-i18n="modal_title">Language / 언어</span></h2>
            <button id="closeModalBtn"><i class="fa-solid fa-xmark" style="font-size: 16px;"></i></button>
        </div>
        <div id="langModalSearchArea">
            <i class="fa-solid fa-magnifying-glass search-icon-pos"></i>
            <input type="text" id="searchInput" placeholder="Search / 검색 ..." data-i18n-ph="modal_search">
        </div>
        <div id="langModalListArea">
            <div id="languageGrid"></div>
            <div id="noResult">
                <i class="fa-regular fa-face-frown-open" style="font-size: 32px; margin-bottom: 10px;"></i>
                <p data-i18n="modal_no_result">No results / 검색 결과 없음</p>
            </div>
        </div>
    </div>
</div>

<div id="toastNotification">
    <div class="toast-icon"><i class="fa-solid fa-check"></i></div>
    <div>
        <p id="ui-toast" class="toast-msg">언어가 변경되었습니다.</p>
        <p id="toastLangName" class="toast-lang">Korean</p>
    </div>
</div>

<div id="game-container">
    <div id="hud" class="hidden">
        <div id="btn-home-ingame" class="small-header-btn" title="첫 화면으로 가기">🏠</div>
        <div class="hud-center-group">
            <div class="hud-center-top">
                <span id="level-text">1단계 (기본)</span>
                <span class="score-display"><i class="fa-solid fa-star" style="font-size:12px; color:var(--dos-yellow);"></i><span id="score">0</span></span>
            </div>
            <div class="hp-bar-container"><div id="hp-bar"></div></div>
        </div>
        <div id="btn-fs-ingame" class="small-header-btn" title="전체화면 토글">⛶</div>
    </div>

    <canvas id="gameCanvas"></canvas>

    <div id="virtual-keyboard">
        <div class="vk-row">
            <button class="vk-btn" data-key="1" data-kr="1" data-en="1">1</button>
            <button class="vk-btn" data-key="2" data-kr="2" data-en="2">2</button>
            <button class="vk-btn" data-key="3" data-kr="3" data-en="3">3</button>
            <button class="vk-btn" data-key="4" data-kr="4" data-en="4">4</button>
            <button class="vk-btn" data-key="5" data-kr="5" data-en="5">5</button>
            <button class="vk-btn" data-key="6" data-kr="6" data-en="6">6</button>
            <button class="vk-btn" data-key="7" data-kr="7" data-en="7">7</button>
            <button class="vk-btn" data-key="8" data-kr="8" data-en="8">8</button>
            <button class="vk-btn" data-key="9" data-kr="9" data-en="9">9</button>
            <button class="vk-btn" data-key="0" data-kr="0" data-en="0">0</button>
        </div>
        <div class="vk-row">
            <button class="vk-btn" data-key="q" data-kr="ㅂ" data-en="Q">ㅂ</button>
            <button class="vk-btn" data-key="w" data-kr="ㅈ" data-en="W">ㅈ</button>
            <button class="vk-btn" data-key="e" data-kr="ㄷ" data-en="E">ㄷ</button>
            <button class="vk-btn" data-key="r" data-kr="ㄱ" data-en="R">ㄱ</button>
            <button class="vk-btn" data-key="t" data-kr="ㅅ" data-en="T">ㅅ</button>
            <button class="vk-btn" data-key="y" data-kr="ㅛ" data-en="Y">ㅛ</button>
            <button class="vk-btn" data-key="u" data-kr="ㅕ" data-en="U">ㅕ</button>
            <button class="vk-btn" data-key="i" data-kr="ㅑ" data-en="I">ㅑ</button>
            <button class="vk-btn" data-key="o" data-kr="ㅐ" data-en="O">ㅐ</button>
            <button class="vk-btn" data-key="p" data-kr="ㅔ" data-en="P">ㅔ</button>
        </div>
        <div class="vk-row">
            <div class="vk-spacer"></div>
            <button class="vk-btn" data-key="a" data-kr="ㅁ" data-en="A">ㅁ</button>
            <button class="vk-btn" data-key="s" data-kr="ㄴ" data-en="S">ㄴ</button>
            <button class="vk-btn" data-key="d" data-kr="ㅇ" data-en="D">ㅇ</button>
            <button class="vk-btn" data-key="f" data-kr="ㄹ" data-en="F">ㄹ</button>
            <button class="vk-btn" data-key="g" data-kr="ㅎ" data-en="G">ㅎ</button>
            <button class="vk-btn" data-key="h" data-kr="ㅗ" data-en="H">ㅗ</button>
            <button class="vk-btn" data-key="j" data-kr="ㅓ" data-en="J">ㅓ</button>
            <button class="vk-btn" data-key="k" data-kr="ㅏ" data-en="K">ㅏ</button>
            <button class="vk-btn" data-key="l" data-kr="ㅣ" data-en="L">ㅣ</button>
            <div class="vk-spacer"></div>
        </div>
        <div class="vk-row">
            <div class="vk-spacer-lg"></div>
            <button class="vk-btn" data-key="z" data-kr="ㅋ" data-en="Z">ㅋ</button>
            <button class="vk-btn" data-key="x" data-kr="ㅌ" data-en="X">ㅌ</button>
            <button class="vk-btn" data-key="c" data-kr="ㅊ" data-en="C">ㅊ</button>
            <button class="vk-btn" data-key="v" data-kr="ㅍ" data-en="V">ㅍ</button>
            <button class="vk-btn" data-key="b" data-kr="ㅠ" data-en="B">ㅠ</button>
            <button class="vk-btn" data-key="n" data-kr="ㅜ" data-en="N">ㅜ</button>
            <button class="vk-btn" data-key="m" data-kr="ㅡ" data-en="M">ㅡ</button>
            <div class="vk-spacer-lg"></div>
        </div>
    </div>

    <div id="start-screen" class="screen">
        <h1 data-i18n="title">킹타자 디펜스<br><span style='font-size: 20px; color: var(--dos-white);'>모바일</span></h1>
        <div style="text-align: center; margin-bottom: 10px; width: 90%;">
            <p style="margin: 2px 0; font-size:12px; color:var(--dos-cyan);" data-i18n="rule1">* 떨어지는 알파벳/자모음을 내장 키보드로 쏘세요!</p>
            <p style="margin: 2px 0; font-size:12px; color:var(--dos-red);" data-i18n="rule2">* 한/영 전환은 레벨에 따라 자동/스위칭 적용됩니다.</p>
            <p style="margin: 2px 0; font-size:12px; color:var(--dos-red);" data-i18n="rule3">* 오타 입력 시 2초간 발사가 정지됩니다!</p>
        </div>

        <div id="qrcode-wrapper"><div id="qrcode"></div></div>
        
        <input type="text" id="nickname-input" placeholder="닉네임 (최대 8자)" data-i18n-ph="placeholder_nick" maxlength="8" autocomplete="off">
        <button id="start-btn" class="main-btn" data-i18n="start_btn">GAME START</button>
        
        <div class="ranking-board-vertical ranking-container"><div style="text-align:center; margin-top: 20px;" data-i18n="rank_loading">서버에서 랭킹을 불러오는 중입니다...</div></div>
    </div>

    <div id="game-over-screen" class="screen hidden" style="z-index: 40;">
        <h1 style="color: var(--dos-red);" data-i18n="gameover">GAME OVER</h1>
        <h2>SCORE: <span id="final-score">0</span></h2>
        <div id="submit-msg" data-i18n="submit_prep">점수 등록 준비 중...</div>
        
        <div id="game-over-actions" class="hidden" style="display:flex; flex-direction:column; align-items:center; z-index: 50; pointer-events: auto;">

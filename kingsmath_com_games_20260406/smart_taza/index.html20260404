const languages = [
    { code: 'ko', country: 'kr', name: '한국어', enName: 'Korean' }, { code: 'en', country: 'us', name: 'English', enName: 'English' },
    { code: 'zh', country: 'cn', name: '中文 (简体)', enName: 'Chinese (Simplified)' }, { code: 'ja', country: 'jp', name: '日本語', enName: 'Japanese' },
    { code: 'es', country: 'es', name: 'Español', enName: 'Spanish' }, { code: 'fr', country: 'fr', name: 'Français', enName: 'French' },
    { code: 'de', country: 'de', name: 'Deutsch', enName: 'German' }, { code: 'it', country: 'it', name: 'Italiano', enName: 'Italian' },
    { code: 'pt-br', country: 'br', name: 'Português', enName: 'Portuguese (Brazil)' }, { code: 'ru', country: 'ru', name: 'Русский', enName: 'Russian' },
    { code: 'hi', country: 'in', name: 'हिन्दी', enName: 'Hindi' }, { code: 'bn', country: 'bd', name: 'বাংলা', enName: 'Bengali' },
    { code: 'id', country: 'id', name: 'Bahasa Indonesia', enName: 'Indonesian' }, { code: 'vi', country: 'vn', name: 'Tiếng Việt', enName: 'Vietnamese' },
    { code: 'th', country: 'th', name: 'ไทย', enName: 'Thai' }, { code: 'tr', country: 'tr', name: 'Türkçe', enName: 'Turkish' }
];

let currentLang = 'ko';
let currentFontFamily = "'Galmuri11', 'Courier New', monospace";

function initLanguage() {
    const urlParams = new URLSearchParams(window.location.search);
    let selectedLang = urlParams.get('lang') || localStorage.getItem('kingsmath_lang') || 'ko';
    if(!translations[selectedLang]) selectedLang = 'en';
    applyLanguage(selectedLang, false);
}

function applyLanguage(langCode, showToastMsg = true) {
    if (!translations[langCode]) langCode = 'en';
    currentLang = langCode;
    currentFontFamily = (langCode === 'ko') ? "'Galmuri11', 'Courier New', monospace" : "'Noto Sans KR', sans-serif";
    localStorage.setItem('kingsmath_lang', langCode);
    const url = new URL(window.location); url.searchParams.set('lang', langCode); window.history.pushState({}, '', url);

    const dict = translations[langCode];
    const langObj = languages.find(l => l.code === langCode);

    document.getElementById('currentFlag').src = `https://flagcdn.com/w40/${langObj.country}.png`;
    document.getElementById('currentLangName').textContent = langObj.name;

    document.querySelectorAll('[data-i18n]').forEach(el => { if (dict[el.getAttribute('data-i18n')]) el.innerHTML = dict[el.getAttribute('data-i18n')]; });
    document.querySelectorAll('[data-i18n-ph]').forEach(el => { if (dict[el.getAttribute('data-i18n-ph')]) el.placeholder = dict[el.getAttribute('data-i18n-ph')]; });
    if (showToastMsg) showToast(langObj.name, langCode);
}

function t(key) { return translations[currentLang][key] || translations['en'][key] || key; }

// 모달 로직
const triggerBtn = document.getElementById('langTriggerBtn');
const langModalOverlay = document.getElementById('langModalOverlay');
const closeBtn = document.getElementById('closeModalBtn');
const searchInput = document.getElementById('searchInput');
const grid = document.getElementById('languageGrid');
const noResult = document.getElementById('noResult');
const toastNotification = document.getElementById('toastNotification');
const toastLangName = document.getElementById('toastLangName');
let toastTimeout;

function renderLanguages(filterText = '') {
    grid.innerHTML = '';
    const lowerFilter = filterText.toLowerCase();
    const filteredLangs = languages.filter(lang => lang.name.toLowerCase().includes(lowerFilter) || lang.enName.toLowerCase().includes(lowerFilter) || lang.code.toLowerCase().includes(lowerFilter));
    if (filteredLangs.length === 0) { grid.style.display = 'none'; noResult.style.display = 'flex'; } 
    else {
        grid.style.display = 'grid'; noResult.style.display = 'none';
        filteredLangs.forEach(lang => {
            const isSelected = lang.code === currentLang;
            const btn = document.createElement('div');
            btn.className = `lang-item ${isSelected ? 'selected' : ''}`;
            btn.innerHTML = `<div class="lang-flag"><img src="https://flagcdn.com/w40/${lang.country}.png"></div><div class="lang-text"><span class="lang-text-main">${lang.name}</span><span class="lang-text-sub">${lang.enName}</span></div>${isSelected ? '<i class="fa-solid fa-circle-check check-icon"></i>' : ''}`;
            btn.addEventListener('click', () => { applyLanguage(lang.code, true); closeModal(); renderLanguages(searchInput.value); });
            grid.appendChild(btn);
        });
    }
}

function openModal() { langModalOverlay.classList.add('active'); setTimeout(() => searchInput.focus(), 100); }
function closeModal() { langModalOverlay.classList.remove('active'); }
function showToast(langName, langCode) {
    document.getElementById('ui-toast').textContent = translations[langCode]['toast'] || "언어가 변경되었습니다.";
    toastLangName.textContent = langName; toastNotification.classList.add('show');
    clearTimeout(toastTimeout); toastTimeout = setTimeout(() => { toastNotification.classList.remove('show'); }, 3000);
}

triggerBtn.addEventListener('click', openModal); closeBtn.addEventListener('click', closeModal);
langModalOverlay.addEventListener('click', (e) => { if (e.target === langModalOverlay) closeModal(); });
document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && langModalOverlay.classList.contains('active')) closeModal(); });
searchInput.addEventListener('input', (e) => { renderLanguages(e.target.value); });

initLanguage(); renderLanguages();

/* =====================================================================
   [2] 100% 꽉찬 네이티브 동적 캔버스
   ===================================================================== */
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');

let BASE_X = 0; let BASE_Y = 0;

function resizeGame() {
    const container = document.getElementById('game-container');
    canvas.width = container.clientWidth; canvas.height = container.clientHeight;
    BASE_X = canvas.width / 2;
    
    // 키패드가 렌더링된 높이를 실시간으로 가져와 그 위로 포탑 배치
    const vk = document.getElementById('virtual-keyboard');
    const vkHeight = (vk.style.display !== 'none' && vk.offsetHeight > 0) ? vk.offsetHeight : 230; 
    BASE_Y = canvas.height - vkHeight - 10; 

    if(stars.length === 0) initStars();
}

window.addEventListener('resize', resizeGame);
window.addEventListener('orientationchange', () => setTimeout(resizeGame, 100));
window.addEventListener('load', () => {
    resizeGame(); fetchRankings();
    const currentUrl = window.location.href.split('?')[0]; 
    new QRCode(document.getElementById("qrcode"), { text: currentUrl, width: 90, height: 90, colorDark : "#000000", colorLight : "#ffffff", correctLevel : QRCode.CorrectLevel.L });
});

function toggleFullScreen() {
    if (!document.fullscreenElement) { document.documentElement.requestFullscreen().catch(err => { console.log(err.message); }); } 
    else { if (document.exitFullscreen) document.exitFullscreen(); }
}
document.addEventListener('fullscreenchange', () => { setTimeout(resizeGame, 100); });

document.getElementById('btn-home-ingame').addEventListener('click', () => {
    if (document.fullscreenElement) {
        gameState = 'START'; if (animationId) cancelAnimationFrame(animationId);
        document.getElementById('hud').classList.add('hidden'); document.getElementById('game-over-screen').classList.add('hidden');
        document.getElementById('virtual-keyboard').style.display = 'none'; document.getElementById('start-screen').classList.remove('hidden');
        document.getElementById('langTriggerBtnContainer').style.display = 'block'; 
        if(window.playSound) window.playSound('error'); fetchRankings();
    } else { location.reload(); }
});

document.getElementById('btn-fs-ingame').addEventListener('click', toggleFullScreen);

/* =====================================================================
   [3] 타자 디펜스 데이터 및 로직 구성
   ===================================================================== */
const startScreen = document.getElementById('start-screen');
const gameOverScreen = document.getElementById('game-over-screen');
const hud = document.getElementById('hud');
const scoreEl = document.getElementById('score');
const levelTextEl = document.getElementById('level-text');
const hpBarEl = document.getElementById('hp-bar');
const finalScoreEl = document.getElementById('final-score');
const virtualKeyboard = document.getElementById('virtual-keyboard');
const nicknameInput = document.getElementById('nickname-input');
const submitMsg = document.getElementById('submit-msg');
const gameOverActions = document.getElementById('game-over-actions');
const rankingContainers = document.querySelectorAll('.ranking-container');

// 영문-한글 양방향 매핑 (소문자 기준 매핑)
const enToKr = { 'a':'ㅁ', 's':'ㄴ', 'd':'ㅇ', 'f':'ㄹ', 'g':'ㅎ', 'h':'ㅗ', 'j':'ㅓ', 'k':'ㅏ', 'l':'ㅣ', 'q':'ㅂ', 'w':'ㅈ', 'e':'ㄷ', 'r':'ㄱ', 't':'ㅅ', 'z':'ㅋ', 'x':'ㅌ', 'c':'ㅊ', 'v':'ㅍ', 'y':'ㅛ', 'u':'ㅕ', 'i':'ㅑ', 'o':'ㅐ', 'p':'ㅔ', 'b':'ㅠ', 'n':'ㅜ', 'm':'ㅡ' };
const krToEn = {}; for (const [en, kr] of Object.entries(enToKr)) { krToEn[kr] = en.toLowerCase(); }

// 1~4단계: 한글 (시프트 제외)
const L1_KR = ['ㅁ','ㄴ','ㅇ','ㄹ','ㅎ','ㅗ','ㅓ','ㅏ','ㅣ']; // 기본자리
const L2_KR = [...L1_KR, 'ㅂ','ㅈ','ㄷ','ㄱ','ㅅ','ㅛ','ㅕ','ㅑ','ㅐ','ㅔ']; // 기본 + 윗자리
const L3_KR = [...L2_KR, 'ㅋ','ㅌ','ㅊ','ㅍ','ㅠ','ㅜ','ㅡ']; // 모든 자리
const L4_KR_NUM = [...L3_KR, '1','2','3','4','5','6','7','8','9','0']; // 모든 자리 + 숫자

// 5~7단계: 영문
const L5_EN = ['a','s','d','f','g','h','j','k','l']; // 기본자리
const L6_EN = [...L5_EN, 'q','w','e','r','t','y','u','i','o','p']; // 기본 + 윗자리
const L7_EN = [...L6_EN, 'z','x','c','v','b','n','m']; // 모든 자리

// 8단계 이후: 한글 영문 혼합 (1초 단위 키패드 스위칭용)
const L8_MIX = [...L4_KR_NUM, ...L7_EN]; 

const LEVELS = [
    { name: "1단계 (한글 기본)", reqScore: 0, speed: 0.25, spawnRate: 90, chars: L1_KR, kbMode: 'kr' },
    { name: "2단계 (한글 상단)", reqScore: 300, speed: 0.3, spawnRate: 85, chars: L2_KR, kbMode: 'kr' },
    { name: "3단계 (한글 전체)", reqScore: 600, speed: 0.35, spawnRate: 80, chars: L3_KR, kbMode: 'kr' },
    { name: "4단계 (한글+숫자)", reqScore: 1000, speed: 0.4, spawnRate: 75, chars: L4_KR_NUM, kbMode: 'kr' },
    { name: "5단계 (영문 기본)", reqScore: 1500, speed: 0.45, spawnRate: 70, chars: L5_EN, kbMode: 'en' },
    { name: "6단계 (영문 상단)", reqScore: 2000, speed: 0.5, spawnRate: 65, chars: L6_EN, kbMode: 'en' },
    { name: "7단계 (영문 전체)", reqScore: 2600, speed: 0.55, spawnRate: 60, chars: L7_EN, kbMode: 'en' },
    { name: "8단계 (한·영 혼합)", reqScore: 3300, speed: 0.6, spawnRate: 55, chars: L8_MIX, kbMode: 'mix' },
    { name: "9단계 (속도 증가)", reqScore: 4100, speed: 0.7, spawnRate: 50, chars: L8_MIX, kbMode: 'mix' },
    { name: "10단계 (초고속)", reqScore: 5000, speed: 0.8, spawnRate: 45, chars: L8_MIX, kbMode: 'mix' }
];

const ITEMS = [
    { id: 'BOMB', icon: '💣', name: '폭탄', color: '#FF5555' }, { id: 'SLOW', icon: '🐢', name: '느리게', color: '#55FF55' },
    { id: 'HEAL', icon: '💙', name: '에너지회복', color: '#55FF55' }, { id: 'INVINCIBLE', icon: '🛡️', name: '무적', color: '#5555FF' }
];

let currentNickname = "익명"; let gameState = 'START'; 
let score = 0; let currentLevel = 0; let baseHp = 100;
let frameCount = 0; let animationId; let countdownValue = 3; let countdownTimer = 0;
let effectTimer = 0; let currentEffect = null; let globalSpeedMult = 1.0; let isInvincible = false;
let centerMsg = ""; let centerMsgTimer = 0; let centerMsgColor = "#FFF"; let centerMsgSize = 40;
let firePenaltyTimer = 0; 
let currentKbMode = 'kr'; // 현재 키보드 표시 상태 ('kr' or 'en')

let audioCtx;
function playSound(type) {
    if (!audioCtx) return; if (audioCtx.state === 'suspended') audioCtx.resume();
    const osc = audioCtx.createOscillator(); const gainNode = audioCtx.createGain();
    osc.connect(gainNode); gainNode.connect(audioCtx.destination); const now = audioCtx.currentTime;
    
    if (type === 'shoot') { osc.type = 'square'; osc.frequency.setValueAtTime(880, now); osc.frequency.exponentialRampToValueAtTime(110, now + 0.1); gainNode.gain.setValueAtTime(0.05, now); gainNode.gain.exponentialRampToValueAtTime(0.01, now + 0.1); osc.start(now); osc.stop(now + 0.1); }
    else if (type === 'explosion') { osc.type = 'sawtooth'; osc.frequency.setValueAtTime(150, now); osc.frequency.exponentialRampToValueAtTime(0.01, now + 0.2); gainNode.gain.setValueAtTime(0.1, now); gainNode.gain.exponentialRampToValueAtTime(0.01, now + 0.2); osc.start(now); osc.stop(now + 0.2); }
    else if (type === 'error') { osc.type = 'sawtooth'; osc.frequency.setValueAtTime(100, now); gainNode.gain.setValueAtTime(0.1, now); gainNode.gain.linearRampToValueAtTime(0, now + 0.3); osc.start(now); osc.stop(now + 0.3); }
    else if (type === 'item') { osc.type = 'square'; osc.frequency.setValueAtTime(440, now); osc.frequency.setValueAtTime(660, now + 0.1); osc.frequency.setValueAtTime(880, now + 0.2); gainNode.gain.setValueAtTime(0.1, now); gainNode.gain.linearRampToValueAtTime(0, now + 0.3); osc.start(now); osc.stop(now + 0.3); }
    else if (type === 'levelup') { osc.type = 'square'; osc.frequency.setValueAtTime(261.63, now); osc.frequency.setValueAtTime(329.63, now + 0.1); osc.frequency.setValueAtTime(392.00, now + 0.2); osc.frequency.setValueAtTime(523.25, now + 0.3); gainNode.gain.setValueAtTime(0.1, now); gainNode.gain.linearRampToValueAtTime(0, now + 0.6); osc.start(now); osc.stop(now + 0.6); }
    else if (type === 'beep') { osc.type = 'square'; osc.frequency.setValueAtTime(660, now); gainNode.gain.setValueAtTime(0.1, now); gainNode.gain.linearRampToValueAtTime(0, now + 0.1); osc.start(now); osc.stop(now + 0.1); }
}

let enemies = []; let missiles = []; let particles = []; let stars = []; 

function initStars() {
    stars = []; for (let i = 0; i < 100; i++) { stars.push({ x: Math.random() * canvas.width, y: Math.random() * canvas.height, speed: Math.random() * 0.5 + 0.1, size: Math.random() * 2, color: Math.random() > 0.5 ? '#55FF55' : '#55FFFF' }); }
}

// 가상 키보드 텍스트 토글
function updateKeyboardUI() {
    const keys = document.querySelectorAll('.vk-btn');
    keys.forEach(btn => {
        if (btn.dataset.kr && btn.dataset.en) {
            btn.innerText = currentKbMode === 'kr' ? btn.dataset.kr : btn.dataset.en;
        }
    });
}

function startGame() {
    document.getElementById('langTriggerBtnContainer').style.display = 'none';
    const inputVal = nicknameInput.value.trim(); currentNickname = inputVal ? inputVal : "익명";
    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)(); if (audioCtx.state === 'suspended') audioCtx.resume();
    
    gameState = 'COUNTDOWN'; countdownValue = 3; countdownTimer = 60; playSound('beep');
    score = 0; currentLevel = 0; baseHp = 100; enemies = []; missiles = []; particles = [];
    frameCount = 0; effectTimer = 0; currentEffect = null; globalSpeedMult = 1.0; isInvincible = false;
    centerMsgTimer = 0; firePenaltyTimer = 0;
    
    currentKbMode = LEVELS[currentLevel].kbMode === 'en' ? 'en' : 'kr';
    updateKeyboardUI();

    startScreen.classList.add('hidden'); gameOverScreen.classList.add('hidden'); hud.classList.remove('hidden');
    virtualKeyboard.style.display = 'flex';
    
    setTimeout(resizeGame, 50);

    updateHUD(); levelTextEl.innerText = LEVELS[currentLevel].name;
    if(animationId) cancelAnimationFrame(animationId); gameLoop();
}

function gameOver() {
    gameState = 'GAMEOVER'; hud.classList.add('hidden'); virtualKeyboard.style.display = 'none';
    gameOverScreen.classList.remove('hidden'); finalScoreEl.innerText = `${score}`;
    gameOverActions.classList.add('hidden'); autoSubmitScore();
}

function updateHUD() {
    scoreEl.innerText = score; hpBarEl.style.width = `${Math.max(0, baseHp)}%`;
    if (baseHp > 60) hpBarEl.style.backgroundColor = 'var(--dos-green)'; else if (baseHp > 30) hpBarEl.style.backgroundColor = 'var(--dos-yellow)'; else hpBarEl.style.backgroundColor = 'var(--dos-red)';
}

function updateLevel() {
    let newLevel = 0; for (let i = LEVELS.length - 1; i >= 0; i--) { if (score >= LEVELS[i].reqScore) { newLevel = i; break; } }
    if (newLevel !== currentLevel) {
        currentLevel = newLevel; createExplosion(BASE_X, BASE_Y, '#FFFF55', 50);
        playSound('levelup'); showMessage(`${LEVELS[currentLevel].name}`, '#FFFF55', 120, 30);
        
        // 레벨업 시 키보드 상태 강제 적용 (mix인 경우 다음 틱에 자동 스위칭됨)
        if(LEVELS[currentLevel].kbMode !== 'mix') {
            currentKbMode = LEVELS[currentLevel].kbMode;
            updateKeyboardUI();
        }
    }
    levelTextEl.innerText = LEVELS[currentLevel].name;
}

function showMessage(msg, color, time, size = 40) { centerMsg = msg; centerMsgColor = color; centerMsgTimer = time; centerMsgSize = size; }

/* --------------------------------------------------------------------------
   [핵심] 커스텀 가상 키보드 입력 처리
-------------------------------------------------------------------------- */
function processGameInput(key) {
    if (gameState !== 'PLAYING' || firePenaltyTimer > 0) return;
    
    const lowerKey = key.toLowerCase();
    const mappedKr = enToKr[lowerKey] || key;
    const mappedEn = krToEn[key] || lowerKey;
    const possibleChars = [key, lowerKey, mappedKr, mappedEn].filter(Boolean);

    let targetEnemy = null; let minDist = Infinity;
    let isHitAny = false;

    for (let enemy of enemies) {
        if (!enemy.targeted && possibleChars.includes(enemy.char)) {
            isHitAny = true;
            let dist = Math.hypot(BASE_X - enemy.x, BASE_Y - enemy.y);
            if (dist < minDist) { minDist = dist; targetEnemy = enemy; }
        }
    }
    
    if (targetEnemy) {
        targetEnemy.targeted = true; fireMissile(targetEnemy);
    } else if (!isHitAny) {
        firePenaltyTimer = 120; playSound('error'); showMessage(t('msg_penalty'), "#FF5555", 120, 24);
        updateVirtualKeyboardState();
    }
}

function updateVirtualKeyboardState() {
    const btns = document.querySelectorAll('.vk-btn');
    btns.forEach(btn => firePenaltyTimer > 0 ? btn.classList.add('locked') : btn.classList.remove('locked'));
}

// 가상 버튼 이벤트 바인딩 (preventDefault로 줌 및 더블 탭 방지)
const vkBtns = document.querySelectorAll('.vk-btn');
vkBtns.forEach(btn => {
    btn.addEventListener('mousedown', (e) => { e.preventDefault(); processGameInput(btn.dataset.key); });
    btn.addEventListener('touchstart', (e) => { e.preventDefault(); processGameInput(btn.dataset.key); }, {passive: false});
});

window.addEventListener('keydown', (e) => { 
    if (document.activeElement === nicknameInput) return;
    if (e.key.length === 1) processGameInput(e.key); 
});

/* -------------------------------------------------------------------------- */

function fireMissile(target) {
    playSound('shoot');
    missiles.push({ x: BASE_X, y: BASE_Y, target: target, speed: 20, color: '#FFFF55' });
}

function spawnEnemy(canBeItem = true) {
    const lvlData = LEVELS[currentLevel];
    const char = lvlData.chars[Math.floor(Math.random() * lvlData.chars.length)];
    let x = Math.random() * (canvas.width - 80) + 40; let y = -40;
    
    let isItem = canBeItem && Math.random() < 0.05; 
    let itemData = null; if(isItem) itemData = ITEMS[Math.floor(Math.random() * ITEMS.length)];

    let speed = lvlData.speed + (Math.random() * 0.4); if (isItem) speed *= 1.8;
    enemies.push({ x: x, y: y, char: char, speed: speed, targeted: false, item: itemData, width: 40, height: 30 });
}

function triggerItem(item) {
    playSound('item'); showMessage(`${item.icon} ${item.name} 발동!`, item.color, 120, 24);
    if (item.id === 'BOMB') {
        enemies.forEach(e => createExplosion(e.x, e.y, '#FF5555')); score += enemies.length * 10; enemies = []; updateLevel(); updateHUD();
        ctx.fillStyle = 'rgba(255, 255, 255, 0.5)'; ctx.fillRect(0, 0, canvas.width, canvas.height);
    } else if (item.id === 'HEAL') { baseHp = Math.min(100, baseHp + 30); updateHUD();
    } else { effectTimer = (item.id === 'INVINCIBLE') ? 600 : 180; currentEffect = item.id; }
}

function createExplosion(x, y, color, count = 15) {
    for (let i = 0; i < count; i++) { particles.push({ x: x, y: y, vx: (Math.random() - 0.5) * 8, vy: (Math.random() - 0.5) * 8, life: 1.0, decay: Math.random() * 0.05 + 0.02, color: color, size: Math.random() * 4 + 2 }); }
}

function gameLoop() {
    if (gameState === 'START' || gameState === 'GAMEOVER') return;
    
    if (gameState === 'PLAYING') {
        if (firePenaltyTimer > 0) { firePenaltyTimer--; if (firePenaltyTimer === 0) updateVirtualKeyboardState(); }
        globalSpeedMult = 1.0; isInvincible = false;
        if (effectTimer > 0) {
            effectTimer--;
            if (currentEffect === 'SLOW') globalSpeedMult = 0.5; else if (currentEffect === 'INVINCIBLE') isInvincible = true;
            if (effectTimer <= 0) currentEffect = null;
        }

        // 혼합 모드 (8단계 이상) 1초(60프레임) 마다 한/영 스위칭
        if (LEVELS[currentLevel].kbMode === 'mix') {
            if (frameCount % 60 === 0) {
                currentKbMode = currentKbMode === 'kr' ? 'en' : 'kr';
                updateKeyboardUI();
            }
        }
    }

    ctx.fillStyle = '#000000'; ctx.fillRect(0, 0, canvas.width, canvas.height);
    
    ctx.fillStyle = '#FFFFFF';
    stars.forEach(star => {
        star.y += star.speed; if (star.y > canvas.height) { star.y = 0; star.x = Math.random() * canvas.width; }
        ctx.globalAlpha = Math.random() * 0.5 + 0.3; ctx.fillStyle = star.color; ctx.fillRect(star.x, star.y, star.size, star.size);
    });
    ctx.globalAlpha = 1.0;

    if (gameState === 'PLAYING') {
        frameCount++;
        const currentLvl = LEVELS[currentLevel]; const scoreProgress = Math.max(0, score - currentLvl.reqScore);
        const currentSpawnRate = Math.max(15, currentLvl.spawnRate - Math.floor(scoreProgress / 150));
        if (frameCount % currentSpawnRate === 0) spawnEnemy();

        for (let i = enemies.length - 1; i >= 0; i--) {
            let enemy = enemies[i];
            let dx = BASE_X - enemy.x; let dy = BASE_Y - enemy.y;
            let dist = Math.sqrt(dx*dx + dy*dy);
            
            if (dist > 0) { enemy.x += (dx / dist) * enemy.speed * globalSpeedMult; enemy.y += (dy / dist) * enemy.speed * globalSpeedMult; }

            ctx.fillStyle = enemy.targeted ? '#FF5555' : (enemy.item ? enemy.item.color : '#55FFFF');
            ctx.fillRect(enemy.x - 15, enemy.y - 10, 30, 10); ctx.fillRect(enemy.x - 5, enemy.y - 20, 10, 10);
            ctx.fillRect(enemy.x - 20, enemy.y, 10, 10); ctx.fillRect(enemy.x + 10, enemy.y, 10, 10);
            ctx.fillStyle = '#FF5555'; ctx.fillRect(enemy.x - 3, enemy.y - 15, 6, 4);

            if (enemy.item) { ctx.font = '16px Galmuri11'; ctx.fillStyle = '#FFFF55'; ctx.fillText('❓', enemy.x, enemy.y - 30); }
            ctx.fillStyle = '#FFFFFF'; ctx.font = 'bold 22px Galmuri11, Courier New'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
            ctx.fillStyle = 'rgba(0,0,0,0.8)'; ctx.fillRect(enemy.x - 14, enemy.y + 10, 28, 28);
            ctx.fillStyle = '#FFFF55'; ctx.fillText(enemy.char, enemy.x, enemy.y + 24);

            if (dist < 40) {
                if (!isInvincible) { baseHp -= 10; playSound('explosion'); canvas.style.transform = `translate(${(Math.random()-0.5)*10}px, ${(Math.random()-0.5)*10}px)`; setTimeout(() => { canvas.style.transform = 'translate(0, 0)'; }, 50); }
                else { playSound('explosion'); }
                createExplosion(enemy.x, enemy.y, '#FF5555'); enemies.splice(i, 1); updateHUD();
                if (baseHp <= 0) { gameOver(); return; }
            }
        }

        for (let i = missiles.length - 1; i >= 0; i--) {
            let m = missiles[i];
            let dx = m.target.x - m.x; let dy = m.target.y - m.y; let dist = Math.sqrt(dx*dx + dy*dy);
            
            if (dist < m.speed || !enemies.includes(m.target)) { 
                const enemyIndex = enemies.indexOf(m.target);
                if (enemyIndex > -1) {
                    let hitEnemy = enemies[enemyIndex]; enemies.splice(enemyIndex, 1);
                    playSound('explosion'); createExplosion(hitEnemy.x, hitEnemy.y, '#55FF55');
                    score += 10; updateLevel(); updateHUD();
                    if (hitEnemy.item) triggerItem(hitEnemy.item);
                }
                missiles.splice(i, 1); continue;
            }

            m.x += (dx / dist) * m.speed; m.y += (dy / dist) * m.speed;
            ctx.fillStyle = m.color; ctx.beginPath(); ctx.arc(m.x, m.y, 6, 0, Math.PI * 2); ctx.fill();
            if (Math.random() > 0.5) particles.push({ x: m.x, y: m.y, vx: 0, vy: 2, life: 1.0, decay: 0.1, color: '#FF5555', size: 2 });
        }
    }

    for (let i = particles.length - 1; i >= 0; i--) {
        let p = particles[i]; p.x += p.vx; p.y += p.vy; p.life -= p.decay;
        if (p.life <= 0) { particles.splice(i, 1); } else { ctx.globalAlpha = p.life; ctx.fillStyle = p.color; ctx.fillRect(p.x, p.y, p.size, p.size); ctx.globalAlpha = 1.0; }
    }

    // 포탑 베이스 결합부 (모바일 최하단)
    ctx.fillStyle = '#0055AA'; ctx.beginPath(); ctx.arc(BASE_X, BASE_Y + 40, 100, Math.PI, 0); ctx.fill();
    if (isInvincible) { ctx.strokeStyle = `rgba(85, 85, 255, ${0.5 + Math.sin(frameCount * 0.1) * 0.3})`; ctx.lineWidth = 4; ctx.beginPath(); ctx.arc(BASE_X, BASE_Y + 40, 110, Math.PI, 0); ctx.stroke(); }
    ctx.fillStyle = '#AAAAAA'; ctx.fillRect(BASE_X - 20, BASE_Y, 40, 20);
    ctx.fillStyle = (gameState === 'PLAYING' && firePenaltyTimer > 0) ? '#FF5555' : '#FFFFFF'; ctx.fillRect(BASE_X - 5, BASE_Y - 20, 10, 20);
    ctx.fillStyle = '#FF5555'; ctx.fillRect(BASE_X - 8, BASE_Y - 25, 16, 5);

    if (gameState === 'PLAYING' && firePenaltyTimer > 0) { ctx.fillStyle = '#FF5555'; ctx.font = 'bold 16px Galmuri11'; ctx.textAlign = 'center'; ctx.fillText('LOCKED', BASE_X, BASE_Y - 40); }

    if (gameState === 'COUNTDOWN') {
        countdownTimer--;
        if (countdownTimer <= 0) {
            countdownValue--;
            if (countdownValue > 0) { countdownTimer = 60; playSound('beep'); } 
            else { gameState = 'PLAYING'; playSound('levelup'); showMessage(`${LEVELS[currentLevel].name}`, '#FFFF55', 120, 40); }
        }
        if (countdownValue > 0) {
            ctx.fillStyle = `rgba(0, 0, 0, 0.5)`; ctx.fillRect(0, canvas.height/2 - 60, canvas.width, 120);
            ctx.font = 'bold 60px Galmuri11'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
            ctx.shadowColor = '#FF0000'; ctx.shadowBlur = 15; ctx.shadowOffsetX = 3; ctx.shadowOffsetY = 3;
            ctx.fillStyle = '#FFFF55'; ctx.fillText(countdownValue, canvas.width / 2, canvas.height / 2);
            ctx.shadowBlur = 0; ctx.shadowOffsetX = 0; ctx.shadowOffsetY = 0;
        }
    }

    if (centerMsgTimer > 0) {
        centerMsgTimer--;
        ctx.fillStyle = `rgba(0, 0, 0, ${Math.min(0.7, centerMsgTimer/30)})`; ctx.fillRect(0, BASE_Y - centerMsgSize - 100, canvas.width, centerMsgSize * 2);
        ctx.font = `bold ${centerMsgSize}px Galmuri11`; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
        if (centerMsgSize > 40) { ctx.shadowColor = '#FF0000'; ctx.shadowBlur = 15; ctx.shadowOffsetX = 3; ctx.shadowOffsetY = 3; } 
        else { ctx.shadowColor = '#000000'; ctx.shadowBlur = 5; ctx.shadowOffsetX = 0; ctx.shadowOffsetY = 0; }
        ctx.fillStyle = centerMsgColor; ctx.globalAlpha = Math.min(1.0, centerMsgTimer / 30); ctx.fillText(centerMsg, canvas.width / 2, BASE_Y - 100);
        ctx.globalAlpha = 1.0; ctx.shadowBlur = 0; ctx.shadowOffsetX = 0; ctx.shadowOffsetY = 0;
    }

    animationId = requestAnimationFrame(gameLoop);
}

async function fetchRankings() {
    try {
        const response = await fetch('ranking.php?action=list'); const data = await response.json(); let htmlContent = "";
        if (data && data.length > 0) {
            data.forEach((item, index) => {
                let rankColor = 'var(--dos-cyan)'; if (index === 0) rankColor = '#FFD700'; else if (index === 1) rankColor = '#C0C0C0'; else if (index === 2) rankColor = '#CD7F32'; 
                htmlContent += `<div class="rank-row"><span class="t-rank" style="color:${rankColor};">${index + 1}위</span><span class="t-name">${item.nickname}</span><span class="t-score">${item.score.toLocaleString()}점</span></div>`;
            });
        } else { htmlContent = `<div style='text-align:center; margin-top: 20px; color: var(--dos-white);'>${t('rank_empty')}</div>`; }
        rankingContainers.forEach(container => { container.innerHTML = htmlContent; });
    } catch (e) { rankingContainers.forEach(container => { container.innerHTML = `<div style='text-align:center; margin-top: 20px; color: var(--dos-red);'>${t('rank_error')}</div>`; }); }
}

async function autoSubmitScore() {
    if (score <= 0) { submitMsg.style.color = 'var(--dos-yellow)'; submitMsg.innerText = "점수가 0점이므로 등록되지 않았습니다."; gameOverActions.classList.remove('hidden'); return; }
    submitMsg.style.color = 'var(--dos-yellow)'; submitMsg.innerText = "서버에 점수를 등록 중입니다...";
    try {
        const formData = new URLSearchParams(); formData.append('action', 'submit'); formData.append('nickname', currentNickname); formData.append('score', score);
        const response = await fetch('ranking.php', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: formData.toString() });
        const result = await response.json();
        if (result.status === 'success') { submitMsg.style.color = 'var(--dos-green)'; submitMsg.innerText = `축하합니다! [${currentNickname}]님, ${result.rank}위로 등록 완료!`; } 
        else if (result.status === 'error') {
            submitMsg.style.color = 'var(--dos-red)';
            if (result.message === 'bad_word') submitMsg.innerText = "사용할 수 없는 닉네임으로 인해 등록이 거절되었습니다.";
            else if (result.message === 'busy') submitMsg.innerText = "서버가 바쁩니다. 등록에 실패했습니다."; else submitMsg.innerText = "점수 등록에 실패했습니다.";
        }
    } catch (e) { submitMsg.style.color = 'var(--dos-red)'; submitMsg.innerText = "서버 통신 오류가 발생했습니다."; } 
    finally { gameOverActions.classList.remove('hidden'); fetchRankings(); }
}

document.getElementById('start-btn').addEventListener('click', startGame);
document.getElementById('to-main-btn').addEventListener('click', startGame);
nicknameInput.addEventListener('keypress', (e) => { if (e.key === 'Enter') startGame(); });
</script>
</body>
</html>
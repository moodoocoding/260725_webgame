}

.fixed-btn:active { transform: translateY(-50%) scale(0.85); background: rgba(0,0,0,0.8);}

#resetBtn { left: 10px; }

#gameFsBtn { right: 10px; }



@keyframes shake { 0%, 100% { transform: translateX(0); } 25% { transform: translateX(-10px); } 75% { transform: translateX(10px); } }

.wrong { animation: shake 0.2s; color: #ff6b6b !important; border-color: #ff6b6b !important; }

@keyframes winPulse { 0%, 100% { transform: scale(1); box-shadow: 0 4px 15px rgba(255,215,0,0.2); } 50% { transform: scale(1.02); box-shadow: 0 4px 25px rgba(255,215,0,0.5); } }

.gold { background: #332b00 !important; border: 2px solid #fcc419 !important; color: #fcc419; animation: winPulse 0.6s infinite ease-in-out; }



#resultList {margin: 20px 0;padding: 0;list-style: none;width: 470px;max-width: 92vw;}

#resultList li {


function check(team) {

    if(state.isGameOver || state.isCounting) return;

    const s = state[team];

    if(s.input !== "" && parseInt(s.input) === s.ans) {

        playSuccessSound(); s.combo++; 

        let addScore = 1;

        if (s.combo > 0 && s.combo % 5 === 0) { addScore = 3; showComboEffect(team, s.combo, true); } else if (s.combo > 1) { showComboEffect(team, s.combo, false); }

        let currentMax = 0; let t1, t2, t3;

        if (state.teamModeType === '2vs2') { t1 = state.dog.score + state.cat.score; t2 = state.rabbit.score + state.hamster.score; currentMax = Math.max(t1, t2); } 

        else if (state.teamModeType === '3vs3') { t1 = state.dog.score + state.cat.score + state.rabbit.score; t2 = state.hamster.score + state.panda.score + state.monkey.score; currentMax = Math.max(t1, t2); } 

        else if (state.teamModeType === '2vs2vs2') { t1 = state.dog.score + state.cat.score; t2 = state.rabbit.score + state.hamster.score; t3 = state.panda.score + state.monkey.score; currentMax = Math.max(t1, t2, t3); } 

        else { const activeTeams = playerIds.map(id => state[id]).filter(t => t.active); currentMax = Math.max(...activeTeams.map(t => t.score)); }

        s.score += addScore; 

        let becomeFirst = false;

        if (state.teamModeType !== 'none') {

            let myTeamScore = 0;

            if (state.teamModeType === '2vs2') { if (team==='dog'||team==='cat') myTeamScore = state.dog.score + state.cat.score; else myTeamScore = state.rabbit.score + state.hamster.score; } 

            else if (state.teamModeType === '3vs3') { if (team==='dog'||team==='cat'||team==='rabbit') myTeamScore = state.dog.score + state.cat.score + state.rabbit.score; else myTeamScore = state.hamster.score + state.panda.score + state.monkey.score; } 

            else if (state.teamModeType === '2vs2vs2') { if (team==='dog'||team==='cat') myTeamScore = state.dog.score + state.cat.score; else if (team==='rabbit'||team==='hamster') myTeamScore = state.rabbit.score + state.hamster.score; else myTeamScore = state.panda.score + state.monkey.score; }

            becomeFirst = (myTeamScore >= currentMax && currentMax > 0);

        } else { becomeFirst = (s.score >= currentMax && currentMax > 0); }

        spawnItem(team, becomeFirst); updateRanks(); generate(team);

    } else {

        playFailSound(); s.combo = 0; const d = document.getElementById(team+'Disp');

        d.classList.add('wrong'); setTimeout(()=>d.classList.remove('wrong'), 300);

        if(s.score > 0) s.score--; s.input = ""; d.textContent = ""; updateRanks(); generate(team);

    }

    render();

}



function updateRanks() {

    if (state.teamModeType !== 'none') {

        let scores = [];

        if (state.teamModeType === '2vs2') { scores.push({ id:'A', val: state.dog.score + state.cat.score }); scores.push({ id:'B', val: state.rabbit.score + state.hamster.score }); } 

        else if (state.teamModeType === '3vs3') { scores.push({ id:'A', val: state.dog.score + state.cat.score + state.rabbit.score }); scores.push({ id:'B', val: state.hamster.score + state.panda.score + state.monkey.score }); } 

        else if (state.teamModeType === '2vs2vs2') { scores.push({ id:'A', val: state.dog.score + state.cat.score }); scores.push({ id:'B', val: state.rabbit.score + state.hamster.score }); scores.push({ id:'C', val: state.panda.score + state.monkey.score }); }

        scores.sort((a,b) => b.val - a.val);

        let currentRank = 1;

        for(let i=0; i<scores.length; i++) { if(i > 0 && scores[i].val < scores[i-1].val) { currentRank = i + 1; } const rankEl = document.getElementById('rank' + scores[i].id); if(rankEl) { rankEl.textContent = currentRank + "st"; rankEl.classList.remove('rank-1'); if(currentRank === 1) rankEl.classList.add('rank-1'); } }

    } else {

        const activeTeams = playerIds.map(id => state[id]).filter(t => t.active);

        const sortedScores = activeTeams.map(t => t.score).sort((a, b) => b - a);

        activeTeams.forEach(t => { const rank = sortedScores.indexOf(t.score) + 1; state[t.id].rank = rank; updateBadge(t.id, rank); });

    }

}




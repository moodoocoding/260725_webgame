document.getElementById('startBtn').onpointerdown = (e) => { e.preventDefault(); prepareGame(); };

document.getElementById('resetBtn').onpointerdown = (e) => { e.preventDefault(); goToMenu(); };

attachMobileEvents();



</script>






/* === 다크모드/라이트모드 로직 === */
const themeBtn = document.getElementById('themeBtn');
const body = document.body;

// 1. 저장된 테마 불러오기 (없으면 Dark 기본)
const currentTheme = localStorage.getItem('kingsmath_theme');
if (currentTheme === 'light') {
    body.classList.add('light-mode');
    themeBtn.textContent = '☀️'; // 라이트모드 아이콘
} else {
    body.classList.remove('light-mode');
    themeBtn.textContent = '🌙'; // 다크모드 아이콘
}

// 2. 버튼 클릭 이벤트
themeBtn.addEventListener('click', () => {
    body.classList.toggle('light-mode');
    
    if (body.classList.contains('light-mode')) {
        localStorage.setItem('kingsmath_theme', 'light');
        themeBtn.textContent = '☀️';
    } else {
        localStorage.setItem('kingsmath_theme', 'dark');
        themeBtn.textContent = '🌙';
    }
});


</script>




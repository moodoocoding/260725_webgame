        if (currentLevel === 1) { while(true) { let num1 = getRandomInt(4, 100); let num2 = getRandomInt(4, 100); if (num1 === num2) continue; answer = getGCD(num1, num2); if (answer > 1 && answer <= 100) { equation = `GCD ${num1}, ${num2}`; break; } } }

        else if (currentLevel === 2) { while(true) { let num1 = getRandomInt(2, 50); let num2 = getRandomInt(2, 50); if (num1 === num2) continue; let gcd = getGCD(num1, num2); if (gcd === 1) continue; answer = (num1 * num2) / gcd; if (answer <= 100 && answer > num1 && answer > num2) { equation = `LCM ${num1}, ${num2}`; break; } } }

        else if (currentLevel === 3) { let baseA = getRandomInt(1, 10); let baseB = getRandomInt(1, 10); const g = getGCD(baseA, baseB); baseA /= g; baseB /= g; let m1, m2; if (Math.random() < 0.5) { m1 = 1; m2 = getRandomInt(2, 10); } else { m1 = getRandomInt(2, 10); m2 = 1; } let A = baseA * m1; let B = baseB * m1; let C = baseA * m2; let D = baseB * m2; if (A <= 100 && B <= 100 && C <= 100 && D <= 100) { const blank = getRandomInt(0, 3); if (blank === 0) { equation = `□ : ${B} = ${C} : ${D}`; answer = A; } else if (blank === 1) { equation = `${A} : □ = ${C} : ${D}`; answer = B; } else if (blank === 2) { equation = `${A} : ${B} = □ : ${D}`; answer = C; } else { equation = `${A} : ${B} = ${C} : □`; answer = D; } } else { return generateProblem('rule', levelIndex, teamId); } }

    }

    else if (type === 'find') {

        let blankPos = getRandomInt(0, 1); let a, b, c;

        if (currentLevel === 1) { answer = getRandomInt(1, 99); b = getRandomInt(1, 100 - answer); c = answer + b; if (blankPos === 0) equation = `□+${b}=${c}`; else equation = `${b}+□=${c}`; }

        else if (currentLevel === 2) { if (blankPos === 0) { b = getRandomInt(1, 50); c = getRandomInt(1, 50); answer = b + c; equation = `□-${b}=${c}`; } else { a = getRandomInt(2, 100); answer = getRandomInt(1, a - 1); c = a - answer; equation = `${a}-□=${c}`; } }

        else if (currentLevel === 3) { answer = getRandomInt(2, 20); b = getRandomInt(2, 9); c = answer * b; if (blankPos === 0) equation = `□×${b}=${c}`; else equation = `${b}×□=${c}`; }

        else if (currentLevel === 4) { if (blankPos === 0) { b = getRandomInt(2, 9); c = getRandomInt(2, Math.floor(100/b)); answer = b * c; equation = `□÷${b}=${c}`; } else { answer = getRandomInt(2, 20); c = getRandomInt(2, 9); a = answer * c; equation = `${a}÷□=${c}`; } }

    }

    return { equation, answer };

}




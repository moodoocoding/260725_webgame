}
#startBtn:active { transform: translateY(4px); box-shadow: 0 2px 0 #1c7ed6 !important; }

#otherGameLink {
    display: block; margin-top: 20px; color: var(--text-muted);
    text-decoration: underline; font-size: 1.1rem; cursor: pointer; transition: all 0.2s;
}
#otherGameLink:hover { color: var(--dark); }

/* === 인게임 스타일 === */
#finalPodium { height: 25vh; width: 100%; display: none; flex-direction: row; }
.podium-col {
    flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center;
    position: relative; border-top: 4px solid rgba(128,128,128,0.1);
}
.podium-medal {
    font-size: clamp(45px, 5vw, 69px); filter: drop-shadow(0 4px 6px rgba(0,0,0,0.2));
    margin-bottom: 5px; animation: popIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
}
.podium-name {
    font-size: clamp(45px, 5vw, 69px); color: var(--dark);
    display: flex; align-items: center; justify-content: center; line-height: 1;
}
@keyframes popIn { 0% { transform: scale(0); opacity: 0; } 100% { transform: scale(1); opacity: 1; } }

#countdownLayer {
    position: fixed; inset: 0; background: rgba(0, 0, 0, 0.6);

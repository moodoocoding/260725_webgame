}
.header-logo { font-size: clamp(20px, 2vw, 30px); flex: 1; color: var(--text-muted); }
.header-logo a { color: #ff8787; text-decoration: none; transition: all 0.2s ease-in-out; }
.header-logo a:hover { color: #d63031; text-decoration: underline; }
.logo-left { text-align: center; } 
.logo-right { text-align: center; }

#timerDisplay {
    font-size:120px; padding: 0; color: #ff7675;
    text-align: center; width: 260px; min-width: auto;
    font-weight: bold; flex-shrink: 0;
}
.timer-urgent { animation: timerBlink 0.5s infinite; background: #ff7675 !important; color: white !important; border-radius: 20px; }
@keyframes timerBlink { 50% { opacity: 0.7; } }

/* === 팀전 전용 스코어보드 === */
#teamScoreBoard {
    display: none; width: 100%; height: 31vh;
    flex-direction: row; justify-content: space-around; align-items: center;
    background: var(--bg); padding: 0 10px; box-sizing: border-box; z-index: 15;
}
.team-card {
    flex: 1; height: 90%; border-radius: 20px;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    position: relative; box-shadow: 0 4px 15px rgba(0,0,0,0.1); margin: 0 5px;
}
.team-A { background: var(--dog-color); }
.team-B { background: var(--rabbit-color); }
.team-C { background: var(--panda-color); display: none; }

.team-card .team-name { font-size: 3.5rem; color: var(--dark); margin-bottom: 5px; white-space: nowrap; }
.team-card .team-score { font-size: 4rem; color: #ff7675; font-weight: bold; display: flex; align-items: center; gap: 10px; }
.team-card .team-rank {
    position: absolute; bottom: -30px; background: var(--panel-bg); color: var(--dark);
    padding: 5px 20px; border-radius: 20px; font-size: 2rem;
    box-shadow: 0 2px 5px rgba(0,0,0,0.2); transition: 0.3s;

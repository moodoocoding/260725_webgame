}


@import url('https://fonts.googleapis.com/css2?family=Jua&display=swap');

/* === [핵심] 색상 변수 설정 === */
:root {
    /* 1. 다크 모드 (기본값) */
    --bg: #121212;
    --panel-bg: #1e1e2e; /* 카드, 메뉴 배경 */
    --dark: #e0e0e0;     /* 기본 텍스트 (흰색에 가까운 회색) */
    --text-muted: #a0a0a0;
    --border-color: #333333;

    /* 팀 배경색 (다크모드용: 어두운 톤) */
    --dog-color: #332b00;
    --cat-color: #1e1b2e;
    --rabbit-color: #2e151a;
    --hamster-color: #2e1e0f;
    --panda-color: #0f2e26;
    --monkey-color: #221826;

    /* 수학 영역 색상 (다크모드용: 배경은 어둡게, 텍스트는 밝게) */
    --math-blue: #4dabf7; --math-blue-light: #183e5c;
    --math-red: #ff8787; --math-red-light: #4a1818;
    --math-green: #69db7c; --math-green-light: #164020;
    --math-yellow: #fcc419; --math-yellow-light: #423202;
    --math-purple: #b197fc; --math-purple-light: #2d1e4a;
    --math-cyan: #20c997; --math-cyan-light: #0d382e;
    --math-pink: #e64980; --math-pink-light: #421022;
    --math-orange: #fd7e14; --math-orange-light: #422005;
}

/* 2. 라이트 모드 (클래스 추가 시 적용) - 기존 요청하신 색상값 */
body.light-mode {
    --bg: #ffffff;
    --panel-bg: #ffffff;
    --dark: #4b4b4b;     /* 기존 진한 회색 텍스트 */
    --text-muted: #666666;
    --border-color: #eeeeee;

    /* 팀 배경색 (파스텔톤) */
    --dog-color: #fff9db;
    --cat-color: #f3f0ff;
    --rabbit-color: #fff0f6;
    --hamster-color: #ffe8cc;
    --panda-color: #e6fcf5;
    --monkey-color: #f8f0fc;

    /* 수학 영역 색상 (파스텔톤 배경) */
    --math-blue: #74c0fc; --math-blue-light: #e7f5ff;
    --math-red: #ff8787; --math-red-light: #ffe3e3;
    --math-green: #69db7c; --math-green-light: #ebfbee;
    --math-yellow: #fcc419; --math-yellow-light: #fff9db;
    --math-purple: #b197fc; --math-purple-light: #f3f0ff;
    --math-cyan: #20c997; --math-cyan-light: #e6fcf5;
    --math-pink: #e64980; --math-pink-light: #fff0f6;
    --math-orange: #fd7e14; --math-orange-light: #fff4e6;
}

body {
    margin: 0;
    background: var(--bg);
    color: var(--dark);
    font-family: 'Jua', sans-serif;
    overflow: hidden;
    user-select: none; -webkit-user-select: none;
    touch-action: pan-y; overscroll-behavior: none;
    -webkit-text-size-adjust: none;
    display: flex; flex-direction: column;
    height: 100vh; height: -webkit-fill-available; height: 100dvh;
    padding-bottom: env(safe-area-inset-bottom);
    box-sizing: border-box;
    transition: background 0.3s, color 0.3s; /* 모드 전환 애니메이션 */
}

/* === 왼쪽 상단 테마 버튼 스타일 === */
.fixed-btn-top-left {
    position: fixed;
    top: 15px; left: 15px;
    z-index: 9999;
    background: rgba(128, 128, 128, 0.2);
    border: 1px solid var(--border-color);
    border-radius: 50%;
    width: 45px; height: 45px;
    font-size: 1.5rem;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    backdrop-filter: blur(5px);
    transition: transform 0.2s;
    color: var(--dark);
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
}
.fixed-btn-top-left:hover { transform: scale(1.1); }

/* === 오버레이 (시작/종료 화면) === */
#overlay {
    position: fixed; inset: 0;
    background: var(--bg); /* 배경 변수 사용 */
    opacity: 0.98;
    display: flex; flex-direction: column;
    z-index: 100; backdrop-filter: blur(15px);
    text-align: center; padding: 0;
    overflow-y: auto; touch-action: pan-y;
}

.overlay-content {
    flex: 1; display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    padding: 0px; width: 100%; box-sizing: border-box;
}

.title-area { margin-bottom: 15px; }

#msgTitle {
    font-size: 3.6rem;
    color: var(--dark);
    margin: 0; font-weight: 500;
}

.subtitle {
    color: var(--text-muted);
    font-size: 1.2rem; margin-top: 5px;
}

#setupArea {
    width: 480px; max-width: 95vw;
    margin: 0 auto 15px auto;
    display: flex; flex-direction: column; gap: 15px;
}

.setup-row { display: flex; gap: 10px; width: 100%; }
.setup-group { flex: 1; text-align: left; }

.setup-label {
    font-size: 1.2rem; color: var(--text-muted);
    margin-bottom: 6px; display: block; margin-left: 5px;
}

.custom-select {
    width: 100%; font-family: 'Jua', sans-serif;
    font-size: 1.2rem; padding: 12px 12px;
    border-radius: 12px;
    border: 2px solid var(--border-color);
    background: var(--panel-bg);
    cursor: pointer; outline: none;
    color: var(--dark);
}

.math-menu-wrapper {
    width: 480px; max-width: 95vw; margin: 0 auto;
}

.math-menu-container {
    width: 100%; background: var(--panel-bg);
    border-radius: 20px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.1);
    overflow: hidden;
    border: 1px solid var(--border-color);
}

.math-tabs {
    display: flex;
    background: rgba(128, 128, 128, 0.1); /* 탭 배경 반투명 처리 */
    padding: 8px 8px 0 8px; gap: 4px; overflow-x: auto;
}
.math-tabs::-webkit-scrollbar { display: none; }

.math-tab {
    flex: 1; min-width: 45px; padding: 10px 2px;
    border-radius: 12px 12px 0 0; border: none;
    background: transparent; cursor: pointer;
    transition: all 0.2s; color: var(--text-muted);
    display: flex; flex-direction: column; align-items: center; gap: 4px;
}
.math-tab.active {
    background: var(--panel-bg);
    box-shadow: 0 -3px 10px rgba(0,0,0,0.05);
    color: var(--dark); font-weight: bold;
    transform: translateY(2px);
}

.tab-icon { font-size: 1.4rem; width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; }
.tab-text { font-size: 0.9rem; white-space: nowrap; }

/* 탭 활성화 색상 */
.math-tab[data-type="add"].active { color: var(--math-blue); background: var(--math-blue-light); }
.math-tab[data-type="sub"].active { color: var(--math-red); background: var(--math-red-light); }
.math-tab[data-type="mul"].active { color: var(--math-green); background: var(--math-green-light); }
.math-tab[data-type="div"].active { color: var(--math-yellow); background: var(--math-yellow-light); }
.math-tab[data-type="mix"].active { color: var(--math-purple); background: var(--math-purple-light); }
.math-tab[data-type="rule"].active { color: var(--math-cyan); background: var(--math-cyan-light); }
.math-tab[data-type="find"].active { color: var(--math-pink); background: var(--math-pink-light); }
.math-tab[data-type="frac"].active { color: var(--math-orange); background: var(--math-orange-light); }

.level-list { padding: 10px; background: var(--panel-bg); }

.level-item {
    display: flex; align-items: center; padding: 12px 15px;
    margin-bottom: 8px; border-radius: 12px;
    border: 2px solid var(--border-color);
    background: var(--panel-bg);
    cursor: pointer; transition: all 0.15s; text-align: left;
    color: var(--dark);
}
.level-item:last-child { margin-bottom: 0; }
.level-item.selected { border-color: transparent; }

/* 리스트 선택 시 배경색 */
.level-list[data-theme="add"] .level-item.selected { background-color: var(--math-blue-light); border-color: var(--math-blue); }
.level-list[data-theme="sub"] .level-item.selected { background-color: var(--math-red-light); border-color: var(--math-red); }
.level-list[data-theme="mul"] .level-item.selected { background-color: var(--math-green-light); border-color: var(--math-green); }
.level-list[data-theme="div"] .level-item.selected { background-color: var(--math-yellow-light); border-color: var(--math-yellow); }
.level-list[data-theme="mix"] .level-item.selected { background-color: var(--math-purple-light); border-color: var(--math-purple); }
.level-list[data-theme="rule"] .level-item.selected { background-color: var(--math-cyan-light); border-color: var(--math-cyan); }
.level-list[data-theme="find"] .level-item.selected { background-color: var(--math-pink-light); border-color: var(--math-pink); }
.level-list[data-theme="frac"] .level-item.selected { background-color: var(--math-orange-light); border-color: var(--math-orange); }

.level-badge {
    width: 28px; height: 28px; border-radius: 50%;
    background: rgba(128,128,128,0.2); color: var(--text-muted);
    display: flex; align-items: center; justify-content: center;
    font-size: 1rem; font-weight: bold; margin-right: 15px; flex-shrink: 0;
}
.level-item.selected .level-badge { color: white; background: rgba(0,0,0,0.2); }
.level-list[data-theme="add"] .level-item.selected .level-badge { background: var(--math-blue); }
.level-list[data-theme="sub"] .level-item.selected .level-badge { background: var(--math-red); }
.level-list[data-theme="mul"] .level-item.selected .level-badge { background: var(--math-green); }
.level-list[data-theme="div"] .level-item.selected .level-badge { background: var(--math-yellow); }
.level-list[data-theme="mix"] .level-item.selected .level-badge { background: var(--math-purple); }
.level-list[data-theme="rule"] .level-item.selected .level-badge { background: var(--math-cyan); }
.level-list[data-theme="find"] .level-item.selected .level-badge { background: var(--math-pink); }
.level-list[data-theme="frac"] .level-item.selected .level-badge { background: var(--math-orange); }

.level-info { flex: 1; display: flex; justify-content: space-between; align-items: center; overflow: hidden; }
.level-title { font-size: 1.15rem; color: var(--dark); white-space: nowrap; }

/* 레벨 설명 텍스트 색상 */
.level-desc { font-size: 1.15rem; margin-left: 15px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; text-align: right; }
.level-list[data-theme="add"] .level-desc { color: var(--math-blue); }
.level-list[data-theme="sub"] .level-desc { color: var(--math-red); }
.level-list[data-theme="mul"] .level-desc { color: var(--math-green); }
.level-list[data-theme="div"] .level-desc { color: var(--math-yellow); }
.level-list[data-theme="mix"] .level-desc { color: var(--math-purple); }
.level-list[data-theme="rule"] .level-desc { color: var(--math-cyan); }
.level-list[data-theme="find"] .level-desc { color: var(--math-pink); }
.level-list[data-theme="frac"] .level-desc { color: var(--math-orange); }
.level-item.selected .level-desc { color: inherit; opacity: 1; }

#startBtn {
    font-size: 2.2rem; padding: 12px 0; border-radius: 50px; border: none;
    background: #339af0; color: white; cursor: pointer;
    box-shadow: 0 6px 0 #1c7ed6; transition: 0.1s;
    font-family: 'Jua', sans-serif; touch-action: manipulation;

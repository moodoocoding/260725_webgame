    padding: 10px 2px; position: relative;
    border-right: 1px solid rgba(128,128,128,0.2);
    overflow: hidden; z-index: 1;
}
body.team-mode .teamTitle, body.team-mode .scoreBadge, body.team-mode .rank-badge { display: none !important; }
body.team-mode .problem { font-size: 40px; margin-bottom: -10px; }

let currentLang = 'en';



function detectLanguage() {

    const params = new URLSearchParams(window.location.search);

    const urlLang = params.get('lang');

    if (urlLang && I18N[urlLang]) return urlLang;

    const storedLang = localStorage.getItem('kingsmath_lang');

    if (storedLang && I18N[storedLang]) return storedLang;

    const navLang = navigator.language.slice(0, 2);

    if (I18N[navLang]) return navLang;

    return 'en';

}



function updateMathMenuData(lang) {

    const t = I18N[lang].menus;

    const d = I18N[lang].levelDetails;

    

    const menuKeys = ['add', 'sub', 'mul', 'div', 'frac', 'find', 'mix', 'rule'];

    menuKeys.forEach((key, index) => {

        if(MATH_MENU_DATA[index]) {

            MATH_MENU_DATA[index].title = t[key];

            if (d && d[index]) {

                MATH_MENU_DATA[index].levels.forEach((lv, lvIdx) => {

                    if (d[index][lvIdx]) {

                        lv.title = d[index][lvIdx];

                    }

                    if (lv.lv === 5 && index < 8) {

                        lv.desc = d[8][index]; 

                    } else if (key === 'find' && lv.lv === 5) {

                         lv.desc = d[8][5];

                    } else if (key === 'rule' && lv.lv === 5) {

                        lv.desc = d[8][8];

                    } else if (key === 'rule') {

                        if(lvIdx === 0) lv.desc = d[8][9];

                        if(lvIdx === 1) lv.desc = d[8][10];

                    }

                });

            }

        }

    });

}



function applyLanguage(lang) {

    currentLang = lang;

    localStorage.setItem('kingsmath_lang', lang);

    const url = new URL(window.location);

    url.searchParams.set('lang', lang);

    window.history.pushState({}, '', url);



    const t = I18N[lang];

    document.title = t.pageTitle;


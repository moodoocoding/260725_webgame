}
#countdownText {
    font-size: 30vw; color: white;
    text-shadow: 0 10px 30px rgba(0,0,0,0.5);
    animation: countAnim 1s ease-out forwards;
}
@keyframes countAnim { 0% { transform: scale(0.3); opacity: 0; } 50% { transform: scale(1.1); opacity: 1; } 100% { transform: scale(1); opacity: 0; } }

/* === 헤더 & 타이머 === */
#header {
    height: 160px; background: var(--panel-bg);

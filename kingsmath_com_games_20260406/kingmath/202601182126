.combo-text.super { color: #ff8787; font-size: 3.2rem; top: 25%; }

@keyframes comboPop { 0% { transform: translate(-50%, 0) scale(0.5); opacity: 0; } 40% { transform: translate(-50%, -40px) scale(1.2); opacity: 1; } 100% { transform: translate(-50%, -100px) scale(1); opacity: 0; } }



.fixed-btn {


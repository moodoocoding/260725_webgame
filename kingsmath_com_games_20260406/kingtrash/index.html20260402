            id: { title: "Raja Daur Ulang", desc: "Masukkan sampah ke tempat yang benar!<br>Bersihkan 10 item untuk poin bonus!", p1: "1 P", p2: "2 P", p3: "3 P", p4: "4 P", p5: "5 P", p6: "6 P", start: "Mulai Game!", other: "🎮 Game Lain", plastic: "Plastik", paper: "Kertas", glass: "Kaca", can: "Kaleng", general: "Umum", sec: "d", score: " pt", clear: "Bersih!\n+100", r1: "🥇 Ke-1", r2: "🥈 Ke-2", r3: "🥉 Ke-3", rN: "Ke-", top1: "🏆 Juara 1 🏆", replay: "Main Lagi", msg: "Bahasa telah diubah.", seo_desc: "Masukkan sampah ke tempat yang benar!" },
            vi: { title: "Vua Tái Chế", desc: "Bỏ rác vào đúng thùng nhé!<br>Dọn 10 món để nhận điểm thưởng!", p1: "1 N", p2: "2 N", p3: "3 N", p4: "4 N", p5: "5 N", p6: "6 N", start: "Bắt đầu!", other: "🎮 Trò chơi khác", plastic: "Nhựa", paper: "Giấy", glass: "Kính", can: "Lon", general: "Chung", sec: "s", score: " đ", clear: "Đã dọn!\n+100", r1: "🥇 Hạng 1", r2: "🥈 Hạng 2", r3: "🥉 Hạng 3", rN: "Hạng", top1: "🏆 Hạng 1 🏆", replay: "Chơi lại", msg: "Ngôn ngữ đã được thay đổi.", seo_desc: "Bỏ rác vào đúng thùng nhé!" },
            th: { title: "ราชาแห่งการรีไซเคิล", desc: "ทิ้งขยะลงถังให้ถูกต้อง!<br>เคลียร์ขยะ 10 ชิ้นเพื่อรับคะแนนโบนัส!", p1: "1 คน", p2: "2 คน", p3: "3 คน", p4: "4 คน", p5: "5 คน", p6: "6 คน", start: "เริ่มเกม!", other: "🎮 เกมอื่นๆ", plastic: "พลาสติก", paper: "กระดาษ", glass: "แก้ว", can: "กระป๋อง", general: "ทั่วไป", sec: "วิ", score: " คะแนน", clear: "เคลียร์แล้ว!\n+100", r1: "🥇 ที่ 1", r2: "🥈 ที่ 2", r3: "🥉 ที่ 3", rN: "ที่", top1: "🏆 อันดับ 1 🏆", replay: "เล่นอีกครั้ง", msg: "เปลี่ยนภาษาเรียบร้อยแล้ว", seo_desc: "ทิ้งขยะลงถังให้ถูกต้อง!" },
            'pt-br': { title: "Rei da Reciclagem", desc: "Coloque o lixo nas lixeiras corretas!<br>Limpe 10 itens para ganhar pontos bônus!", p1: "1 J", p2: "2 J", p3: "3 J", p4: "4 J", p5: "5 J", p6: "6 J", start: "Iniciar Jogo!", other: "🎮 Outros Jogos", plastic: "Plástico", paper: "Papel", glass: "Vidro", can: "Lata", general: "Geral", sec: "s", score: " pt", clear: "Limpo!\n+100", r1: "🥇 1º", r2: "🥈 2º", r3: "🥉 3º", rN: "º", top1: "🏆 1º Lugar 🏆", replay: "Jogar Novamente", msg: "Idioma alterado.", seo_desc: "Coloque o lixo nas lixeiras corretas!" },
            hi: { title: "रीसाइक्लिंग किंग", desc: "कचरे को सही डिब्बे में डालें!<br>बोनस अंक के लिए 10 आइटम साफ़ करें!", p1: "1 P", p2: "2 P", p3: "3 P", p4: "4 P", p5: "5 P", p6: "6 P", start: "खेल शुरू!", other: "🎮 अन्य खेल", plastic: "प्लास्टिक", paper: "कागज़", glass: "कांच", can: "कैन", general: "सामान्य", sec: "s", score: " अंक", clear: "साफ़!\n+100", r1: "🥇 पहला", r2: "🥈 दूसरा", r3: "🥉 तीसरा", rN: "वां", top1: "🏆 पहला स्थान 🏆", replay: "फिर से खेलें", msg: "भाषा बदल दी गई है।", seo_desc: "कचरे को सही डिब्बे में डालें!" },
            bn: { title: "রিসাইক্লিং কিং", desc: "সঠিক পাত্রে আবর্জনা ফেলুন!<br>বোনাস পয়েন্টের জন্য 10টি আইটেম পরিষ্কার করুন!", p1: "1 P", p2: "2 P", p3: "3 P", p4: "4 P", p5: "5 P", p6: "6 P", start: "খেলা শুরু!", other: "🎮 অন্যান্য খেলা", plastic: "প্লাস্টিক", paper: "কাগজ", glass: "কাঁচ", can: "ক্যান", general: "সাধারণ", sec: "s", score: " পয়েন্ট", clear: "পরিষ্কার!\n+100", r1: "🥇 1ম", r2: "🥈 2য়", r3: "🥉 3য়", rN: "তম", top1: "🏆 1ম স্থান 🏆", replay: "পুনরায় খেলুন", msg: "ভাষা পরিবর্তন করা হয়েছে।", seo_desc: "সঠিক পাত্রে আবর্জনা ফেলুন!" },
            tr: { title: "Geri Dönüşüm Kralı", desc: "Düşen çöpleri doğru kutulara atın!<br>Bonus puanlar için 10 öğeyi temizleyin!", p1: "1 O", p2: "2 O", p3: "3 O", p4: "4 O", p5: "5 O", p6: "6 O", start: "Oyuna Başla!", other: "🎮 Diğer Oyunlar", plastic: "Plastik", paper: "Kağıt", glass: "Cam", can: "Kutu", general: "Genel", sec: "sn", score: " pt", clear: "Temizlendi!\n+100", r1: "🥇 1.", r2: "🥈 2.", r3: "🥉 3.", rN: ".", top1: "🏆 1. Sıra 🏆", replay: "Tekrar Oyna", msg: "Dil değiştirildi.", seo_desc: "Düşen çöpleri doğru kutulara atın!" },
            de: { title: "Recycling-König", desc: "Wirf den Müll in die richtigen Tonnen!<br>Räume 10 Teile für Bonuspunkte weg!", p1: "1 S", p2: "2 S", p3: "3 S", p4: "4 S", p5: "5 S", p6: "6 S", start: "Spiel starten!", other: "🎮 Andere Spiele", plastic: "Plastik", paper: "Papier", glass: "Glas", can: "Dose", general: "Allgemein", sec: "s", score: " Pkt", clear: "Aufgeräumt!\n+100", r1: "🥇 1.", r2: "🥈 2.", r3: "🥉 3.", rN: ".", top1: "🏆 1. Platz 🏆", replay: "Nochmal spielen", msg: "Sprache geändert.", seo_desc: "Wirf den Müll in die richtigen Tonnen!" },
            it: { title: "Re del Riciclaggio", desc: "Metti i rifiuti nei bidoni giusti!<br>Pulisci 10 oggetti per punti bonus!", p1: "1 G", p2: "2 G", p3: "3 G", p4: "4 G", p5: "5 G", p6: "6 G", start: "Inizia Gioco!", other: "🎮 Altri Giochi", plastic: "Plastica", paper: "Carta", glass: "Vetro", can: "Lattina", general: "Generale", sec: "s", score: " pt", clear: "Pulito!\n+100", r1: "🥇 1º", r2: "🥈 2º", r3: "🥉 3º", rN: "º", top1: "🏆 1º Posto 🏆", replay: "Gioca di nuovo", msg: "Lingua cambiata.", seo_desc: "Metti i rifiuti nei bidoni giusti!" }
        };

        const languagesData = [
            { code: 'ko', country: 'kr', name: '한국어', enName: 'Korean' }, { code: 'en', country: 'us', name: 'English', enName: 'English' },
            { code: 'zh', country: 'cn', name: '中文 (简体)', enName: 'Chinese (Simplified)' }, { code: 'ja', country: 'jp', name: '日本語', enName: 'Japanese' },
            { code: 'es', country: 'es', name: 'Español', enName: 'Spanish' }, { code: 'fr', country: 'fr', name: 'Français', enName: 'French' },
            { code: 'ru', country: 'ru', name: 'Русский', enName: 'Russian' }, { code: 'id', country: 'id', name: 'Bahasa Indonesia', enName: 'Indonesian' },
            { code: 'vi', country: 'vn', name: 'Tiếng Việt', enName: 'Vietnamese' }, { code: 'th', country: 'th', name: 'ไทย', enName: 'Thai' },
            { code: 'pt-br', country: 'br', name: 'Português (Brasil)', enName: 'Portuguese (Brazil)' }, { code: 'hi', country: 'in', name: 'हिन्दी', enName: 'Hindi' },
            { code: 'bn', country: 'bd', name: 'বাংলা', enName: 'Bengali' }, { code: 'tr', country: 'tr', name: 'Türkçe', enName: 'Turkish' },
            { code: 'de', country: 'de', name: 'Deutsch', enName: 'German' }, { code: 'it', country: 'it', name: 'Italiano', enName: 'Italian' }
        ];

        let currentLang = 'en'; // 기본값 세팅

        function t(key) {
            return i18n[currentLang][key] || i18n['en'][key];
        }

        // ==================== 언어 변경 적용 로직 ====================
        function applyLanguage(langCode) {
            currentLang = langCode;
            
            // 폰트 설정 (한국어일 때만 주아체 적용)
            if (currentLang === 'ko') {
                document.body.classList.remove('font-other');
            } else {
                document.body.classList.add('font-other');
            }

            // HTML 정적 텍스트 즉시 변경
            document.getElementById('t-maintitle').innerText = t('title');
            document.getElementById('t-desc').innerHTML = t('desc');
            document.getElementById('t-p1').innerText = t('p1');
            document.getElementById('t-p2').innerText = t('p2');
            document.getElementById('t-p3').innerText = t('p3');
            document.getElementById('t-p4').innerText = t('p4');
            document.getElementById('t-p5').innerText = t('p5');
            document.getElementById('t-p6').innerText = t('p6');
            document.getElementById('btn-start').innerText = t('start');
            document.getElementById('t-othergame').innerText = t('other');
            document.getElementById('btn-replay-global').innerText = t('replay');

            // SEO 업데이트
            document.title = t('title');
            document.querySelector('meta[name="description"]').setAttribute('content', t('seo_desc'));
        }

        function detectAndInitLanguage() {
            const params = new URLSearchParams(window.location.search);
            const urlLang = params.get('lang');
            const savedLang = localStorage.getItem('kingsmath_lang');
            const browserLang = navigator.language.split('-')[0];

            let finalLang = 'en'; // 4순위 기본값
            if (urlLang && i18n[urlLang]) {
                finalLang = urlLang;
            } else if (savedLang && i18n[savedLang]) {
                finalLang = savedLang;
            } else if (i18n[browserLang]) {
                finalLang = browserLang;
            } else if (navigator.language.toLowerCase() === 'pt-br') {
                finalLang = 'pt-br';
            }

            // 초기 언어 선택기 버튼 UI 반영
            const langInfo = languagesData.find(l => l.code === finalLang) || languagesData[1];
            document.getElementById('currentFlag').src = `https://flagcdn.com/w40/${langInfo.country}.png`;
            document.getElementById('currentLangName').textContent = langInfo.name;

            applyLanguage(finalLang);
        }

        // ==================== 기존 게임 자바스크립트 로직 ====================
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        
        function playTone(freq, type, duration, vol=0.1) {
            if(audioCtx.state === 'suspended') audioCtx.resume();
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.type = type;
            osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
            gain.gain.setValueAtTime(vol, audioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + duration);
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            osc.start();
            osc.stop(audioCtx.currentTime + duration);
        }

        const sounds = {
            count: () => playTone(440, 'sine', 0.2, 0.2),
            go: () => playTone(880, 'sine', 0.4, 0.3),
            correct: () => { 
                playTone(440, 'sine', 0.1, 0.1);
                setTimeout(()=>playTone(554, 'sine', 0.1, 0.1), 100);
                setTimeout(()=>playTone(659, 'sine', 0.2, 0.1), 200);
            },
            wrong: () => playTone(150, 'sawtooth', 0.3, 0.2),
            tick: () => playTone(1000, 'square', 0.05, 0.05)
        };

        const trashDB = [
            { char: '🧴', type: 'plastic' }, { char: '🥤', type: 'plastic' }, { char: '💳', type: 'plastic' },
            { char: '📦', type: 'paper' }, { char: '📰', type: 'paper' }, { char: '📚', type: 'paper' }, { char: '📄', type: 'paper' },
            { char: '🍷', type: 'glass' }, { char: '🍾', type: 'glass' }, { char: '🧪', type: 'glass' },
            { char: '🥫', type: 'can' }, { char: '🛠️', type: 'can' }, { char: '🍴', type: 'can' }, { char: '✂️', type: 'can' },
            { char: '🪀', type: 'general' }, { char: '🚬', type: 'general' }, { char: '🧻', type: 'general' }, { char: '🖍️', type: 'general' }
        ];

        const charList = [
            { id: 1, emo: '🐶', name: '강아지' }, { id: 2, emo: '🐱', name: '고양이' }, { id: 3, emo: '🐰', name: '토끼' },
            { id: 4, emo: '🐹', name: '햄스터' }, { id: 5, emo: '🐼', name: '판다' }, { id: 6, emo: '🐵', name: '원숭이' }
        ];

        let playerCount = 6;
        let playersData = [];
        let timeLeft = 60;
        let gameTimer = null;
        let countdownTimer = null;
        let replayTimeout = null; 
        let isPlaying = false;
        
        const activePointers = new Map();

        const screens = document.querySelectorAll('.screen');
        const board = document.getElementById('game-board');
        const trashLayer = document.getElementById('trash-layer');
        const timeDisplay = document.getElementById('timer');
        const overlay = document.getElementById('countdown-overlay');

        document.querySelectorAll('.btn-player').forEach(btn => {
            btn.addEventListener('click', (e) => {
                document.querySelectorAll('.btn-player').forEach(b => b.classList.remove('selected'));
                e.target.classList.add('selected');
                playerCount = parseInt(e.target.dataset.num);
            });
        });

        // 사용자가 요청한 [전체화면 지체없이 첫화면] 소스 완벽 적용
        document.getElementById('btn-home').addEventListener('click', () => {
            if (document.fullscreenElement) {
                // 게임 상태 완전 초기화
                isPlaying = false;
                clearInterval(gameTimer);
                clearInterval(countdownTimer);
                clearTimeout(replayTimeout);
                activePointers.clear();
                
                // 다시 홈화면 상태로 노출 복구
                document.getElementById('langTriggerContainer').style.display = 'block';
                document.getElementById('btn-replay-global').style.display = 'none';
                document.getElementById('global-result-overlay').style.display = 'none';
                document.getElementById('countdown-overlay').style.display = 'none';
                
                switchScreen('home-screen');
                if(window.playSound) window.playSound('click');
            } else {
                location.reload();
            }
        });

        function goHome() {
            isPlaying = false;
            clearInterval(gameTimer);
            clearInterval(countdownTimer);
            clearTimeout(replayTimeout);
            activePointers.clear();

            document.getElementById('langTriggerContainer').style.display = 'block'; // 언어버튼 홈에서는 보임
            document.getElementById('btn-replay-global').style.display = 'none';
            document.getElementById('global-result-overlay').style.display = 'none';
            document.getElementById('countdown-overlay').style.display = 'none';
            
            switchScreen('home-screen');
        }

        function toggleFullScreen() {
            if (!document.fullscreenElement) {
                document.documentElement.requestFullscreen().catch(err => console.log(err));
            } else {
                if (document.exitFullscreen) document.exitFullscreen();
            }
        }

        function switchScreen(id) {
            screens.forEach(s => s.classList.remove('active-screen'));
            document.getElementById(id).classList.add('active-screen');
        }

        function createBinHTML(type, label, emoji) {
            return `
                <div class="bin-group">
                    <div class="bin-wrapper bin-${type}" data-type="${type}">
                        <div class="trash-container">
                            <div class="back-lip"></div>
                            <div class="garbage">${emoji}</div>
                            <div class="front-body">
                                <div class="face">
                                    <div class="eyes"><div class="eye"><div class="pupil"></div></div><div class="eye"><div class="pupil"></div></div></div>
                                    <div class="mouth"></div>
                                </div>
                                <div class="lines"><span></span><span></span><span></span></div>
                                <div class="bin-category-label" style="background-color: var(--color-${type});">${label}</div>
                            </div>
                            <div class="lid-wrapper">
                                <div class="handle"></div>
                                <div class="lid"></div>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        }

        function initBoard() {
            board.innerHTML = '';
            trashLayer.innerHTML = '';
            playersData = [];
            document.getElementById('btn-replay-global').style.display = 'none';
            document.getElementById('global-result-overlay').style.display = 'none';

            const colWidth = window.innerWidth / playerCount;
            let binsPerRow = 5; 
            
            if (colWidth < 400) binsPerRow = 3;
            if (colWidth < 250) binsPerRow = 2;

            let targetBinWidth = (colWidth * 0.95) / binsPerRow;
            let scale = targetBinWidth / 160; 
            
            if(scale > 0.4) scale = 0.4;
            if(scale < 0.2) scale = 0.2; 

            for (let i = 0; i < playerCount; i++) {
                const p = { ...charList[i], score: 0, index: i, clearedCount: 0 };
                playersData.push(p);

                const col = document.createElement('div');
                col.className = 'player-col';
                col.id = `col-${i}`;

                col.innerHTML = `
                    <div class="player-header">
                        <div class="p-char">${p.emo} ${p.name}</div>
                        <div class="p-score" id="score-${i}">0${t('score')}</div>
                    </div>
                    <div class="spawn-zone" id="spawn-${i}"></div>
                    <div class="bins-zone" id="bins-${i}">
                        ${createBinHTML('plastic', t('plastic'), '🥤')}
                        ${createBinHTML('paper', t('paper'), '📦')}
                        ${createBinHTML('glass', t('glass'), '🍷')}
                        ${createBinHTML('can', t('can'), '🥫')}
                        ${createBinHTML('general', t('general'), '🗑️')}
                    </div>
                `;
                board.appendChild(col);

                const groups = col.querySelectorAll('.bin-group');
                groups.forEach(g => {
                    g.style.width = `${100 / binsPerRow}%`;
                });

                const wrappers = col.querySelectorAll('.bin-wrapper');
                wrappers.forEach(w => {
                    w.style.transform = `scale(${scale})`;
                    w.style.marginTop = `-${230 * (1 - scale) - 10}px`; 
                });
            }
        }

        function startCountdown() {
            if(audioCtx.state === 'suspended') audioCtx.resume();
            
            // 게임 시작 시 언어 선택기 몰입을 위해 숨김 처리
            document.getElementById('langTriggerContainer').style.display = 'none';
            
            switchScreen('game-screen');
            initBoard();
            
            overlay.style.display = 'flex';
            let count = 3;
            overlay.innerText = count;
            sounds.count();

            clearInterval(countdownTimer);
            countdownTimer = setInterval(() => {
                count--;
                if (count > 0) {
                    overlay.innerText = count;
                    sounds.count();
                } else if (count === 0) {
                    overlay.innerText = t('start');
                    sounds.go();
                } else {
                    clearInterval(countdownTimer);
                    overlay.style.display = 'none';
                    runGame();
                }
            }, 1000);
        }

        function runGame() {
            isPlaying = true;
            timeLeft = 60;
            timeDisplay.innerText = `⏳ ${timeLeft}${t('sec')}`;
            timeDisplay.classList.remove('time-warning');

            for (let i = 0; i < playerCount; i++) {
                spawnTrashBatch(i, 8); 
            }

            gameTimer = setInterval(() => {
                timeLeft--;
                timeDisplay.innerText = `⏳ ${timeLeft}${t('sec')}`;
                
                if (timeLeft <= 5 && timeLeft > 0) {
                    timeDisplay.classList.add('time-warning');
                    sounds.tick();
                }
                if (timeLeft <= 0) endGame();
            }, 1000);
        }

        function spawnTrashBatch(pIndex, count) {
            if(!isPlaying) return;
            const spawnZone = document.getElementById(`spawn-${pIndex}`);
            if(!spawnZone) return;
            const rect = spawnZone.getBoundingClientRect();

            for(let i=0; i<count; i++) {
                const data = trashDB[Math.floor(Math.random() * trashDB.length)];
                const item = document.createElement('div');
                item.className = 'trash-item';
                item.dataset.type = data.type;
                item.dataset.owner = pIndex;

                item.innerHTML = `<div class="emoji">${data.char}</div>`;
                
                const randomBottomHeavy = Math.sqrt(Math.random());
                const posX = rect.left + 10 + Math.random() * (rect.width - 110); 
                const posY = rect.top + 10 + randomBottomHeavy * (rect.height - 120);
                
                item.style.left = `${posX}px`;
                item.style.top = `${posY}px`;

                trashLayer.appendChild(item);
            }
        }

        trashLayer.addEventListener('pointerdown', (e) => {
            if(!isPlaying) return;
            const item = e.target.closest('.trash-item');
            if(!item) return;

            item.classList.add('dragging');
            item.setPointerCapture(e.pointerId);

            activePointers.set(e.pointerId, {
                item: item,
                x: e.clientX, y: e.clientY,
                startX: e.clientX, startY: e.clientY,
                initLeft: parseFloat(item.style.left), initTop: parseFloat(item.style.top)
            });
            e.preventDefault();
        });

        document.addEventListener('pointermove', (e) => {
            if(!isPlaying) return;
            
            if(activePointers.has(e.pointerId)) {
                const p = activePointers.get(e.pointerId);
                p.x = e.clientX;
                p.y = e.clientY;

                const dx = p.x - p.startX;
                const dy = p.y - p.startY;
                p.item.style.left = `${p.initLeft + dx}px`;
                p.item.style.top = `${p.initTop + dy}px`;
            }

            const pts = Array.from(activePointers.values());
            if(pts.length === 0) return;

            document.querySelectorAll('.trash-container').forEach(bin => {
                bin.querySelector('.lid-wrapper').style.transform = 'rotate(0deg)';
                bin.querySelector('.mouth').classList.remove('open');
                bin.querySelectorAll('.pupil').forEach(pup => pup.style.transform = 'translate(0,0)');
            });

            pts.forEach(pt => {
                const ownerIdx = pt.item.dataset.owner;
                const ownerBins = document.getElementById(`bins-${ownerIdx}`).querySelectorAll('.trash-container');

                let minDist = Infinity;
                let closestBin = null;

                ownerBins.forEach(bin => {
                    const rect = bin.getBoundingClientRect();
                    const centerX = rect.left + rect.width / 2;
                    const centerY = rect.top + 40;

                    const dist = Math.sqrt((pt.x - centerX)**2 + (pt.y - centerY)**2);
                    if(dist < minDist) { 
                        minDist = dist; 
                        closestBin = bin; 
                    }
                });

                const minTriggerDist = 80; 
                if(closestBin && minDist < minTriggerDist) {
                    const lid = closestBin.querySelector('.lid-wrapper');
                    const mouth = closestBin.querySelector('.mouth');
                    const pupils = closestBin.querySelectorAll('.pupil');

                    lid.style.transform = `rotate(85deg)`;
                    mouth.classList.add('open');

                    const rect = closestBin.getBoundingClientRect();
                    const centerX = rect.left + rect.width / 2;
                    const centerY = rect.top + 40;
                    const aMouse = Math.atan2(pt.y - centerY, pt.x - centerX);
                    const pDist = Math.min(minDist / 20, 4);
                    const px = Math.cos(aMouse) * pDist;
                    const py = Math.sin(aMouse) * pDist;
                    pupils.forEach(pup => pup.style.transform = `translate(${px}px, ${py}px)`);
                }
            });
        });

        document.addEventListener('pointerup', (e) => {
            if(!activePointers.has(e.pointerId)) return;
            const p = activePointers.get(e.pointerId);
            const item = p.item;
            
            item.classList.remove('dragging');
            item.releasePointerCapture(e.pointerId);
            activePointers.delete(e.pointerId);

            const rect = item.getBoundingClientRect();
            const centerX = rect.left + rect.width/2;
            const centerY = rect.top + rect.height/2;

            checkDropLogic(item, centerX, centerY, p.initLeft, p.initTop);
            resetAllBins();
        });

        function resetAllBins() {
            if(activePointers.size > 0) return;
            document.querySelectorAll('.trash-container').forEach(bin => {
                bin.querySelector('.lid-wrapper').style.transform = 'rotate(0deg)';
                bin.querySelector('.mouth').classList.remove('open');
                bin.querySelectorAll('.pupil').forEach(p => p.style.transform = 'translate(0,0)');
            });
        }

        function checkDropLogic(item, x, y, origLeft, origTop) {
            const ownerIdx = parseInt(item.dataset.owner);
            const pData = playersData[ownerIdx];
            
            const playerBins = document.getElementById(`bins-${ownerIdx}`).querySelectorAll('.bin-wrapper');
            let droppedBin = null;

            playerBins.forEach(bw => {
                const bRect = bw.getBoundingClientRect();
                if(x > bRect.left - 20 && x < bRect.right + 20 && y > bRect.top - 20 && y < bRect.bottom + 20) {
                    droppedBin = bw;
                }
            });

            if(droppedBin) {
                const tType = item.dataset.type;
                const bType = droppedBin.dataset.type;

                if(tType === bType) {
                    pData.score += 10;
                    pData.clearedCount++;
                    
                    if(pData.clearedCount % 10 === 0) {
                        pData.score += 100;
                        sounds.correct();
                        showFloatingText(t('clear'), x, y, '#fbbf24', 3000);
                    } else {
                        sounds.correct();
                        showFloatingText('+10', x, y, '#4ade80', 1000);
                    }
                } else {
                    pData.score -= 5;
                    if(pData.score < 0) pData.score = 0;
                    sounds.wrong();
                    showFloatingText('-5', x, y, '#ef4444', 1000);
                }
                
                document.getElementById(`score-${ownerIdx}`).innerText = `${pData.score}${t('score')}`;
                item.remove();

                const remaining = document.querySelectorAll(`.trash-item[data-owner="${ownerIdx}"]`).length;
                if(remaining < 3) spawnTrashBatch(ownerIdx, 5); 

            } else {
                item.style.transition = 'all 0.3s ease';
                item.style.left = `${origLeft}px`;
                item.style.top = `${origTop}px`;
                setTimeout(()=> item.style.transition = 'none', 300);
            }
        }

        function showFloatingText(txt, x, y, color, duration = 1000) {
            const el = document.createElement('div');
            el.className = 'feedback-text';
            el.innerText = txt;
            el.style.color = color;
            el.style.left = `${x}px`;
            el.style.top = `${y - 30}px`;
            el.style.animationDuration = `${duration/1000}s`;
            document.body.appendChild(el);
            setTimeout(()=>el.remove(), duration);
        }

        function endGame() {
            isPlaying = false;
            clearInterval(gameTimer);
            trashLayer.innerHTML = ''; 
            
            const sortedPlayers = [...playersData].sort((a,b) => b.score - a.score);
            let currentRank = 1;
            sortedPlayers[0].rank = 1;
            
            for(let i=1; i<sortedPlayers.length; i++) {
                if(sortedPlayers[i].score === sortedPlayers[i-1].score) {
                    sortedPlayers[i].rank = currentRank;
                } else {
                    currentRank = i + 1;
                    sortedPlayers[i].rank = currentRank;
                }
            }

            const globalOverlay = document.getElementById('global-result-overlay');
            const topDiv = document.getElementById('result-top');
            const bottomDiv = document.getElementById('result-bottom');
            
            globalOverlay.style.display = 'flex';
            topDiv.innerHTML = `<div style="font-size: 6vh; margin-bottom: 2vh; color: #fbbf24; text-shadow: 0 4px 10px rgba(0,0,0,0.5);">${t('top1')}</div>`;
            bottomDiv.innerHTML = '';

            const winners = sortedPlayers.filter(p => p.rank === 1);
            let winnersHtml = '<div style="display: flex; gap: 60px; justify-content: center; flex-wrap: wrap;">';
            winners.forEach(w => {
                winnersHtml += `<div style="text-align: center;">
                    <div style="font-size: 10vh; margin-bottom: 1vh; filter: drop-shadow(0 4px 10px rgba(0,0,0,0.5));">${w.emo}</div>
                    <div style="font-size: 4vh; margin-bottom: 0.5vh;">${w.name}</div>
                    <div style="font-size: 5vh; color: #4ade80; text-shadow: 0 2px 5px rgba(0,0,0,0.5);">${w.score}${t('score')}</div>
                </div>`;
            });
            winnersHtml += '</div>';
            topDiv.innerHTML += winnersHtml;

            playersData.forEach(p => {
                let rankText = '';
                if(p.rank === 1) rankText = t('r1');
                else if(p.rank === 2) rankText = t('r2');
                else if(p.rank === 3) rankText = t('r3');
                else rankText = (currentLang === 'ko' ? `${p.rank}${t('rN')}` : `${p.rank}${t('rN')}`);

                bottomDiv.innerHTML += `
                    <div class="bottom-col">
                        <div style="font-size: 3.5vh; margin-bottom: 1.5vh; color: #fbbf24;">${rankText}</div>
                        <div style="font-size: 3vh; margin-bottom: 1vh;">${p.emo} <br> ${p.name}</div>
                        <div style="font-size: 3.5vh; color: #4ade80;">${p.score}${t('score')}</div>
                    </div>
                `;
            });

            clearTimeout(replayTimeout); 
            replayTimeout = setTimeout(() => {
                document.getElementById('btn-replay-global').style.display = 'block';
            }, 3000);
        }

        // ==================== 언어 모달 컨트롤러 ====================
        const langTriggerBtn = document.getElementById('langTriggerBtn');
        const langModal = document.getElementById('langModal');
        const closeModalBtn = document.getElementById('closeModalBtn');
        const searchInput = document.getElementById('searchInput');
        const grid = document.getElementById('languageGrid');
        const noResult = document.getElementById('noResult');
        
        const toast = document.getElementById('toastNotification');
        let toastTimeout;

        function renderLanguages(filterText = '') {
            grid.innerHTML = '';
            const lowerFilter = filterText.toLowerCase();
            
            const filteredLangs = languagesData.filter(lang => 
                lang.name.toLowerCase().includes(lowerFilter) || 
                lang.enName.toLowerCase().includes(lowerFilter) ||
                lang.code.toLowerCase().includes(lowerFilter)
            );

            if (filteredLangs.length === 0) {
                grid.classList.add('hidden');
                noResult.classList.remove('hidden');
                noResult.classList.add('flex');
            } else {
                grid.classList.remove('hidden');
                noResult.classList.add('hidden');
                noResult.classList.remove('flex');

                filteredLangs.forEach(lang => {
                    const isSelected = lang.code === currentLang;
                    
                    const baseClasses = "flex items-center gap-3 p-3 rounded-xl border cursor-pointer transition-all duration-200 group relative overflow-hidden";
                    const stateClasses = isSelected 
                        ? "bg-gray-800 border-yellow-500 ring-1 ring-yellow-500/50" 
                        : "bg-gray-800/40 border-gray-700 hover:bg-gray-700 hover:border-gray-500";

                    const flagUrl = `https://flagcdn.com/w40/${lang.country}.png`;

                    const btn = document.createElement('div');
                    btn.className = `${baseClasses} ${stateClasses}`;

                    btn.innerHTML = `
                        <div class="shrink-0 w-8 h-6 rounded overflow-hidden shadow-sm border border-gray-700/50">
                            <img src="${flagUrl}" alt="${lang.country}" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300">
                        </div>
                        <div class="flex-1 min-w-0 flex flex-col items-start">
                            <span class="text-sm text-white truncate w-full ${isSelected ? 'text-yellow-400' : ''}">${lang.name}</span>
                            <span class="text-xs text-gray-400 truncate w-full">${lang.enName}</span>
                        </div>
                        ${isSelected ? '<i class="fa-solid fa-circle-check text-yellow-500 text-lg ml-2"></i>' : ''}
                    `;

                    btn.addEventListener('click', () => {
                        applyLanguage(lang.code);
                        
                        // Storage 및 공유 URL 업데이트 (history pushState)
                        localStorage.setItem('kingsmath_lang', lang.code);
                        const newUrl = new URL(window.location);
                        newUrl.searchParams.set('lang', lang.code);
                        window.history.pushState(null, '', newUrl.toString());

                        // 모달 버튼 상태 업데이트
                        document.getElementById('currentFlag').src = flagUrl;
                        document.getElementById('currentLangName').textContent = lang.name;
                        
                        closeModal();
                        
                        // 토스트 알림 표시
                        document.getElementById('ui-toast').textContent = t('msg');
                        document.getElementById('toastLangName').textContent = lang.name;
                        toast.classList.add('show');
                        clearTimeout(toastTimeout);
                        toastTimeout = setTimeout(() => toast.classList.remove('show'), 3000);
                        
                        // 모달 다시 열림 방지를 위해 렌더링 초기화
                        renderLanguages(searchInput.value);
                    });
                    grid.appendChild(btn);
                });
            }
        }

        function openModal() {
            langModal.classList.add('active');
            setTimeout(() => searchInput.focus(), 100);
        }

        function closeModal() {
            langModal.classList.remove('active');
        }

        langTriggerBtn.addEventListener('click', openModal);
        closeModalBtn.addEventListener('click', closeModal);
        langModal.addEventListener('click', (e) => {
            if (e.target === langModal) closeModal();
        });
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && langModal.classList.contains('active')) closeModal();
        });
        searchInput.addEventListener('input', (e) => renderLanguages(e.target.value));

        // 초기 언어 감지 및 세팅
        detectAndInitLanguage();
        // 잊기 쉬운 제미나이 실수 방지: 언어 모달 렌더링 호출
        renderLanguages();



// ==================== 전자칠판 최적화: 브라우저 기본 동작 차단 ====================

// 1. 우클릭 및 길게 누르기(Context Menu) 완벽 차단
document.addEventListener('contextmenu', function(e) {
    e.preventDefault();
}, { passive: false });

// 2. 더블 탭 확대 및 기본 터치 동작 차단 (멀티터치 시 튀는 현상 방지)
document.addEventListener('touchstart', function(e) {
    // 2개 이상의 손가락으로 터치 시 확대/축소되는 브라우저 기본 동작 방지
    if (e.touches.length > 1) {
        e.preventDefault(); 
    }
}, { passive: false });

// 3. 더블 클릭 시 화면 확대되거나 텍스트 선택되는 현상 차단
document.addEventListener('dblclick', function(e) {
    e.preventDefault();
}, { passive: false });

// 4. (선택사항) iOS 등에서 핀치 줌(두 손가락으로 화면 꼬집어서 확대) 차단
document.addEventListener('touchmove', function(e) {
    if (e.touches.length > 1) {
        e.preventDefault();
    }
}, { passive: false });
    </script>
</body>
</html>
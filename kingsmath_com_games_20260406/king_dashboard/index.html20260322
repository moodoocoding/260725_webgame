            padding: 5px 15px;
            border-radius: 20px;
        }

        .hero h1 {
            font-size: 4.5rem;
            color: var(--dark);
            margin-bottom: 20px;
            line-height: 1.2;
        }

        .hero h1 span {
            color: var(--primary);
        }

        .hero p {
            font-size: 1.3rem;
            color: var(--gray);
            margin-bottom: 40px;
        }

        .hero-buttons {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }

        .hero-image {
            flex: 1.2;
            perspective: 1000px;
        }

        .hero-image img {
            width: 100%;
            border-radius: 20px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            transform: rotateY(-5deg) rotateX(5deg);
            transition: transform 0.5s ease;
            animation: float 6s ease-in-out infinite;
        }

        .hero-image img:hover {
            transform: rotateY(0) rotateX(0);
        }

        @keyframes float {
            0% { transform: translateY(0px) rotateY(-5deg) rotateX(5deg); }
            50% { transform: translateY(-20px) rotateY(-5deg) rotateX(5deg); }
            100% { transform: translateY(0px) rotateY(-5deg) rotateX(5deg); }
        }

        /* Highlight Section */
        .highlight-section {
            background-color: var(--dark);
            color: white;
            text-align: center;
        }

        .highlight-section h2 {
            color: white;
            font-size: 3.5rem;
        }

        .countdown-display {
            font-size: 8rem;
            font-family: 'Jua', sans-serif;
            color: var(--accent);
            text-shadow: 0 0 20px rgba(245, 158, 11, 0.5);
            margin: 20px 0;
            line-height: 1;
        }

        /* Features Grid */
        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
            margin: 50px;
        }

        .feature-card {
            background: white;
            padding: 25px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
            text-align: center;
            transition: transform 0.3s ease;
        }

        .feature-card:hover {
            transform: translateY(-10px);
        }

        .feature-icon {
            width: 80px;
            height: 80px;
            background-color: #e0e7ff;
            color: var(--primary);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            margin: 0 auto 20px;
        }

        .feature-card h3 {
            font-size: 1.6rem;
            margin-bottom: 15px;
        }

        .feature-card p {
            color: var(--gray);
            font-size: 0.95rem;
        }
        
        /* 상세 기능 섹션 */
        .detail-features-section {
            background-color: #f8fafc;
        }

        .detail-row {
            display: flex;
            align-items: stretch;
            gap: 40px;
            margin-bottom: 80px;
        }

        .detail-row:nth-child(even) {
            flex-direction: row-reverse;
        }

        .detail-img-wrapper {
            flex: 1;
            background: white;
            padding: 20px;
            border-radius: 20px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.06);
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 350px; 
        }

        .detail-img-wrapper img {
            width: 100%;
            height: 100%;
            max-height: 400px;
            object-fit: contain; 
            border-radius: 10px;
        }

        .detail-text-wrapper {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .detail-text-wrapper h3 {
            font-size: 2.2rem;
            color: var(--primary);
            margin-bottom: 20px;
            font-family: 'Jua', sans-serif;
        }

        .detail-text-wrapper p {
            font-size: 1.15rem;
            color: var(--dark);
            line-height: 1.8;
            margin-bottom: 15px;
        }

        .detail-text-wrapper ul {
            list-style: none;
        }
        
        .detail-text-wrapper ul li {
            position: relative;
            padding-left: 25px;
            margin-bottom: 10px;
            color: var(--gray);
        }

        .detail-text-wrapper ul li::before {
            content: "✨";
            position: absolute;
            left: 0;
            top: 2px;
            font-size: 0.9rem;
        }

        /* Themes Section */
        .themes-section {
            background-color: #ffffff;
        }
        
        .theme-grid {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 20px;
        }

        .theme-card {
            width: calc(33.333% - 20px);
            min-width: 300px;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 10px 20px rgba(0,0,0,0.08);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            cursor: pointer;
        }

        .theme-card:hover {
            transform: translateY(-10px) scale(1.02);
            box-shadow: 0 20px 30px rgba(0,0,0,0.12);
        }

        .theme-card img {
            width: 100%;
            height: auto;
            display: block;
        }

        /* Target Audience Section */
        .audience {
            background-color: var(--light);
        }

        .audience-flex {
            display: flex;
            gap: 40px;
            flex-wrap: wrap;
        }

        .audience-box {
            flex: 1;
            min-width: 300px;
            background: white;
            border-radius: 20px;
            padding: 40px;
            border-left: 8px solid var(--secondary);
            box-shadow: 0 4px 6px rgba(0,0,0,0.02);
        }
        
        .audience-box:nth-child(2) {
            border-left-color: var(--accent);
        }

        .audience-box h3 {
            font-size: 2rem;
            margin-bottom: 15px;
        }

        /* How to Install */
        .install-section {
            background-color: #ffffff;
        }

        .steps {
            display: flex;
            flex-direction: column;
            gap: 20px;
            max-width: 800px;
            margin: 0 auto;
        }

        .step-item {
            display: flex;
            align-items: center;
            background: var(--light);
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        }

        .step-number {
            font-family: 'Jua', sans-serif;
            font-size: 4rem;
            color: var(--primary);
            opacity: 0.3;
            margin-right: 30px;
            line-height: 1;
        }

        .step-content h3 {
            font-size: 1.5rem;
            margin-bottom: 5px;
        }

        /* Footer / CTA */
        .cta-section {
            background: linear-gradient(135deg, var(--primary) 0%, #818cf8 100%);
            color: white;
            text-align: center;
            padding: 80px 0;
        }

        .cta-section h2 {
            font-size: 3rem;
            color: white;
            margin-bottom: 20px;
        }

        .cta-buttons {
            display: flex;
            justify-content: center;
            gap: 15px;
            flex-wrap: wrap;
            margin-top: 30px;
        }

        .cta-section .btn {
            background-color: white;
            color: var(--primary);
            font-size: 1.5rem;
            padding: 20px 50px;
        }

        .cta-section .btn:hover {
            background-color: var(--light);
            color: var(--dark);
        }

        .cta-section .btn-preview {
            background-color: transparent;
            color: white;
            border: 2px solid white;
        }

        .cta-section .btn-preview:hover {
            background-color: rgba(255, 255, 255, 0.1);
            color: white;
        }

        /* Responsive */
        @media (max-width: 992px) {
            .hero-container {
                flex-direction: column;
                text-align: center;
            }
            .hero h1 { font-size: 3.5rem; }
            .hero-buttons { justify-content: center; }
            .hero-image img { transform: none; animation: none; margin-top: 30px; }
            .theme-card { width: calc(50% - 20px); }
        }

        @media (max-width: 768px) {
            .hero h1 { font-size: 3rem; }
            .countdown-display { font-size: 5rem; }
            .step-item { flex-direction: column; text-align: center; }
            .step-number { margin-right: 0; margin-bottom: 15px; }
            .theme-card { width: 100%; }
            .detail-row, .detail-row:nth-child(even) { flex-direction: column; margin-bottom: 50px; }
            .detail-img-wrapper { min-height: auto; padding: 10px; }
        }
    </style>

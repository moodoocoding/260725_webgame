            text-align: center;
            font-size: 1.2rem;
            color: var(--gray);
            margin-bottom: 4rem;
        }

        /* Sections */
        section {
            padding: 100px 0;
        }

        /* Hero Section */
        .hero {
            background: linear-gradient(135deg, #e0e7ff 0%, #d1fae5 100%);
            padding: 120px 0 80px;
            min-height: 100vh;
            display: flex;
            align-items: center;
        }

        .hero-container {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 50px;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 30px;
        }

        .hero-content {
            flex: 1;
            max-width: 600px;
        }
        
        /* 킹수학 대쉬보드 타이틀 스타일 */
        .hero-subtitle {
            color: var(--primary);
            font-family: 'Jua', sans-serif;
            font-size: 1.8rem;

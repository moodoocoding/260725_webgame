        function playSound(type) {
            if (audioCtx.state === 'suspended') audioCtx.resume();
            const now = audioCtx.currentTime;
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.connect(gain);
            gain.connect(audioCtx.destination);

            if (type === 'eat') {
                osc.type = 'sine';
                osc.frequency.setValueAtTime(600, now);
                osc.frequency.exponentialRampToValueAtTime(1000, now + 0.1);
                gain.gain.setValueAtTime(0.3, now);
                gain.gain.linearRampToValueAtTime(0, now + 0.1);
                osc.start(now); osc.stop(now + 0.1);
            } else if (type === 'win') {
                osc.type = 'triangle';
                [523, 659, 783, 1046].forEach((freq, i) => {
                    const o = audioCtx.createOscillator();
                    const g = audioCtx.createGain();
                    o.connect(g); g.connect(audioCtx.destination);
                    o.type = 'triangle';
                    o.frequency.value = freq;
                    g.gain.setValueAtTime(0.2, now + i*0.1);
                    g.gain.linearRampToValueAtTime(0, now + i*0.1 + 0.3);
                    o.start(now + i*0.1); o.stop(now + i*0.1 + 0.3);
                });
            } else if (type === 'lose') {
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(150, now);
                osc.frequency.linearRampToValueAtTime(50, now + 0.5);
                gain.gain.setValueAtTime(0.3, now);
                gain.gain.linearRampToValueAtTime(0, now + 0.5);
                osc.start(now); osc.stop(now + 0.5);
            } else if (type === 'spawn') {
                osc.type = 'sine';
                osc.frequency.setValueAtTime(200, now);
                osc.frequency.linearRampToValueAtTime(400, now + 0.2);
                gain.gain.setValueAtTime(0.5, now);
                gain.gain.linearRampToValueAtTime(0, now + 0.2);
                osc.start(now); osc.stop(now + 0.2);
            } else if (type === 'beep') {
                osc.type = 'square';
                osc.frequency.setValueAtTime(600, now);
                gain.gain.setValueAtTime(0.1, now);
                gain.gain.linearRampToValueAtTime(0, now + 0.15);
                osc.start(now); osc.stop(now + 0.15);
            } else if (type === 'go') {
                osc.type = 'square';
                osc.frequency.setValueAtTime(800, now);
                osc.frequency.linearRampToValueAtTime(1200, now + 0.3);
                gain.gain.setValueAtTime(0.2, now);
                gain.gain.linearRampToValueAtTime(0, now + 0.4);
                osc.start(now); osc.stop(now + 0.4);
            }
        }

        // --- Maze Generator ---
        class MazeCell {
            constructor(c, r) {
                this.c = c;
                this.r = r;
                this.visited = false;
                this.walls = { top: true, right: true, bottom: true, left: true };
            }
        }

        class Maze {
            constructor(cols, rows) {
                this.cols = cols;
                this.rows = rows;
                this.grid = [];
                this.fruits = [];
                this.goalSpawned = false;
                this.goalRect = null;
                this.initGrid();
                this.generateDFS();
            }

            initGrid() {
                for(let r=0; r<this.rows; r++) {
                    const row = [];
                    for(let c=0; c<this.cols; c++) {
                        row.push(new MazeCell(c, r));
                    }
                    this.grid.push(row);
                }
            }

            generateDFS() {
                let stack = [];
                let current = this.grid[0][0];
                current.visited = true;
                stack.push(current);

                while(stack.length > 0) {
                    current = stack[stack.length - 1];
                    let neighbors = this.getUnvisitedNeighbors(current);

                    if (neighbors.length > 0) {
                        let next = neighbors[Math.floor(Math.random() * neighbors.length)];
                        this.removeWalls(current, next);
                        next.visited = true;
                        stack.push(next);
                    } else {
                        stack.pop();
                    }
                }

                if (state.difficulty === 'easy') {
                    this.braidMaze(0.5);
                } else {
                    this.braidMaze(0.1);
                }
            }

            getUnvisitedNeighbors(cell) {
                let neighbors = [];
                const dirs = [[0,-1], [1,0], [0,1], [-1,0]];
                for(let d of dirs) {
                    let nc = cell.c + d[0];
                    let nr = cell.r + d[1];
                    if(nc >= 0 && nc < this.cols && nr >= 0 && nr < this.rows) {
                        if(!this.grid[nr][nc].visited) {
                            neighbors.push(this.grid[nr][nc]);
                        }
                    }
                }
                return neighbors;
            }

            removeWalls(a, b) {
                let x = a.c - b.c;
                let y = a.r - b.r;
                if(x === 1) { a.walls.left = false; b.walls.right = false; }
                else if(x === -1) { a.walls.right = false; b.walls.left = false; }
                if(y === 1) { a.walls.top = false; b.walls.bottom = false; }
                else if(y === -1) { a.walls.bottom = false; b.walls.top = false; }
            }

            braidMaze(factor) {
                for(let r=0; r<this.rows; r++) {
                    for(let c=0; c<this.cols; c++) {
                        let cell = this.grid[r][c];
                        let wallCount = (cell.walls.top?1:0) + (cell.walls.right?1:0) + (cell.walls.bottom?1:0) + (cell.walls.left?1:0);
                        
                        if (wallCount === 3 && Math.random() < factor) {
                            let walls = [];
                            if (cell.walls.top && r > 0) walls.push('top');
                            if (cell.walls.right && c < this.cols-1) walls.push('right');
                            if (cell.walls.bottom && r < this.rows-1) walls.push('bottom');
                            if (cell.walls.left && c > 0) walls.push('left');

                            if(walls.length > 0) {
                                let pick = walls[Math.floor(Math.random() * walls.length)];
                                if(pick === 'top') { cell.walls.top = false; this.grid[r-1][c].walls.bottom = false; }
                                if(pick === 'right') { cell.walls.right = false; this.grid[r][c+1].walls.left = false; }
                                if(pick === 'bottom') { cell.walls.bottom = false; this.grid[r+1][c].walls.top = false; }
                                if(pick === 'left') { cell.walls.left = false; this.grid[r][c-1].walls.right = false; }
                            }
                        }
                    }
                }
            }

            populateFruits(count) {
                this.fruits = [];
                let placed = 0;
                // Center safe zone (2x2)
                const cX = Math.floor(this.cols/2);
                const cY = Math.floor(this.rows/2);

                while(placed < count) {
                    const r = Math.floor(Math.random() * this.rows);
                    const c = Math.floor(Math.random() * this.cols);
                    
                    // Exclude center 2x2
                    const isCenter = (r >= cY-1 && r <= cY && c >= cX-1 && c <= cX);
                    
                    if(!this.fruits.find(f => f.r === r && f.c === c) && !isCenter) {
                        this.fruits.push({
                            id: placed, r: r, c: c,
                            type: FRUITS[Math.floor(Math.random() * FRUITS.length)],
                            eaten: false
                        });
                        placed++;
                    }
                }
            }
        }


            left: 20px;
            color: var(--accent-color);
            text-decoration: none;
            font-size: 1.2rem;
            text-shadow: 1px 1px 0 #000;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            max-width: 60%;

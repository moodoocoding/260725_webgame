                const zoneW = 1 / state.playerCount;
                for(let i=0; i<state.playerCount; i++) {
                    state.zones.push({ x: i*zoneW, y: 0, w: zoneW, h: 1, mazeIdx: i });
                    const m = new Maze(state.cols, state.rows);
                    m.grid = JSON.parse(JSON.stringify(masterMaze.grid));
                    m.fruits = JSON.parse(JSON.stringify(masterMaze.fruits));
                    state.mazes.push(m);
                    state.players.push(new Player(i, i, m, {r: state.rows-1, c: 0}));
                }
            } else if (state.modeType === 'team') {
                const teamCount = 2; 
                const zoneW = 0.5;
                for(let t=0; t<teamCount; t++) {
                    state.zones.push({ x: t*zoneW, y: 0, w: zoneW, h: 1, mazeIdx: t });
                    const m = new Maze(state.cols, state.rows);
                    m.grid = JSON.parse(JSON.stringify(masterMaze.grid));
                    m.fruits = JSON.parse(JSON.stringify(masterMaze.fruits));
                    state.mazes.push(m);
                }
                for(let i=0; i<4; i++) {
                    const t = (i < 2) ? 0 : 1;
                    const startC = (i % 2 === 0) ? 0 : state.cols - 1;
                    state.players.push(new Player(i, t, state.mazes[t], {r: state.rows-1, c: startC}));
                }
            } else { // Coop
                state.zones.push({ x: 0, y: 0, w: 1, h: 1, mazeIdx: 0 });
                state.mazes.push(masterMaze);
                const positions = [
                    {r: state.rows-1, c: 0}, 
                    {r: state.rows-1, c: state.cols-1}, 
                    {r: state.rows-1, c: Math.floor(state.cols/3)}, 
                    {r: state.rows-1, c: Math.floor(state.cols*2/3)}
                ];
                for(let i=0; i<4; i++) {

        .lang-switcher {
            position: fixed;
            top: 15px;
            right: 15px;
            background: #aaaaaa52;
            border-radius: 20px;
            padding: 5px 10px;
            z-index: 1000;
            display: flex;
            flex-wrap: nowrap;
            gap: 8px;
            box-shadow: 2px 2px 5px rgba(0,0,0,0.2);
            backdrop-filter: blur(2px);
        }

        .lang-btn {
            cursor: pointer;
            font-size: 1.5rem;
            text-decoration: none;
            border: none;
            background: none;
            padding: 0;
            margin: 0;
            line-height: 1;
            transition: transform 0.2s;
            opacity: 0.7;
        }
        .lang-btn:hover, .lang-btn.active {
            transform: scale(1.2);
            opacity: 1;
        }

        /* --- Layout --- */
        #app-container {
            flex: 1;
            position: relative;
            display: flex;
            justify-content: center;
            width: 100%;
            height: calc(100% - 60px);
            overflow: hidden; 
            padding-bottom: 30px;
            box-sizing: border-box;
        }


        function calculateRank() {
            if (state.modeType === 'team') {
                const t0 = [state.players[0], state.players[1]];
                const t1 = [state.players[2], state.players[3]];

                const t0Fin = t0.every(p => p.finished);
                const t1Fin = t1.every(p => p.finished);
                
                const t0Score = t0.reduce((acc, p) => acc + p.score, 0);
                const t1Score = t1.reduce((acc, p) => acc + p.score, 0);

                let t0Rank, t1Rank;

                if (t0Fin && !t1Fin) {
                    t0Rank = 1; t1Rank = 2;
                } else if (!t0Fin && t1Fin) {
                    t0Rank = 2; t1Rank = 1;
                } else if (t0Fin && t1Fin) {
                    t0Rank = 1; t1Rank = 1;
                } else {
                    if (t0Score > t1Score) { t0Rank = 1; t1Rank = 2; }
                    else if (t1Score > t0Score) { t0Rank = 2; t1Rank = 1; }
                    else { t0Rank = 1; t1Rank = 1; }
                }

                t0.forEach(p => p.rank = t0Rank);
                t1.forEach(p => p.rank = t1Rank);

                return [...t0, ...t1];
            } 
            
            // [NEW] 개인전/협동전 랭킹 로직 개선
            // 1. 이미 도착한 사람들은 도착 순서대로의 Rank 유지
            // 2. 도착하지 못한 사람들은 Score 내림차순으로 정렬하여 남은 등수 부여

            const sorted = [...state.players].sort((a, b) => {
                // 둘 다 도착했으면 기존 등수(도착순서) 유지
                if (a.finished && b.finished) return a.rank - b.rank;
                // 한 명만 도착했으면 도착한 사람이 위로
                if (a.finished) return -1;
                if (b.finished) return 1;
                // 둘 다 도착 못했으면 점수 높은 순
                return b.score - a.score;
            });
            
            // 도착하지 못한 플레이어들에게 순위 부여 (현재 1등, 2등... 다음 순서부터)
            let currentNextRank = state.finishedRankCounter; 
            
            for (let i = 0; i < sorted.length; i++) {
                if (!sorted[i].finished) {
                    // 점수가 이전 사람과 같다면 공동 등수 처리 (선택사항이나 여기선 단순 순차 부여)
                    sorted[i].rank = currentNextRank++;
                }
            }

            return sorted;
        }


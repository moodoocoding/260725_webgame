                createOsc('sine', 1046.50, now + 0.2, 0.4, 0.2); // C6
            } else if (type === 'error') {
                createOsc('sawtooth', 150, now, 0.3, 0.3);
                createOsc('sawtooth', 140, now + 0.1, 0.3, 0.3);
            } else if (type === 'win') {

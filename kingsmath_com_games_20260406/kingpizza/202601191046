                const times = [0, 0.15, 0.3, 0.45, 0.6, 0.75];
                melody.forEach((f, i) => createOsc('square', f, now + times[i], 0.4, 0.2));
            }
        } catch (e) {
            console.error("Audio error", e);
        }
    };


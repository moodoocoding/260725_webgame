    const playSound = (type, freq) => {
        try {
            const AudioContext = window.AudioContext || window.webkitAudioContext;
            if (!AudioContext) return;
            
            const ctx = new AudioContext();
            const now = ctx.currentTime;
            
            // 메인 볼륨 컨트롤
            const masterGain = ctx.createGain();
            masterGain.connect(ctx.destination);
            masterGain.gain.setValueAtTime(0.5, now); // 기본 볼륨

            const createOsc = (type, frequency, startTime, duration, vol = 1) => {
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.type = type;
                osc.frequency.setValueAtTime(frequency, startTime);
                
                gain.gain.setValueAtTime(0, startTime);
                gain.gain.linearRampToValueAtTime(vol, startTime + 0.01);
                gain.gain.exponentialRampToValueAtTime(0.001, startTime + duration);
                
                osc.connect(gain);
                gain.connect(masterGain);
                osc.start(startTime);
                osc.stop(startTime + duration);
            };

            if (type === 'pop') {
                createOsc('sine', freq || 600, now, 0.15, 0.4);
            } else if (type === 'start') {
                const notes = [440, 554.37, 659.25, 880, 1108.73]; // A major arpeggio

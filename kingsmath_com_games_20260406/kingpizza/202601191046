                gain.gain.setValueAtTime(0.1, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now + 0.05);
                osc.connect(gain);
                gain.connect(masterGain);
                osc.start(now);
                osc.stop(now + 0.05);
            } else if (type === 'success') {
                createOsc('triangle', 523.25, now, 0.2, 0.3); // C5
                createOsc('triangle', 659.25, now + 0.1, 0.2, 0.3); // E5

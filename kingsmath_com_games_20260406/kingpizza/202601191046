        { id: 'mushroom', soundFreq: 349.23, color: '#a8a29e', emoji: '🍄' },
        { id: 'bacon', soundFreq: 392.00, color: '#f43f5e', emoji: '🥓' },
        { id: 'steak', soundFreq: 440.00, color: '#78350f', emoji: '🥩' },
    ];

    const TOTAL_SLICES = 12;
    const GOAL_SCORE = 5;

    // --- 로직 유틸리티 ---
    const gcd = (a, b) => b === 0 ? a : gcd(b, a % b);

    const generateRandomProblem = () => {
        const difficulty = Math.floor(Math.random() * 4) + 1;
        let numToppings = 2;
        if (difficulty >= 2) numToppings = 3;
        if (difficulty >= 4) numToppings = 4;

        const shuffledToppings = [...TOPPINGS].sort(() => 0.5 - Math.random());
        const selectedToppings = shuffledToppings.slice(0, numToppings);

        let remains = TOTAL_SLICES;
        let partitions = [];

        for (let i = 0; i < numToppings - 1; i++) {
            const maxTake = remains - (numToppings - 1 - i);
            let take;
            if (difficulty === 1) {
                const candidates = [1, 2, 3, 4, 6].filter(n => n <= maxTake);
                take = candidates[Math.floor(Math.random() * candidates.length)] || 1;
            } else {
                take = Math.floor(Math.random() * maxTake) + 1;
            }
            partitions.push(take);
            remains -= take;
        }
        partitions.push(remains);

        const order = partitions.map((count, idx) => {
            const divisor = gcd(count, TOTAL_SLICES);
            return {
                topping: selectedToppings[idx].id,
                n: count / divisor,
                d: TOTAL_SLICES / divisor,
                originalCount: count
            };
        });

        return { difficulty, order };
    };

    const getRandomProblem = () => generateRandomProblem();

    const FractionDisplay = ({ n, d, textColor, small }) => (
        <div className={`inline-flex flex-col items-center align-middle mx-1 font-black leading-none ${textColor} ${small ? 'text-lg' : 'text-2xl'}`} style={{ verticalAlign: 'middle' }}>
            <span className="border-b-[2px] border-current px-1 mb-0.5">{n}</span>
            <span className="px-1">{d}</span>
        </div>
    );

    const describeArc = (x, y, radius, startAngle, endAngle) => {
        const start = polarToCartesian(x, y, radius, endAngle);
        const end = polarToCartesian(x, y, radius, startAngle);
        const largeArcFlag = endAngle - startAngle <= 180 ? "0" : "1";
        return ["M", x, y, "L", start.x, start.y, "A", radius, radius, 0, largeArcFlag, 0, end.x, end.y, "Z"].join(" ");
    };

    const polarToCartesian = (centerX, centerY, radius, angleInDegrees) => {
        const angleInRadians = (angleInDegrees - 90) * Math.PI / 180.0;
        return {
            x: centerX + (radius * Math.cos(angleInRadians)),
            y: centerY + (radius * Math.sin(angleInRadians))
        };
    };

    // --- 메인 앱 컴포넌트 ---
    function App() {
        const [lang, setLang] = useState(getInitialLang);
        const [viewState, setViewState] = useState('start');
        const [winner, setWinner] = useState(null);
        const [soundEnabled, setSoundEnabled] = useState(true);
        const [isFullscreen, setIsFullscreen] = useState(false);
        const [gameMode, setGameMode] = useState('2p'); 

        const [p1State, setP1State] = useState({ score: 0, slices: Array(TOTAL_SLICES).fill(null), topping: TOPPINGS[0].id, problem: getRandomProblem(), message: { type: '', text: '' }, delivering: false });
        const [p2State, setP2State] = useState({ score: 0, slices: Array(TOTAL_SLICES).fill(null), topping: TOPPINGS[0].id, problem: getRandomProblem(), message: { type: '', text: '' }, delivering: false });
        const [p3State, setP3State] = useState({ score: 0, slices: Array(TOTAL_SLICES).fill(null), topping: TOPPINGS[0].id, problem: getRandomProblem(), message: { type: '', text: '' }, delivering: false });
        const [p4State, setP4State] = useState({ score: 0, slices: Array(TOTAL_SLICES).fill(null), topping: TOPPINGS[0].id, problem: getRandomProblem(), message: { type: '', text: '' }, delivering: false });

        const [isDragging, setIsDragging] = useState(false);
        const [dragMode, setDragMode] = useState(null);

        const t = TRANSLATIONS[lang];

        const getPlayerState = (pid) => {
            if(pid === 'p1') return { state: p1State, setState: setP1State };
            if(pid === 'p2') return { state: p2State, setState: setP2State };
            if(pid === 'p3') return { state: p3State, setState: setP3State };
            if(pid === 'p4') return { state: p4State, setState: setP4State };
            return { state: p1State, setState: setP1State };
        };

        const changeLang = (newLang) => {
            setLang(newLang);
            localStorage.setItem('kingsmath_lang', newLang);
            const url = new URL(window.location);
            url.searchParams.set('lang', newLang);
            window.history.pushState({}, '', url);
            updateMetadata(newLang);
        };

        useEffect(() => {
            updateMetadata(lang);
        }, [lang]);

        // --- 멀티터치 & 드래그 최적화 ---
        useEffect(() => {
            const handleGlobalUp = () => {
                if(isDragging) {
                    setIsDragging(false);
                    setDragMode(null);
                }
            };
            window.addEventListener('mouseup', handleGlobalUp);
            window.addEventListener('touchend', handleGlobalUp);

            const handleContextMenu = (e) => e.preventDefault();
            window.addEventListener('contextmenu', handleContextMenu);

            const handleTouchMove = (e) => {
                if (e.scale !== 1) e.preventDefault();
            };
            document.addEventListener('touchmove', handleTouchMove, { passive: false });
            
            let lastTouchEnd = 0;
            const handleTouchEnd = (event) => {
                const now = (new Date()).getTime();
                if (now - lastTouchEnd <= 300) {
                    event.preventDefault();
                }
                lastTouchEnd = now;
            };
            document.addEventListener('touchend', handleTouchEnd, { passive: false });

            return () => {
                window.removeEventListener('mouseup', handleGlobalUp);
                window.removeEventListener('touchend', handleGlobalUp);
                window.removeEventListener('contextmenu', handleContextMenu);
                document.removeEventListener('touchmove', handleTouchMove);
                document.removeEventListener('touchend', handleTouchEnd);
            };
        }, [isDragging]);

        // 우승 체크
        useEffect(() => {
            if (p1State.score >= GOAL_SCORE) { setWinner('p1'); setViewState('winner'); if(soundEnabled) playSound('win'); }
            else if (p2State.score >= GOAL_SCORE) { setWinner('p2'); setViewState('winner'); if(soundEnabled) playSound('win'); }
            else if (gameMode === '4p' && p3State.score >= GOAL_SCORE) { setWinner('p3'); setViewState('winner'); if(soundEnabled) playSound('win'); }
            else if (gameMode === '4p' && p4State.score >= GOAL_SCORE) { setWinner('p4'); setViewState('winner'); if(soundEnabled) playSound('win'); }
        }, [p1State.score, p2State.score, p3State.score, p4State.score, soundEnabled, gameMode]);

        const toggleFullscreen = () => {
            if (!document.fullscreenElement) {
                document.documentElement.requestFullscreen().catch((e) => console.log(e));
                setIsFullscreen(true);
            } else {
                if (document.exitFullscreen) {
                    document.exitFullscreen();
                    setIsFullscreen(false);
                }
            }
        };

        const resetAllPlayers = () => {
            const initial = { score: 0, slices: Array(TOTAL_SLICES).fill(null), topping: TOPPINGS[0].id, problem: getRandomProblem(), message: { type: '', text: '' }, delivering: false };
            setP1State({ ...initial, problem: getRandomProblem() });
            setP2State({ ...initial, problem: getRandomProblem() });
            setP3State({ ...initial, problem: getRandomProblem() });
            setP4State({ ...initial, problem: getRandomProblem() });
        };

        const goHome = () => {
            setViewState('start');
            setWinner(null);
            resetAllPlayers();
        };

        const startGame = (mode) => {
            setGameMode(mode);
            setViewState('playing');
            resetAllPlayers();
            if(soundEnabled) playSound('start');
        };

        const applySliceChange = (player, index, mode) => {
            const { state, setState } = getPlayerState(player);
            if (state.delivering) return;
            const newSlices = [...state.slices];
            const targetVal = mode === 'paint' ? state.topping : null;
            if (newSlices[index] === targetVal) return;
            newSlices[index] = targetVal;
            if (soundEnabled && mode === 'paint') {
                  const toppingData = TOPPINGS.find(t => t.id === state.topping);
                  playSound('pop', toppingData ? toppingData.soundFreq : 600);
            }
            setState(prev => ({ ...prev, slices: newSlices, message: { type: '', text: '' } }));
        };

        const handlePointerDown = (player, index) => {
            const { state } = getPlayerState(player);
            if (state.delivering) return;
            const currentTopping = state.slices[index];
            const selectedTopping = state.topping;
            const mode = (currentTopping === selectedTopping) ? 'erase' : 'paint';
            setDragMode(mode);
            setIsDragging(true);
            applySliceChange(player, index, mode);
        };

        const handlePointerEnter = (player, index) => {
            if (!isDragging) return;
            applySliceChange(player, index, dragMode);
        };

        // --- 완벽한 멀티터치 처리를 위한 함수 ---
        const handleTouchMove = (e, player) => {
            if(e.cancelable) e.preventDefault(); 
            if (!isDragging && e.type !== 'touchmove') return;

            Array.from(e.changedTouches).forEach(touch => {
                const target = document.elementFromPoint(touch.clientX, touch.clientY);
                if (target && target.tagName === 'path' && target.dataset.player === player) {
                    const index = parseInt(target.dataset.index, 10);
                    if (!isNaN(index)) {
                        let currentDragMode = dragMode;
                        if (!currentDragMode) {
                             const { state } = getPlayerState(player);
                             const currentTopping = state.slices[index];
                             currentDragMode = (currentTopping === state.topping) ? 'erase' : 'paint';
                             if(e.changedTouches.length === 1) setDragMode(currentDragMode); 
                        }
                        applySliceChange(player, index, currentDragMode || 'paint');
                    }
                }
            });
        };

        const updateTopping = (player, toppingId) => {
            const { state, setState } = getPlayerState(player);
            if (state.delivering) return;
            setState(prev => ({ ...prev, topping: toppingId }));
            if(soundEnabled) {
                  const toppingData = TOPPINGS.find(t => t.id === toppingId);
                  playSound('pop', toppingData ? toppingData.soundFreq : 600);
            }
        };

        const checkOrder = (player) => {
            const { state, setState } = getPlayerState(player);
            if (state.delivering) return;
            const filledCount = state.slices.filter(s => s !== null).length;
            if (filledCount < TOTAL_SLICES) {
                setState(prev => ({ ...prev, message: { type: 'error', text: t.msg_fill } }));
                if(soundEnabled) playSound('error');
                setTimeout(() => { setState(prev => ({ ...prev, message: { type: '', text: '' } })); }, 2000);
                return;
            }
            const counts = {};
            TOPPINGS.forEach(t => counts[t.id] = 0);
            state.slices.forEach(s => { if(s) counts[s]++ });
            let isCorrect = true;
            for (const item of state.problem.order) {
                const required = Math.round((item.n / item.d) * TOTAL_SLICES);
                if (counts[item.topping] !== required) {
                    isCorrect = false;
                    break;
                }
            }
            if (isCorrect) {
                if(soundEnabled) playSound('success');
                const equationText = state.problem.order.map(item => `${item.n}/${item.d}`).join(' + ') + ' = 1';
                setState(prev => ({ ...prev, delivering: true, message: { type: 'success', text: equationText } }));
                setTimeout(() => {
                    setState(prev => ({ ...prev, score: prev.score + 1, slices: Array(TOTAL_SLICES).fill(null), problem: getRandomProblem(), message: { type: 'success', text: t.msg_success }, delivering: false }));
                    // 3초 후 메시지 삭제
                    setTimeout(() => {
                        setState(prev => ({ ...prev, message: { type: '', text: '' } }));
                    }, 3000);
                }, 1500);
            } else {
                if(soundEnabled) playSound('error');
                setState(prev => ({ ...prev, message: { type: 'error', text: t.msg_wrong } }));
                setTimeout(() => { setState(prev => ({ ...prev, message: { type: '', text: '' } })); }, 2000);
            }
        };

        const resetPlate = (player) => {
            const { state, setState } = getPlayerState(player);
            if (state.delivering) return;
            setState(prev => ({ ...prev, slices: Array(TOTAL_SLICES).fill(null), message: { type: '', text: '' } }));
        };

        // --- Render Board Function ---
        const renderBoard = (player, mode = '2p') => {
            const { state } = getPlayerState(player);
            const is4P = mode === '4p';
            
            let name, theme;
            const darkTheme = { bg: 'bg-stone-900', border: 'border-stone-700', headerBg: 'bg-stone-800', text: 'text-stone-100', cardBg: 'bg-stone-800', cardBorder: 'border-stone-700', btnBg: 'bg-stone-700', btnHover: 'hover:bg-stone-600', btnText: 'text-stone-100', btnShadow: 'shadow-stone-950', fractionText: 'text-stone-100', ticketBg: 'bg-stone-700', pizzaBorderColor: '#57534e', strokeColor: '#57534e', ringColor: 'ring-stone-500' };
            const lightTheme = { bg: 'bg-white', border: 'border-gray-200', headerBg: 'bg-white', text: 'text-gray-900', cardBg: 'bg-white', cardBorder: 'border-gray-200', btnBg: 'bg-white', btnHover: 'hover:bg-gray-50', btnText: 'text-gray-800', btnShadow: 'shadow-gray-200', fractionText: 'text-gray-800', ticketBg: 'bg-gray-50', pizzaBorderColor: '#d1d5db', strokeColor: '#d1d5db', ringColor: 'ring-gray-300' };
            const kingTheme = { bg: 'bg-slate-900', border: 'border-amber-600', headerBg: 'bg-slate-800', text: 'text-amber-100', cardBg: 'bg-slate-800', cardBorder: 'border-amber-700', btnBg: 'bg-slate-700', btnHover: 'hover:bg-slate-600', btnText: 'text-amber-100', btnShadow: 'shadow-slate-950', fractionText: 'text-amber-100', ticketBg: 'bg-slate-700', pizzaBorderColor: '#b45309', strokeColor: '#b45309', ringColor: 'ring-amber-500' };
            const queenTheme = { bg: 'bg-rose-50', border: 'border-rose-200', headerBg: 'bg-white', text: 'text-rose-900', cardBg: 'bg-white', cardBorder: 'border-rose-200', btnBg: 'bg-white', btnHover: 'hover:bg-rose-50', btnText: 'text-rose-800', btnShadow: 'shadow-rose-200', fractionText: 'text-rose-800', ticketBg: 'bg-rose-50', pizzaBorderColor: '#fda4af', strokeColor: '#fda4af', ringColor: 'ring-rose-300' };

            if (player === 'p1') { name = t.p1Name; theme = darkTheme; }
            else if (player === 'p2') { name = t.p2Name; theme = lightTheme; }
            else if (player === 'p3') { name = t.p3Name; theme = kingTheme; }
            else { name = t.p4Name; theme = queenTheme; }

            const textSize = is4P ? 'text-3xl font-black' : 'text-4xl lg:text-6xl';
            const pizzaSizeClass = is4P ? 'w-[18vw] h-[18vw] max-w-[220px] max-h-[220px]' : 'w-[25vh] h-[25vh] max-w-[400px] max-h-[400px]';

            return (
                <div className={`flex-1 flex flex-col h-full relative ${theme.bg} ${is4P ? 'border-r-2 last:border-r-0' : 'border-x-4'} ${theme.border} overflow-hidden transition-colors duration-300`}>
                    {state.delivering && (
                        <div className="absolute inset-0 z-50 pointer-events-none flex items-center justify-center overflow-hidden">
                            <div className={`absolute animate-drive-delivery filter drop-shadow-2xl ${is4P ? 'text-6xl' : 'text-9xl'}`}>
                                <div className="flip-horizontal">🛵💨🍕</div>
                            </div>
                        </div>
                    )}

                    <div className={`${theme.headerBg} ${is4P ? 'py-4 px-2' : 'py-4 px-6'} shadow-md flex flex-col items-center border-b-2 ${theme.border} z-10 shrink-0`}>
                        <div className={`${textSize} ${is4P ? 'mb-1' : 'mb-4'} font-bold ${theme.text}`}>{name}</div>
                        <div className={`flex gap-1 ${is4P ? 'h-8' : 'gap-4 h-14'} items-center`}>
                            {Array.from({ length: GOAL_SCORE }).map((_, i) => (
                                <div key={i} className={`transition-all duration-500 ${i < (GOAL_SCORE - state.score) ? 'scale-100 opacity-100' : 'scale-50 opacity-20 grayscale'}`}>
                                    <span className={`${is4P ? 'text-2xl' : 'text-4xl'} drop-shadow-sm`}>🍕</span>
                                </div>
                            ))}
                        </div>
                    </div>

                    <div className="flex-1 flex flex-col items-center p-2 min-h-0 justify-between relative">
                        <div className={`w-full max-w-[95%] rounded-2xl shadow-lg border-2 ${is4P ? 'p-2 mt-1' : 'p-4 mt-4'} flex flex-col items-center animate-in slide-in-from-top-4 ${theme.cardBg} ${theme.cardBorder} shrink-0`}>
                            <div className={`text-lg font-bold uppercase tracking-widest ${is4P ? 'mb-1' : 'mb-2'} flex items-center gap-2 ${theme.text} opacity-50`}>
                                <IconShoppingCart size={is4P ? 16 : 20} /> {t.order}
                            </div>
                            <div className={`flex flex-nowrap overflow-x-auto scrollbar-hide justify-center items-center ${is4P ? 'gap-1' : 'gap-4'} w-full px-1 ${theme.text}`}>
                                {state.problem.order.map((item, idx) => {
                                    const top = TOPPINGS.find(to => to.id === item.topping);
                                    return (
                                        <div key={idx} className={`flex items-center flex-shrink-0 ${is4P ? 'px-2 py-1 rounded-lg border' : 'px-5 py-2 rounded-xl border-2'} ${theme.ticketBg} ${theme.border}`}>
                                            <span className={`${is4P ? 'text-xl mr-1' : 'text-3xl mr-3'}`}>{top.emoji}</span>
                                            <FractionDisplay n={item.n} d={item.d} textColor={theme.fractionText} small={is4P} />
                                        </div>
                                    );
                                })}
                            </div>
                        </div>

                        {/* 피자 영역 */}
                        <div className={`flex-1 min-h-0 flex flex-col justify-center w-full items-center`}>
                             <div className={`relative ${pizzaSizeClass} aspect-square transition-transform duration-500 flex items-center justify-center shrink ${state.delivering ? 'scale-0 rotate-180 opacity-0' : 'scale-100 rotate-0 opacity-100'}`}>
                                <svg 
                                    viewBox="0 0 100 100" 
                                    className="absolute inset-0 w-full h-full transform -rotate-15 drop-shadow-lg"
                                    onTouchMove={(e) => handleTouchMove(e, player)}
                                    style={{ touchAction: 'none' }}
                                >
                                    <circle cx="50" cy="50" r="48" fill={theme.bg === 'bg-stone-900' ? 'rgba(255,255,255,0.03)' : 'rgba(0,0,0,0.03)'} stroke={theme.pizzaBorderColor} strokeWidth="1.5" />
                                    {state.slices.map((tid, i) => {
                                        const start = (i * 360) / TOTAL_SLICES;
                                        const end = ((i + 1) * 360) / TOTAL_SLICES;
                                        const top = tid ? TOPPINGS.find(x => x.id === tid) : null;
                                        return (
                                            <g key={i}>
                                                <path
                                                    d={describeArc(50, 50, 48, start, end)}
                                                    fill={top ? top.color : 'transparent'} 
                                                    stroke={theme.strokeColor}
                                                    strokeWidth="0.5"
                                                    style={{ pointerEvents: 'all', cursor: 'pointer' }}
                                                    data-index={i}
                                                    data-player={player}
                                                    onPointerDown={() => handlePointerDown(player, i)}
                                                    onMouseEnter={() => handlePointerEnter(player, i)}
                                                />
                                                {top && (
                                                    <text
                                                        x={polarToCartesian(50, 50, 34, (i * 360 / TOTAL_SLICES) + (180 / TOTAL_SLICES)).x}
                                                        y={polarToCartesian(50, 50, 34, (i * 360 / TOTAL_SLICES) + (180 / TOTAL_SLICES)).y}
                                                        textAnchor="middle"
                                                        dominantBaseline="central"
                                                        fontSize="8"
                                                        pointerEvents="none"
                                                    >
                                                        {top.emoji}
                                                    </text>
                                                )}
                                            </g>
                                        );
                                    })}
                                    {Array.from({ length: TOTAL_SLICES }).map((_, i) => (
                                        <line
                                            key={`l-${i}`}
                                            x1="50" y1="50"
                                            x2={polarToCartesian(50, 50, 48, (i * 360) / TOTAL_SLICES).x}
                                            y2={polarToCartesian(50, 50, 48, (i * 360) / TOTAL_SLICES).y}
                                            stroke={theme.strokeColor}
                                            strokeWidth="0.3"
                                            pointerEvents="none"
                                        />
                                    ))}
                                </svg>
                                
                                {state.message.text && (
                                    <div className={`absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 z-50 ${is4P ? 'px-4 py-3 text-xl border-2' : 'px-8 py-6 text-3xl md:text-5xl border-4'} rounded-full shadow-2xl text-center font-black animate-pulse flex items-center justify-center whitespace-nowrap ${state.message.type === 'success' ? 'bg-green-600 text-white border-green-400' : 'bg-red-600 text-white border-red-400'}`}>
                                            {state.message.text}
                                    </div>
                                )}
                            </div>
                        </div>

                        <div className={`${theme.headerBg} ${is4P ? 'p-2 pb-4' : 'p-3'} border-t ${theme.border} z-10 flex flex-col ${is4P ? 'gap-2' : 'gap-3'} shadow-[0_-5px_15px_rgba(0,0,0,0.1)] transition-opacity duration-300 shrink-0 ${state.delivering ? 'opacity-50 pointer-events-none' : 'opacity-100'}`}>
                            <div className="flex gap-2 w-full">
                                <button 
                                    onPointerDown={() => resetPlate(player)} 
                                    className={`flex-[1] rounded-xl font-bold ${is4P ? 'text-sm py-2' : 'text-lg py-3'} shadow-lg active:translate-y-0.5 transition-all flex items-center justify-center ${theme.bg === 'bg-stone-900' || theme.bg === 'bg-slate-900' ? 'bg-white/10 text-white/70 hover:bg-white/20' : 'bg-gray-100 text-gray-500 hover:bg-gray-200 border border-gray-200'}`}
                                >
                                    {t.reset}
                                </button>
                                <button 
                                    onPointerDown={() => checkOrder(player)} 
                                    className={`flex-[2] rounded-xl font-black ${is4P ? 'text-sm py-2' : 'text-xl py-3'} shadow-lg active:translate-y-0.5 transition-all flex items-center justify-center gap-2 ${theme.btnBg} ${theme.btnText} ${theme.btnHover} ${theme.btnShadow} border-2 ${theme.border}`}
                                >
                                    {t.deliver} {!is4P && <IconArrowRight size={24} strokeWidth={3} />}
                                </button>
                            </div>

                            <div className={`grid grid-cols-6 ${is4P ? 'gap-1' : 'gap-2'} w-full`}>
                                {TOPPINGS.map((top) => (
                                    <button
                                        key={top.id}
                                        onPointerDown={() => updateTopping(player, top.id)}
                                        className={`flex flex-col items-center justify-center p-1 rounded-lg border transition-all aspect-square ${
                                            state.topping === top.id
                                                ? `bg-opacity-20 shadow-md scale-105 ring-2 ring-offset-1 ${theme.ringColor} border-transparent bg-current`
                                                : `border-transparent hover:bg-black/5`
                                        }`}
                                    >
                                        <span className={`${is4P ? 'text-3xl' : 'text-3xl lg:text-4xl'} leading-none`}>{top.emoji}</span>
                                    </button>
                                ))}
                            </div>
                        </div>
                    </div>
                </div>
            );
        };

        // --- 언어 선택기 ---
        const LanguageSwitcher = () => (
            <div className="lang-switcher">
                {['ko', 'en', 'zh', 'ja', 'es', 'fr', 'ru'].map(lc => (
                    <button 
                        key={lc} 
                        className={`lang-btn ${lang === lc ? 'active' : ''}`}
                        onPointerDown={() => changeLang(lc)}
                        title={TRANSLATIONS[lc].name}
                    >
                        {TRANSLATIONS[lc].flag}
                    </button>
                ))}
            </div>
        );

        const CommonControls = () => (
            <>
                <LanguageSwitcher />
                <button 
                    onPointerDown={goHome}
                    className="fixed left-4 top-1/2 transform -translate-y-1/2 z-50 bg-white p-3 rounded-full shadow-lg text-stone-500 hover:text-stone-900 border-2 border-stone-100 transition-all"
                    title={t.home}
                >
                    <IconHome size={28} />
                </button>

                <button 
                    onPointerDown={toggleFullscreen}
                    className="fixed right-4 top-1/2 transform -translate-y-1/2 z-50 bg-white p-3 rounded-full shadow-lg text-stone-500 hover:text-stone-900 border-2 border-stone-100 transition-all"
                    title="Fullscreen"
                >
                    {isFullscreen ? <IconMinimize size={28} /> : <IconMaximize size={28} />}
                </button>
                <button 
                    onPointerDown={() => setSoundEnabled(!soundEnabled)}
                    className="fixed bottom-4 left-1/2 transform -translate-x-1/2 z-50 bg-stone-900 text-white p-2 rounded-full opacity-50 hover:opacity-100 transition-opacity"
                >
                    {soundEnabled ? <IconVolume2 size={16}/> : <IconVolumeX size={16}/>}
                </button>
            </>
        );

        if (viewState === 'start') {
            const otherGameLink = lang === 'ko' ? '/' : '/';

            return (
                <div className="flex flex-col items-center justify-center h-screen bg-stone-100 font-sans relative overflow-hidden">
                    <LanguageSwitcher />

                    <div className="absolute inset-0 flex">
                        <div className="w-1/2 h-full bg-stone-950 border-r border-stone-800"></div>
                        <div className="w-1/2 h-full bg-stone-100"></div>
                    </div>

                    <button onPointerDown={goHome} className="fixed left-4 top-1/2 transform -translate-y-1/2 z-50 bg-white p-3 rounded-full shadow-lg text-stone-500 hover:text-stone-900 border-2 border-stone-100 transition-all">
                        <IconHome size={28} />
                    </button>
                    <button onPointerDown={toggleFullscreen} className="fixed right-4 top-1/2 transform -translate-y-1/2 z-50 bg-white p-3 rounded-full shadow-lg text-stone-500 hover:text-stone-900 border-2 border-stone-100 transition-all">
                        {isFullscreen ? <IconMinimize size={28} /> : <IconMaximize size={28} />}
                    </button>

                    <div className="relative z-10 p-10 lg:p-14 mt-10 max-w-5xl w-full text-center bg-white/95 backdrop-blur-md rounded-3xl shadow-2xl border-4 border-stone-800 flex flex-col items-center justify-center gap-6">
                        
                        <a href={t.linkUrl} target="_blank" className="inline-block px-8 py-3 bg-gradient-to-r from-amber-500 to-yellow-500 text-white rounded-full font-black text-lg hover:from-amber-600 hover:to-yellow-600 transition-all shadow-lg transform hover:-translate-y-1">
                            👑 {t.siteName}
                        </a>
                        
                        <h1 className="text-6xl lg:text-8xl font-black tracking-tight mb-2">
                            <span className="text-stone-900 text-stroke-white drop-shadow-lg mr-2">{t.heroTitle1}</span> 
                            <span className="text-amber-500 text-stroke-white drop-shadow-lg">{t.heroTitle2}</span>
                        </h1>

                        <div className="bg-stone-900/90 text-white px-8 py-3 rounded-full shadow-lg mb-4">
                            <p className="text-2xl font-bold">{t.heroSubtitle}</p>
                        </div>

                        <div className="grid grid-cols-2 md:grid-cols-4 gap-4 w-full px-2 mb-6">
                             <div className="bg-stone-900 text-white p-4 rounded-xl border border-stone-700">
                                <div className="text-3xl mb-2">🌑</div>
                                <div className="font-bold">{t.p1Name}</div>
                             </div>
                             <div className="bg-white text-stone-900 p-4 rounded-xl border border-stone-200">
                                <div className="text-3xl mb-2">🌕</div>
                                <div className="font-bold">{t.p2Name}</div>
                             </div>
                             <div className="bg-slate-900 text-amber-100 p-4 rounded-xl border border-amber-500">
                                <div className="text-3xl mb-2">🤴</div>
                                <div className="font-bold">{t.p3Name}</div>
                             </div>
                             <div className="bg-rose-50 text-rose-900 p-4 rounded-xl border border-rose-200">
                                <div className="text-3xl mb-2">👸</div>
                                <div className="font-bold">{t.p4Name}</div>
                             </div>
                        </div>

                        <div className="flex flex-col md:flex-row gap-4 w-full justify-center">
                            <button 
                                onPointerDown={() => startGame('2p')}
                                className="flex-1 py-6 bg-stone-900 hover:bg-stone-800 text-white text-2xl font-black rounded-2xl shadow-xl hover:shadow-stone-900/30 hover:scale-105 active:scale-95 transition-all flex items-center justify-center gap-3 border-b-4 border-stone-950 active:border-b-0 active:translate-y-1"
                            >
                                <span className="text-4xl">👥</span> {t.gameStart2}
                            </button>
                            <button 
                                onPointerDown={() => startGame('4p')}
                                className="flex-1 py-6 bg-amber-600 hover:bg-amber-500 text-white text-2xl font-black rounded-2xl shadow-xl hover:shadow-amber-600/30 hover:scale-105 active:scale-95 transition-all flex items-center justify-center gap-3 border-b-4 border-amber-800 active:border-b-0 active:translate-y-1"
                            >
                                <span className="text-4xl">👨‍👩‍👧‍👦</span> {t.gameStart4}
                            </button>
                        </div>
                        
                        <div className="mt-4">
                            <a 
                                href={otherGameLink} 
                                className="inline-flex items-center gap-2 text-stone-500 hover:text-stone-800 font-bold text-lg border-b-2 border-transparent hover:border-stone-800 transition-all"
                            >
                                {t.otherGames}
                            </a>
                        </div>
                        
                        <div className="mt-2">
                            <button 
                                onPointerDown={() => setSoundEnabled(!soundEnabled)}
                                className="p-4 rounded-full bg-stone-100 hover:bg-stone-200 text-stone-600 transition-colors shadow-md border border-stone-200"
                            >
                                {soundEnabled ? <IconVolume2 size={24} /> : <IconVolumeX size={24} />}
                            </button>
                        </div>
                    </div>
                </div>
            );
        }

        if (viewState === 'winner') {
            let winName, winDesc;
            if(winner === 'p1') { winName = t.p1Name; winDesc = t.p1Desc; }
            else if(winner === 'p2') { winName = t.p2Name; winDesc = t.p2Desc; }
            else if(winner === 'p3') { winName = t.p3Name; winDesc = t.p3Desc; }
            else { winName = t.p4Name; winDesc = t.p4Desc; }

            const bgClass = winner === 'p1' ? 'bg-stone-900 text-white' : 
                            winner === 'p2' ? 'bg-stone-100 text-stone-900' :
                            winner === 'p3' ? 'bg-slate-900 text-amber-100' : 'bg-rose-50 text-rose-900';

            return (
                <div className={`flex flex-col items-center justify-center h-screen font-sans p-6 overflow-hidden relative ${bgClass}`}>
                    <LanguageSwitcher />
                    <div className="absolute inset-0 opacity-20 pointer-events-none">
                        {[...Array(30)].map((_, i) => (
                            <div key={i} className="absolute text-4xl animate-pulse" style={{ left: `${Math.random()*100}%`, top: `${Math.random()*100}%`, animationDuration: `${1+Math.random()}s` }}>🎉</div>
                        ))}
                    </div>

                    <div className="p-12 rounded-[3rem] shadow-2xl text-center max-w-2xl w-full z-10 animate-in zoom-in border-4 bg-white/10 backdrop-blur-md border-current">
                        <IconTrophy className="w-32 h-32 mx-auto mb-6 drop-shadow-lg animate-bounce" />
                        
                        <h2 className="text-2xl font-bold mb-2 opacity-80">{t.winTitle}</h2>
                        <h1 className="text-6xl font-black mb-6">{winName}!</h1>
                        
                        <p className="text-xl mb-10 font-medium">
                            {t.winProof}<br/>
                            {winDesc}
                        </p>
                        
                        <div className="flex gap-4 justify-center">
                            <button 
                                onPointerDown={goHome}
                                className="px-6 py-5 text-xl font-bold rounded-2xl transition-all flex items-center justify-center gap-3 shadow-lg bg-black/20 hover:bg-black/30 text-current"
                            >
                                <IconHome /> {t.home}
                            </button>
                            <button 
                                onPointerDown={() => startGame(gameMode)}
                                className="px-8 py-5 text-xl font-bold rounded-2xl transition-all flex items-center justify-center gap-3 shadow-xl bg-current text-stone-900 hover:opacity-90 invert"
                            >
                                <IconRefreshCcw /> {t.replay}
                            </button>
                        </div>
                    </div>
                </div>
            );
        }

        if (gameMode === '4p') {
            return (
                <div className="h-screen bg-stone-200 font-sans overflow-hidden relative flex flex-col pt-10">
                    <CommonControls />
                    
                    {/* 4 Player Horizontal Layout (1 Row, 4 Columns) */}
                    <div className="w-full h-full flex flex-row">
                        {renderBoard('p1', '4p')}
                        {renderBoard('p2', '4p')}
                        {renderBoard('p3', '4p')}
                        {renderBoard('p4', '4p')}
                    </div>
                </div>
            )
        }

        // 2P Mode (Existing Layout)
        return (
            <div className="flex h-screen bg-stone-100 font-sans overflow-hidden relative">
                <CommonControls />

                {renderBoard('p1', '2p')}
                
                <div className="w-2 bg-stone-300 z-20 flex flex-col items-center justify-center relative shadow-inner">
                    <div className="absolute w-12 h-12 bg-white rounded-full flex items-center justify-center border-4 border-stone-300 shadow-lg text-stone-900 font-black text-sm z-30">
                        {t.vs}
                    </div>
                </div>
                
                {renderBoard('p2', '2p')}
            </div>
        );
    }

    const root = ReactDOM.createRoot(document.getElementById('root'));
    root.render(<App />);
</script>
</body>
</html>
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>분수 피자킹</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    
    <script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Jua&display=swap" rel="stylesheet">

    <style>
        /* 커스텀 스크롤바 숨김 */
        .scrollbar-hide::-webkit-scrollbar { display: none; }
        .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
        
        /* 배달 애니메이션 */
        @keyframes drive-delivery {
            0% { transform: translateX(-200vw) rotate(-5deg); opacity: 0; }
            20% { opacity: 1; transform: translateX(-20vw) rotate(0deg); }
            80% { opacity: 1; transform: translateX(20vw) rotate(0deg); }
            100% { transform: translateX(200vw) rotate(5deg); opacity: 0; }
        }
        .animate-drive-delivery {
            animation: drive-delivery 1.5s cubic-bezier(0.4, 0, 0.2, 1) forwards;
        }

        .flip-horizontal {
            transform: scaleX(-1);
            display: inline-block;
        }

        /* [필수 최적화 설정] 텍스트 드래그 방지, 폰트, 터치 액션 제어 */
        body { 
            user-select: none; 
            -webkit-user-select: none; 
            font-family: 'Jua', sans-serif !important;
            overscroll-behavior: none; /* 전체 화면 바운스 방지 */
            touch-action: none; /* 터치 딜레이 제거 및 스크롤/줌 방지 필수 */
            -webkit-touch-callout: none; /* 꾹 눌렀을 때 메뉴/돋보기 방지 */
        }
        
        body, button, input, textarea, select, div, span, h1, h2, h3, h4, h5, h6, a {
            font-family: 'Jua', sans-serif !important;
            -webkit-user-drag: none; /* 이미지/링크 드래그 방지 */
        }

        .text-stroke { -webkit-text-stroke: 1px rgba(0, 0, 0, 0.1); }
        .text-stroke-white { -webkit-text-stroke: 4px white; paint-order: stroke fill; }
    </style>
</head>
<body class="bg-stone-100 fixed inset-0 overflow-hidden"> <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect, useRef } = React;

        // --- 아이콘 컴포넌트 ---
        const IconShoppingCart = ({ size = 24, className }) => (
            <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className={className}><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
        );
        const IconRefreshCcw = ({ size = 24, className }) => (
            <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className={className}><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 16h5v5"/></svg>
        );
        const IconArrowRight = ({ size = 24, strokeWidth = 2, className }) => (
            <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth={strokeWidth} strokeLinecap="round" strokeLinejoin="round" className={className}><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        );
        const IconTrophy = ({ className }) => (
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className={className}><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
        );
        const IconHome = ({ size = 24, className }) => (
            <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className={className}><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        );
        const IconMaximize = ({ size = 24 }) => (
            <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3"/><path d="M21 8V5a2 2 0 0 0-2-2h-3"/><path d="M3 16v3a2 2 0 0 0 2 2h3"/><path d="M16 21h3a2 2 0 0 0 2-2v-3"/></svg>
        );
        const IconMinimize = ({ size = 24 }) => (
            <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M8 3v3a2 2 0 0 1-2 2H3"/><path d="M21 8h-3a2 2 0 0 1-2-2V3"/><path d="M3 16h3a2 2 0 0 1 2 2v3"/><path d="M16 21v-3a2 2 0 0 1 2-2h3"/></svg>
        );
        const IconVolume2 = ({ size = 24 }) => (
            <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/></svg>
        );
        const IconVolumeX = ({ size = 24 }) => (
            <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" x2="17" y1="9" y2="15"/><line x1="17" x2="23" y1="9" y2="15"/></svg>
        );
        const IconChef = ({ className }) => (
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className={className}><path d="M6 13.87A4 4 0 0 1 7.41 6a5.11 5.11 0 0 1 1.05-1.54 5 5 0 0 1 7.08 0A5.11 5.11 0 0 1 16.59 6 4 4 0 0 1 18 13.87V21H6Z"/><line x1="6" y1="17" x2="18" y2="17"/></svg>
        );

        // --- 사운드 유틸리티 ---
        const playSound = (type, freq) => {
            try {
                const AudioContext = window.AudioContext || window.webkitAudioContext;
                if (!AudioContext) return;
                
                const ctx = new AudioContext();
                const osc = ctx.createOscillator();
                const gainNode = ctx.createGain();
                
                osc.connect(gainNode);
                gainNode.connect(ctx.destination);

                const now = ctx.currentTime;

                if (type === 'pop') {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(freq || 600, now);
                    osc.frequency.exponentialRampToValueAtTime((freq || 600) / 2, now + 0.1);
                    gainNode.gain.setValueAtTime(0.3, now);
                    gainNode.gain.exponentialRampToValueAtTime(0.01, now + 0.1);
                    osc.start(now);
                    osc.stop(now + 0.1);
                } else if (type === 'start') {
                    const notes = [261.63, 329.63, 392.00, 523.25, 392.00, 523.25];
                    const times = [0, 0.1, 0.2, 0.35, 0.5, 0.65];
                    const durations = [0.1, 0.1, 0.15, 0.15, 0.15, 0.4];

                    notes.forEach((f, i) => {
                        const osc2 = ctx.createOscillator();
                        const gain2 = ctx.createGain();
                        osc2.connect(gain2);
                        gain2.connect(ctx.destination);
                        osc2.type = 'triangle';
                        osc2.frequency.setValueAtTime(f, now + times[i]);
                        gain2.gain.setValueAtTime(0.2, now + times[i]);
                        gain2.gain.exponentialRampToValueAtTime(0.01, now + times[i] + durations[i]);
                        osc2.start(now + times[i]);
                        osc2.stop(now + times[i] + durations[i]);
                    });
                } else if (type === 'success') {
                    const notes = [523.25, 659.25, 783.99, 1046.50]; 
                    notes.forEach((freq, i) => {
                        const osc2 = ctx.createOscillator();
                        const gain2 = ctx.createGain();
                        osc2.connect(gain2);
                        gain2.connect(ctx.destination);
                        osc2.type = 'square';
                        osc2.frequency.value = freq;
                        gain2.gain.setValueAtTime(0.1, now + i * 0.08);
                        gain2.gain.exponentialRampToValueAtTime(0.01, now + i * 0.08 + 0.3);
                        osc2.start(now + i * 0.08);
                        osc2.stop(now + i * 0.08 + 0.3);
                    });
                } else if (type === 'error') {
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(150, now);
                    osc.frequency.linearRampToValueAtTime(100, now + 0.3);
                    gainNode.gain.setValueAtTime(0.2, now);
                    gainNode.gain.linearRampToValueAtTime(0.01, now + 0.3);
                    osc.start(now);
                    osc.stop(now + 0.3);
                } else if (type === 'win') {
                    const notes = [523.25, 659.25, 783.99, 1046.50];
                    notes.forEach((freq, i) => {
                        const osc2 = ctx.createOscillator();
                        const gain2 = ctx.createGain();
                        osc2.connect(gain2);
                        gain2.connect(ctx.destination);
                        osc2.type = 'triangle';
                        osc2.frequency.value = freq;
                        gain2.gain.setValueAtTime(0.2, now + i * 0.15);
                        gain2.gain.exponentialRampToValueAtTime(0.01, now + i * 0.15 + 0.5);
                        osc2.start(now + i * 0.15);
                        osc2.stop(now + i * 0.15 + 0.5);
                    });
                }
            } catch (e) {
                console.error("Audio play failed", e);
            }
        };

        // --- 데이터 상수 ---
        const TOPPINGS = [
            { id: 'tomato', name: '토마토', color: '#f87171', emoji: '🍅', soundFreq: 261.63 },
            { id: 'cheese', name: '치즈', color: '#fbbf24', emoji: '🧀', soundFreq: 293.66 },
            { id: 'onion', name: '양파', color: '#f3f4f6', emoji: '🧅', soundFreq: 329.63 },
            { id: 'mushroom', name: '버섯', color: '#a8a29e', emoji: '🍄', soundFreq: 349.23 },
            { id: 'bacon', name: '베이컨', color: '#f43f5e', emoji: '🥓', soundFreq: 392.00 },
            { id: 'steak', name: '스테이크', color: '#78350f', emoji: '🥩', soundFreq: 440.00 },
        ];

        const TOTAL_SLICES = 12;
        const GOAL_SCORE = 5;

        // --- 문제 생성 함수 ---
        const gcd = (a, b) => b === 0 ? a : gcd(b, a % b);

        const generateRandomProblem = () => {
            const difficulty = Math.floor(Math.random() * 4) + 1;
            let numToppings = 2;
            if (difficulty >= 2) numToppings = 3;
            if (difficulty >= 4) numToppings = 4;

            const shuffledToppings = [...TOPPINGS].sort(() => 0.5 - Math.random());
            const selectedToppings = shuffledToppings.slice(0, numToppings);

            let remains = TOTAL_SLICES;
            let partitions = [];

            for (let i = 0; i < numToppings - 1; i++) {
                const maxTake = remains - (numToppings - 1 - i);
                let take;
                if (difficulty === 1) {
                    const candidates = [1, 2, 3, 4, 6].filter(n => n <= maxTake);
                    take = candidates[Math.floor(Math.random() * candidates.length)] || 1;
                } else {
                    take = Math.floor(Math.random() * maxTake) + 1;
                }
                partitions.push(take);
                remains -= take;
            }
            partitions.push(remains);

            const order = partitions.map((count, idx) => {
                const divisor = gcd(count, TOTAL_SLICES);
                return {
                    topping: selectedToppings[idx].id,
                    n: count / divisor,
                    d: TOTAL_SLICES / divisor,
                    originalCount: count
                };
            });

            return { difficulty, order };
        };

        const getRandomProblem = () => generateRandomProblem();

        const FractionDisplay = ({ n, d, textColor }) => (
            <div className={`inline-flex flex-col items-center align-middle mx-1 font-black text-2xl leading-none ${textColor}`} style={{ verticalAlign: 'middle' }}>
                <span className="border-b-[3px] border-current px-1 mb-0.5">{n}</span>
                <span className="px-1">{d}</span>
            </div>
        );

        const describeArc = (x, y, radius, startAngle, endAngle) => {
            const start = polarToCartesian(x, y, radius, endAngle);
            const end = polarToCartesian(x, y, radius, startAngle);
            const largeArcFlag = endAngle - startAngle <= 180 ? "0" : "1";
            return ["M", x, y, "L", start.x, start.y, "A", radius, radius, 0, largeArcFlag, 0, end.x, end.y, "Z"].join(" ");
        };

        const polarToCartesian = (centerX, centerY, radius, angleInDegrees) => {
            const angleInRadians = (angleInDegrees - 90) * Math.PI / 180.0;
            return {
                x: centerX + (radius * Math.cos(angleInRadians)),
                y: centerY + (radius * Math.sin(angleInRadians))
            };
        };

        // --- 메인 앱 컴포넌트 ---
        function App() {
            const [viewState, setViewState] = useState('start');
            const [winner, setWinner] = useState(null);
            const [soundEnabled, setSoundEnabled] = useState(true);
            const [isFullscreen, setIsFullscreen] = useState(false);

            const [p1State, setP1State] = useState({ score: 0, slices: Array(TOTAL_SLICES).fill(null), topping: TOPPINGS[0].id, problem: getRandomProblem(), message: { type: '', text: '' }, delivering: false });
            const [p2State, setP2State] = useState({ score: 0, slices: Array(TOTAL_SLICES).fill(null), topping: TOPPINGS[0].id, problem: getRandomProblem(), message: { type: '', text: '' }, delivering: false });

            const [isDragging, setIsDragging] = useState(false);
            const [dragMode, setDragMode] = useState(null);

            // [필수 최적화 설정] JS 이벤트 차단 및 글로벌 설정
            useEffect(() => {
                const handleGlobalUp = () => {
                    if(isDragging) {
                        setIsDragging(false);
                        setDragMode(null);
                    }
                };
                window.addEventListener('mouseup', handleGlobalUp);
                window.addEventListener('touchend', handleGlobalUp);

                // 우클릭 방지
                const handleContextMenu = (e) => e.preventDefault();
                window.addEventListener('contextmenu', handleContextMenu);

                // 핀치 줌 및 더블 탭 확대 방지
                const handleTouchMove = (e) => {
                    if (e.scale !== 1) e.preventDefault();
                };
                document.addEventListener('touchmove', handleTouchMove, { passive: false });
                
                // 더블 탭 방지 로직
                let lastTouchEnd = 0;
                const handleTouchEnd = (event) => {
                    const now = (new Date()).getTime();
                    if (now - lastTouchEnd <= 300) {
                        event.preventDefault();
                    }
                    lastTouchEnd = now;
                };
                document.addEventListener('touchend', handleTouchEnd, { passive: false });

                return () => {
                    window.removeEventListener('mouseup', handleGlobalUp);
                    window.removeEventListener('touchend', handleGlobalUp);
                    window.removeEventListener('contextmenu', handleContextMenu);
                    document.removeEventListener('touchmove', handleTouchMove);
                    document.removeEventListener('touchend', handleTouchEnd);
                };
            }, [isDragging]);

            useEffect(() => {
                if (p1State.score >= GOAL_SCORE) { setWinner('p1'); setViewState('winner'); if(soundEnabled) playSound('win'); }
                else if (p2State.score >= GOAL_SCORE) { setWinner('p2'); setViewState('winner'); if(soundEnabled) playSound('win'); }
            }, [p1State.score, p2State.score, soundEnabled]);

            const toggleFullscreen = () => {
                if (!document.fullscreenElement) {
                    document.documentElement.requestFullscreen().catch((e) => console.log(e));
                    setIsFullscreen(true);
                } else {
                    if (document.exitFullscreen) {
                        document.exitFullscreen();
                        setIsFullscreen(false);
                    }
                }
            };

            const goHome = () => {
                setViewState('start');
                setWinner(null);
                setP1State({ score: 0, slices: Array(TOTAL_SLICES).fill(null), topping: TOPPINGS[0].id, problem: getRandomProblem(), message: { type: '', text: '' }, delivering: false });
                setP2State({ score: 0, slices: Array(TOTAL_SLICES).fill(null), topping: TOPPINGS[0].id, problem: getRandomProblem(), message: { type: '', text: '' }, delivering: false });
            };

            const startGame = () => {
                setViewState('playing');
                setP1State({ score: 0, slices: Array(TOTAL_SLICES).fill(null), topping: TOPPINGS[0].id, problem: getRandomProblem(), message: { type: '', text: '' }, delivering: false });
                setP2State({ score: 0, slices: Array(TOTAL_SLICES).fill(null), topping: TOPPINGS[0].id, problem: getRandomProblem(), message: { type: '', text: '' }, delivering: false });
                if(soundEnabled) playSound('start');
            };

            const applySliceChange = (player, index, mode) => {
                const isP1 = player === 'p1';
                const state = isP1 ? p1State : p2State;
                const setState = isP1 ? setP1State : setP2State;
                
                if (state.delivering) return;

                const newSlices = [...state.slices];
                const targetVal = mode === 'paint' ? state.topping : null;

                // 이미 상태가 같다면 변경하지 않음 (깜빡임 방지 & 계속 닿아있을 때 유지)
                if (newSlices[index] === targetVal) return;

                newSlices[index] = targetVal;
                
                if (soundEnabled && mode === 'paint') {
                      const toppingData = TOPPINGS.find(t => t.id === state.topping);
                      playSound('pop', toppingData ? toppingData.soundFreq : 600);
                }

                setState(prev => ({ ...prev, slices: newSlices, message: { type: '', text: '' } }));
            };

            const handlePointerDown = (player, index) => {
                const state = player === 'p1' ? p1State : p2State;
                if (state.delivering) return;

                const currentTopping = state.slices[index];
                const selectedTopping = state.topping;
                
                // 터치 시작 시점의 칸 상태에 따라 모드 결정
                const mode = (currentTopping === selectedTopping) ? 'erase' : 'paint';

                setDragMode(mode);
                setIsDragging(true);
                applySliceChange(player, index, mode);
            };

            const handlePointerEnter = (player, index) => {
                if (!isDragging) return;
                applySliceChange(player, index, dragMode);
            };

            const handleTouchMove = (e, player) => {
                if (!isDragging) return;
                if(e.cancelable) e.preventDefault(); // 스크롤 방지

                const touch = e.touches[0];
                const target = document.elementFromPoint(touch.clientX, touch.clientY);
                
                if (target && target.tagName === 'path' && target.dataset.player === player) {
                    const index = parseInt(target.dataset.index, 10);
                    if (!isNaN(index)) {
                        applySliceChange(player, index, dragMode);
                    }
                }
            };

            const updateTopping = (player, toppingId) => {
                const isP1 = player === 'p1';
                const state = isP1 ? p1State : p2State;
                const setState = isP1 ? setP1State : setP2State;
                if (state.delivering) return;
                setState(prev => ({ ...prev, topping: toppingId }));
                if(soundEnabled) {
                      const toppingData = TOPPINGS.find(t => t.id === toppingId);
                      playSound('pop', toppingData ? toppingData.soundFreq : 600);
                }
            };

            const checkOrder = (player) => {
                const isP1 = player === 'p1';
                const state = isP1 ? p1State : p2State;
                const setState = isP1 ? setP1State : setP2State;

                if (state.delivering) return;

                const filledCount = state.slices.filter(s => s !== null).length;
                if (filledCount < TOTAL_SLICES) {
                    setState(prev => ({ ...prev, message: { type: 'error', text: '한 판을 꽉 채워주세요!' } }));
                    if(soundEnabled) playSound('error');
                    // 2초 후 메시지 제거
                    setTimeout(() => {
                        setState(prev => ({ ...prev, message: { type: '', text: '' } }));
                    }, 2000);
                    return;
                }

                const counts = {};
                TOPPINGS.forEach(t => counts[t.id] = 0);
                state.slices.forEach(s => { if(s) counts[s]++ });

                let isCorrect = true;
                for (const item of state.problem.order) {
                    const required = Math.round((item.n / item.d) * TOTAL_SLICES);
                    if (counts[item.topping] !== required) {
                        isCorrect = false;
                        break;
                    }
                }

                if (isCorrect) {
                    if(soundEnabled) playSound('success');
                    
                    const equationText = state.problem.order
                        .map(item => `${item.n}/${item.d}`)
                        .join(' + ') + ' = 1';

                    setState(prev => ({
                        ...prev,
                        delivering: true,
                        message: { type: 'success', text: equationText }
                    }));

                    setTimeout(() => {
                        setState(prev => ({
                            ...prev,
                            score: prev.score + 1,
                            slices: Array(TOTAL_SLICES).fill(null),
                            problem: getRandomProblem(),
                            message: { type: 'success', text: '' }, 
                            delivering: false
                        }));
                    }, 1500);

                } else {
                    if(soundEnabled) playSound('error');
                    setState(prev => ({ ...prev, message: { type: 'error', text: '비율이 맞지 않아요!' } }));
                    // 2초 후 메시지 제거
                    setTimeout(() => {
                        setState(prev => ({ ...prev, message: { type: '', text: '' } }));
                    }, 2000);
                }
            };

            const resetPlate = (player) => {
                const isP1 = player === 'p1';
                const state = isP1 ? p1State : p2State;
                const setState = isP1 ? setP1State : setP2State;
                if (state.delivering) return;
                setState(prev => ({ ...prev, slices: Array(TOTAL_SLICES).fill(null), message: { type: '', text: '' } }));
            };

            const renderBoard = (player) => {
                const isP1 = player === 'p1';
                const state = isP1 ? p1State : p2State;
                const name = isP1 ? '흑수저 피자' : '백수저 피자';
                
                const theme = isP1 ? {
                    bg: 'bg-stone-900',
                    border: 'border-stone-700',
                    headerBg: 'bg-stone-800',
                    text: 'text-stone-100',
                    accentText: 'text-yellow-500', 
                    cardBg: 'bg-stone-800',
                    cardBorder: 'border-stone-700',
                    btnBg: 'bg-stone-700',
                    btnHover: 'hover:bg-stone-600',
                    btnText: 'text-stone-100',
                    btnShadow: 'shadow-stone-950',
                    fractionText: 'text-stone-100',
                    ticketBg: 'bg-stone-700',
                    pizzaBorderColor: '#57534e',
                    strokeColor: '#57534e'
                } : {
                    bg: 'bg-white',
                    border: 'border-gray-200',
                    headerBg: 'bg-white',
                    text: 'text-gray-900',
                    accentText: 'text-yellow-600',
                    cardBg: 'bg-white',
                    cardBorder: 'border-gray-200',
                    btnBg: 'bg-white',
                    btnHover: 'hover:bg-gray-50',
                    btnText: 'text-gray-800',
                    btnShadow: 'shadow-gray-200',
                    fractionText: 'text-gray-800',
                    ticketBg: 'bg-gray-50',
                    pizzaBorderColor: '#d1d5db',
                    strokeColor: '#d1d5db'
                };

                return (
                    <div className={`flex-1 flex flex-col h-full relative ${theme.bg} border-x-4 ${theme.border} overflow-hidden transition-colors duration-300`}>
                        {state.delivering && (
                            <div className="absolute inset-0 z-50 pointer-events-none flex items-center justify-center overflow-hidden">
                                <div className="absolute animate-drive-delivery text-9xl filter drop-shadow-2xl">
                                    <div className="flip-horizontal">🛵💨🍕</div>
                                </div>
                            </div>
                        )}

                        <div className={`${theme.headerBg} py-4 px-6 shadow-md flex flex-col items-center border-b-2 ${theme.border} z-10`}>
                            <div className={`text-6xl mb-4 font-bold ${theme.text}`}>{name}</div>
                            <div className="flex gap-4 h-16 items-center">
                                {Array.from({ length: GOAL_SCORE }).map((_, i) => (
                                    <div key={i} className={`transition-all duration-500 ${i < (GOAL_SCORE - state.score) ? 'scale-100 opacity-100' : 'scale-50 opacity-20 grayscale'}`}>
                                        <span className="text-5xl drop-shadow-sm">🍕</span>
                                    </div>
                                ))}
                                <span className={`text-xl font-bold ml-4 ${isP1 ? 'text-stone-400' : 'text-gray-400'}`}>남은 배달: {GOAL_SCORE - state.score}</span>
                            </div>
                        </div>

                        <div className="flex-1 flex flex-col items-center p-2 min-h-0 overflow-y-auto scrollbar-hide">
                            <div className={`w-full max-w-[90%] rounded-2xl shadow-lg border-2 p-6 mt-6 flex flex-col items-center animate-in slide-in-from-top-4 ${theme.cardBg} ${theme.cardBorder}`}>
                                <div className={`text-lg font-bold uppercase tracking-widest mb-4 flex items-center gap-2 ${isP1 ? 'text-stone-400' : 'text-gray-400'}`}>
                                    <IconShoppingCart size={20} /> 주문서
                                </div>
                                <div className={`flex flex-nowrap overflow-x-auto scrollbar-hide justify-start lg:justify-center items-center gap-4 w-full px-2 ${theme.text}`}>
                                    {state.problem.order.map((item, idx) => {
                                        const t = TOPPINGS.find(to => to.id === item.topping);
                                        return (
                                            <div key={idx} className={`flex items-center flex-shrink-0 px-5 py-2 rounded-xl border-2 ${theme.ticketBg} ${isP1 ? 'border-stone-600' : 'border-gray-200'}`}>
                                                <span className="text-4xl mr-3">{t.emoji}</span>
                                                <FractionDisplay n={item.n} d={item.d} textColor={theme.fractionText} />
                                            </div>
                                        );
                                    })}
                                </div>
                            </div>

                            <div className="flex-1"></div>

                            {/* w-[25vw] 적용, onTouchMove 추가 */}
                            <div className={`relative w-[17vw] aspect-square mb-4 transition-transform duration-500 flex items-center justify-center shrink-0 ${state.delivering ? 'scale-0 rotate-180 opacity-0' : 'scale-100 rotate-0 opacity-100'}`}>
                                <svg 
                                    viewBox="0 0 100 100" 
                                    className="absolute inset-0 w-full h-full transform -rotate-15 drop-shadow-lg"
                                    onTouchMove={(e) => handleTouchMove(e, player)}
                                    style={{ touchAction: 'none' }}
                                >
                                    <circle cx="50" cy="50" r="48" fill={isP1 ? 'rgba(255,255,255,0.03)' : 'rgba(0,0,0,0.03)'} stroke={theme.pizzaBorderColor} strokeWidth="1.5" />
                                    {state.slices.map((tid, i) => {
                                        const start = (i * 360) / TOTAL_SLICES;
                                        const end = ((i + 1) * 360) / TOTAL_SLICES;
                                        const t = tid ? TOPPINGS.find(x => x.id === tid) : null;
                                        return (
                                            <g key={i}>
                                                <path
                                                    d={describeArc(50, 50, 48, start, end)}
                                                    fill={t ? t.color : 'transparent'} 
                                                    stroke={theme.strokeColor}
                                                    strokeWidth="0.5"
                                                    style={{ pointerEvents: 'all', cursor: 'pointer' }}
                                                    data-index={i}
                                                    data-player={player}
                                                    onPointerDown={() => handlePointerDown(player, i)}
                                                    onMouseEnter={() => handlePointerEnter(player, i)}
                                                />
                                                {t && (
                                                    <text
                                                        x={polarToCartesian(50, 50, 34, (i * 360 / TOTAL_SLICES) + (180 / TOTAL_SLICES)).x}
                                                        y={polarToCartesian(50, 50, 34, (i * 360 / TOTAL_SLICES) + (180 / TOTAL_SLICES)).y}
                                                        textAnchor="middle"
                                                        dominantBaseline="central"
                                                        fontSize="8"
                                                        pointerEvents="none"
                                                    >
                                                        {t.emoji}
                                                    </text>
                                                )}
                                            </g>
                                        );
                                    })}
                                    {Array.from({ length: TOTAL_SLICES }).map((_, i) => (
                                        <line
                                            key={`l-${i}`}
                                            x1="50" y1="50"
                                            x2={polarToCartesian(50, 50, 48, (i * 360) / TOTAL_SLICES).x}
                                            y2={polarToCartesian(50, 50, 48, (i * 360) / TOTAL_SLICES).y}
                                            stroke={theme.strokeColor}
                                            strokeWidth="0.3"
                                            pointerEvents="none"
                                        />
                                    ))}
                                </svg>
                                
                                {state.message.text && (
                                    <div className={`absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 z-50 px-8 py-6 rounded-full shadow-2xl text-center font-black text-3xl md:text-5xl animate-pulse flex items-center justify-center whitespace-nowrap border-4 ${state.message.type === 'success' ? 'bg-green-600 text-white border-green-400' : 'bg-red-600 text-white border-red-400'}`}>
                                            {state.message.text}
                                    </div>
                                )}
                            </div>
                        </div>

                        <div className={`${theme.headerBg} p-3 border-t ${theme.border} z-10 flex flex-col gap-3 shadow-[0_-5px_15px_rgba(0,0,0,0.1)] transition-opacity duration-300 ${state.delivering ? 'opacity-50 pointer-events-none' : 'opacity-100'}`}>
                            <div className="flex gap-2 w-full">
                                <button 
                                    onPointerDown={() => resetPlate(player)} 
                                    className={`flex-[1] rounded-xl font-bold text-lg shadow-lg active:translate-y-0.5 transition-all flex items-center justify-center py-3 ${isP1 ? 'bg-stone-700 text-stone-300 hover:bg-stone-600' : 'bg-gray-100 text-gray-500 hover:bg-gray-200 border-2 border-gray-200'}`}
                                >
                                    다시 만들기
                                </button>
                                <button 
                                    onPointerDown={() => checkOrder(player)} 
                                    className={`flex-[2] rounded-xl font-black text-xl shadow-lg active:translate-y-0.5 transition-all flex items-center justify-center gap-2 py-3 ${theme.btnBg} ${theme.btnText} ${theme.btnHover} ${theme.btnShadow} ${isP1 ? '' : 'border-2 border-gray-200'}`}
                                >
                                    배달하기 <IconArrowRight size={24} strokeWidth={3} />
                                </button>
                            </div>

                            <div className="grid grid-cols-6 gap-2">
                                {TOPPINGS.map((t) => (
                                    <button
                                        key={t.id}
                                        onPointerDown={() => updateTopping(player, t.id)}
                                        className={`flex flex-col items-center justify-center p-2 rounded-xl border-2 transition-all aspect-square ${
                                            state.topping === t.id
                                                ? `${isP1 ? 'border-stone-400 bg-stone-700' : 'border-gray-400 bg-gray-100'} shadow-md scale-105 ring-2 ring-offset-1 ${isP1 ? 'ring-stone-500' : 'ring-gray-300'}`
                                                : `${isP1 ? 'border-stone-800 hover:bg-stone-800' : 'border-gray-100 hover:bg-gray-50'}`
                                        }`}
                                        aria-label={t.name}
                                    >
                                        <span className="text-3xl leading-none">{t.emoji}</span>
                                    </button>
                                ))}
                            </div>
                        </div>
                    </div>
                );
            };

            if (viewState === 'start') {
                return (
                    <div className="flex flex-col items-center justify-center h-screen bg-stone-100 font-sans relative overflow-hidden">
                        <div className="absolute inset-0 flex">
                            <div className="w-1/2 h-full bg-stone-950 border-r border-stone-800"></div>
                            <div className="w-1/2 h-full bg-stone-100"></div>
                        </div>

                        {/* 플로팅 버튼 (시작 화면용) */}
                        <button 
                            onPointerDown={goHome}
                            className="fixed left-4 top-1/2 transform -translate-y-1/2 z-50 bg-white p-3 rounded-full shadow-lg text-stone-500 hover:text-stone-900 border-2 border-stone-100 transition-all"
                            title="처음으로"
                        >
                            <IconHome size={28} />
                        </button>

                        <button 
                            onPointerDown={toggleFullscreen}
                            className="fixed right-4 top-1/2 transform -translate-y-1/2 z-50 bg-white p-3 rounded-full shadow-lg text-stone-500 hover:text-stone-900 border-2 border-stone-100 transition-all"
                            title="전체화면"
                        >
                            {isFullscreen ? <IconMinimize size={28} /> : <IconMaximize size={28} />}
                        </button>

                        <div className="absolute inset-0 pointer-events-none opacity-10">
                            <div className="absolute top-10 left-10 text-stone-700 text-9xl rotate-12">🍕</div>
                            <div className="absolute bottom-10 right-10 text-stone-300 text-9xl -rotate-12">🍕</div>
                        </div>

                        <div className="relative z-10 p-10 lg:p-14 max-w-4xl w-full text-center bg-white/95 backdrop-blur-md rounded-3xl shadow-2xl border-4 border-stone-800 flex flex-col items-center justify-center gap-6">
                            
                            <a href="http://킹수학.com" target="_blank" className="inline-block px-8 py-3 bg-gradient-to-r from-amber-500 to-yellow-500 text-white rounded-full font-black text-lg hover:from-amber-600 hover:to-yellow-600 transition-all shadow-lg transform hover:-translate-y-1">
                                👑 게임으로 수학의 킹이 되어라. 킹수학.com
                            </a>
                            
                            <h1 className="text-6xl lg:text-8xl font-black tracking-tight mb-2">
                                <span className="text-stone-900 text-stroke-white drop-shadow-lg mr-2">분수</span> 
                                <span className="text-amber-500 text-stroke-white drop-shadow-lg">피자킹</span>
                            </h1>

                            <div className="bg-stone-900/90 text-white px-8 py-3 rounded-full shadow-lg mb-8">
                                <p className="text-2xl font-bold">토핑을 채워 피자를 배달해라.</p>
                            </div>

                            <div className="flex flex-col md:flex-row gap-8 mb-8 justify-center items-stretch w-full px-4">
                                <div className="bg-stone-900 text-stone-100 p-8 rounded-3xl flex-1 border-2 border-stone-700 shadow-xl transform hover:scale-105 transition-transform group">
                                    <div className="text-6xl mb-4 group-hover:scale-110 transition-transform">🌑</div>
                                    <h3 className="font-bold text-3xl mb-2">흑수저 피자</h3>
                                    <div className="w-12 h-1 bg-stone-700 mx-auto mb-4"></div>
                                    <p className="text-lg text-stone-400 font-medium">어둠의 실력자</p>
                                </div>

                                <div className="flex items-center justify-center relative px-2">
                                    <div className="bg-amber-500 text-white font-black text-3xl w-20 h-20 rounded-full flex items-center justify-center shadow-xl border-4 border-white z-10">
                                        VS
                                    </div>
                                </div>

                                <div className="bg-white text-stone-900 p-8 rounded-3xl flex-1 border-2 border-stone-200 shadow-xl transform hover:scale-105 transition-transform group">
                                    <div className="text-6xl mb-4 group-hover:scale-110 transition-transform">🌕</div>
                                    <h3 className="font-bold text-3xl mb-2">백수저 피자</h3>
                                    <div className="w-12 h-1 bg-stone-200 mx-auto mb-4"></div>
                                    <p className="text-lg text-stone-500 font-medium">전통의 강호</p>
                                </div>
                            </div>

                            <div className="flex items-center justify-center gap-6 mt-4">
                                <button 
                                    onPointerDown={() => setSoundEnabled(!soundEnabled)}
                                    className="p-5 rounded-full bg-stone-100 hover:bg-stone-200 text-stone-600 transition-colors shadow-md border border-stone-200"
                                    title="소리 켜기/끄기"
                                >
                                    {soundEnabled ? <IconVolume2 size={28} /> : <IconVolumeX size={28} />}
                                </button>

                                <button 
                                    onPointerDown={startGame}
                                    className="px-16 py-5 bg-stone-900 hover:bg-stone-800 text-white text-3xl font-black rounded-2xl shadow-xl hover:shadow-stone-900/30 hover:scale-105 active:scale-95 transition-all flex items-center gap-4 border-b-4 border-stone-950 active:border-b-0 active:translate-y-1"
                                >
                                    <IconChef /> 대결 시작
                                </button>
                            </div>

                            {/* 요청사항: 다른 게임 고르기 링크 추가 (현재창) */}
                            <a href="http://킹수학.com" className="text-stone-400 font-bold underline mt-6 text-lg hover:text-stone-600 transition-colors">
                                🎮 다른 게임 고르기
                            </a>

                        </div>
                    </div>
                );
            }

            if (viewState === 'winner') {
                return (
                    <div className={`flex flex-col items-center justify-center h-screen font-sans p-6 overflow-hidden relative ${winner === 'p1' ? 'bg-stone-900 text-white' : 'bg-stone-100 text-stone-900'}`}>
                        <div className="absolute inset-0 opacity-20 pointer-events-none">
                            {[...Array(30)].map((_, i) => (
                                <div key={i} className="absolute text-4xl animate-pulse" style={{ left: `${Math.random()*100}%`, top: `${Math.random()*100}%`, animationDuration: `${1+Math.random()}s` }}>🎉</div>
                            ))}
                        </div>

                        <div className={`p-12 rounded-[3rem] shadow-2xl text-center max-w-2xl w-full z-10 animate-in zoom-in border-4 ${winner === 'p1' ? 'bg-stone-800 border-stone-600' : 'bg-white border-white'}`}>
                            <IconTrophy className={`w-32 h-32 mx-auto mb-6 ${winner === 'p1' ? 'text-yellow-500' : 'text-yellow-600'} drop-shadow-lg animate-bounce`} />
                            
                            <h2 className={`text-2xl font-bold mb-2 ${winner === 'p1' ? 'text-stone-400' : 'text-stone-500'}`}>최종 우승</h2>
                            <h1 className="text-6xl font-black mb-6">
                                {winner === 'p1' ? '흑수저 피자' : '백수저 피자'}!
                            </h1>
                            
                            <p className={`text-xl mb-10 font-medium ${winner === 'p1' ? 'text-stone-300' : 'text-stone-600'}`}>
                                최고의 분수 요리 실력을 증명했습니다.<br/>
                                {winner === 'p1' ? '어둠 속에서 빛나는 맛!' : '클래스는 영원하다!'}
                            </p>
                            
                            <div className="flex gap-4 justify-center">
                                <button 
                                    onPointerDown={goHome}
                                    className={`px-6 py-5 text-xl font-bold rounded-2xl transition-all flex items-center justify-center gap-3 shadow-lg ${winner === 'p1' ? 'bg-stone-700 text-white hover:bg-stone-600' : 'bg-gray-200 text-gray-700 hover:bg-gray-300'}`}
                                >
                                    <IconHome /> 홈으로
                                </button>
                                <button 
                                    onPointerDown={startGame}
                                    className={`px-8 py-5 text-xl font-bold rounded-2xl transition-all flex items-center justify-center gap-3 shadow-xl ${winner === 'p1' ? 'bg-white text-stone-900 hover:bg-gray-200' : 'bg-stone-900 text-white hover:bg-stone-800'}`}
                                >
                                    <IconRefreshCcw /> 다시 대결하기
                                </button>
                            </div>
                        </div>
                    </div>
                );
            }

            return (
                <div className="flex h-screen bg-stone-100 font-sans overflow-hidden relative">
                    <button 
                        onPointerDown={goHome}
                        className="fixed left-4 top-1/2 transform -translate-y-1/2 z-50 bg-white p-3 rounded-full shadow-lg text-stone-500 hover:text-stone-900 border-2 border-stone-100 transition-all"
                        title="처음으로"
                    >
                        <IconHome size={28} />
                    </button>

                    <button 
                        onPointerDown={toggleFullscreen}
                        className="fixed right-4 top-1/2 transform -translate-y-1/2 z-50 bg-white p-3 rounded-full shadow-lg text-stone-500 hover:text-stone-900 border-2 border-stone-100 transition-all"
                        title="전체화면"
                    >
                        {isFullscreen ? <IconMinimize size={28} /> : <IconMaximize size={28} />}
                    </button>

                    {renderBoard('p1')}
                    
                    <div className="w-2 bg-stone-300 z-20 flex flex-col items-center justify-center relative shadow-inner">
                        <div className="absolute w-12 h-12 bg-white rounded-full flex items-center justify-center border-4 border-stone-300 shadow-lg text-stone-900 font-black text-sm z-30">
                            VS
                        </div>
                    </div>
                    
                    {renderBoard('p2')}

                    <button 
                        onPointerDown={() => setSoundEnabled(!soundEnabled)}
                        className="fixed bottom-4 left-1/2 transform -translate-x-1/2 z-50 bg-stone-900 text-white p-2 rounded-full opacity-50 hover:opacity-100 transition-opacity"
                    >
                        {soundEnabled ? <IconVolume2 size={16}/> : <IconVolumeX size={16}/>}
                    </button>
                </div>
            );
        }

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>


</body>
</html>
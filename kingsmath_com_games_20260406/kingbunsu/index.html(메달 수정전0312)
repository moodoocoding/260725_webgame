function createKeypad(id) {
    const pad = document.getElementById(`pad_${id}`);
    const txt = I18N[currentLang].placeholders;
    pad.innerHTML = [1,2,3,4,5,6,7,8,9].map(n => `<div class="key-mini" onpointerdown="numInput('${id}','${n}')">${n}</div>`).join('') +
    `<div class="key-mini key-clear" onpointerdown="resetInput('${id}')">${txt.clear}</div>
     <div class="key-mini" onpointerdown="numInput('${id}','0')">0</div>
     <div class="key-mini key-next" onpointerdown="nextSlot('${id}')">${txt.next}</div>
     <div class="key-mini key-submit" onpointerdown="submitAns('${id}')">${txt.submit}</div>`;
}

function setSlot(id, slot) {
    state[id].slot = slot;
    const el = document.querySelector(`#disp_${id}`);
    el.querySelectorAll('.slot').forEach(s => s.classList.remove('active'));
    document.getElementById(`slot_${slot==='integer'?'int':(slot==='numerator'?'num':'den')}_${id}`).classList.add('active');
}
function nextSlot(id) {
    const order = ['integer', 'denominator', 'numerator'];
    const next = order[(order.indexOf(state[id].slot)+1)%3];
    setSlot(id, next);
}
function numInput(id, val) {
    if(state.isGameOver || state.isCounting) return;
    const t = state[id];
    const s = t.slot === 'integer' ? 'int' : (t.slot === 'numerator' ? 'num' : 'den');
    if(t[s].length >= 3) return;
    if(t[s] === '0') t[s] = val; else t[s] += val;
    updateDisplay(id);
}
function delInput(id) {
    const t = state[id];
    const s = t.slot === 'integer' ? 'int' : (t.slot === 'numerator' ? 'num' : 'den');
    t[s] = t[s].slice(0,-1);
    updateDisplay(id);
}
function resetInput(id) {
    state[id].int=''; state[id].num=''; state[id].den=''; state[id].slot='integer';
    const disp = document.getElementById(`disp_${id}`);
    if(disp) updateDisplay(id);
}
function updateDisplay(id) {
    const t = state[id];
    const txt = I18N[currentLang].placeholders;
    document.getElementById(`slot_int_${id}`).innerHTML = t.int?t.int:`<span class="slot-placeholder">${txt.int}</span>`;
    document.getElementById(`slot_num_${id}`).innerHTML = t.num?t.num:`<span class="slot-placeholder">${txt.num}</span>`;
    document.getElementById(`slot_den_${id}`).innerHTML = t.den?t.den:`<span class="slot-placeholder">${txt.den}</span>`;
}

function nextProblem(id) {
    const p = generateProblem(state.currentTabId, state.levelIdx);
    state[id].q = p;
    document.getElementById(`prob_${id}`).innerHTML = renderMathString(p.q);
}

function showCombo(id, cnt, isSuper) {
    const box = document.getElementById(id+'Side');
    const el = document.createElement('div'); el.className = 'combo-text'; 
    el.innerHTML = isSuper ? `🔥SUPER<br>COMBO! +3` : `⚡ ${cnt} COMBO`;
    box.appendChild(el); setTimeout(()=>el.remove(), 800);
}

function spawnItem(team, isGold) {
    const parent = document.getElementById(team + 'Side');
    const itemEl = document.createElement('div'); itemEl.className = 'item-effect';
    itemEl.textContent = isGold ? '🥇' : state[team].item;
    itemEl.style.cssText = "position:absolute; bottom:-50px; font-size:4rem; pointer-events:none; z-index:50; animation:itemFlyUp 1.8s ease-in forwards; left:" + (Math.random()*70+10) + "%;";
    if(!document.getElementById('keyframeFlyUp')){
        const styleSheet = document.createElement("style"); styleSheet.id='keyframeFlyUp';
        styleSheet.innerText = "@keyframes itemFlyUp { 0% { transform: translateY(0) scale(0.6); opacity:0; } 20% { opacity:0.8; } 100% { transform: translateY(-700px) scale(2.8); opacity:0; } }";
        document.head.appendChild(styleSheet);
    }
    parent.appendChild(itemEl); setTimeout(() => itemEl.remove(), 1875);
}

function submitAns(id) {
    if(state.isGameOver || state.isCounting) return;
    const t = state[id];
    const i = parseInt(t.int)||0, n = parseInt(t.num)||0, d = parseInt(t.den)||1;
    let userVal = (t.num==='' && t.den==='') ? i : i + (n/d);
    
    let currentMax = 0;
    const activeTeams = playerIds.map(pid => state[pid]).filter(tm => tm.active);
    currentMax = Math.max(...activeTeams.map(tm => tm.score));

    if(Math.abs(userVal - t.q.val) < 0.000001) {
        playSuccess(); t.combo++;
        let pts = 1;
        if(t.combo % 5 === 0) { pts += 2; showCombo(id, t.combo, true); } 
        else if(t.combo > 1) { showCombo(id, t.combo, false); }
        t.score += pts;
        
        let becomeFirst = (t.score >= currentMax && currentMax > 0);
        spawnItem(id, becomeFirst);
        
        resetInput(id); 
        nextProblem(id); 
        setSlot(id, 'integer');
        updateRanks(); 
        renderScores();
    } else {
        playFail(); t.combo = 0;
        const disp = document.getElementById(`disp_${id}`);
        disp.classList.add('wrong'); setTimeout(()=>disp.classList.remove('wrong'),300);
        if(t.score > 0) t.score--;
        resetInput(id); 
        updateRanks(); 
        renderScores();
    }
}

async function startCountdown() {
    state.isCounting = true;
    const layer = document.getElementById('countdownLayer');
    const txt = document.getElementById('countdownText');
    layer.style.display = 'flex';
    const counts = ['3', '2', '1', I18N[currentLang].msgStart];
    
    for(let i=0; i<counts.length; i++) {
        if(state.isGameOver) { layer.style.display='none'; state.isCounting=false; return; }
        txt.innerText = counts[i];
        playBeep(i===3?880:440, i===3?0.4:0.2);
        txt.style.animation = 'none'; txt.offsetHeight; txt.style.animation = 'countAnim 1s ease-out forwards';
        await new Promise(r=>setTimeout(r,1000));
    }
    layer.style.display = 'none'; state.isCounting = false;
}

function startTimer() {
    clearInterval(state.timerInterval);
    state.timerInterval = setInterval(() => {
        state.timeLeft--;
        const td = document.getElementById('timerDisplay');
        td.innerText = state.timeLeft;
        if(state.timeLeft <= 5 && state.timeLeft > 0) { playBeep(900,0.1); td.classList.add('timer-urgent'); }
        else td.classList.remove('timer-urgent');
        
        if(state.timeLeft <= 0) endGame();
    }, 1000);
}

function updateRanks() {
    if (state.teamModeType !== 'none') {
        let scores = [];
        if (state.teamModeType === '2vs2') { scores.push({ id:'A', val: state.dog.score + state.cat.score }); scores.push({ id:'B', val: state.rabbit.score + state.hamster.score }); } 
        else if (state.teamModeType === '3vs3') { scores.push({ id:'A', val: state.dog.score + state.cat.score + state.rabbit.score }); scores.push({ id:'B', val: state.hamster.score + state.panda.score + state.monkey.score }); } 
        else if (state.teamModeType === '2vs2vs2') { scores.push({ id:'A', val: state.dog.score + state.cat.score }); scores.push({ id:'B', val: state.rabbit.score + state.hamster.score }); scores.push({ id:'C', val: state.panda.score + state.monkey.score }); }
        scores.sort((a,b) => b.val - a.val);
        let currentRank = 1;
        for(let i=0; i<scores.length; i++) { 
            if(i > 0 && scores[i].val < scores[i-1].val) { currentRank = i + 1; } 
            const rankEl = document.getElementById('rank' + scores[i].id); 
            if(rankEl) { 
                rankEl.textContent = currentRank + "st"; rankEl.classList.remove('rank-1'); 
                if(currentRank === 1) rankEl.classList.add('rank-1'); 
            } 
        }
    } else {
        const active = playerIds.map(id=>state[id]).filter(t=>t.active);
        const scores = active.map(t=>t.score).sort((a,b)=>b-a);
        active.forEach(t => {
            const rank = scores.indexOf(t.score) + 1;
            const badge = document.getElementById(`rank_${t.id}`);
            if(badge) {
                badge.textContent = rank+"st";
                badge.classList.remove('rank-1'); if(rank===1) badge.classList.add('rank-1');
            }
        });
    }
}

function renderScores() {
    if(state.teamModeType !== 'none') {
        let sa=0, sb=0, sc=0;
        if(state.teamModeType.includes('2vs2')) { sa=state.dog.score+state.cat.score; sb=state.rabbit.score+state.hamster.score; }
        if(state.teamModeType === '3vs3') { sa=state.dog.score+state.cat.score+state.rabbit.score; sb=state.hamster.score+state.panda.score+state.monkey.score; }
        if(state.teamModeType === '2vs2vs2') sc=state.panda.score+state.monkey.score;
        document.getElementById('scoreA').innerText = sa;
        document.getElementById('scoreB').innerText = sb;
        if(state.teamModeType==='2vs2vs2') document.getElementById('scoreC').innerText = sc;
    }
    playerIds.forEach(id => {
        const t = state[id];
        if(t.active) {
            const el = document.getElementById(`score_${id}`);
            if(el && state.teamModeType === 'none') el.innerText = `${t.item} ${t.score}`;
        }
    });
}

function getRankSymbol(rank) { const symbols = ['🥇', '🥈', '🥉', '4️⃣', '5️⃣', '6️⃣']; return symbols[rank-1] || rank; }

function endGame() {
    state.isGameOver = true; clearInterval(state.timerInterval); playVictorySound();
    
    document.getElementById('setupArea').style.display = 'none';
    document.querySelector('.math-menu-wrapper').style.display = 'none';
    document.getElementById('overlay').style.display = 'flex';
    document.getElementById('msgTitle').innerText = I18N[currentLang].msgGameOver;

    const resultList = document.getElementById('resultList');
    const podium = document.getElementById('finalPodium');
    resultList.innerHTML = ''; podium.innerHTML = ''; podium.style.display = 'flex';
    resultList.style.display = 'block';

    const t = I18N[currentLang].teamNames;
    if (state.teamModeType !== 'none') {
        let teams = [];
        if (state.teamModeType === '2vs2') { teams = [ { name: t.teamA_2, score: state.dog.score + state.cat.score, ids: ['dog','cat'], class: 'bg-dog' }, { name: t.teamB_2, score: state.rabbit.score + state.hamster.score, ids: ['rabbit','hamster'], class: 'bg-rabbit' } ]; } 
        else if (state.teamModeType === '3vs3') { teams = [ { name: t.teamA_3, score: state.dog.score + state.cat.score + state.rabbit.score, ids: ['dog','cat','rabbit'], class: 'bg-dog' }, { name: t.teamB_3, score: state.hamster.score + state.panda.score + state.monkey.score, ids: ['hamster','panda','monkey'], class: 'bg-hamster' } ]; } 
        else if (state.teamModeType === '2vs2vs2') { teams = [ { name: t.teamA_222, score: state.dog.score + state.cat.score, ids: ['dog','cat'], class: 'bg-dog' }, { name: t.teamB_222, score: state.rabbit.score + state.hamster.score, ids: ['rabbit','hamster'], class: 'bg-rabbit' }, { name: t.teamC_222, score: state.panda.score + state.monkey.score, ids: ['panda','monkey'], class: 'bg-panda' } ]; }
        teams.sort((a,b) => b.score - a.score);
        let currentRank = 1; for(let i=0; i<teams.length; i++){ if(i>0 && teams[i].score < teams[i-1].score) currentRank = i+1; teams[i].rank = currentRank; }
        
        teams.forEach(t => { const li = document.createElement('li'); if(t.rank === 1) li.className = 'gold'; const symbol = getRankSymbol(t.rank); li.innerHTML = `<div class="result-name"><span>${symbol}</span><span>${t.name}</span></div><div class="result-score">Total ${t.score}</div>`; resultList.appendChild(li); });
        
        playerIds.forEach(id => { if(state[id].active) { const myTeam = teams.find(t => t.ids.includes(id)); const rank = myTeam ? myTeam.rank : 6; const tInfo = state[id]; const col = document.createElement('div'); col.className = `podium-col ${tInfo.colorClass}`; col.innerHTML = ` <div class="podium-medal">${getRankSymbol(rank)}</div> <div class="podium-name">${tInfo.emoji}</div> `; podium.appendChild(col); } });
    } else {
        const active = playerIds.map(id=>state[id]).filter(t=>t.active);
        const scores = active.map(t=>t.score).sort((a,b)=>b-a);
        const sortedTeams = [...active].sort((a,b)=>b.score - a.score);
        
        sortedTeams.forEach(t => {
            const li = document.createElement('li');
            const rank = scores.indexOf(t.score) + 1;
            if(rank === 1) li.className = 'gold';
            li.innerHTML = `<div class="result-name"><span>${getRankSymbol(rank)}</span><span>${I18N[currentLang].teamNames[t.id]}</span></div><div class="result-score">${t.item} ${t.score}</div>`;
            resultList.appendChild(li);
        });
        
        active.forEach(t => {
            const rank = scores.indexOf(t.score) + 1;
            const col = document.createElement('div');
            col.className = `podium-col ${t.colorClass}`;
            col.innerHTML = ` <div class="podium-medal">${getRankSymbol(rank)}</div> <div class="podium-name">${t.emoji}</div> `;
            podium.appendChild(col);
        });
    }

    const startBtn = document.getElementById('startBtn');
    startBtn.innerText = I18N[currentLang].btnRestart;
    startBtn.onclick = () => window.location.reload();
}

function toggleFullScreen() {
    if (!document.fullscreenElement) document.documentElement.requestFullscreen(); else document.exitFullscreen();
}

document.getElementById('startBtn').onpointerdown = (e) => { e.preventDefault(); prepareGame(); };
document.getElementById('resetBtn').onpointerdown = (e) => { e.preventDefault(); window.location.reload(); };
document.getElementById('gameFsBtn').onpointerdown = (e) => { e.preventDefault(); toggleFullScreen(); };
document.getElementById('mobileTitleFsBtn').onpointerdown = (e) => { e.preventDefault(); toggleFullScreen(); };
document.getElementById('headerFsBtn').onpointerdown = (e) => { e.preventDefault(); toggleFullScreen(); };
document.getElementById('headerHomeBtn').onpointerdown = (e) => { e.preventDefault(); window.location.reload(); };

const pcSelect = document.getElementById('playerCount');
if (window.innerWidth <= 768) pcSelect.value = "1"; else pcSelect.value = "4";

// 언어 목록 초기화 렌더링
renderLanguages();

// 초기 실행 (감지 우선순위)
applyLanguage(detectLanguage());

document.addEventListener('touchmove', function(e) { if (e.scale !== 1) { e.preventDefault(); } }, { passive: false });
document.addEventListener('gesturestart', function(e) { e.preventDefault(); });
document.addEventListener('contextmenu', e => e.preventDefault());

</script>
</body>
</html>
                            <div class="slot integer active" id="slot_int_${id}" onpointerdown="setSlot('${id}','integer')"><span class="slot-placeholder">${txt.int}</span></div>
                            <div class="fraction-part">
                                <div class="slot numerator" id="slot_num_${id}" onpointerdown="setSlot('${id}','numerator')"><span class="slot-placeholder">${txt.num}</span></div>

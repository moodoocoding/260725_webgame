const rand = (min, max) => Math.floor(Math.random() * (max - min + 1)) + min;
function generateProblem(type, lv) {
    let eq = "", ansVal = 0;
    let n1, d1, i1, n2, d2, i2;
    if (type === 'add') {
        if (lv === 5) return generateProblem('add', rand(0, 4));
        if (lv === 0) { d1=rand(4,12); n1=rand(1,d1-2); n2=rand(1,d1-n1); if(n2<1)n2=1; eq=`${n1}/${d1} + ${n2}/${d1}`; ansVal=(n1+n2)/d1; }
        else if (lv === 1) { d1=rand(4,9); i1=rand(1,3); n1=rand(1,Math.floor(d1/2)); i2=rand(1,3); n2=rand(1,Math.floor(d1/2)); eq=`${i1} ${n1}/${d1} + ${i2} ${n2}/${d1}`; ansVal=i1+i2+(n1+n2)/d1; }
        else if (lv === 2) { d1=rand(4,9); i1=rand(1,3); n1=rand(Math.ceil(d1/2),d1-1); i2=rand(1,3); n2=rand(Math.ceil(d1/2),d1-1); eq=`${i1} ${n1}/${d1} + ${i2} ${n2}/${d1}`; ansVal=i1+i2+(n1+n2)/d1; }
        else if (lv === 3) { d1=rand(2,6); d2=rand(2,6); if(d1===d2)d2++; n1=rand(1,d1-1); n2=rand(1,d2-1); eq=`${n1}/${d1} + ${n2}/${d2}`; ansVal=(n1/d1)+(n2/d2); }
        else if (lv === 4) { d1=rand(2,5); d2=rand(2,5); if(d1===d2)d2++; i1=rand(1,2); n1=rand(1,d1-1); i2=rand(0,2); n2=rand(1,d2-1); if(i2===0) eq=`${i1} ${n1}/${d1} + ${n2}/${d2}`; else eq=`${i1} ${n1}/${d1} + ${i2} ${n2}/${d2}`; ansVal=i1+(n1/d1)+i2+(n2/d2); }
    } else if (type === 'sub') {
        if (lv === 6) return generateProblem('sub', rand(0, 5));
        if (lv === 0) { d1=rand(5,12); n1=rand(2,d1-1); n2=rand(1,n1-1); eq=`${n1}/${d1} - ${n2}/${d1}`; ansVal=(n1-n2)/d1; }
        else if (lv === 1) { i1=rand(2,9); d1=rand(3,9); n1=rand(1,d1-1); eq=`${i1} - ${n1}/${d1}`; ansVal=i1-(n1/d1); }
        else if (lv === 2) { d1=rand(4,9); i1=rand(2,5); n1=rand(2,d1-1); i2=rand(1,i1-1); n2=rand(1,n1-1); eq=`${i1} ${n1}/${d1} - ${i2} ${n2}/${d1}`; ansVal=(i1+n1/d1)-(i2+n2/d1); }
        else if (lv === 3) { d1=rand(4,9); i1=rand(2,5); n1=rand(1,Math.floor(d1/3)+1); i2=rand(1,i1-1); n2=rand(n1+1,d1-1); eq=`${i1} ${n1}/${d1} - ${i2} ${n2}/${d1}`; ansVal=(i1+n1/d1)-(i2+n2/d1); }
        else if (lv === 4) { d1=rand(2,5); d2=rand(2,5); if(d1===d2)d2++; n1=rand(1,d1-1); n2=rand(1,d2-1); if(n1/d1<n2/d2){let t=n1;n1=n2;n2=t;t=d1;d1=d2;d2=t;} if(n1/d1===n2/d2)n1++; eq=`${n1}/${d1} - ${n2}/${d2}`; ansVal=(n1/d1)-(n2/d2); }
        else if (lv === 5) { d1=rand(2,5); d2=rand(2,5); if(d1===d2)d2++; i1=rand(2,4); n1=rand(1,d1-1); i2=rand(1,i1-1); n2=rand(1,d2-1); if(Math.random()<0.5){eq=`${i1} ${n1}/${d1} - ${n2}/${d2}`; ansVal=(i1+n1/d1)-(n2/d2);}else{eq=`${i1} ${n1}/${d1} - ${i2} ${n2}/${d2}`; ansVal=(i1+n1/d1)-(i2+n2/d2);} }
    } else if (type === 'mul') {
        if (lv === 3) return generateProblem('mul', rand(0, 2));
        if (lv === 0) { d1=rand(3,9); n1=rand(1,d1-1); i2=rand(2,6); eq=`${n1}/${d1} × ${i2}`; ansVal=(n1*i2)/d1; }
        else if (lv === 1) { d1=rand(2,8); d2=rand(2,8); eq=`1/${d1} × 1/${d2}`; ansVal=1/(d1*d2); }
        else if (lv === 2) { d1=rand(3,8); n1=rand(2,d1-1); d2=rand(3,8); n2=rand(2,d2-1); eq=`${n1}/${d1} × ${n2}/${d2}`; ansVal=(n1*n2)/(d1*d2); }
    } else { // div
        if (lv === 5) return generateProblem('div', rand(0, 4));
        if (lv === 0) { n1=rand(1,8); d1=rand(n1+1,9); eq=`${n1} ÷ ${d1}`; ansVal=n1/d1; }
        else if (lv === 1) { d1=rand(3,9); i2=rand(2,4); n1=i2*rand(1,3); if(n1>=d1)n1=i2; eq=`${n1}/${d1} ÷ ${i2}`; ansVal=(n1/d1)/i2; }
        else if (lv === 2) { d1=rand(3,7); n1=rand(1,d1-1); i2=rand(2,5); while(n1%i2===0){n1=rand(1,d1-1);} eq=`${n1}/${d1} ÷ ${i2}`; ansVal=(n1/d1)/i2; }
        else if (lv === 3) { d1=rand(5,13); n1=rand(3,d1-1); n2=rand(1,n1-1); eq=`${n1}/${d1} ÷ ${n2}/${d1}`; ansVal=n1/n2; }
        else if (lv === 4) { d1=rand(3,6); n1=rand(1,d1-1); d2=rand(3,6); n2=rand(1,d2-1); eq=`${n1}/${d1} ÷ ${n2}/${d2}`; ansVal=(n1/d1)/(n2/d2); }
    }
    return { q: eq, val: ansVal };
}

function renderMathString(text) {
    const parts = text.split(/([+\-×÷])/);
    return parts.map(part => {
        part = part.trim();
        if (part.match(/[+\-×÷]/)) return `<span class="math-op">${part}</span>`;
        if (part.includes('/')) {
            const mixedMatch = part.match(/^(\d+)\s+(\d+)\/(\d+)$/);
            if (mixedMatch) return `<div class="frac"><span class="frac-whole">${mixedMatch[1]}</span></div><div class="frac"><span class="frac-top">${mixedMatch[2]}</span><span class="frac-bot">${mixedMatch[3]}</span></div>`;
            const fracMatch = part.match(/^(\d+)\/(\d+)$/);
            if (fracMatch) return `<div class="frac"><span class="frac-top">${fracMatch[1]}</span><span class="frac-bot">${fracMatch[2]}</span></div>`;
        }
        return `<span style="font-size:1.2em; margin:0 2px;">${part}</span>`;
    }).join('');
}

const AudioContext = window.AudioContext || window.webkitAudioContext;
let audioCtx;
function initAudio() { if (!audioCtx) audioCtx = new AudioContext(); }
function playBeep(f,d,t='sine'){if(!audioCtx)return;const o=audioCtx.createOscillator();const g=audioCtx.createGain();o.type=t;o.frequency.setValueAtTime(f,audioCtx.currentTime);g.gain.setValueAtTime(0.3,audioCtx.currentTime);o.connect(g);g.connect(audioCtx.destination);o.start();g.gain.exponentialRampToValueAtTime(0.001,audioCtx.currentTime+d);o.stop(audioCtx.currentTime+d);}
function playSuccess(){if(!audioCtx)return;[523,659,784].forEach((f,i)=>{playBeep(f,0.2,'sine')});}
function playFail(){if(!audioCtx)return;[392,349,311].forEach((f,i)=>{playBeep(f,0.2,'sawtooth')});}
function playVictorySound() { if(!audioCtx) return; const notes = [523.25, 659.25, 783.99, 1046.50, 1318.51]; notes.forEach((f, i) => { const osc = audioCtx.createOscillator(); const g = audioCtx.createGain(); const startTime = audioCtx.currentTime + (i * 0.12); osc.type = (i === notes.length - 1) ? 'square' : 'triangle'; osc.frequency.setValueAtTime(f, startTime); g.gain.setValueAtTime(0.4, startTime); g.gain.exponentialRampToValueAtTime(0.0001, startTime + 0.6); osc.connect(g); g.connect(audioCtx.destination); osc.start(startTime); osc.stop(startTime + 0.6); }); }


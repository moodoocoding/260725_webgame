// 글자 수 기반 동적 폰트 리사이징 로직
function autoResizeText(element, minSize=20, maxSize=57) {
    if(!element) return;
    let fontSize = maxSize;
    element.style.fontSize = fontSize + 'px';
    while(element.scrollWidth > element.clientWidth && fontSize > minSize) {
        fontSize--;
        element.style.fontSize = fontSize + 'px';
    }
}

// UI 텍스트 업데이트
function updateModalUIText(langCode) {
    const t = uiTranslations[langCode] || uiTranslations['en'];
    document.getElementById('ui-title').textContent = t.title;
    document.getElementById('ui-desc').textContent = t.desc;
    document.getElementById('searchInput').placeholder = t.search;
    document.getElementById('ui-empty').textContent = t.empty;
    document.getElementById('ui-toast').textContent = t.toast;
}

// 언어 목록 렌더링
function renderLanguages(filterText = '') {
    grid.innerHTML = '';
    const lowerFilter = filterText.toLowerCase();
    const filteredLangs = languages.filter(lang => 
        lang.name.toLowerCase().includes(lowerFilter) || 
        lang.enName.toLowerCase().includes(lowerFilter) ||
        lang.code.toLowerCase().includes(lowerFilter)
    );

    if (filteredLangs.length === 0) {
        grid.classList.add('hidden');
        noResult.classList.remove('hidden'); noResult.classList.add('flex');
    } else {
        grid.classList.remove('hidden');
        noResult.classList.add('hidden'); noResult.classList.remove('flex');

        filteredLangs.forEach(lang => {
            const isSelected = lang.code === currentLang;
            const baseClasses = "flex items-center gap-3 p-3 rounded-xl border cursor-pointer transition-all duration-200 group relative overflow-hidden";
            const stateClasses = isSelected ? "bg-gray-800 border-yellow-500 ring-1 ring-yellow-500/50" : "bg-gray-800/40 border-gray-700 hover:bg-gray-700 hover:border-gray-500";
            const flagUrl = `https://flagcdn.com/w40/${lang.country}.png`;

            const btn = document.createElement('div');
            btn.className = `${baseClasses} ${stateClasses}`;
            btn.innerHTML = `
                <div class="shrink-0 w-8 h-6 rounded overflow-hidden shadow-sm border border-gray-700/50">
                    <img src="${flagUrl}" alt="${lang.country}" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300">
                </div>
                <div class="flex-1 min-w-0 flex flex-col items-start">
                    <span class="text-sm font-medium text-white truncate w-full ${isSelected ? 'text-yellow-400' : ''}" style="margin:0;line-height:1.2;">${lang.name}</span>
                    <span class="text-xs text-gray-400 truncate w-full" style="margin:0;line-height:1.2;">${lang.enName}</span>
                </div>
                ${isSelected ? '<i class="fa-solid fa-circle-check text-yellow-500 text-lg ml-2"></i>' : ''}
            `;
            btn.addEventListener('click', () => { selectLanguage(lang); });
            grid.appendChild(btn);
        });
    }
}

// 언어 선택 모달 액션
function selectLanguage(lang) {
    closeModal();
    applyLanguage(lang.code);
    showToast(lang.name);
    setTimeout(() => renderLanguages(searchInput.value), 300);
}

// 모달 제어
function openModal() {
    langModal.classList.add('active');
    setTimeout(() => searchInput.focus(), 100);
}
function closeModal() {
    langModal.classList.remove('active');
}
function showToast(langName) {
    toastLangName.textContent = langName;
    toast.classList.add('show');
    clearTimeout(toastTimeout);
    toastTimeout = setTimeout(() => toast.classList.remove('show'), 3000);
}

// 이벤트 리스너 등록
triggerBtn.addEventListener('click', openModal);
closeBtn.addEventListener('click', closeModal);
langModal.addEventListener('click', (e) => { if (e.target === langModal) closeModal(); });
document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && langModal.classList.contains('active')) closeModal(); });
searchInput.addEventListener('input', (e) => renderLanguages(e.target.value));

/* =========================================
   [통합됨] 3. 언어 감지 및 게임 적용 로직 (우선순위 철저 준수)
   ========================================= */

function detectLanguage() {
    // 1순위: URL
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.has('lang') && I18N[urlParams.get('lang')]) return urlParams.get('lang');
    // 2순위: 로컬 스토리지
    const savedLang = localStorage.getItem('kingsmath_lang');
    if (savedLang && I18N[savedLang]) return savedLang;
    // 3순위: 브라우저
    const navLang = navigator.language.substring(0, 2);
    if (I18N[navLang]) return navLang;
    // 기본값
    return 'en';
}

function applyLanguage(lang) {
    if (!I18N[lang]) lang = 'en';
    currentLang = lang;
    localStorage.setItem('kingsmath_lang', lang);

    // URL 업데이트 (새로고침 방지)
    const newUrl = new URL(window.location);
    newUrl.searchParams.set('lang', lang);
    window.history.pushState({}, '', newUrl);

    // Body 클래스 변경
    document.body.className = ''; 
    document.body.classList.add('lang-' + lang);

    const t = I18N[lang];
    const langObj = languages.find(l => l.code === lang) || languages[1];

    // SEO 메타 태그
    document.title = t.seoTitle;
    document.querySelector('meta[name="description"]').setAttribute("content", t.seoDesc);
    document.querySelector('meta[name="keywords"]').setAttribute("content", t.seoKeywords);
    document.querySelector('meta[property="og:title"]').setAttribute("content", t.seoTitle);
    document.querySelector('meta[property="og:description"]').setAttribute("content", t.seoDesc);
    document.querySelector('meta[property="og:site_name"]').setAttribute("content", t.siteName);

    // 게임 텍스트 교체
    document.getElementById('msgTitle').innerHTML = t.gameTitle;
    document.getElementById('subtitle').innerHTML = t.deviceMsg;
    document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.getAttribute('data-i18n');
        if (t[key]) el.innerHTML = t[key];
    });

    // 도메인 링크 하드코딩 교체 (_self)
    const siteLink = document.getElementById('siteLink');
    const headerSiteLink = document.getElementById('headerSiteLink');
    const otherGameLink = document.getElementById('otherGameLink');
    siteLink.innerText = t.siteName;
    headerSiteLink.innerText = t.siteName;
    
    // 모달 및 트리거 UI 업데이트
    currentFlagImg.src = `https://flagcdn.com/w40/${langObj.country}.png`;
    currentLangSpan.textContent = langObj.name;
    updateModalUIText(lang);

    // 팀 이름 업데이트
    if(document.getElementById('teamNameA')) {
        document.getElementById('teamNameA').innerHTML = t.teamNames.teamA_2;
        document.getElementById('teamNameB').innerHTML = t.teamNames.teamB_2;
    }
    
    renderMenu();

    // 제목 크기 동적 조절 (DOM 반영 이후 실행)
    setTimeout(() => {
        const msgTitleObj = document.getElementById('msgTitle');
        autoResizeText(msgTitleObj, 24, 57);
    }, 50);
}


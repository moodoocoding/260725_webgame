<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>당구킹</title>
    <style>
        /* 웹폰트 적용: HS산토끼 */
        @font-face {
            font-family: 'HsSantoki';
            src: url('https://gcore.jsdelivr.net/gh/projectnoonnu/noonfonts_2201-2@1.0/HS-Regular.woff') format('woff');
            font-weight: normal;
            font-display: swap;
        }

        :root {
            --app-height: 100vh;
        }

        html, body {
            margin: 0;
            padding: 0;
            overflow: hidden;
            background-color: #121212;
            font-family: 'HsSantoki', sans-serif; /* 기본 폰트 변경 */
            width: 100%;
            height: 100vh; /* Fallback */
            height: 100dvh; /* Dynamic Viewport Height */
            height: var(--app-height); /* JS Fallback */
            /* 터치 제스처(확대, 스크롤 등) 차단 */
            touch-action: none; 
            -webkit-user-select: none;
            -moz-user-select: none;
            -ms-user-select: none;
            user-select: none;
        }

        body {
            display: flex;
            flex-direction: column;
            color: #fff;
        }

        /* --- 상단 정보 영역 (화면 상단 30%) --- */
        #top-area {
            flex: 0 0 30%;
            min-height: 120px;
            background: linear-gradient(180deg, #1a1a1a 0%, #0d0d0d 100%);
            border-bottom: 4px solid #c5a059;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            position: relative;
            z-index: 10;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }

        #scoreboard-row {
            display: flex;
            justify-content: space-around;
            align-items: center;
            width: 100%;
            padding: 0 20px;
            height: 100%;
        }

        .player-zone {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 10px 20px;
            border-radius: 16px;
            background: rgba(255,255,255,0.05);
            min-width: 200px;
            justify-content: center;
            box-shadow: 0 5px 15px rgba(0,0,0,0.3);
        }
        
        .p1-zone { border: 3px solid #ff4d4d; color: #ff4d4d; }
        .p2-zone { border: 3px solid #4d88ff; color: #4d88ff; flex-direction: row-reverse; }

        /* 팀 이름 레이블: 굵게 유지 */
        .player-label { font-size: 24px; font-weight: 700; letter-spacing: 1px; white-space: nowrap; }
        /* 점수 숫자: 보통으로 변경 */
        .score { font-size: 60px; font-weight: normal; font-family: 'HsSantoki'; margin: 0 15px; line-height: 1; }
        
        /* 중앙 타이머 */
        .timer-container {
            width: 40%; /* 링크 길이에 맞춰 약간 확장 */
            max-width: 500px;
            text-align: center;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        /* 킹수학 홍보 링크 스타일 개선 */
        .promo-link {
            color: #fff;
            text-decoration: none;
            font-size: 20px; /* 크기 키움 */
            margin-bottom: 12px;
            display: block;
            font-weight: normal;
            opacity: 0.95;
            transition: transform 0.2s, color 0.2s;
            white-space: nowrap;
        }
        .promo-link span {
            color: #ffcc00; /* 킹수학.com 강조 색상 */
            font-weight: 700; /* 강조 굵게 */
            text-decoration: underline;
            margin-left: 5px;
        }
        .promo-link:hover {
            transform: scale(1.05);
            color: #fff;
        }

        /* 남은 시간 라벨: 보통으로 변경 */
        .timer-label { 
            color: #ffcc00; 
            font-size: 32px; 
            margin-bottom: 10px; 
            font-weight: normal; 
            letter-spacing: 1px; 
            text-shadow: 0 2px 4px rgba(0,0,0,0.8);
        }
        #timer-bar {
            width: 100%; height: 16px; background: #333; border-radius: 8px;
            overflow: hidden; border: 2px solid #555;
        }
        #timer-fill {
            width: 100%; height: 100%;
            background: linear-gradient(90deg, #4cd964, #ffcc00, #ff3b30);
            transition: width 1s linear;
        }

        /* --- 하단 게임 영역 (화면 하단 70%) --- */
        #game-area-wrapper {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: flex-end;
            padding: 15px;
            background-color: #0d0d0d;
            position: relative;
            overflow: hidden;
        }

        #game-area {
            width: 100%;
            height: 100%; 
            display: flex;
            position: relative;
            gap: 15px;
        }

        canvas {
            position: absolute; top: 0; left: 0;
            display: block; width: 100%; height: 100%; z-index: 5;
        }

        .table-bg {
            flex: 1;
            border-radius: 15px;
            border: 10px solid #3e2723;
            box-shadow: inset 0 0 60px rgba(0,0,0,0.8), 0 5px 20px rgba(0,0,0,0.5);
            position: relative;
            transition: box-shadow 0.1s, border-color 0.1s;
        }
        
        .table-bg.error-anim {
            box-shadow: inset 0 0 100px rgba(255, 0, 0, 0.6) !important;
            border-color: #ff3333 !important;
        }

        .left-table { background: radial-gradient(circle at 30% 30%, #1a5e2e 0%, #0a3315 90%); }
        .right-table { background: radial-gradient(circle at 70% 30%, #005c4b 0%, #002e26 90%); }

        .divider {
            position: absolute; left: 50%; top: 10px; bottom: 10px;
            width: 4px; background: rgba(255, 215, 0, 0.3);
            transform: translateX(-50%); z-index: 4;
            border-radius: 2px;
        }

        .pocket { position: absolute; width: 36px; height: 36px; background: #000; border-radius: 50%; box-shadow: inset 2px 2px 8px rgba(255,255,255,0.1); }
        .tl { top: 6px; left: 6px; } .tr { top: 6px; right: 6px; }
        .bl { bottom: 6px; left: 6px; } .br { bottom: 6px; right: 6px; }

        /* --- 정답 타겟 (숨김 처리하지만 요소는 존재) --- */
        #target-container {
            display: none;
        }
        .target-circle {
            width: 10px; height: 10px;
        }

        /* --- 플로팅 전체화면 버튼 --- */
        #fullscreen-btn {
            position: fixed;
            bottom: 20px;
            right: 20px;
            width: 50px;
            height: 50px;
            background: rgba(255, 255, 255, 0.15);
            border: 2px solid rgba(255, 255, 255, 0.4);
            border-radius: 50%;
            cursor: pointer;
            z-index: 1000;
            display: flex;
            justify-content: center;
            align-items: center;
            color: white;
            font-size: 24px;
            transition: all 0.2s;
            backdrop-filter: blur(4px);
        }
        #fullscreen-btn:hover { background: rgba(255, 255, 255, 0.3); transform: scale(1.1); }

        /* --- 오버레이 --- */
        #overlay {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.85);
            display: flex; flex-direction: column; justify-content: center; align-items: center;
            z-index: 100; backdrop-filter: blur(8px);
        }
        
        .modal-content {
            background: rgba(30, 30, 30, 0.95); padding: 50px 80px;
            border-radius: 30px; border: 2px solid rgba(197, 160, 89, 0.5);
            display: flex; flex-direction: column; align-items: center;
            text-align: center; max-width: 800px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.9);
        }

        /* 제목: 굵게 유지 */
        h1 { 
            font-size: 80px; margin: 0 0 20px 0; font-family: 'HsSantoki';
            font-weight: 700;
            background: linear-gradient(to bottom, #fff8e1, #c5a059);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            filter: drop-shadow(0 0 20px rgba(197, 160, 89, 0.6));
        }
        
        .result-msg { font-size: 36px; font-weight: normal; margin: 20px 0; color: #fff; }
        .sub-msg { font-size: 22px; color: #ccc; line-height: 1.6; font-weight: normal; }
        .sub-msg b { color: #ffcc00; font-weight: normal; }

        /* 시작 버튼: 보통으로 변경 */
        button.start-btn {
            padding: 20px 60px; font-size: 30px; font-family: 'HsSantoki';
            font-weight: normal;
            background: linear-gradient(to bottom, #ffd700, #ff8c00);
            border: 4px solid #fff; border-radius: 60px; color: #222; cursor: pointer;
            box-shadow: 0 10px 30px rgba(255, 140, 0, 0.5); margin-top: 40px;
            transition: transform 0.1s, box-shadow 0.2s;
            /* 터치 딜레이 제거 */
            touch-action: manipulation;
        }
        button.start-btn:hover { transform: scale(1.05); box-shadow: 0 15px 40px rgba(255, 140, 0, 0.7); }
        button.start-btn:active { transform: scale(0.95); }

        .ripple {
            position: absolute;
            border-radius: 50%;
            transform: scale(0);
            animation: ripple-anim 0.4s cubic-bezier(0, 0, 0.2, 1);
            pointer-events: none;
            border: 2px solid rgba(255,255,255,0.6);
            background: rgba(255,255,255,0.1);
            z-index: 999;
        }
        @keyframes ripple-anim { 
            to { transform: scale(3); opacity: 0; border-width: 0; } 
        }

    </style>
</head>
<body>

    <div id="top-area">
        <div id="scoreboard-row">
            <div class="player-zone p1-zone" id="p1-ui">
                <div class="score" id="score-p1">0</div>
                <div class="player-label">빨강팀</div>
            </div>
            
            <div class="timer-container">
                <a href="http://킹수학.com" target="_blank" class="promo-link">
                    게임으로 수학의 킹이 되어라. <span>킹수학.com</span>
                </a>
                <div class="timer-label">남은 시간</div>
                <div id="timer-bar"><div id="timer-fill"></div></div>
            </div>

            <div class="player-zone p2-zone" id="p2-ui">
                <div class="score" id="score-p2">0</div>
                <div class="player-label">파랑팀</div>
            </div>
        </div>
    </div>

    <div id="game-area-wrapper">
        <div id="game-area">
            <div class="table-bg left-table">
                <div class="pocket tl"></div><div class="pocket tr"></div>
                <div class="pocket bl"></div><div class="pocket br"></div>
            </div>
            <div class="divider"></div>
            <div class="table-bg right-table">
                <div class="pocket tl"></div><div class="pocket tr"></div>
                <div class="pocket bl"></div><div class="pocket br"></div>
            </div>
            <canvas id="canvas"></canvas>
        </div>
    </div>

    <div id="fullscreen-btn" onclick="toggleFullscreen()" title="전체화면">
        ⛶
    </div>

    <div id="target-container">
        <div id="target-p1" class="target-circle"></div>
        <div id="target-p2" class="target-circle"></div>
    </div>

    <div id="overlay">
        <div class="modal-content">
            <h1 id="msg-title">당구킹</h1>
            <div class="result-msg" id="main-msg">
                <span style="color:#ff6b6b">빨강팀</span> vs <span style="color:#6b9fff">파랑팀</span>
            </div>
            <div class="sub-msg">
                내 구역의 <b>정답 공</b>을 터치하여<br>
                검정 공을 <b>안쪽 구멍</b>에 넣으세요!
            </div>
            <div id="result-score" style="display:none; margin-top:30px;"></div>
            <button class="start-btn" onclick="startGame()" ontouchend="startGame()">게임 시작</button>
            
            <a href="http://킹수학.com" style="margin-top: 25px; color: #888; font-size: 20px; text-decoration: underline; cursor: pointer;">🎮다른 게임 고르기</a>
        </div>
    </div>

<script>
    // 보안 및 편의 기능: 우클릭, 드래그, 더블클릭 등 방지
    document.addEventListener('contextmenu', e => e.preventDefault());
    document.addEventListener('dragstart', e => e.preventDefault());
    document.addEventListener('selectstart', e => e.preventDefault());
    document.addEventListener('dblclick', e => e.preventDefault());

    // 1. 변수 선언 및 초기화 (최상단)
    const canvas = document.getElementById('canvas');
    const ctx = canvas.getContext('2d');
    const timerFill = document.getElementById('timer-fill');
    const targetElP1 = document.getElementById('target-p1');
    const targetElP2 = document.getElementById('target-p2');

    let balls = [];
    let particles = [];
    let flyingBalls = []; 
    let pocketingBalls = [];
    
    let targets = { left: 0, right: 0 };
    let scores = { p1: 0, p2: 0 };
    // 각 팀별 진행 단계 (맞춘 개수)
    let stages = { left: 0, right: 0 };

    let timeLeft = 60;
    const maxTime = 60;
    let gameLoopId = null;
    let timerId;
    let isPlaying = false;

    // 공 크기 축소 (48)
    const BALL_RADIUS = 48; 
    const COLORS = {
        P1: { main: '#ff4d4d', light: '#ff9999', dark: '#cc0000' },
        P2: { main: '#4d88ff', light: '#99bbff', dark: '#0040cc' },
        NEUTRAL: { main: '#777777', light: '#aaaaaa', dark: '#444444' },
        TARGET: { main: '#000000', light: '#444444', dark: '#000000' }
    };

    // 2. AudioEngine 정의
    const AudioEngine = {
        ctx: null,
        init: function() {
            if (!this.ctx) {
                window.AudioContext = window.AudioContext || window.webkitAudioContext;
                this.ctx = new AudioContext();
            } else if (this.ctx.state === 'suspended') {
                this.ctx.resume();
            }
        },
        playTone: function(freq, type, duration, vol=0.3, startTime=null) {
            if (!this.ctx) this.init();
            if (this.ctx.state === 'suspended') this.ctx.resume();
            
            const now = startTime || this.ctx.currentTime;
            const osc = this.ctx.createOscillator();
            const gain = this.ctx.createGain();
            osc.type = type;
            osc.frequency.setValueAtTime(freq, now);
            gain.gain.setValueAtTime(vol, now);
            gain.gain.exponentialRampToValueAtTime(0.01, now + duration);
            osc.connect(gain);
            gain.connect(this.ctx.destination);
            osc.start(now);
            osc.stop(now + duration);
        },
        playClack: function() { this.playTone(200, 'triangle', 0.05, 0.2); },
        playPocket: function() { this.playTone(100, 'sine', 0.3, 0.6); },
        playCorrect: function(isP1) { 
            if (!this.ctx) return;
            const now = this.ctx.currentTime;
            const base = isP1 ? 660 : 880; 
            this.playTone(base, 'square', 0.1, 0.15, now);
            this.playTone(base, 'triangle', 0.3, 0.3, now + 0.08);
            this.playTone(base * 1.25, 'triangle', 0.3, 0.3, now + 0.16);
            this.playTone(base * 1.5, 'sine', 0.5, 0.2, now + 0.24);
        },
        playWrong: function() { 
            this.playTone(150, 'sawtooth', 0.3, 0.4);
            setTimeout(() => this.playTone(100, 'sawtooth', 0.4, 0.4), 150);
        },
        playFly: function() { this.playTone(600, 'sine', 0.4, 0.1); },
        playCountdown: function() { this.playTone(1200, 'sine', 0.1, 0.2); },
        playStart: function() {
            if (!this.ctx) return;
            const now = this.ctx.currentTime;
            this.playTone(600, 'square', 0.1, 0.3, now);
            this.playTone(600, 'square', 0.1, 0.3, now + 0.15);
            this.playTone(800, 'square', 0.4, 0.4, now + 0.3);
            this.playTone(1200, 'sine', 0.5, 0.2, now + 0.3);
        },
        playFanfare: function() {
            if (!this.ctx) return;
            const now = this.ctx.currentTime;
            [523, 659, 783, 1046, 783, 1046].forEach((freq, i) => {
                this.playTone(freq, 'square', 0.2, 0.3, now + i*0.15);
            });
        }
    };

    // 3. Helper Functions
    function resizeCanvas() {
        const area = document.getElementById('game-area');
        if (area) {
            canvas.width = area.clientWidth;
            canvas.height = area.clientHeight;
        }
    }

    function toggleFullscreen() {
        if (!document.fullscreenElement) {
            document.documentElement.requestFullscreen().catch(err => {
                console.log("Fullscreen not supported or allowed");
            });
        } else {
            if (document.exitFullscreen) {
                document.exitFullscreen();
            }
        }
    }

    // 4. Classes
    class Particle {
        constructor(x, y, color) {
            this.x = x; this.y = y;
            this.vx = (Math.random() - 0.5) * 10;
            this.vy = (Math.random() - 0.5) * 10;
            this.life = 1.0; this.color = color;
        }
        update() { this.x += this.vx; this.y += this.vy; this.life -= 0.05; }
        draw(ctx) {
            ctx.save(); ctx.globalAlpha = this.life; ctx.fillStyle = this.color;
            ctx.beginPath(); ctx.arc(this.x, this.y, 4, 0, Math.PI*2);
            ctx.fill(); ctx.restore();
        }
    }

    class Ball {
        constructor(x, y, type, mathObj, zone) {
            this.x = x; this.y = y;
            this.type = type; this.zone = zone; 
            this.radius = BALL_RADIUS;
            this.isStatic = (type === 'target'); 
            
            if (this.isStatic) { this.vx = 0; this.vy = 0; } 
            else {
                // 속도 1.5배 (7.0)
                const speed = 7.0;
                const angle = Math.random() * Math.PI * 2;
                this.vx = Math.cos(angle) * speed;
                this.vy = Math.sin(angle) * speed;
            }
            
            this.text = mathObj.text;
            this.value = mathObj.val;
            this.mass = this.isStatic ? 100 : 1; 

            if (type === 'p1') this.theme = COLORS.P1;
            else if (type === 'p2') this.theme = COLORS.P2;
            else if (type === 'target') this.theme = COLORS.TARGET;
            else this.theme = COLORS.NEUTRAL;
        }

        draw() {
            ctx.beginPath();
            ctx.shadowColor = 'rgba(0,0,0,0.5)';
            ctx.shadowBlur = 6; ctx.shadowOffsetX = 3; ctx.shadowOffsetY = 3;

            let grad = ctx.createRadialGradient(
                this.x - this.radius/3, this.y - this.radius/3, this.radius/10,
                this.x, this.y, this.radius
            );
            
            if (this.type === 'target') {
                grad.addColorStop(0, '#666'); grad.addColorStop(0.3, '#000'); grad.addColorStop(1, '#000');
            } else {
                grad.addColorStop(0, this.theme.light); grad.addColorStop(1, this.theme.main);
            }
            
            ctx.fillStyle = grad;
            ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
            ctx.fill();
            
            if (this.type !== 'target') {
                ctx.shadowColor = 'transparent';
                ctx.lineWidth = 2; ctx.strokeStyle = this.theme.dark; ctx.stroke();
            }

            ctx.fillStyle = '#fff';
            // 공 안의 숫자 폰트: 보통(normal)으로 변경
            ctx.font = `normal ${this.radius * 0.6}px 'HsSantoki', sans-serif`; 
            ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
            
            if (this.type !== 'target') {
                ctx.shadowColor = 'rgba(0,0,0,0.8)'; ctx.shadowBlur = 2;
                ctx.shadowOffsetX = 1; ctx.shadowOffsetY = 1;
            } else {
                ctx.shadowColor = 'transparent';
            }
            
            ctx.fillText(this.text || this.value, this.x, this.y);
            ctx.shadowColor = 'transparent';
        }

        update() {
            if (this.isStatic) return; 

            // 마찰력 적용 (30초 기준)
            this.vx *= 0.998;
            this.vy *= 0.998;
            if (Math.abs(this.vx) < 0.01) this.vx = 0;
            if (Math.abs(this.vy) < 0.01) this.vy = 0;

            let minX, maxX;
            if (this.zone === 'left') {
                minX = 0; maxX = canvas.width / 2 - 2; 
            } else {
                minX = canvas.width / 2 + 2; maxX = canvas.width;
            }
            const minY = 0;
            const maxY = canvas.height;

            if (this.x + this.radius > maxX) { this.x = maxX - this.radius; this.vx *= -1; }
            if (this.x - this.radius < minX) { this.x = minX + this.radius; this.vx *= -1; }
            if (this.y + this.radius > maxY) { this.y = maxY - this.radius; this.vy *= -1; }
            if (this.y - this.radius < minY) { this.y = minY + this.radius; this.vy *= -1; }

            this.x += this.vx; this.y += this.vy;
        }
    }

    class FlyingBall extends Ball {
        constructor(ball, targetBall, isP1) {
            super(ball.x, ball.y, ball.type, {text: ball.text, val: ball.value}, ball.zone);
            this.targetBall = targetBall; 
            this.isP1 = isP1;
            this.reached = false;
        }

        update() {
            const dx = this.targetBall.x - this.x;
            const dy = this.targetBall.y - this.y;
            const dist = Math.sqrt(dx*dx + dy*dy);
            
            if (dist < this.radius + this.targetBall.radius) {
                this.reached = true;
                return;
            }

            const angle = Math.atan2(dy, dx);
            const speed = 25;
            this.x += Math.cos(angle) * speed;
            this.y += Math.sin(angle) * speed;
        }
    }

    class PocketingBall extends Ball {
        constructor(ball, isP1) {
            super(ball.x, ball.y, 'target', {text: '', val: ball.value}, ball.zone);
            this.isP1 = isP1;
            this.radius = BALL_RADIUS;
            this.isStatic = false;
            
            let targetX, targetY;
            const pMargin = 40; 
            
            if (isP1) { 
                targetX = (canvas.width / 2) - pMargin; targetY = pMargin; 
            } else { 
                targetX = (canvas.width / 2) + pMargin; targetY = pMargin; 
            }

            const angle = Math.atan2(targetY - this.y, targetX - this.x);
            const speed = 15;
            this.vx = Math.cos(angle) * speed;
            this.vy = Math.sin(angle) * speed;
            this.finished = false;
        }

        update() {
            this.x += this.vx; this.y += this.vy;
            this.radius *= 0.92; 
            if (this.radius < 5) this.finished = true;
        }
    }

    // 5. Game Logic
    function getMath(isCorrect, forcedOp, targetVal) {
        let op = forcedOp;
        let a, b, text, val;
        
        // 구구단 범위 체크를 위한 헬퍼
        const getDivisors = (num) => {
            let divs = [];
            for (let i = 2; i <= 9; i++) {
                if (num % i === 0 && (num / i) <= 9 && (num / i) >= 2) divs.push(i);
            }
            return divs;
        };

        if (isCorrect) {
            val = targetVal;
            if (op === '+') {
                a = Math.floor(Math.random() * (val - 1)) + 1; 
                b = val - a; 
            } else if (op === '-') {
                b = Math.floor(Math.random() * 50) + 1; 
                a = val + b; 
            } else if (op === '×') {
                let divs = getDivisors(val);
                if (divs.length > 0) {
                    a = divs[Math.floor(Math.random() * divs.length)];
                    b = val / a;
                } else {
                    op = '×';
                    a = 1; b = val;
                }
            } else if (op === '÷') {
                b = Math.floor(Math.random() * 8) + 2; 
                a = val * b;
            }
        } else {
            do {
                if (op === '+') {
                    a = Math.floor(Math.random() * 49) + 1;
                    b = Math.floor(Math.random() * 49) + 1;
                    val = a + b;
                } else if (op === '-') {
                    a = Math.floor(Math.random() * 50) + 10;
                    b = Math.floor(Math.random() * (a - 1)) + 1;
                    val = a - b;
                } else if (op === '×') {
                    a = Math.floor(Math.random() * 8) + 2; 
                    b = Math.floor(Math.random() * 8) + 2; 
                    val = a * b;
                } else if (op === '÷') {
                    b = Math.floor(Math.random() * 8) + 2; 
                    let res = Math.floor(Math.random() * 9) + 1; 
                    if (res === targetVal) res++;
                    val = res; 
                    a = val * b;
                }
            } while (val === targetVal || val < 0);
        }

        text = `${a}${op}${b}`;
        return { text, val };
    }

    function spawnZone(zone) {
        // 기존 공 제거
        balls = balls.filter(b => b.zone !== zone);
        
        // 현재 단계 확인
        const currentStage = (zone === 'left') ? stages.left : stages.right;
        
        // --- 팀 공 개수 결정 ---
        let teamBallCount;
        if (currentStage === 0) teamBallCount = 2;
        else if (currentStage === 1) teamBallCount = 3;
        else if (currentStage === 2) teamBallCount = 4;
        else if (currentStage === 3 || currentStage === 4) teamBallCount = 5;
        else teamBallCount = 6 + (currentStage - 5);

        // --- 전체 공 개수 (최소 6개 보장) ---
        const totalBalls = Math.max(6, teamBallCount);
        const grayBallCount = totalBalls - teamBallCount;

        // --- 전체 연산자 리스트 생성 (규칙 적용) ---
        let allOps = [];
        
        if (totalBalls <= 6) {
            // 6개 이하일 때도 6개 규칙: +2, -1, ×2, ÷1
            allOps = ['+', '+', '-', '×', '×', '÷'];
        } else if (totalBalls === 7) {
            // 7개: +2, -2, ×1, ÷2
            allOps = ['+', '+', '-', '-', '×', '÷', '÷'];
        } else if (totalBalls === 8) {
            // 8개: +2, -2, ×2, ÷2
            allOps = ['+', '+', '-', '-', '×', '×', '÷', '÷'];
        } else if (totalBalls === 9) {
            // 9개: +3, -2, ×2, ÷2
            allOps = ['+', '+', '+', '-', '-', '×', '×', '÷', '÷'];
        } else if (totalBalls === 10) {
            // 10개: +3, -3, ×2, ÷2
            allOps = ['+', '+', '+', '-', '-', '-', '×', '×', '÷', '÷'];
        } else if (totalBalls === 11) {
            // 11개: +3, -3, ×2, ÷3
            allOps = ['+', '+', '+', '-', '-', '-', '×', '×', '÷', '÷', '÷'];
        } else if (totalBalls === 12) {
            // 12개: +3, -3, ×3, ÷3
            allOps = ['+', '+', '+', '-', '-', '-', '×', '×', '×', '÷', '÷', '÷'];
        } else {
            // 13개 이상: 12개 기본 + 나머지 랜덤
            allOps = ['+', '+', '+', '-', '-', '-', '×', '×', '×', '÷', '÷', '÷'];
            const remainder = totalBalls - 12;
            const basicOps = ['+', '-', '×', '÷'];
            for(let k=0; k<remainder; k++) {
                allOps.push(basicOps[Math.floor(Math.random() * basicOps.length)]);
            }
        }

        // 연산자 섞기
        allOps.sort(() => Math.random() - 0.5);

        // 팀/회색 공에 연산자 분배
        const teamOps = allOps.slice(0, teamBallCount);
        const grayOps = allOps.slice(teamBallCount);
        
        const playerType = zone === 'left' ? 'p1' : 'p2';

        // --- 타겟 숫자 생성 ---
        let newTarget;
        // 생성된 전체 연산자 목록에 곱셈('×')이 포함되어 있는지 확인
        let hasMultiplication = allOps.includes('×');
        
        if (hasMultiplication) {
            // 곱셈이 있으면 구구단 결과값(합성수) 타겟 생성
            const a = Math.floor(Math.random() * 8) + 2; 
            const b = Math.floor(Math.random() * 8) + 2;
            newTarget = a * b;
        } else {
            // 없으면 자유롭게 (5 ~ 50)
            newTarget = Math.floor(Math.random() * 46) + 5;
        }
        targets[zone] = newTarget;

        // 검정 타겟공 배치
        const margin = BALL_RADIUS + 20; 
        let tX = (zone === 'left') ? (canvas.width / 2) - margin : (canvas.width / 2) + margin;
        let tY = margin;
        balls.push(new Ball(tX, tY, 'target', {text: '', val: newTarget}, zone));

        // 안전 좌표 생성 함수
        let minX, maxX;
        if (zone === 'left') {
            minX = BALL_RADIUS; maxX = canvas.width/2 - BALL_RADIUS;
        } else {
            minX = canvas.width/2 + BALL_RADIUS; maxX = canvas.width - BALL_RADIUS;
        }
        const minY = BALL_RADIUS, maxY = canvas.height - BALL_RADIUS;

        const getSafePosition = () => {
            let x, y, dist;
            let attempts = 0;
            const safeDistance = BALL_RADIUS * 2.5; 
            do {
                x = Math.random() * (maxX - minX) + minX;
                y = Math.random() * (maxY - minY) + minY;
                const dx = x - tX;
                const dy = y - tY;
                dist = Math.sqrt(dx*dx + dy*dy);
                attempts++;
            } while (dist < safeDistance && attempts < 50);
            return {x, y};
        };

        let generatedTexts = new Set();
        
        // --- 팀 공 생성 ---
        let correctIdx = Math.floor(Math.random() * teamBallCount);

        for (let i = 0; i < teamBallCount; i++) {
            let isCorrect = (i === correctIdx);
            let op = teamOps[i]; 
            let m;
            let safety = 0;
            
            do {
                m = getMath(isCorrect, op, newTarget);
                safety++;
            } while (generatedTexts.has(m.text) && safety < 20);
            
            generatedTexts.add(m.text);
            let pos = getSafePosition();
            balls.push(new Ball(pos.x, pos.y, playerType, m, zone));
        }

        // --- 회색 공 생성 ---
        for (let i = 0; i < grayBallCount; i++) {
            let op = grayOps[i]; 
            let m;
            let safety = 0;
            do {
                m = getMath(false, op, newTarget); 
                safety++;
            } while (generatedTexts.has(m.text) && safety < 20);
            
            generatedTexts.add(m.text);
            let pos = getSafePosition();
            balls.push(new Ball(pos.x, pos.y, 'trap', m, zone));
        }
    }

    function initGame() {
        balls = []; flyingBalls = []; pocketingBalls = [];
        spawnZone('left'); spawnZone('right');
        for(let i=0; i<15; i++) resolveCollisions();
    }

    function resolveCollisions() {
        for (let i = 0; i < balls.length; i++) {
            for (let j = i + 1; j < balls.length; j++) {
                let b1 = balls[i]; let b2 = balls[j];
                if (b1.zone !== b2.zone) continue;

                let dx = b2.x - b1.x; let dy = b2.y - b1.y;
                let dist = Math.sqrt(dx*dx + dy*dy);

                if (dist < b1.radius + b2.radius) {
                    if (Math.random() > 0.85 && isPlaying && flyingBalls.length === 0) AudioEngine.playClack();

                    let angle = Math.atan2(dy, dx);
                    let overlap = (b1.radius + b2.radius - dist) / 2;
                    
                    if (b1.isStatic) {
                        b2.x += Math.cos(angle) * overlap * 2; b2.y += Math.sin(angle) * overlap * 2;
                    } else if (b2.isStatic) {
                        b1.x -= Math.cos(angle) * overlap * 2; b1.y -= Math.sin(angle) * overlap * 2;
                    } else {
                        b1.x -= Math.cos(angle) * overlap; b1.y -= Math.sin(angle) * overlap;
                        b2.x += Math.cos(angle) * overlap; b2.y += Math.sin(angle) * overlap;
                    }

                    let tx = Math.cos(angle), ty = Math.sin(angle);
                    let dpTan1 = b1.vx * (-ty) + b1.vy * tx;
                    let dpTan2 = b2.vx * (-ty) + b2.vy * tx;
                    let dpNorm1 = b1.vx * tx + b1.vy * ty;
                    let dpNorm2 = b2.vx * tx + b2.vy * ty;

                    let m1 = b1.mass; let m2 = b2.mass;
                    let p1 = (dpNorm1 * (m1 - m2) + 2 * m2 * dpNorm2) / (m1 + m2);
                    let p2 = (dpNorm2 * (m2 - m1) + 2 * m1 * dpNorm1) / (m1 + m2);

                    b1.vx = tx * p1 - ty * dpTan1; b1.vy = ty * p1 + tx * dpTan1;
                    b2.vx = tx * p2 - ty * dpTan2; b2.vy = ty * p2 + tx * dpTan2;
                }
            }
        }
    }

    function gameLoop() {
        if (!isPlaying) return;
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        resolveCollisions();
        balls.forEach(b => { b.update(); b.draw(); });

        for (let i = flyingBalls.length - 1; i >= 0; i--) {
            let fb = flyingBalls[i];
            fb.update(); fb.draw();

            if (fb.reached) {
                AudioEngine.playClack(); 
                let targetBallIndex = balls.findIndex(b => b.zone === (fb.isP1 ? 'left' : 'right') && b.type === 'target');
                if (targetBallIndex !== -1) {
                    let targetBall = balls[targetBallIndex];
                    pocketingBalls.push(new PocketingBall(targetBall, fb.isP1));
                    balls.splice(targetBallIndex, 1); 
                }
                flyingBalls.splice(i, 1);
            }
        }

        for (let i = pocketingBalls.length - 1; i >= 0; i--) {
            let pb = pocketingBalls[i];
            pb.update(); pb.draw();

            if (pb.finished) {
                AudioEngine.playPocket();
                AudioEngine.playCorrect(pb.isP1);
                
                // 점수 및 단계(Stage) 업데이트
                if (pb.isP1) {
                    scores.p1 += 200;
                    stages.left++; 
                } else {
                    scores.p2 += 200;
                    stages.right++;
                }
                updateScores();
                
                let ui = document.getElementById(pb.isP1 ? 'p1-ui' : 'p2-ui');
                ui.style.transform = 'scale(1.05)';
                setTimeout(() => ui.style.transform = 'scale(1)', 100);

                spawnZone(pb.isP1 ? 'left' : 'right'); 
                pocketingBalls.splice(i, 1);
            }
        }

        for (let i = particles.length - 1; i >= 0; i--) {
            particles[i].update(); particles[i].draw(ctx);
            if (particles[i].life <= 0) particles.splice(i, 1);
        }

        gameLoopId = requestAnimationFrame(gameLoop);
    }

    function handleInput(x, y, globalX, globalY) {
        if (!isPlaying) return;

        const isLeftZone = x < canvas.width / 2;
        const clickZone = isLeftZone ? 'left' : 'right';
        const playerType = isLeftZone ? 'p1' : 'p2';

        if (flyingBalls.some(fb => (fb.isP1 && isLeftZone) || (!fb.isP1 && !isLeftZone)) ||
            pocketingBalls.some(pb => (pb.isP1 && isLeftZone) || (!pb.isP1 && !isLeftZone))) return;

        const targetValue = targets[clickZone];

        let touchedIndex = -1;
        const TOUCH_TOLERANCE = 1.5; 

        for (let i = balls.length - 1; i >= 0; i--) {
            let b = balls[i];
            if (b.zone !== clickZone) continue;
            if (b.type === 'target') continue; 

            let dist = Math.sqrt((x - b.x)**2 + (y - b.y)**2);
            if (dist < b.radius * TOUCH_TOLERANCE) {
                touchedIndex = i; break;
            }
        }

        createRipple(globalX, globalY);

        if (touchedIndex !== -1) {
            let b = balls[touchedIndex];
            
            // 정답 판단: 공이 플레이어 색깔이고, 값이 정답이어야 함
            let isCorrect = (b.type === playerType && b.value === targetValue);

            if (isCorrect) {
                AudioEngine.playFly();
                let targetBall = balls.find(ball => ball.zone === clickZone && ball.type === 'target');
                if (targetBall) {
                    let fb = new FlyingBall(b, targetBall, isLeftZone);
                    flyingBalls.push(fb);
                    balls.splice(touchedIndex, 1);
                }
            } else {
                AudioEngine.playWrong();
                // 오답 시 점수 감점 (0점 미만 방지)
                if (isLeftZone) scores.p1 = Math.max(0, scores.p1 - 100);
                else scores.p2 = Math.max(0, scores.p2 - 100);
                updateScores();

                for(let k=0; k<8; k++) { particles.push(new Particle(b.x, b.y, '#fff')); }
                balls.splice(touchedIndex, 1); 

                const bg = isLeftZone ? document.querySelector('.left-table') : document.querySelector('.right-table');
                bg.classList.add('error-anim');
                setTimeout(() => bg.classList.remove('error-anim'), 200);
            }
        }
    }

    function createRipple(x, y) {
        const ripple = document.createElement('div');
        ripple.className = 'ripple';
        ripple.style.left = (x - 20) + 'px';
        ripple.style.top = (y - 20) + 'px';
        ripple.style.width = '40px';
        ripple.style.height = '40px';
        document.body.appendChild(ripple);
        setTimeout(() => ripple.remove(), 400);
    }

    function updateScores() {
        document.getElementById('score-p1').textContent = scores.p1;
        document.getElementById('score-p2').textContent = scores.p2;
    }

    // 6. Initialization & Listeners
    const setAppHeight = () => {
        const doc = document.documentElement;
        doc.style.setProperty('--app-height', `${window.innerHeight}px`);
        resizeCanvas();
    }
    window.addEventListener('resize', setAppHeight);
    window.addEventListener('orientationchange', setAppHeight);
    
    // Initial call
    setAppHeight();

    function startGame() {
        AudioEngine.init();
        AudioEngine.playStart();
        
        if(isPlaying) return;
        
        scores = { p1: 0, p2: 0 };
        // 게임 시작 시 단계 초기화
        stages = { left: 0, right: 0 };

        timeLeft = maxTime;
        isPlaying = true;
        updateScores();
        
        document.getElementById('overlay').style.display = 'none';
        document.getElementById('result-score').style.display = 'none';
        document.getElementById('main-msg').style.display = 'block';
        document.querySelector('.sub-msg').style.display = 'block';

        setAppHeight(); 
        setTimeout(() => {
            initGame(); 
        }, 100);
        
        if (gameLoopId) cancelAnimationFrame(gameLoopId);
        gameLoopId = requestAnimationFrame(gameLoop);

        clearInterval(timerId);
        timerFill.style.width = '100%';
        
        timerId = setInterval(() => {
            timeLeft--;
            let pct = (timeLeft / maxTime) * 100;
            timerFill.style.width = pct + '%';
            if (timeLeft <= 10 && timeLeft > 0) AudioEngine.playCountdown();
            if (timeLeft <= 0) endGame();
        }, 1000);
    }

    function endGame() {
        isPlaying = false;
        clearInterval(timerId);
        if (gameLoopId) cancelAnimationFrame(gameLoopId);
        AudioEngine.playFanfare();

        const overlay = document.getElementById('overlay');
        overlay.style.display = 'flex';
        document.getElementById('msg-title').textContent = "게임 종료";
        document.getElementById('main-msg').style.display = 'none';
        document.querySelector('.sub-msg').style.display = 'none';
        
        const resDiv = document.getElementById('result-score');
        resDiv.style.display = 'block';
        
        let msg = "";
        if (scores.p1 > scores.p2) msg = `<span style="color:#ff6b6b; font-size:36px; font-weight:700;">빨강팀 승리!</span>`;
        else if (scores.p2 > scores.p1) msg = `<span style="color:#6b9fff; font-size:36px; font-weight:700;">파랑팀 승리!</span>`;
        else msg = `<span style="color:#fff; font-size:36px;">무승부!</span>`;

        resDiv.innerHTML = `
            <div style="font-size:60px; margin-bottom:20px; font-family:'HsSantoki'; letter-spacing:2px;">
                <span style="color:#ff6b6b">${scores.p1}</span> : <span style="color:#6b9fff">${scores.p2}</span>
            </div>
            ${msg}
        `;
    }

    canvas.addEventListener('mousedown', (e) => {
        const rect = canvas.getBoundingClientRect();
        handleInput(e.clientX - rect.left, e.clientY - rect.top, e.clientX, e.clientY);
    });

    canvas.addEventListener('touchstart', (e) => {
        e.preventDefault();
        const rect = canvas.getBoundingClientRect();
        for (let i = 0; i < e.changedTouches.length; i++) {
            let t = e.changedTouches[i];
            handleInput(t.clientX - rect.left, t.clientY - rect.top, t.clientX, t.clientY);
        }
    }, {passive: false});

</script>


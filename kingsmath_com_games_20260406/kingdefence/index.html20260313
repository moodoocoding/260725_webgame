<!DOCTYPE html>
<html lang="ko">
<head>

<script async src="https://www.googletagmanager.com/gtag/js?id=G-5YW0T2C109"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-5YW0T2C109');
</script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>킹수학 디펜스</title>
    <meta name="description" content="게임의 규칙을 찾고 최고 점수를 기록하세요">
    <meta name="keywords" content="킹수학 디펜스, KingsMath, Math game, education">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Jua&display=swap');
        @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&display=swap');

        /* 폰트어썸 아이콘 깨짐 방지용 예외 처리 */
        i[class^="fa-"] {
            font-family: "Font Awesome 6 Free" !important;
            font-weight: 900 !important;
        }

        body {
            margin: 0;
            background-color: #050505;
            color: white;
            font-family: 'Jua', 'Noto Sans KR', sans-serif;
            user-select: none;
        }

        #gameCanvas { 
            display: block; 
            touch-action: none;
        }

        /* UI 레이어 */
        #ui-layer {
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 100%;
            pointer-events: none;
            z-index: 10;
        }

        .hud-text {
            font-family: 'Jua', sans-serif;
            letter-spacing: 1px;
            text-shadow: 2px 2px 0 #000, -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000, 1px 1px 0 #000;
        }

        /* 카드 스타일 */
        .card-container {
            display: none;
            position: absolute;
            top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            display: flex;
            gap: 20px;
            pointer-events: auto;
            z-index: 50;
            justify-content: center;
            align-items: center;
        }

        @media (max-width: 768px) {
            .card-container {
                flex-direction: column;
                gap: 10px;
                width: 90%;
            }
            .card {
                width: 100% !important;
                height: 100px !important;
                flex-direction: row !important;
                padding: 10px 15px !important;
                text-align: left !important;
                justify-content: space-between !important;
            }
            .card-desc { font-size: 14px !important; white-space: pre-wrap; }
            .card-math { font-size: 20px !important; margin: 0 10px !important; }
        }

        .card {
            background: rgba(30, 30, 50, 0.95);
            border: 3px solid #666;
            border-radius: 15px;
            width: 220px;
            height: 300px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: transform 0.2s, border-color 0.2s;
            box-shadow: 0 10px 30px rgba(0,0,0,0.8);
            padding: 15px;
            text-align: center;
        }
        .card:hover {
            transform: scale(1.05);
            border-color: #ffd700;
            background-color: rgba(60, 60, 100, 1);
        }
        .card:active { transform: scale(0.95); }
        .card-title { font-size: 24px; font-weight: bold; color: #ffcc00; margin-bottom: 8px; word-break: keep-all; }
        .card-desc { font-size: 18px; color: #eee; line-height: 1.4; word-break: keep-all; }
        .card-math { font-size: 32px; font-weight: bold; color: #00ffff; margin: 15px 0; }

        /* 화면 공통 스타일 */
        #start-screen, #game-over-screen {
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.9);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            pointer-events: auto;
            z-index: 100;
            text-align: center;
        }

        #start-screen {
            justify-content: flex-start;
            padding-top: 80px;
            padding-bottom: 2vh;
            overflow-y: auto;
            -webkit-overflow-scrolling: touch;
        }

        button, input, select { pointer-events: auto; font-family: 'Jua', 'Noto Sans KR', sans-serif; }
        .hidden { display: none !important; }

        #ranking-list::-webkit-scrollbar { width: 6px; }
        #ranking-list::-webkit-scrollbar-track { background: #222; border-radius: 4px; }
        #ranking-list::-webkit-scrollbar-thumb { background: #555; border-radius: 4px; }

        /* 모달 및 언어 선택기 전용 스타일 */
        .custom-scrollbar::-webkit-scrollbar { width: 8px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: rgba(31, 41, 55, 0.5); border-radius: 4px; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #4b5563; border-radius: 4px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #6b7280; border-radius: 4px; }

        .modal-overlay { opacity: 0; visibility: hidden; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .modal-overlay.active { opacity: 1; visibility: visible; }
        .modal-content { transform: scale(0.95) translateY(-10px); opacity: 0; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .modal-overlay.active .modal-content { transform: scale(1) translateY(0); opacity: 1; }
        .toast { transform: translateY(100%); opacity: 0; transition: all 0.3s ease; }
        .toast.show { transform: translateY(0); opacity: 1; }

        /* 동적 폰트 크기 조절용 클래스 */
        .resize-text { transition: font-size 0.2s ease; }
    </style>
</head>
<body class="bg-gray-900 text-gray-100 min-h-screen flex flex-col relative overflow-x-hidden">

    <canvas id="gameCanvas"></canvas>

    <div id="ui-layer" style="display: none;">
        <div class="absolute top-0 left-0 w-full h-8 bg-gray-900 border-b-2 border-gray-500 overflow-hidden shadow-lg z-20">
            <div id="xpBar" class="h-full bg-gradient-to-r from-blue-600 to-purple-600 w-0 transition-all duration-200"></div>
            <div class="absolute top-0 left-0 w-full h-full flex items-center justify-center text-lg font-bold text-white pt-1 drop-shadow-md z-30">
                LEVEL <span id="levelVal" class="ml-2 text-yellow-300">1</span>
            </div>
        </div>
        <div class="absolute top-12 left-4 flex flex-col gap-4 items-start select-none pointer-events-none z-20">
            <div class="flex flex-col gap-1">
                <div class="text-3xl text-yellow-400 hud-text resize-text"><span data-i18n="score">점수</span>: <span id="scoreVal">0</span></div>
                <div class="text-2xl text-cyan-400 hud-text resize-text"><span data-i18n="attack">공격력</span>: <span id="dmgVal">1</span></div>
            </div>
            <div id="bonusStats" class="flex flex-col gap-1 text-lg text-green-400 hud-text font-bold text-left shadow-black drop-shadow-md resize-text"></div>
        </div>
    </div>

    <div id="start-screen" class="w-full h-full px-4">
        <div class="absolute top-0 left-0 w-full p-4 flex justify-between items-center z-50">
            <a href="/" target="_self" id="btn-home" class="text-xl md:text-2xl text-yellow-400 hover:text-white font-bold transition-colors drop-shadow-md decoration-none border-b-2 border-yellow-400 pb-1 flex items-center gap-2 relative z-[99999]" style="z-index: 99999 !important;">
                <span>🏠</span> <span id="domainLinkText">킹수학.com</span>
            </a>
            
            <div class="absolute top-4 right-4 sm:top-6 sm:right-6 z-[99999]" style="z-index: 99999 !important;">
                <button id="langTriggerBtn" class="flex items-center gap-2 bg-gray-700/80 hover:bg-gray-700 border border-gray-600 rounded-full px-4 py-2 transition-all duration-200 text-sm font-medium shadow-lg backdrop-blur-sm">
                    <i class="fa-solid fa-globe text-gray-400"></i>
                    <img id="currentFlag" src="https://flagcdn.com/w40/kr.png" alt="KR" class="w-5 h-auto rounded-[2px] shadow-sm">
                    <span id="currentLangName" class="hidden sm:inline-block">한국어</span>
                    <i class="fa-solid fa-chevron-down text-gray-400 ml-1 text-xs"></i>
                </button>
            </div>
        </div>

        <div class="flex flex-col items-center mb-2 shrink-0 mt-8">
            <h1 class="text-5xl md:text-7xl text-transparent bg-clip-text bg-gradient-to-r from-yellow-400 to-red-500 font-black mb-1 hud-text drop-shadow-lg resize-text" style="-webkit-text-stroke: 1px white;" data-i18n="gameTitle">
                킹수학 디펜스
            </h1>
            <p class="text-gray-300 text-lg md:text-xl font-bold mb-6 break-keep resize-text" data-i18n="subtitle">
                게임의 규칙을 찾고 최고 점수를 기록하세요
            </p>
        </div>

        <div class="flex flex-col gap-3 w-full max-w-sm mb-6 shrink-0">
            <input type="text" id="startNickname" placeholder="닉네임 입력 (자동저장)" maxlength="12"
                   class="w-full px-4 py-3 rounded-xl text-black text-xl font-bold text-center outline-none border-4 border-gray-400 focus:border-yellow-400 bg-gray-100 placeholder-gray-500 shadow-lg resize-text">
            
            <button id="startBtn" class="w-full px-8 py-4 bg-yellow-600 hover:bg-yellow-500 text-white font-bold rounded-xl text-2xl shadow-[0_0_15px_rgba(255,215,0,0.5)] transition-all transform hover:scale-105 border-4 border-yellow-300">
                <span data-i18n="startBtn" class="resize-text">게임 시작!</span>
            </button>
            <p class="text-gray-400 text-sm resize-text">* <span data-i18n="autoSaveMsg">게임 종료 시 점수가 자동 등록됩니다.</span></p>

            <a href="/" target="_self" class="block text-center mt-2 text-xl text-green-400 font-bold hover:text-white underline decoration-2 underline-offset-4 transition-transform hover:scale-105 resize-text">
                🏠 <span data-i18n="otherGames">다른 게임 고르기</span>
            </a>
        </div>

        <div class="w-full max-w-xl flex flex-col shrink-0 mb-10 bg-gray-800/80 rounded-t-xl border-x-4 border-t-4 border-gray-600 shadow-2xl pb-4">
            <div class="bg-gray-900 text-yellow-400 font-bold p-3 text-lg border-b-2 border-gray-600 flex justify-between items-center px-6">
                <span class="resize-text">🏆 <span data-i18n="rankingTitle">명예의 전당 (Top 100)</span></span>
                <span class="text-xs text-gray-400 resize-text" data-i18n="recent24">최근 24시간</span>
            </div>
            <div id="ranking-list" class="flex-1 p-2 space-y-1">
                <div class="text-center text-gray-500 mt-10 resize-text" data-i18n="loading">랭킹 불러오는 중...</div>
            </div>
        </div>
    </div>

    <div id="levelup-screen" class="hidden absolute top-0 left-0 w-full h-full bg-black/80 z-100 flex flex-col items-center justify-center" style="z-index: 90;">
        <h2 class="text-6xl text-yellow-400 mb-8 font-bold hud-text animate-pulse drop-shadow-[0_0_10px_rgba(255,255,0,0.8)] resize-text" data-i18n="levelUp">레벨 업!</h2>
        <div class="text-2xl text-white mb-4 font-bold resize-text" data-i18n="selectAbility">능력을 선택하세요!</div>
        <div id="cards-container" class="card-container">
        </div>
    </div>

    <div id="game-over-screen" class="hidden">
        <h2 class="text-7xl text-gray-400 font-bold mb-4 hud-text drop-shadow-[0_0_15px_rgba(255,255,255,0.2)] resize-text" data-i18n="defeat">패배...</h2>
        <p class="text-3xl text-white mb-2 font-bold resize-text"><span data-i18n="finalScore">최종 점수</span>: <span id="finalScore" class="text-yellow-400">0</span></p>
        
        <div id="auto-save-msg" class="text-2xl font-bold mb-8 h-8 flex items-center justify-center resize-text">
            <span class="text-gray-400" data-i18n="saving">점수 저장 중...</span>
        </div>

        <button id="restartBtn" class="hidden px-10 py-5 bg-gray-600 hover:bg-gray-500 text-white font-bold rounded-2xl text-3xl shadow-[0_0_20px_rgba(200,200,200,0.5)] transition-all transform hover:scale-105 border-4 border-gray-400">
            <span data-i18n="retry" class="resize-text">다시 도전</span>
        </button>
    </div>

    <div id="langModal" class="modal-overlay fixed inset-0 z-[99999] flex items-start sm:items-center justify-center bg-black/60 backdrop-blur-sm pt-16 sm:pt-0 px-4" style="z-index: 99999 !important;">
        <div class="modal-content bg-gray-900 border border-gray-700 rounded-2xl shadow-2xl w-full max-w-4xl max-h-[85vh] flex flex-col overflow-hidden">
            <div class="flex items-center justify-between p-5 border-b border-gray-800 bg-gray-900/95 sticky top-0 z-10">
                <div>
                    <h2 class="text-xl font-bold text-white flex items-center gap-2">
                        <i class="fa-solid fa-language text-yellow-500"></i> <span id="ui-title">언어 및 지역 선택</span>
                    </h2>
                    <p id="ui-desc" class="text-sm text-gray-400 mt-1">선호하는 언어와 지역을 선택하세요.</p>
                </div>
                <button id="closeModalBtn" class="w-10 h-10 rounded-full bg-gray-800 hover:bg-gray-700 flex items-center justify-center text-gray-400 hover:text-white transition-colors">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            <div class="p-5 pb-2 bg-gray-900">
                <div class="relative">
                    <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                    <input type="text" id="searchInput" placeholder="언어 검색 (예: English, 한국어...)" 
                        class="w-full bg-gray-800 border border-gray-700 text-white text-sm rounded-xl focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500 block pl-11 p-3.5 outline-none transition-all placeholder-gray-500">
                </div>
            </div>
            <div class="p-5 overflow-y-auto custom-scrollbar flex-1">
                <div id="languageGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3"></div>
                <div id="noResult" class="hidden flex-col items-center justify-center py-12 text-gray-500">
                    <i class="fa-regular fa-face-frown-open text-4xl mb-3"></i>
                    <p id="ui-empty">검색 결과가 없습니다.</p>
                </div>
            </div>
        </div>
    </div>

    <div id="toastNotification" class="toast fixed bottom-6 right-6 bg-gray-800 border border-gray-700 shadow-lg rounded-xl p-4 flex items-center gap-3 z-[99999]" style="z-index: 99999 !important;">
        <div class="w-8 h-8 rounded-full bg-green-500/20 flex items-center justify-center text-green-400">
            <i class="fa-solid fa-check"></i>
        </div>
        <div>
            <p id="ui-toast" class="text-sm font-medium text-white">언어가 변경되었습니다.</p>
            <p id="toastLangName" class="text-xs text-gray-400">Korean</p>
        </div>
    </div>

<script>
// --- 다국어 데이터베이스 (16개국 전부 독자적 번역 채택) ---
const languages = [
    { code: 'ko', country: 'kr', name: '한국어', enName: 'Korean' },
    { code: 'en', country: 'us', name: 'English', enName: 'English' },
    { code: 'zh', country: 'cn', name: '中文 (简体)', enName: 'Chinese (Simplified)' },
    { code: 'ja', country: 'jp', name: '日本語', enName: 'Japanese' },
    { code: 'es', country: 'es', name: 'Español', enName: 'Spanish' },
    { code: 'fr', country: 'fr', name: 'Français', enName: 'French' },
    { code: 'de', country: 'de', name: 'Deutsch', enName: 'German' },
    { code: 'it', country: 'it', name: 'Italiano', enName: 'Italian' },
    { code: 'pt-br', country: 'br', name: 'Português', enName: 'Portuguese (Brazil)' },
    { code: 'ru', country: 'ru', name: 'Русский', enName: 'Russian' },
    { code: 'hi', country: 'in', name: 'हिन्दी', enName: 'Hindi' },
    { code: 'bn', country: 'bd', name: 'বাংলা', enName: 'Bengali' },
    { code: 'id', country: 'id', name: 'Bahasa Indonesia', enName: 'Indonesian' },
    { code: 'vi', country: 'vn', name: 'Tiếng Việt', enName: 'Vietnamese' },
    { code: 'th', country: 'th', name: 'ไทย', enName: 'Thai' },
    { code: 'tr', country: 'tr', name: 'Türkçe', enName: 'Turkish' }
];

const uiTranslations = {
    'ko': { title: '언어 및 지역 선택', desc: '선호하는 언어와 지역을 선택하세요.', search: '언어 검색 (예: English, 한국어...)', empty: '검색 결과가 없습니다.', toast: '언어가 변경되었습니다.' },
    'en': { title: 'Language & Region', desc: 'Select your preferred language and region.', search: 'Search language (e.g. English, Español...)', empty: 'No results found.', toast: 'Language changed.' },
    'zh': { title: '语言和地区选择', desc: '请选择您偏好的语言和地区。', search: '搜索语言 (例如: English, 中文...)', empty: '未找到结果。', toast: '语言已更改。' },
    'ja': { title: '言語と地域の選択', desc: '希望する言語と地域を選択してください。', search: '言語を検索 (例: English, 日本語...)', empty: '結果が見つかりません。', toast: '言語が変更されました。' },
    'es': { title: 'Idioma y Región', desc: 'Selecciona tu idioma y región preferidos.', search: 'Buscar idioma (ej. English, Español...)', empty: 'No se encontraron resultados.', toast: 'Idioma cambiado.' },
    'fr': { title: 'Langue et Région', desc: 'Sélectionnez votre langue et région.', search: 'Rechercher (ex: English, Français...)', empty: 'Aucun résultat trouvé.', toast: 'Langue modifiée.' },
    'ru': { title: 'Язык и Регион', desc: 'Выберите предпочитаемый язык и регион.', search: 'Поиск языка (напр. English, Русский...)', empty: 'Ничего не найдено.', toast: 'Язык изменен.' },
    'vi': { title: 'Ngôn ngữ & Khu vực', desc: 'Chọn ngôn ngữ và khu vực của bạn.', search: 'Tìm kiếm (VD: English, Tiếng Việt...)', empty: 'Không tìm thấy kết quả.', toast: 'Ngôn ngữ đã được thay đổi.' },
    'id': { title: 'Bahasa & Wilayah', desc: 'Pilih bahasa dan wilayah pilihan Anda.', search: 'Cari bahasa (Mis: English, Indonesia...)', empty: 'Tidak ada hasil yang ditemukan.', toast: 'Bahasa telah diubah.' },
    'th': { title: 'ภาษาและภูมิภาค', desc: 'เลือกภาษาและภูมิภาคที่คุณต้องการ', search: 'ค้นหาภาษา (เช่น English, ไทย...)', empty: 'ไม่พบผลลัพธ์', toast: 'เปลี่ยนภาษาเรียบร้อยแล้ว' },
    'pt-br':{ title: 'Idioma e Região', desc: 'Selecione seu idioma e região preferidos.', search: 'Buscar idioma (ex: English, Português...)', empty: 'Nenhum resultado encontrado.', toast: 'Idioma alterado.' },
    'hi': { title: 'भाषा और क्षेत्र', desc: 'अपनी पसंदीदा भाषा और क्षेत्र चुनें।', search: 'भाषा खोजें (उदा: English, हिन्दी...)', empty: 'कोई परिणाम नहीं मिला।', toast: 'भाषा बदल दी गई है।' },
    'bn': { title: 'ভাষা এবং অঞ্চল', desc: 'আপনার পছন্দের ভাষা নির্বাচন করুন।', search: 'ভাষা খুঁজুন...', empty: 'কোন ফলাফল পাওয়া যায়নি।', toast: 'ভাষা পরিবর্তন করা হয়েছে।' },
    'tr': { title: 'Dil ve Bölge', desc: 'Tercih ettiğiniz dili seçin.', search: 'Dil ara...', empty: 'Sonuç bulunamadı.', toast: 'Dil değiştirildi.' },
    'de': { title: 'Sprache & Region', desc: 'Wählen Sie Ihre bevorzugte Sprache.', search: 'Sprache suchen...', empty: 'Keine Ergebnisse gefunden.', toast: 'Sprache geändert.' },
    'it': { title: 'Lingua e Regione', desc: 'Seleziona la tua lingua preferita.', search: 'Cerca lingua...', empty: 'Nessun risultato.', toast: 'Lingua cambiata.' }
};

// --- 게임 텍스트 번역 데이터 (16개국 모두 범용처리 없이 단독 번역 적용) ---
const i18nData = {
    ko: {
        gameTitle: "킹수학 디펜스", subtitle: "게임의 규칙을 찾고 최고 점수를 기록하세요", keywords: "킹수학 디펜스, KingsMath, Math game, education",
        score: "점수", attack: "공격력", startBtn: "게임 시작!", autoSaveMsg: "게임 종료 시 점수가 자동 등록됩니다.",

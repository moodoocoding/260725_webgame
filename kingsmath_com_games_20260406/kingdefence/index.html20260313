let currentLang = 'en';

// 초기 언어 감지 우선순위 (1순위: URL, 2순위: 저장값, 3순위: 브라우저, 4순위: en)
function getInitialLanguage() {
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.has('lang')) {
        const urlLang = urlParams.get('lang').toLowerCase();
        if (languages.some(l => l.code === urlLang)) return urlLang;
    }
    const savedLang = localStorage.getItem('kingsmath_lang');
    if (savedLang && languages.some(l => l.code === savedLang)) return savedLang;

    const browserLang = navigator.language.split('-')[0].toLowerCase();
    const fullBrowserLang = navigator.language.toLowerCase();
    
    if (languages.some(l => l.code === fullBrowserLang)) return fullBrowserLang;
    if (languages.some(l => l.code === browserLang)) return browserLang;

    return 'en'; // default
}

// 폰트 크기 자동 리사이징 함수
function adjustFontSize() {
    setTimeout(() => {
        document.querySelectorAll('.resize-text, .card-title, .card-desc, .card-math').forEach(el => {
            el.style.fontSize = ''; // 초기화
            let currentSize = parseFloat(window.getComputedStyle(el).fontSize);
            // 너무 작아지지 않도록 최소 제한 (10px)
            while ((el.scrollHeight > el.clientHeight || el.scrollWidth > el.clientWidth) && currentSize > 10) {
                currentSize -= 1;
                el.style.fontSize = currentSize + 'px';
            }
        });
    }, 50);
}

function updateSEO(langCode, t) {
    document.title = t.gameTitle;
    let descMeta = document.querySelector('meta[name="description"]');
    if (descMeta) descMeta.content = t.subtitle;
    let keywordMeta = document.querySelector('meta[name="keywords"]');
    if (keywordMeta) keywordMeta.content = t.keywords;
    document.documentElement.lang = langCode;
}

function setLanguage(langCode) {
    currentLang = langCode;
    const data = i18nData[langCode] || i18nData['en'];

    // 1. 상태 저장 및 URL 업데이트 (history.pushState)
    localStorage.setItem('kingsmath_lang', langCode);
    const newUrl = new URL(window.location);
    newUrl.searchParams.set('lang', langCode);
    window.history.pushState({}, '', newUrl);

    // 2. 게임 내부 텍스트 업데이트
    document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.getAttribute('data-i18n');
        if (data[key]) {
            if (el.tagName === 'INPUT' && el.getAttribute('placeholder')) {
                // Ignore placeholder here, handled below
            } else {
                el.innerHTML = data[key];
            }
        }
    });

    document.getElementById('startNickname').placeholder = data.nickPlaceholder;
    updateSEO(langCode, data);

    // 3. 도메인 링크 텍스트 업데이트 (한국어만 킹수학.com, 나머진 KingsMath.com)
    document.getElementById('domainLinkText').innerText = (langCode === 'ko') ? '킹수학.com' : 'KingsMath.com';

    // 4. 모달 및 버튼 UI 업데이트
    const langObj = languages.find(l => l.code === langCode) || languages.find(l => l.code === 'en');
    document.getElementById('currentFlag').src = `https://flagcdn.com/w40/${langObj.country}.png`;
    document.getElementById('currentLangName').textContent = langObj.name;
    
    const uiData = uiTranslations[langCode] || uiTranslations['en'];
    document.getElementById('ui-title').textContent = uiData.title;
    document.getElementById('ui-desc').textContent = uiData.desc;
    document.getElementById('searchInput').placeholder = uiData.search;
    document.getElementById('ui-empty').textContent = uiData.empty;
    document.getElementById('ui-toast').textContent = uiData.toast;

    updateUi();
    adjustFontSize();
}

// 모달 조작 및 검색 관련 DOM 요소
const triggerBtn = document.getElementById('langTriggerBtn');
const modal = document.getElementById('langModal');
const closeBtn = document.getElementById('closeModalBtn');
const searchInput = document.getElementById('searchInput');
const grid = document.getElementById('languageGrid');
const noResult = document.getElementById('noResult');
const toast = document.getElementById('toastNotification');
const toastLangName = document.getElementById('toastLangName');
let toastTimeout;

function renderLanguages(filterText = '') {
    grid.innerHTML = '';
    const lowerFilter = filterText.toLowerCase();
    const filteredLangs = languages.filter(lang => 
        lang.name.toLowerCase().includes(lowerFilter) || 
        lang.enName.toLowerCase().includes(lowerFilter) ||
        lang.code.toLowerCase().includes(lowerFilter)
    );

    if (filteredLangs.length === 0) {
        grid.classList.add('hidden');
        noResult.classList.remove('hidden');
        noResult.classList.add('flex');
    } else {
        grid.classList.remove('hidden');
        noResult.classList.add('hidden');
        noResult.classList.remove('flex');

        filteredLangs.forEach(lang => {
            const isSelected = lang.code === currentLang;
            const stateClasses = isSelected ? "bg-gray-800 border-yellow-500 ring-1 ring-yellow-500/50" : "bg-gray-800/40 border-gray-700 hover:bg-gray-700 hover:border-gray-500";
            const flagUrl = `https://flagcdn.com/w40/${lang.country}.png`;

            const btn = document.createElement('div');
            btn.className = `flex items-center gap-3 p-3 rounded-xl border cursor-pointer transition-all duration-200 group relative overflow-hidden ${stateClasses}`;
            btn.innerHTML = `
                <div class="shrink-0 w-8 h-6 rounded overflow-hidden shadow-sm border border-gray-700/50">
                    <img src="${flagUrl}" alt="${lang.country}" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300">
                </div>
                <div class="flex-1 min-w-0 flex flex-col items-start">
                    <span class="text-sm font-medium text-white truncate w-full ${isSelected ? 'text-yellow-400' : ''}">${lang.name}</span>
                    <span class="text-xs text-gray-400 truncate w-full">${lang.enName}</span>
                </div>
                ${isSelected ? '<i class="fa-solid fa-circle-check text-yellow-500 text-lg ml-2"></i>' : ''}
            `;
            btn.addEventListener('click', () => {
                setLanguage(lang.code);
                closeModal();
                showToast(lang.name);
                renderLanguages(searchInput.value);
            });
            grid.appendChild(btn);
        });
    }
}

function openModal() {
    modal.classList.add('active');
    document.body.style.overflow = 'hidden';
    setTimeout(() => searchInput.focus(), 100);
}
function closeModal() {
    modal.classList.remove('active');
    document.body.style.overflow = '';
}
function showToast(langName) {
    toastLangName.textContent = langName;
    toast.classList.add('show');
    clearTimeout(toastTimeout);
    toastTimeout = setTimeout(() => toast.classList.remove('show'), 3000);
}

triggerBtn.addEventListener('click', openModal);
closeBtn.addEventListener('click', closeModal);
modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && modal.classList.contains('active')) closeModal(); });
searchInput.addEventListener('input', (e) => renderLanguages(e.target.value));

window.addEventListener('DOMContentLoaded', () => {
    // 초기 언어 설정 적용
    setLanguage(getInitialLanguage());
    renderLanguages();
});

// [홈 이모지 전체 화면 지체 없이 첫화면 가는 소스 로직 병합 적용]
document.getElementById('btn-home').addEventListener('click', (e) => {
    if (document.fullscreenElement) {
        e.preventDefault(); // 기본 링크 이동 막기
        // 화면 초기화 로직 실행
        gameState = 'START';
        cancelAnimationFrame(frameId);
        
        document.getElementById('ui-layer').style.display = 'none';
        document.getElementById('game-over-screen').classList.add('hidden');
        document.getElementById('levelup-screen').classList.add('hidden');
        document.getElementById('start-screen').classList.remove('hidden');
        
        // 캔버스 클리어
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        
        if(window.playSound) window.playSound('click');
    } else {
        // 전체화면이 아닐 경우 링크로 이동되게 하거나 원하는 사이트로 리로드
        window.location.href = '/';
        e.preventDefault();
    }
});

// --- 기존 게임 로직 (완전 원형 보존) ---
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');

let playerNickname = "";
let isScoreSaved = false;
let inputLockUntil = 0;

let score = 0;
let _securityCode = 0;
const _salt = 521;
const _base = 999;
let lastBossLevel = 0;

let items = [];         
let freezeTimer = 0;    
let announcement = { text: "", subText: "", timer: 0, color: "" }; 

function addScore(amount) {
    score += amount;
    _securityCode += amount * _salt;
}
function resetScore() {
    score = 0;
    _securityCode = _base;
}
function verifyScore() {
    return _securityCode === (score * _salt) + _base;
}

let gameState = 'START';
let frameId;
let level = 1;
let xp = 0;
let xpToNextLevel = 10;
let gameTime = 0;

const player = {
    x: 0, y: 0, radius: 24, baseRadius: 24, speed: 4, color: '#FFD700',
    damage: 1, fireRate: 10, fireTimer: 0, projectiles: 1,
    bonuses: { two: 0, three: 0, five: 0, triangle: 0, square: 0, pentagon: 0, divisors: { 12: 0, 24: 0, 48: 0, 96: 0 } },
    critChance: 0, awakenedTime: 0, hasShield: false 
};

const mouse = { x: 0, y: 0 };
let bullets = []; let enemies = []; let particles = []; let damageTexts = []; let xpOrbs = [];

const AudioContext = window.AudioContext || window.webkitAudioContext;
const audioCtx = new AudioContext();
const bufferSize = audioCtx.sampleRate * 2;
const noiseBuffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
const noiseOutput = noiseBuffer.getChannelData(0);
for (let i = 0; i < bufferSize; i++) { noiseOutput[i] = Math.random() * 2 - 1; }

function playSound(type) {
    if (audioCtx.state === 'suspended') audioCtx.resume();
    const now = audioCtx.currentTime;
    if (type === 'shoot') {
        const osc = audioCtx.createOscillator(); const gain = audioCtx.createGain();
        osc.connect(gain); gain.connect(audioCtx.destination);
        osc.type = 'triangle'; osc.frequency.setValueAtTime(600, now); osc.frequency.exponentialRampToValueAtTime(100, now + 0.15);
        gain.gain.setValueAtTime(0.1, now); gain.gain.exponentialRampToValueAtTime(0.001, now + 0.15);
        osc.start(now); osc.stop(now + 0.15);
    } else if (type === 'hit') {
        const osc = audioCtx.createOscillator(); const gain = audioCtx.createGain();
        osc.connect(gain); gain.connect(audioCtx.destination);
        osc.type = 'square'; osc.frequency.setValueAtTime(150, now); osc.frequency.exponentialRampToValueAtTime(50, now + 0.05);
        gain.gain.setValueAtTime(0.1, now); gain.gain.exponentialRampToValueAtTime(0.001, now + 0.05);
        osc.start(now); osc.stop(now + 0.05);
    } else if (type === 'explode') {
        const src = audioCtx.createBufferSource(); src.buffer = noiseBuffer;
        const filter = audioCtx.createBiquadFilter(); filter.type = 'lowpass'; const gain = audioCtx.createGain();
        src.connect(filter); filter.connect(gain); gain.connect(audioCtx.destination);
        filter.frequency.setValueAtTime(1000, now); filter.frequency.exponentialRampToValueAtTime(100, now + 0.3);
        gain.gain.setValueAtTime(0.3, now); gain.gain.exponentialRampToValueAtTime(0.001, now + 0.3);
        src.start(now); src.stop(now + 0.3);
    } else if (type === 'crit') {
        const osc = audioCtx.createOscillator(); const gain = audioCtx.createGain();
        osc.connect(gain); gain.connect(audioCtx.destination);
        osc.type = 'sawtooth'; osc.frequency.setValueAtTime(800, now); osc.frequency.exponentialRampToValueAtTime(1600, now + 0.15); 
        gain.gain.setValueAtTime(0.15, now); gain.gain.exponentialRampToValueAtTime(0.001, now + 0.2);
        osc.start(now); osc.stop(now + 0.2);
    } else if (type === 'levelup') {
        [523.25, 659.25, 783.99, 1046.50].forEach((freq, i) => {
            const osc = audioCtx.createOscillator(); const gain = audioCtx.createGain();
            osc.connect(gain); gain.connect(audioCtx.destination);
            const t = now + i * 0.1; osc.type = 'triangle'; osc.frequency.value = freq;
            gain.gain.setValueAtTime(0, t); gain.gain.linearRampToValueAtTime(0.1, t + 0.05); gain.gain.exponentialRampToValueAtTime(0.001, t + 0.5);
            osc.start(t); osc.stop(t + 0.5);
        });
    } else if (type === 'gameover_music') {
        const notes = [{f: 440, d: 1.0}, {f: 392, d: 1.0}, {f: 349, d: 1.0}, {f: 329, d: 2.0}, {f: 293, d: 1.0}, {f: 261, d: 1.0}, {f: 220, d: 3.0}];
        let currentTime = now;
        notes.forEach(n => {
            const osc = audioCtx.createOscillator(); const gain = audioCtx.createGain();
            osc.connect(gain); gain.connect(audioCtx.destination);
            osc.type = 'sine'; osc.frequency.value = n.f;
            gain.gain.setValueAtTime(0, currentTime); gain.gain.linearRampToValueAtTime(0.2, currentTime + 0.1); gain.gain.linearRampToValueAtTime(0, currentTime + n.d);
            osc.start(currentTime); osc.stop(currentTime + n.d);
            currentTime += n.d;
        });
    } else if (type === 's_magnet') {
        const osc = audioCtx.createOscillator(); const gain = audioCtx.createGain();
        osc.connect(gain); gain.connect(audioCtx.destination);
        osc.type = 'sine'; osc.frequency.setValueAtTime(200, now); osc.frequency.exponentialRampToValueAtTime(600, now + 0.5);
        gain.gain.setValueAtTime(0.1, now); gain.gain.linearRampToValueAtTime(0, now + 0.5);
        osc.start(now); osc.stop(now + 0.5);
    } else if (type === 's_freeze') {
        const osc = audioCtx.createOscillator(); const gain = audioCtx.createGain();
        osc.connect(gain); gain.connect(audioCtx.destination);
        osc.type = 'sine'; osc.frequency.setValueAtTime(1200, now); gain.gain.setValueAtTime(0.1, now); gain.gain.exponentialRampToValueAtTime(0.001, now + 1.0);
        osc.start(now); osc.stop(now + 1.0);
    } else if (type === 's_shield') {
        const osc = audioCtx.createOscillator(); const gain = audioCtx.createGain();
        osc.connect(gain); gain.connect(audioCtx.destination);
        osc.type = 'square'; osc.frequency.setValueAtTime(400, now); osc.frequency.exponentialRampToValueAtTime(800, now + 0.1);
        gain.gain.setValueAtTime(0.1, now); gain.gain.exponentialRampToValueAtTime(0.001, now + 0.3);
        osc.start(now); osc.stop(now + 0.3);
    } else if (type === 's_bomb_item') {
        const osc = audioCtx.createOscillator(); const gain = audioCtx.createGain();
        osc.connect(gain); gain.connect(audioCtx.destination);
        osc.type = 'sawtooth'; osc.frequency.setValueAtTime(100, now); osc.frequency.exponentialRampToValueAtTime(50, now + 0.3);
        gain.gain.setValueAtTime(0.2, now); gain.gain.exponentialRampToValueAtTime(0.001, now + 0.3);
        osc.start(now); osc.stop(now + 0.3);
    }
}

function resize() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
window.addEventListener('resize', resize);
resize();

function handleInput(e) {
    if (gameState !== 'PLAYING') return; 
    if (e.target.closest('.card') || e.target.tagName === 'BUTTON' || e.target.tagName === 'INPUT' || e.target.tagName === 'SELECT' || e.target.tagName === 'A') return;
    if (Date.now() < inputLockUntil) return;

    e.preventDefault();
    let clientX, clientY;
    if (e.touches && e.touches.length > 0) { clientX = e.touches[0].clientX; clientY = e.touches[0].clientY; }
    else { clientX = e.clientX; clientY = e.clientY; }
    mouse.x = clientX; mouse.y = clientY;
}
window.addEventListener('touchstart', handleInput, { passive: false });
window.addEventListener('touchmove', handleInput, { passive: false });
window.addEventListener('mousemove', (e) => { 
    if (Date.now() < inputLockUntil) return;
    mouse.x = e.clientX; mouse.y = e.clientY; 
});

function randomRange(min, max) { return Math.random() * (max - min) + min; }
function getDistance(x1, y1, x2, y2) { return Math.hypot(x1 - x2, y1 - y2); }

function showAnnouncement(main, sub, color) {
    announcement.text = main; announcement.subText = sub; announcement.color = color; announcement.timer = 120;
}

class Bullet {
    constructor(x, y, angle, damage) {
        this.x = x; this.y = y; this.speed = 12;
        this.vx = Math.cos(angle) * this.speed; this.vy = Math.sin(angle) * this.speed;
        this.damage = damage; this.radius = 6; this.life = 80; this.color = '#ffff00';
    }
    update() { this.x += this.vx; this.y += this.vy; this.life--; }
    draw() {
        ctx.beginPath(); ctx.arc(this.x, this.y, this.radius, 0, Math.PI * 2);
        ctx.fillStyle = this.color; ctx.fill();
        ctx.fillStyle = 'black'; ctx.font = 'bold 10px Jua';
        ctx.textAlign = 'center'; ctx.textBaseline = 'middle'; ctx.fillText(Math.floor(this.damage), this.x, this.y);
    }
}

class Enemy {
    constructor(isBoss = false) {
        this.isBoss = isBoss;
        if (Math.random() < 0.5) { this.x = Math.random() < 0.5 ? -50 : canvas.width + 50; this.y = Math.random() * canvas.height; }
        else { this.x = Math.random() * canvas.width; this.y = Math.random() < 0.5 ? -50 : canvas.height + 50; }

        const allowedColors = ['#FF0000', '#FFFF00', '#0000FF', '#00FF00'];
        const assignedColor = allowedColors[Math.floor(Math.random() * allowedColors.length)];

        if (this.isBoss) {
            if (level >= 20) {
                const playerPower = player.damage * player.projectiles * (60 / player.fireRate);
                this.hp = Math.floor(playerPower * 50); 
                this.speed = 0.5; 
            } else {
                this.hp = Math.floor(level * 100 * (level / 5) * 0.7); 
                this.speed = 0.5 + (level * 0.02);
            }
            this.hp = Math.max(1, Math.floor(this.hp * 0.7));
            this.maxHp = this.hp;
            this.radius = 60 + (level * 1.5); 
            if (this.radius > 120) this.radius = 120;
            this.sides = 12; this.spinSpeed = 0.01; 
            this.color = assignedColor; 
        } else {
            let hpMin = 3 + level * 2; let hpMax = 8 + level * 5;
            if (level >= 3 && level <= 5) { hpMin = Math.floor(hpMin * 1.5); hpMax = Math.floor(hpMax * 1.5); }
            if (level >= 10) {
               const multiplier = 1 + (level - 9) * 0.1;
               hpMin = Math.floor(hpMin * multiplier); hpMax = Math.floor(hpMax * multiplier);
            }
            this.hp = Math.floor(randomRange(hpMin, hpMax) * 0.9);
            if (this.hp < 1) this.hp = 1;
            this.hp = Math.max(1, Math.floor(this.hp * 0.7));
            this.maxHp = this.hp;

            let baseSpeed = randomRange(0.6, 1.4); let speedMultiplier = level * 0.04;
            if (level >= 3) speedMultiplier += 0.5;
            this.speed = baseSpeed + speedMultiplier;
            this.radius = 20 + (this.hp * 1.2); if (this.radius > 55) this.radius = 55;
            this.sides = Math.floor(randomRange(3, 7)); this.spinSpeed = randomRange(-0.03, 0.03);
            this.color = assignedColor;
        }
        this.angle = 0;
    }
    update() {
        if (freezeTimer > 0) return;
        const angle = Math.atan2(player.y - this.y, player.x - this.x);
        this.x += Math.cos(angle) * this.speed; this.y += Math.sin(angle) * this.speed; this.angle += this.spinSpeed;
    }
    draw() {
        ctx.save(); ctx.translate(this.x, this.y); ctx.rotate(this.angle);
        ctx.beginPath();
        for (let i = 0; i < this.sides; i++) {
            const rot = (i * 2 * Math.PI) / this.sides;
            const px = Math.cos(rot) * this.radius; const py = Math.sin(rot) * this.radius;
            if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
        }
        ctx.closePath();
        
        if (this.isBoss) {
            ctx.fillStyle = 'rgba(20, 20, 20, 0.95)'; 
            ctx.strokeStyle = this.color; 
            ctx.lineWidth = 5; ctx.shadowBlur = 20; ctx.shadowColor = this.color;
        } else {
            ctx.fillStyle = 'rgba(0, 0, 0, 0.9)'; 
            ctx.strokeStyle = this.color; 
            ctx.lineWidth = 3; ctx.shadowBlur = 0;
        }
        
        ctx.fill(); ctx.stroke(); ctx.restore();

        ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
        if (this.isBoss) {
            ctx.font = 'bold 24px Jua'; ctx.fillStyle = this.color; ctx.fillText("BOSS", this.x, this.y - this.radius - 20);
            ctx.font = `bold ${this.radius * 0.4}px 'Jua', sans-serif`;
        } else {
            ctx.font = `bold ${this.radius * 0.8}px 'Jua', sans-serif`;
        }

        ctx.lineWidth = 4; ctx.strokeStyle = 'black'; ctx.lineJoin = 'round';
        const displayHp = this.hp === Infinity ? '∞' : Math.ceil(this.hp);
        ctx.strokeText(displayHp, this.x, this.y); ctx.fillStyle = '#fff'; ctx.fillText(displayHp, this.x, this.y);
    }
}

class Item {
    constructor(x, y, type) {
        this.x = x; this.y = y; this.type = type; this.life = 600; this.bobOffset = Math.random() * Math.PI * 2;
        switch (type) {
            case 'odd':    this.icon = '1️⃣'; this.color = '#FFA500'; break;
            case 'even':   this.icon = '2️⃣'; this.color = '#4444FF'; break;
            case 'freeze': this.icon = '❄️'; this.color = '#00FFFF'; break;
            case 'magnet': this.icon = '🧲'; this.color = '#FF00FF'; break;
            case 'bomb':   this.icon = '💣'; this.color = '#FF0000'; break;
            case 'shield': this.icon = '🛡️'; this.color = '#00FF00'; break;
            case 'virus_red':    this.icon = '🔴'; this.color = '#FF0000'; break;
            case 'virus_yellow': this.icon = '🟡'; this.color = '#FFFF00'; break;
            case 'virus_blue':   this.icon = '🔵'; this.color = '#0000FF'; break;
            case 'virus_green':  this.icon = '🟢'; this.color = '#00FF00'; break;
        }
    }
    update() { this.life--; }
    draw() {
        const bobY = Math.sin(Date.now() / 200 + this.bobOffset) * 5;
        ctx.save(); ctx.translate(this.x, this.y + bobY);
        if (this.life < 120) {
            const flickerInterval = Math.max(5, Math.floor(this.life / 6));
            if (this.life % flickerInterval < flickerInterval / 2) { ctx.globalAlpha = 0.2; } else { ctx.globalAlpha = 1.0; }
        }
        ctx.shadowBlur = 0; ctx.font = '45px Arial'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
        ctx.lineWidth = 4; ctx.strokeStyle = this.color; ctx.strokeText(this.icon, 0, 0); ctx.fillText(this.icon, 0, 0);
        ctx.restore(); ctx.globalAlpha = 1;
    }
}

class Particle {
    constructor(x, y, color) {
        this.x = x; this.y = y; this.vx = randomRange(-5, 5); this.vy = randomRange(-5, 5);
        this.life = randomRange(15, 30); this.color = color; this.size = randomRange(2, 5);
    }
    update() { this.x += this.vx; this.y += this.vy; this.life--; this.size *= 0.9; }
    draw() { ctx.globalAlpha = this.life / 30; ctx.fillStyle = this.color; ctx.fillRect(this.x, this.y, this.size, this.size); ctx.globalAlpha = 1; }
}

class FloatingText {
    constructor(x, y, text, color, size = 20) {
        this.x = x + randomRange(-15, 15); this.y = y + randomRange(-15, 15); this.text = text; this.color = color; this.life = 35;
        this.vy = -3.5; this.vx = randomRange(-1.5, 1.5); this.size = size;
    }
    update() { this.x += this.vx; this.y += this.vy; this.life--; }
    draw() {
        ctx.globalAlpha = this.life / 35; ctx.fillStyle = this.color; ctx.strokeStyle = 'black'; ctx.lineWidth = 2;
        ctx.font = `bold ${this.size}px Jua`; ctx.strokeText(this.text, this.x, this.y); ctx.fillText(this.text, this.x, this.y); ctx.globalAlpha = 1;
    }
}

class XpOrb {
    constructor(x, y, val) { this.x = x; this.y = y; this.val = val; this.radius = 5; this.attracted = false; }
    update() {
        const d = getDistance(this.x, this.y, player.x, player.y);
        if (d < 150) this.attracted = true;
        if (this.attracted) {
            const angle = Math.atan2(player.y - this.y, player.x - this.x);
            this.x += Math.cos(angle) * 8; this.y += Math.sin(angle) * 8;
        }
        return d < player.radius + 10;
    }
    draw() { ctx.beginPath(); ctx.arc(this.x, this.y, this.radius, 0, Math.PI*2); ctx.fillStyle = '#00ff00'; ctx.fill(); }
}

function init() {
    resetScore();
    const titleEl = document.querySelector('#game-over-screen h2');
    titleEl.innerText = i18nData[currentLang]?.defeat || "패배...";
    titleEl.classList.remove('text-yellow-400');
    titleEl.classList.add('text-gray-400');

    level = 1; xp = 0; xpToNextLevel = 10; gameTime = 0; lastBossLevel = 0;
    player.x = canvas.width / 2; player.y = canvas.height / 2;
    player.damage = 1; player.projectiles = 1; player.fireRate = 10; player.radius = player.baseRadius;
    player.awakenedTime = 0; player.hasShield = false;
    player.bonuses = { two: 0, three: 0, five: 0, triangle: 0, square: 0, pentagon: 0, divisors: { 12: 0, 24: 0, 48: 0, 96: 0 } };
    player.critChance = 0;
    bullets = []; enemies = []; particles = []; damageTexts = []; xpOrbs = []; items = [];
    freezeTimer = 0; announcement = { text: "", subText: "", timer: 0, color: "" };
    isScoreSaved = false; updateUi();
}

function triggerDefenseSuccess() {
    gameState = 'GAMEOVER';
    document.getElementById('finalScore').innerText = score;
    const gameOverScreen = document.getElementById('game-over-screen');
    gameOverScreen.classList.remove('hidden');
    
    const titleEl = gameOverScreen.querySelector('h2');
    titleEl.innerText = "디펜스 성공!";
    titleEl.classList.remove('text-gray-400');
    titleEl.classList.add('text-yellow-400'); 
    
    document.getElementById('restartBtn').classList.add('hidden');
    playSound('levelup'); 
    if (!isScoreSaved) autoSubmitScore();
}

function updateUi() {
    document.getElementById('scoreVal').innerText = score;
    document.getElementById('dmgVal').innerText = player.damage;
    document.getElementById('levelVal').innerText = level;
    
    const statsContainer = document.getElementById('bonusStats');
    statsContainer.innerHTML = '';
    
    const addStat = (text, color) => {
        const div = document.createElement('div');
        div.innerText = text; div.className = color; 
        statsContainer.appendChild(div);
    };

    if (player.critChance > 0) addStat(`2배 확률 ${Math.floor(player.critChance * 100)}%`, "text-yellow-400");
    if (player.bonuses.two > 0) addStat(`2의 배수 +${Math.round(player.bonuses.two * 100)}%`, "text-white");
    if (player.bonuses.three > 0) addStat(`3의 배수 +${Math.round(player.bonuses.three * 100)}%`, "text-green-400");
    if (player.bonuses.five > 0) addStat(`5의 배수 +${Math.round(player.bonuses.five * 100)}%`, "text-purple-400");
    
    [12, 24, 48, 96].forEach(num => {
        if (player.bonuses.divisors[num] > 0) addStat(`${num}의 약수 +${Math.round(player.bonuses.divisors[num] * 100)}%`, "text-pink-400");
    });

    if (player.bonuses.triangle > 0) addStat(`🔺 +${Math.round(player.bonuses.triangle * 100)}%`, "text-red-400");
    if (player.bonuses.square > 0) addStat(`🟥 +${Math.round(player.bonuses.square * 100)}%`, "text-blue-400");
    if (player.bonuses.pentagon > 0) addStat(`⬠ +${Math.round(player.bonuses.pentagon * 100)}%`, "text-orange-400");
    
    updateXpBar();
}

function spawnEnemy() {
    if ((level % 5 === 0 || level >= 20) && lastBossLevel !== level) {
        enemies.push(new Enemy(true));
        lastBossLevel = level;
        damageTexts.push(new FloatingText(player.x, player.y - 120, "⚠️ WARNING ⚠️", '#ff0000', 40));
        damageTexts.push(new FloatingText(player.x, player.y - 80, "BOSS APPEARED!", '#ff0000', 30));
        playSound('levelup');
        return;
    }
    const baseSpawnRate = Math.max(20, 70 - (level * 2) - Math.floor(gameTime / 500));
    const spawnRate = Math.max(8, Math.floor(baseSpawnRate / 1.5));
    if (gameTime % spawnRate === 0) enemies.push(new Enemy(false));
}

function findNearestEnemy() {
    let nearest = null; let minDist = Infinity;
    for (const e of enemies) {
        const d = getDistance(player.x, player.y, e.x, e.y);
        if (d < minDist && d < 400) { minDist = d; nearest = e; }
    }
    return nearest;
}

function levelUp() {
    gameState = 'LEVELUP';
    document.getElementById('levelup-screen').classList.remove('hidden');
    document.getElementById('cards-container').style.display = 'flex';
    playSound('levelup');
    const container = document.getElementById('cards-container');
    container.innerHTML = '';
    
    const t = i18nData[currentLang] || i18nData['en'];

    const upgrades = [
        { type: 'add', val: 1, title: t.c_add1_t, desc: t.c_add1_d, math: t.c_add1_m },
        { type: 'add', val: 2, title: t.c_add2_t, desc: t.c_add2_d, math: t.c_add2_m }, 
        { type: 'mult', val: 1.5, title: t.c_mult_t, desc: t.c_mult_d, math: t.c_mult_m },
        { type: 'proj', val: 1, title: t.c_proj_t, desc: t.c_proj_d, math: t.c_proj_m },
        { type: 'rate', val: 0.85, title: t.c_rate_t, desc: t.c_rate_d, math: t.c_rate_m },
        { type: 'bonus_two', val: 0.5, title: t.c_b2_t, desc: t.c_b2_d, math: t.c_b2_m },
        { type: 'bonus_three', val: 0.5, title: t.c_b3_t, desc: t.c_b3_d, math: t.c_b3_m },
        { type: 'bonus_five', val: 0.5, title: t.c_b5_t, desc: t.c_b5_d, math: t.c_b5_m },
        { type: 'bonus_div', num: 12, val: 1.0, title: t.c_div12_t, desc: t.c_div12_d, math: t.c_div12_m },
        { type: 'bonus_div', num: 24, val: 1.0, title: t.c_div24_t, desc: t.c_div24_d, math: t.c_div24_m },
        { type: 'bonus_div', num: 48, val: 1.0, title: t.c_div48_t, desc: t.c_div48_d, math: t.c_div48_m },
        { type: 'bonus_div', num: 96, val: 1.0, title: t.c_div96_t, desc: t.c_div96_d, math: t.c_div96_m },
        { type: 'bonus_shape', sides: 3, val: 0.5, title: t.c_tri_t, desc: t.c_tri_d, math: t.c_tri_m },
        { type: 'bonus_shape', sides: 4, val: 0.5, title: t.c_squ_t, desc: t.c_squ_d, math: t.c_squ_m },
        { type: 'bonus_shape', sides: 5, val: 0.5, title: t.c_pen_t, desc: t.c_pen_d, math: t.c_pen_m },
        { type: 'crit', val: 0.2, title: t.c_crit_t, desc: t.c_crit_d, math: t.c_crit_m },
        { type: 'awakening', title: t.c_wake_t, desc: t.c_wake_d, math: t.c_wake_m }
    ];

    let picks = [];
    if (level <= 5) {
        const mandatories = upgrades.filter(u => (u.type === 'add' && u.val === 2) || u.type === 'proj' || u.type === 'rate');
        const guaranteed = mandatories[Math.floor(Math.random() * mandatories.length)];
        picks.push(guaranteed);
        let others = upgrades.filter(u => u !== guaranteed);
        others.sort(() => Math.random() - 0.4); 
        picks.push(...others.slice(0, 2));
    } else {
        upgrades.sort(() => Math.random() - 0.5);
        picks = upgrades.slice(0, 3);
    }

    picks.forEach(up => {
        const card = document.createElement('div');
        card.className = 'card';
        card.innerHTML = `<div class="card-title">${up.title}</div><div class="card-math text-center">${up.math}</div><div class="card-desc">${up.desc}</div>`;
        card.onclick = (e) => { e.stopPropagation(); applyUpgrade(up); };
        container.appendChild(card);
    });

    adjustFontSize();
}

function applyUpgrade(up) {
    if (up.type === 'add') player.damage += up.val;
    else if (up.type === 'mult') player.damage = Math.floor(player.damage * up.val) || 1;
    else if (up.type === 'proj') player.projectiles += up.val;
    else if (up.type === 'rate') player.fireRate = Math.max(5, Math.floor(player.fireRate * up.val));
    else if (up.type === 'bonus_two') player.bonuses.two += up.val;
    else if (up.type === 'bonus_three') player.bonuses.three += up.val;
    else if (up.type === 'bonus_five') player.bonuses.five += up.val;
    else if (up.type === 'bonus_div') { if (player.bonuses.divisors[up.num] !== undefined) player.bonuses.divisors[up.num] += up.val; }
    else if (up.type === 'crit') player.critChance = Math.min(1.0, player.critChance + up.val);
    else if (up.type === 'bonus_shape') {
        if (up.sides === 3) player.bonuses.triangle += up.val;
        else if (up.sides === 4) player.bonuses.square += up.val;
        else if (up.sides >= 5) player.bonuses.pentagon += up.val;
    }
    else if (up.type === 'awakening') {
        player.awakenedTime = 300;
        damageTexts.push(new FloatingText(player.x, player.y - 40, "AWAKENING!", '#FFD700', 40));
    }

    updateUi();
    inputLockUntil = Date.now() + 500; 
    mouse.x = player.x; mouse.y = player.y;
    gameState = 'PLAYING';
    document.getElementById('levelup-screen').classList.add('hidden');
    requestAnimationFrame(loop);
}

function addXp(amount) {
    xp += amount;
    if (xp >= xpToNextLevel) {
        xp = 0; xpToNextLevel = Math.floor(xpToNextLevel * 1.3); level++;
        player.radius = player.baseRadius + Math.min(26, (level - 1) * 2); levelUp();
    }
    updateXpBar();
}
function updateXpBar() { const pct = (xp / xpToNextLevel) * 100; document.getElementById('xpBar').style.width = `${pct}%`; }

function update() {
    if (gameState !== 'PLAYING') return;
    gameTime++;

    if (player.awakenedTime > 0) player.awakenedTime--;
    if (freezeTimer > 0) freezeTimer--;

    if (Date.now() >= inputLockUntil) {
        const dx = mouse.x - player.x; const dy = mouse.y - player.y;
        if (Math.hypot(dx, dy) > 5) { player.x += dx * 0.05; player.y += dy * 0.05; }
        if (player.awakenedTime > 0 && frameId % 5 === 0) particles.push(new Particle(player.x, player.y, `hsl(${Math.random()*360}, 100%, 70%)`));
        player.x = Math.max(player.radius, Math.min(canvas.width - player.radius, player.x));
        player.y = Math.max(player.radius, Math.min(canvas.height - player.radius, player.y));
    }

    player.fireTimer += (player.awakenedTime > 0 ? 5 : 1);
    
    if (player.fireTimer >= player.fireRate) {
        const target = findNearestEnemy();
        if (target) {
            player.fireTimer = 0;
            const angle = Math.atan2(target.y - player.y, target.x - player.x);
            const currentProjectiles = player.projectiles + (player.awakenedTime > 0 ? 5 : 0);
            for(let i=0; i < currentProjectiles; i++) {
                const spread = (i - (currentProjectiles-1)/2) * 0.2;
                const dmgMultiplier = (player.awakenedTime > 0 ? 5 : 1);
                bullets.push(new Bullet(player.x, player.y, angle + spread, player.damage * dmgMultiplier));
            }
            playSound('shoot');
        }
    }
    spawnEnemy();

    const t = i18nData[currentLang] || i18nData['en'];
    items.forEach((item, index) => {
        item.update();
        if (item.life <= 0) { items.splice(index, 1); return; }
        
        const dist = getDistance(player.x, player.y, item.x, item.y);
        if (dist < player.radius + 20) {
            if (item.type === 'odd') {
                playSound('s_bomb_item'); 
                enemies.forEach((e) => {
                    if (Math.ceil(e.hp) % 2 !== 0 && !e.isBoss) {
                        e.hp = 1; e.radius = 20 + (1 * 1.2); 
                        damageTexts.push(new FloatingText(e.x, e.y, "HP=1", '#FFA500', 30));
                        for(let k=0; k<5; k++) particles.push(new Particle(e.x, e.y, '#FFA500'));
                    }
                });
                showAnnouncement(t.item_odd_t || "1", t.item_odd_d || "", "#FFA500");
            } else if (item.type === 'even') {
                playSound('s_bomb_item'); 
                enemies.forEach((e) => {
                    if (Math.ceil(e.hp) % 2 === 0 && !e.isBoss) {
                        e.hp = 2; e.radius = 20 + (2 * 1.2); 
                        damageTexts.push(new FloatingText(e.x, e.y, "HP=2", '#4444FF', 30));
                        for(let k=0; k<5; k++) particles.push(new Particle(e.x, e.y, '#4444FF'));
                    }
                });
                showAnnouncement(t.item_even_t || "2", t.item_even_d || "", "#4444FF");
            } else if (item.type === 'freeze') {
                playSound('s_freeze'); freezeTimer = 300; showAnnouncement(t.item_freeze_t || "❄️", t.item_freeze_d || "", "#00FFFF");
            } else if (item.type === 'magnet') {
                playSound('s_magnet'); xpOrbs.forEach(orb => orb.attracted = true); showAnnouncement(t.item_magnet_t || "🧲", t.item_magnet_d || "", "#FF00FF");
            } else if (item.type === 'bomb') {
                playSound('s_bomb_item'); particles.push(new Particle(player.x, player.y, '#FF0000')); 
                for (let k = enemies.length - 1; k >= 0; k--) {
                    let en = enemies[k];
                    if (en.x >= 0 && en.x <= canvas.width && en.y >= 0 && en.y <= canvas.height && !en.isBoss) {
                        addScore(Math.floor(en.maxHp * 10)); xpOrbs.push(new XpOrb(en.x, en.y, 1));
                        damageTexts.push(new FloatingText(en.x, en.y, "BOOM!", '#FF0000', 40));
                        for(let p=0; p<8; p++) particles.push(new Particle(en.x, en.y, '#FF4500'));
                        enemies.splice(k, 1);
                    }
                }
                updateUi(); playSound('explode'); showAnnouncement(t.item_bomb_t || "💣", t.item_bomb_d || "", "#FF0000");
            } else if (item.type === 'shield') {
                playSound('s_shield'); player.hasShield = true; showAnnouncement(t.item_shield_t || "🛡️", t.item_shield_d || "", "#00FF00");
            } else if (item.type.startsWith('virus_')) {
                playSound('s_bomb_item'); 
                let targetColor = '', title = '', desc = '';
                if (item.type === 'virus_red') { targetColor = '#FF0000'; title = t.item_v_red_t || "🔴"; desc = t.item_v_red_d || ""; }
                else if (item.type === 'virus_yellow') { targetColor = '#FFFF00'; title = t.item_v_yellow_t || "🟡"; desc = t.item_v_yellow_d || ""; }
                else if (item.type === 'virus_blue') { targetColor = '#0000FF'; title = t.item_v_blue_t || "🔵"; desc = t.item_v_blue_d || ""; }
                else if (item.type === 'virus_green') { targetColor = '#00FF00'; title = t.item_v_green_t || "🟢"; desc = t.item_v_green_d || ""; }
                enemies.forEach((e) => {
                    if (e.color === targetColor && !e.isBoss) {
                        e.hp = 1; e.radius = 20 + (1 * 1.2); 
                        damageTexts.push(new FloatingText(e.x, e.y, "HP=1", targetColor, 30));
                        for(let k=0; k<5; k++) particles.push(new Particle(e.x, e.y, targetColor));
                    }
                });
                showAnnouncement(title, desc, targetColor);
            }
            items.splice(index, 1);
        }
    });

    bullets.forEach((b, i) => {
        b.update();
        if (b.life <= 0 || b.x < 0 || b.x > canvas.width || b.y < 0 || b.y > canvas.height) bullets.splice(i, 1);
    });

    enemies.forEach((e, i) => {
        e.update();
        if (getDistance(player.x, player.y, e.x, e.y) < player.radius + e.radius) {
            if (player.awakenedTime > 0) {
                if (e.isBoss && level >= 20) { addScore(200000); updateUi(); triggerDefenseSuccess(); return; }
                addScore(Math.floor(e.maxHp * 10)); updateUi(); enemies.splice(i, 1);
                xpOrbs.push(new XpOrb(e.x, e.y, 1));
                for(let k=0; k<15; k++) particles.push(new Particle(e.x, e.y, e.color));
                damageTexts.push(new FloatingText(e.x, e.y, "KILL!", '#ff0000', 35)); playSound('explode');
                if (Math.random() < 0.15) {
                    const rand = Math.random(); let type = '';
                    if (rand < 0.1) type = 'odd'; else if (rand < 0.2) type = 'even'; else if (rand < 0.3) type = 'virus_red'; else if (rand < 0.4) type = 'virus_yellow'; else if (rand < 0.5) type = 'virus_blue'; else if (rand < 0.6) type = 'virus_green'; else if (rand < 0.7) type = 'magnet'; else if (rand < 0.8) type = 'bomb'; else if (rand < 0.9) type = 'freeze'; else type = 'shield';
                    items.push(new Item(e.x, e.y, type));
                }
                return;
            }

            if (player.hasShield) {
                player.hasShield = false;
                e.x += (e.x - player.x) * 2; e.y += (e.y - player.y) * 2; playSound('hit');
                damageTexts.push(new FloatingText(player.x, player.y, "BLOCK!", '#00FF00', 40));
                for(let k=0; k<10; k++) particles.push(new Particle(player.x, player.y, '#00FF00'));
                showAnnouncement(t.msg_shield_break || "🛡️", t.msg_shield_break_d || "🛡️", "#00FF00");
                enemies.forEach(en => {
                    if (getDistance(player.x, player.y, en.x, en.y) <= 300 && !en.isBoss) {
                        en.hp = 1; en.radius = 20 + (1 * 1.2);
                        damageTexts.push(new FloatingText(en.x, en.y, "HP=1", '#00FF00', 30));
                        for(let k=0; k<5; k++) particles.push(new Particle(en.x, en.y, '#00FF00'));
                    }
                });
                return;
            }
            
            gameState = 'GAMEOVER';
            document.getElementById('finalScore').innerText = score;
            document.getElementById('game-over-screen').classList.remove('hidden');
            document.getElementById('restartBtn').classList.add('hidden');
            playSound('explode'); playSound('gameover_music');
            if (!isScoreSaved) autoSubmitScore();
        }

        bullets.forEach((b, bi) => {
            if (getDistance(b.x, b.y, e.x, e.y) < e.radius + b.radius) {
                let finalDmg = b.damage; let isCrit = false;
                const currentHpVal = Math.ceil(e.hp);
                if (player.bonuses.two > 0 && currentHpVal % 2 === 0) { finalDmg *= (1 + player.bonuses.two); isCrit = true; }
                if (player.bonuses.three > 0 && currentHpVal % 3 === 0) { finalDmg *= (1 + player.bonuses.three); isCrit = true; }
                if (player.bonuses.five > 0 && currentHpVal % 5 === 0) { finalDmg *= (1 + player.bonuses.five); isCrit = true; }
                if (player.bonuses.divisors[12] > 0 && 12 % currentHpVal === 0) { finalDmg *= (1 + player.bonuses.divisors[12]); isCrit = true; }
                if (player.bonuses.divisors[24] > 0 && 24 % currentHpVal === 0) { finalDmg *= (1 + player.bonuses.divisors[24]); isCrit = true; }
                if (player.bonuses.divisors[48] > 0 && 48 % currentHpVal === 0) { finalDmg *= (1 + player.bonuses.divisors[48]); isCrit = true; }
                if (player.bonuses.divisors[96] > 0 && 96 % currentHpVal === 0) { finalDmg *= (1 + player.bonuses.divisors[96]); isCrit = true; }
                if (player.bonuses.triangle > 0 && e.sides === 3) { finalDmg *= (1 + player.bonuses.triangle); isCrit = true; }
                if (player.bonuses.square > 0 && e.sides === 4) { finalDmg *= (1 + player.bonuses.square); isCrit = true; }
                if (player.bonuses.pentagon > 0 && e.sides >= 5) { finalDmg *= (1 + player.bonuses.pentagon); isCrit = true; }
                if (Math.random() < player.critChance) { finalDmg *= 2; isCrit = true; damageTexts.push(new FloatingText(e.x, e.y - 30, `2x!`, '#ff5555', 30)); }
                
                e.hp -= finalDmg;
                let newRadius = 20 + (Math.max(0, e.hp) * 1.2); if (newRadius > 55) newRadius = 55; e.radius = newRadius;
                if (isCrit) { damageTexts.push(new FloatingText(e.x, e.y - 10, `-${Math.floor(finalDmg)}`, '#ffcc00', 30)); playSound('crit'); }
                else { damageTexts.push(new FloatingText(e.x, e.y, `-${Math.floor(finalDmg)}`, '#fff', 20)); playSound('hit'); }
                bullets.splice(bi, 1);
                for(let k=0; k<3; k++) particles.push(new Particle(b.x, b.y, e.color));
                
                if (e.hp <= 0) {
                    if (e.isBoss && level >= 20) { addScore(200000); updateUi(); triggerDefenseSuccess(); return; }
                    addScore(Math.floor(e.maxHp * 10)); updateUi(); enemies.splice(i, 1);
                    xpOrbs.push(new XpOrb(e.x, e.y, 1));
                    for(let k=0; k<10; k++) particles.push(new Particle(e.x, e.y, e.color));
                    playSound('explode');
                    if (Math.random() < 0.15) {
                        const rand = Math.random(); let type = '';
                        if (rand < 0.1) type = 'odd'; else if (rand < 0.2) type = 'even'; else if (rand < 0.3) type = 'virus_red'; else if (rand < 0.4) type = 'virus_yellow'; else if (rand < 0.5) type = 'virus_blue'; else if (rand < 0.6) type = 'virus_green'; else if (rand < 0.7) type = 'magnet'; else if (rand < 0.8) type = 'bomb'; else if (rand < 0.9) type = 'freeze'; else type = 'shield';
                        items.push(new Item(e.x, e.y, type));
                    }
                }
            }
        });
    });

    xpOrbs.forEach((orb, i) => { if (orb.update()) { addXp(orb.val); xpOrbs.splice(i, 1); playSound('exp'); } });
    particles.forEach((p, i) => { p.update(); if (p.life <= 0) particles.splice(i, 1); });
    damageTexts.forEach((t, i) => { t.update(); if (t.life <= 0) damageTexts.splice(i, 1); });
}

function draw() {
    ctx.fillStyle = '#050505'; ctx.fillRect(0, 0, canvas.width, canvas.height);
    ctx.strokeStyle = '#1a1a2e'; ctx.lineWidth = 1; ctx.beginPath();
    for (let x = 0; x < canvas.width; x += 50) { ctx.moveTo(x, 0); ctx.lineTo(x, canvas.height); }
    for (let y = 0; y < canvas.height; y += 50) { ctx.moveTo(0, y); ctx.lineTo(canvas.width, y); }
    ctx.stroke();
    ctx.globalCompositeOperation = 'lighter';
    xpOrbs.forEach(orb => orb.draw()); bullets.forEach(b => b.draw()); enemies.forEach(e => e.draw()); particles.forEach(p => p.draw());
    items.forEach(item => item.draw());

    ctx.save(); ctx.translate(player.x, player.y);
    if (player.awakenedTime > 0) { ctx.shadowBlur = 40 + Math.random() * 20; ctx.shadowColor = `hsl(${Math.random() * 360}, 100%, 50%)`; ctx.fillStyle = '#fff'; }
    else { ctx.shadowBlur = 20; ctx.shadowColor = '#FFD700'; }
    
    if (player.hasShield) {
        ctx.beginPath(); ctx.arc(0, 0, player.radius + 10, 0, Math.PI * 2); ctx.lineWidth = 3;
        ctx.strokeStyle = `rgba(0, 255, 0, ${0.5 + Math.sin(Date.now() / 200) * 0.3})`; ctx.stroke();
        ctx.fillStyle = 'rgba(0, 255, 0, 0.1)'; ctx.fill();
    }

    ctx.font = `${player.radius * 1.8}px sans-serif`; ctx.textAlign = 'center'; ctx.textBaseline = 'middle'; ctx.fillText('👑', 0, 0); ctx.restore();
    ctx.globalCompositeOperation = 'source-over'; ctx.fillStyle = 'white'; ctx.font = 'bold 12px Jua'; ctx.textAlign = 'center'; ctx.fillText(Math.floor(player.damage), player.x, player.y - player.radius - 10);
    damageTexts.forEach(t => t.draw());

    if (announcement.timer > 0) {
        announcement.timer--;
        ctx.save(); ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
        ctx.font = 'bold 50px Jua'; ctx.fillStyle = announcement.color; ctx.lineWidth = 3; ctx.strokeStyle = 'black';
        ctx.strokeText(announcement.text, canvas.width/2, canvas.height * 0.15); ctx.fillText(announcement.text, canvas.width/2, canvas.height * 0.15);
        ctx.font = '30px Jua'; ctx.fillStyle = 'white'; ctx.lineWidth = 2; ctx.strokeStyle = 'black';
        ctx.strokeText(announcement.subText, canvas.width/2, canvas.height * 0.15 + 50); ctx.fillText(announcement.subText, canvas.width/2, canvas.height * 0.15 + 50);
        ctx.restore();
    }
}

function loop() {
    if (gameState === 'PLAYING') { update(); draw(); frameId = requestAnimationFrame(loop); }
    else if (gameState === 'LEVELUP') draw();
}

window.addEventListener('load', () => {
    const savedName = localStorage.getItem('kingMathNickname');
    if (savedName) document.getElementById('startNickname').value = savedName;
    loadRankings(); 
});

document.getElementById('startBtn').addEventListener('click', () => {
    const nameInput = document.getElementById('startNickname');
    const name = nameInput.value.trim();
    if (name.length < 1) { alert("닉네임을 입력해주세요!"); nameInput.focus(); return; }
    localStorage.setItem('kingMathNickname', name);
    playerNickname = name;
    document.getElementById('start-screen').classList.add('hidden');
    document.getElementById('ui-layer').style.display = 'block';
    if (audioCtx.state === 'suspended') audioCtx.resume();
    gameState = 'PLAYING'; init(); player.x = mouse.x; player.y = mouse.y; loop();
});

document.getElementById('restartBtn').addEventListener('click', () => {
    document.getElementById('game-over-screen').classList.add('hidden');
    loadRankings(); 
    document.getElementById('start-screen').classList.remove('hidden');
    document.getElementById('ui-layer').style.display = 'none';
});

const rankingList = document.getElementById('ranking-list');
async function loadRankings() {
    const t = i18nData[currentLang] || i18nData['en'];
    rankingList.innerHTML = `<div class="text-center text-gray-500 mt-10">${t.loading || 'Loading...'}</div>`;
    try {
        const res = await fetch('ranking.php?action=list');
        if(!res.ok) throw new Error('Network error');
        const data = await res.json();
        rankingList.innerHTML = '';
        if (data.length === 0) { rankingList.innerHTML = `<div class="text-center text-gray-500 mt-10 text-lg">${t.noRank || 'No rank'}</div>`; return; }
        data.forEach((item, index) => {
            const rank = index + 1;
            let rowClass = 'bg-gray-700/50 border-b border-gray-600'; let rankColor = 'text-gray-300';
            let icon = `<span class="inline-block w-6 text-center text-gray-500 font-bold">${rank}</span>`;
            if (rank === 1) { rowClass = 'bg-yellow-900/30 border-b border-yellow-600/50'; rankColor = 'text-yellow-400 font-bold'; icon = '🥇'; }
            else if (rank === 2) { rowClass = 'bg-gray-600/40 border-b border-gray-400/50'; rankColor = 'text-gray-200 font-bold'; icon = '🥈'; }
            else if (rank === 3) { rowClass = 'bg-orange-900/30 border-b border-orange-500/50'; rankColor = 'text-orange-400 font-bold'; icon = '🥉'; }
            const div = document.createElement('div');
            div.className = `flex items-center p-2 text-sm md:text-base ${rowClass}`;
            div.innerHTML = `<div class="w-12 text-center text-xl">${icon}</div><div class="flex-1 text-left px-2 truncate text-white">${item.nickname}</div><div class="w-20 text-right text-yellow-300 font-mono font-bold">${item.score}</div>`;
            rankingList.appendChild(div);
        });
    } catch (e) {
        console.error(e);
        rankingList.innerHTML = '<div class="text-center text-red-400 mt-10 text-sm">랭킹 로드 실패<br>(서버 확인 필요)</div>';
    }
}

async function autoSubmitScore() {
    const t = i18nData[currentLang] || i18nData['en'];
    if (!verifyScore()) { alert('비정상적인 점수 조작이 감지되었습니다.'); resetScore(); document.getElementById('finalScore').innerText = 0; return; }
    isScoreSaved = true; 
    const msgDiv = document.getElementById('auto-save-msg');
    const restartBtn = document.getElementById('restartBtn');
    msgDiv.innerHTML = `<span class="text-blue-400 animate-pulse">${t.saving || 'Saving...'}</span>`;
    try {
        const formData = new FormData();
        formData.append('action', 'submit'); formData.append('nickname', playerNickname); formData.append('score', score); formData.append('check_key', _securityCode);
        const res = await fetch('ranking.php', { method: 'POST', body: formData });
        const data = await res.json();
        if (data.status === 'success') { msgDiv.innerHTML = `<span class="text-green-400">${t.saved || 'Saved'} <span class="text-yellow-300 text-3xl mx-2">${data.rank}</span>${t.rankUnit || ''}</span>`; }
        else if (data.message === 'bad_word') { msgDiv.innerHTML = `<span class="text-red-400">${t.badWord || 'Bad word'}</span>`; }
        else { msgDiv.innerHTML = `<span class="text-red-400">${t.saveFail || 'Failed'}</span>`; }
    } catch (e) {
        console.error(e);
        msgDiv.innerHTML = '<span class="text-red-400">서버 연결 실패</span>';
    } finally {
        restartBtn.classList.remove('hidden');
    }
}
</script>
</body>
</html>
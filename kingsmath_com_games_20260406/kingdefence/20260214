        @import url('https://fonts.googleapis.com/css2?family=Jua&display=swap');

        body {
            margin: 0;
            overflow: hidden;
            background-color: #050505;
            color: white;
            font-family: 'Jua', sans-serif;
            touch-action: none;
            user-select: none;
        }

        #gameCanvas { display: block; }

        /* UI 레이어 */
        #ui-layer {
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 100%;
            pointer-events: none;
            z-index: 10;
        }

        .hud-text {
            font-family: 'Jua', sans-serif;
            letter-spacing: 1px;
            text-shadow: 2px 2px 0 #000, -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000, 1px 1px 0 #000;
        }

        /* 카드 스타일 */
        .card-container {
            display: none;
            position: absolute;
            top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            display: flex;
            gap: 20px;
            pointer-events: auto;
            z-index: 50;
            justify-content: center;
            align-items: center;
        }

        @media (max-width: 768px) {
            .card-container {
                flex-direction: column;
                gap: 10px;
                width: 90%;
            }
            .card {
                width: 100% !important;
                height: 100px !important;
                flex-direction: row !important;
                padding: 10px 15px !important;
                text-align: left !important;
                justify-content: space-between !important;
            }
            .card-desc { font-size: 14px !important; white-space: pre-wrap; }
            .card-math { font-size: 20px !important; margin: 0 10px !important; }
        }

        .card {
            background: rgba(30, 30, 50, 0.95);
            border: 3px solid #666;
            border-radius: 15px;
            width: 220px;
            height: 300px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: transform 0.2s, border-color 0.2s;
            box-shadow: 0 10px 30px rgba(0,0,0,0.8);
            padding: 15px;
            text-align: center;
        }
        .card:hover {
            transform: scale(1.05);
            border-color: #ffd700;
            background-color: rgba(60, 60, 100, 1);
        }
        .card:active { transform: scale(0.95); }
        .card-title { font-size: 24px; font-weight: bold; color: #ffcc00; margin-bottom: 8px; word-break: keep-all; }
        .card-desc { font-size: 18px; color: #eee; line-height: 1.4; word-break: keep-all; }
        .card-math { font-size: 32px; font-weight: bold; color: #00ffff; margin: 15px 0; }

        /* 화면 공통 스타일 */
        #start-screen, #game-over-screen {
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.9);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            pointer-events: auto;
            z-index: 100;
            text-align: center;
        }

        #start-screen {
            justify-content: flex-start;
            padding-top: 80px; /* 상단 헤더 공간 확보 */
            padding-bottom: 2vh;
            overflow-y: auto;
            -webkit-overflow-scrolling: touch;
        }

        button { pointer-events: auto; font-family: 'Jua', sans-serif; }
        input { pointer-events: auto; font-family: 'Jua', sans-serif; }
        select { pointer-events: auto; font-family: 'Jua', sans-serif; }
        .hidden { display: none !important; }


function setLanguage(lang) {
    currentLang = lang;
    const data = i18nData[lang];
    if (!data) return;

    // 데이터 속성(data-i18n)이 있는 모든 요소 업데이트
    document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.getAttribute('data-i18n');
        if (data[key]) {
            if (el.tagName === 'INPUT' && el.getAttribute('placeholder')) {
                // placeholder가 있는 input 태그 처리 안됨 수정: 별도 처리
            } else {
                el.innerText = data[key];
            }
        }
    });

    // 별도 처리 필요한 요소들
    document.getElementById('startNickname').placeholder = data.nickPlaceholder;
    
    // 게임 중이라면 UI 업데이트
    updateUi();
}


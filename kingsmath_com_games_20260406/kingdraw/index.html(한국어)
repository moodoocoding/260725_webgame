    <meta name="keywords" content="그림그리기, AI평가, 전자칠판, 킹수학, 교육용게임, 캐치마인드" id="meta-keywords">
    
    <title id="page-title">그림킹</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Jua&family=Noto+Sans+KR:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        corePlugins: { preflight: false }
      }
    </script>

    <style>
        #langSelectorContainer { position: absolute; top: 1rem; right: 1rem; z-index: 99999 !important; font-family: 'Noto Sans KR', sans-serif !important; }
        #langModal { z-index: 99999 !important; font-family: 'Noto Sans KR', sans-serif !important; }
        #toastNotification { z-index: 99999 !important; font-family: 'Noto Sans KR', sans-serif !important; }
        #langModal, #langModal * { box-sizing: border-box !important; }
        #langModal .custom-scrollbar::-webkit-scrollbar { width: 8px; }
        #langModal .custom-scrollbar::-webkit-scrollbar-track { background: rgba(31, 41, 55, 0.5); border-radius: 4px; }
        #langModal .custom-scrollbar::-webkit-scrollbar-thumb { background: #4b5563; border-radius: 4px; }
        .modal-overlay { opacity: 0; visibility: hidden; transition: all 0.3s ease; }
        .modal-overlay.active { opacity: 1; visibility: visible; }
        .modal-content { transform: scale(0.95) translateY(-10px); opacity: 0; transition: all 0.3s ease; }
        .modal-overlay.active .modal-content { transform: scale(1) translateY(0); opacity: 1; }
        .toast { transform: translateY(100%); opacity: 0; transition: all 0.3s ease; pointer-events: none; }
        .toast.show { transform: translateY(0); opacity: 1; pointer-events: auto; }

        /* [전자칠판 최적화] 터치 액션 및 드래그 방지 강력 적용 */
        * { box-sizing: border-box; user-select: none; -webkit-user-select: none; touch-action: none; font-weight: 400 !important; -webkit-touch-callout: none; }

        :root {
            --bg-color: #2b2b2b; --card-bg: #3a3a3a; --text-color: #f0f0f0; --accent-color: #FFD93D; --btn-active: #6c5ce7;
            --p0-main: #2980b9; --p1-main: #d35400; --p2-main: #c2185b; --p3-main: #27ae60;
            --p4-main: #8e44ad; --p5-main: #e67e22;
        }

        body { margin: 0; padding: 0; overflow: hidden; background-color: var(--bg-color); color: var(--text-color); font-family: 'Arial', sans-serif; height: 100vh; display: flex; flex-direction: column; overscroll-behavior: none; }
        body:lang(ko) { font-family: 'Jua', 'Noto Sans KR', sans-serif; }
        a { text-decoration: none; color: inherit; }

        header { background-color: #1e1e1e; padding: 0 30px; display: flex; justify-content: center; align-items: center; box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3); z-index: 10; height: 70px; position: relative; }
        header h1 { font-size: 1.6rem; margin: 0; text-shadow: 1px 1px 0 #000; cursor: pointer; position: absolute; left: 30px; color: var(--accent-color); }

        #header-info { display: none; align-items: center; gap: 20px; }
        #timer-display { font-size: 2.5rem; color: #fff; background: #444; padding: 5px 20px; border-radius: 15px; border: 2px solid #666; min-width: 100px; text-align: center; }
        #timer-display.urgent { background: #c0392b; animation: blink 0.5s infinite alternate; }
        @keyframes blink { from { opacity: 1; } to { opacity: 0.5; } }

        #app-container { flex: 1; position: relative; display: flex; flex-direction: column; justify-content: center; align-items: center; width: 100%; height: calc(100% - 70px); overflow: hidden; }

        /* --- 설정 화면 --- */
        #setup-screen { display: flex; flex-direction: column; align-items: center; gap: 15px; background: var(--card-bg); padding: 30px; border-radius: 30px; border: 3px solid #444; z-index: 20; max-width: 600px; width: 90%; }
        .screen-title { font-size: 3rem; color: #fff; text-shadow: 2px 2px 0 #000; text-align: center; margin-bottom: 10px; }
        .screen-desc { font-size: 1.2rem; color: #ccc; text-align: center; line-height: 1.5; background: rgba(0,0,0,0.2); padding: 15px; border-radius: 10px; border: 1px solid #555; width: 100%; }
        .highlight { color: #ff7675; }

        .option-section { display: flex; justify-content: center; align-items: center; gap: 20px; margin-top: 10px; flex-wrap: wrap; }
        .label-text { font-size: 1.3rem; color: #aaa; }
        .option-group { display: flex; gap: 10px; }
        
        .btn-option { 
            padding: 10px 15px; font-size: 1.1rem; border: 2px solid #555; background: #222; color: #aaa; border-radius: 20px; cursor: pointer; 
            display: flex; justify-content: center; align-items: center; text-align: center; 
        }
        .btn-option.selected { background-color: var(--btn-active); color: white; border-color: var(--btn-active); transform: translateY(-2px); }

        .api-input-section { display: flex; flex-direction: column; align-items: center; gap: 10px; margin-top: 15px; width: 100%; max-width: 400px; background: rgba(0,0,0,0.2); padding: 15px; border-radius: 15px; border: 1px dashed #666; }
        .api-input-section input { width: 100%; padding: 12px; border-radius: 10px; border: 2px solid #555; background: #222; color: #fff; font-size: 1rem; text-align: center; font-family: 'Arial', sans-serif; }
        .api-input-section input:focus { outline: none; border-color: var(--accent-color); }
        .api-link { font-size: 0.9rem; color: #3498db; text-decoration: underline; cursor: pointer; }

        #btn-start { margin-top: 10px; padding: 12px 60px; font-size: 2rem; background-color: #ff7675; color: white; border: none; border-radius: 50px; cursor: pointer; box-shadow: 0 6px 0 #d63031; }
        #btn-start:active { transform: translateY(6px); box-shadow: none; }

        /* --- 게임 화면 --- */
        #big-subject-display { font-size: 4rem; color: var(--accent-color); text-shadow: 3px 3px 0 #000; text-align: center; margin-top: 15px; margin-bottom: 10px; z-index: 10; display: none; }
        
        #game-board { display: none; width: 100%; flex: 1; padding: 10px; gap: 10px; justify-content: center; align-items: center; }

        .team-card {
            background: var(--card-bg); border-radius: 20px; display: flex; flex-direction: column; align-items: center; justify-content: center;
            border: 3px solid #666; padding: 10px; width: 100%; height: 100%; position: relative;
        }

        .team-0 { border-color: var(--p0-main); }
        .team-1 { border-color: var(--p1-main); }
        .team-2 { border-color: var(--p2-main); }
        .team-3 { border-color: var(--p3-main); }
        .team-4 { border-color: var(--p4-main); }
        .team-5 { border-color: var(--p5-main); }

        .player-header { display: flex; align-items: center; justify-content: center; gap: 10px; margin-bottom: 5px; }
        .player-label { font-size: 1.5rem; text-shadow: 2px 2px 0 #000; }
        .result-badge { font-size: 2rem; color: var(--accent-color); text-shadow: 2px 2px 0 #000; }

        .team-0 .player-label { color: var(--p0-main); }
        .team-1 .player-label { color: var(--p1-main); }
        .team-2 .player-label { color: var(--p2-main); }
        .team-3 .player-label { color: var(--p3-main); }
        .team-4 .player-label { color: var(--p4-main); }
        .team-5 .player-label { color: var(--p5-main); }

        .canvas-container { width: 100%; max-width: 100%; aspect-ratio: 1 / 1; position: relative; background: #fff; border-radius: 10px; overflow: hidden; border: 2px solid #aaa; touch-action: none; margin: 0 auto; display: flex; align-items: center; justify-content: center; }
        canvas { width: 100%; height: 100%; cursor: crosshair; touch-action: none; display: block; }

        .tools-area { width: 100%; display: flex; flex-direction: column; gap: 10px; margin-top: 10px; padding: 10px; background: rgba(0,0,0,0.3); border-radius: 10px; }
        .tools-row { display: flex; justify-content: space-between; align-items: center; width: 100%; }
        .tools-row.thickness-row { justify-content: flex-start; gap: 12px; border-top: 1px dashed #666; padding-top: 10px; }
        
        .color-palette { display: flex; gap: 5px; }
        .color-btn { width: 30px; height: 30px; border-radius: 50%; border: 2px solid #fff; cursor: pointer; transition: transform 0.2s; }
        .color-btn[data-color="#ffffff"] { box-shadow: inset 0 0 3px rgba(0,0,0,0.3); }
        .color-btn.active { transform: scale(1.2); border-color: #FFD93D; box-shadow: 0 0 10px #FFD93D; }
        
        .action-btns { display: flex; gap: 10px; }
        .tool-btn { background: #555; color: white; border: none; padding: 5px 10px; border-radius: 8px; cursor: pointer; font-size: 1rem; font-family: 'Arial', sans-serif; } 
        .tool-btn:active { background: #333; }

        .thickness-palette { display: flex; gap: 10px; align-items: center; }
        .thickness-btn { width: 32px; height: 32px; border-radius: 8px; border: 2px solid #555; background: #222; cursor: pointer; display: flex; justify-content: center; align-items: center; transition: all 0.2s; }
        .thickness-dot { background: #fff; border-radius: 50%; pointer-events: none; }
        .thickness-btn.active { border-color: #FFD93D; background: #FFD93D; box-shadow: 0 0 10px #FFD93D; transform: scale(1.15); }
        .thickness-btn.active .thickness-dot { background: #000; }
        .thickness-label { font-size: 1rem; color: #ccc; font-family: 'Jua', 'Noto Sans KR', sans-serif; margin-right: 5px; }

        .btn-individual-finish { width: 100%; margin-top: 10px; padding: 8px 0; background: #e74c3c; color: white; border: 2px solid #c0392b; border-radius: 8px; font-size: 1.2rem; cursor: pointer; transition: all 0.2s; font-family: 'Jua', 'Noto Sans KR', sans-serif; }
        .btn-individual-finish:active { transform: translateY(2px); }
        .btn-individual-finish:disabled { background: #7f8c8d; border-color: #95a5a6; cursor: not-allowed; transform: none; }

        #game-over-controls { display: none; margin-top: 10px; margin-bottom: 20px; flex-direction: row; justify-content: center; gap: 15px; }
        .big-btn { padding: 15px 40px; font-size: 2rem; color: white; border: 4px solid #fff; border-radius: 50px; cursor: pointer; text-shadow: 2px 2px 0 rgba(0,0,0,0.2); transition: transform 0.1s; font-family: 'Jua', 'Noto Sans KR', sans-serif; }
        #btn-grade { background: linear-gradient(to bottom, #9b59b6, #8e44ad); box-shadow: 0 6px 0 #5e3370; display: none; }
        #btn-restart { background: linear-gradient(to bottom, #00b894, #00cec9); box-shadow: 0 6px 0 #006266; display: none; }
        .big-btn:active { transform: translateY(6px); box-shadow: none !important; }

        .floating-btn { position: fixed; bottom: 20px; width: 50px; height: 50px; border-radius: 50%; background: #444; color: white; display: flex; justify-content: center; align-items: center; font-size: 1.5rem; z-index: 60; border: 2px solid #666; cursor: pointer; }
        #btn-home { left: 20px; }
        #btn-fullscreen { right: 20px; }
    </style>
</head>
<body>

    <div id="langSelectorContainer" class="absolute top-4 right-4">
        <button id="langTriggerBtn" class="flex items-center gap-2 bg-gray-700/50 border border-gray-600 rounded-full px-4 py-2 text-sm font-medium shadow-lg">
            <i class="fa-solid fa-globe text-gray-400"></i>
            <img id="currentFlag" src="https://flagcdn.com/w40/kr.png" alt="KR" class="w-5 h-auto rounded-[2px]">
            <span id="currentLangName" class="text-white">한국어</span>
        </button>
    </div>
    <div id="langModal" class="modal-overlay fixed inset-0 flex items-center justify-center bg-black/60 px-4">
        <div class="modal-content bg-gray-900 border border-gray-700 rounded-2xl w-full max-w-4xl max-h-[85vh] flex flex-col">
            <div class="flex items-center justify-between p-5 border-b border-gray-800">
                <h2 class="text-xl text-white m-0">Language / 언어</h2>
                <button id="closeModalBtn" class="text-gray-400 text-lg border-none bg-transparent cursor-pointer"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="p-5 overflow-y-auto flex-1">
                <div id="languageGrid" class="grid grid-cols-2 sm:grid-cols-4 gap-3"></div>
            </div>
        </div>
    </div>
    
    <header>
        <h1 onclick="location.reload()" id="header-title">🎨 그림킹</h1>
        <div id="header-info">
            <div id="timer-display">60</div>
        </div>
    </header>

    <div id="app-container">
        <div id="big-subject-display"></div>

        <div id="setup-screen">
            <div class="screen-title" data-i18n="title">🎨 그림킹</div>
            <div class="screen-desc" data-i18n="desc">
                제시어를 보고 60초 동안 가장 비슷하게 그림을 그려보세요!<br>
                시간이 끝나면 <span class="highlight">AI 심사위원</span>이 여러분의 그림을 평가합니다.<br><br>
                <span style="color:#ff7675; font-size:1.05rem;">⚠️ 주의: 대충 그리거나 낙서를 하면 AI가 채점을 거부하거나 오류가 날 수 있어요. 특징을 살려 정성껏 그려주세요!</span>
            </div>
            
            <div class="option-section">
                <div class="label-text" data-i18n="players">참여 인원</div>
                <div class="option-group" id="player-options">
                    <div class="btn-option" data-value="1">1인 👤</div>
                    <div class="btn-option" data-value="2">2인 👥</div>
                    <div class="btn-option" data-value="3">3인 👨‍👩‍👧</div>
                    <div class="btn-option selected" data-value="4">4인 👨‍👩‍👧‍👦</div>
                    <div class="btn-option" data-value="5">5인 🧑‍🤝‍🧑</div>
                    <div class="btn-option" data-value="6">6인 🧑‍🤝‍🧑</div>
                </div>
            </div>

            <div class="api-input-section">
                <div class="label-text">🔑 선생님용 API 키 입력</div>
                <input type="password" id="api-key-input" placeholder="Gemini API 키를 붙여넣으세요">
                <span id="btn-open-api-guide" class="api-link">👉 무료 API 키 발급 받는 방법</span>
            </div>

            <button id="btn-start" data-i18n="btn_start">게임 시작! 🚀</button>
        </div>

        <div id="game-board">
            </div>

        <div id="game-over-controls">
            <button id="btn-grade" class="big-btn">🤖 AI 점수 확인</button>
            <button id="btn-restart" class="big-btn">🔄 다시 하기</button>
        </div>
    </div>
    
    <iframe id="apiGuideFrame" class="hidden fixed inset-0 w-full h-full" style="z-index: 100000; border: none; background: transparent;"></iframe>

    <div id="btn-home" class="floating-btn">🏠</div>
    <div id="btn-fullscreen" class="floating-btn">⛶</div>

    <script>
        const i18n = {
            ko: {
                title: "그림킹", 
                desc: "제시어를 보고 60초 동안 가장 비슷하게 그림을 그려보세요!<br>시간이 끝나면 <span class='highlight'>AI 심사위원</span>이 여러분의 그림을 평가합니다.<br><br><span style='color:#ff7675; font-size:1.05rem;'>⚠️ 주의: 대충 그리거나 낙서를 하면 AI가 채점을 거부하거나 오류가 날 수 있어요. 특징을 살려 정성껏 그려주세요!</span>",
                players: "참여 인원", btn_start: "게임 시작! 🚀", 
                team_0: "P1", team_1: "P2", team_2: "P3", team_3: "P4",
                subject_prefix: "제시어: "
            },
            en: {
                title: "Painter King", 
                desc: "Draw the subject as best as you can in 60 seconds!<br>An <span class='highlight'>AI Judge</span> will score your drawings.<br><br><span style='color:#ff7675; font-size:1.05rem;'>⚠️ Warning: If you draw carelessly or just scribble, the AI might refuse to score. Please draw carefully!</span>",
                players: "Players", btn_start: "Start! 🚀", 
                team_0: "P1", team_1: "P2", team_2: "P3", team_3: "P4",
                subject_prefix: "Subject: "
            }
        };

        const languagesList = [
            { code: 'ko', country: 'kr', name: '한국어', enName: 'Korean' },
            { code: 'en', country: 'us', name: 'English', enName: 'English' }
        ];
        let currentLang = 'ko';

        function applyLanguageUI() {
            const t = i18n[currentLang] || i18n['ko'];
            document.querySelectorAll('[data-i18n]').forEach(el => {
                if(t[el.dataset.i18n]) el.innerHTML = t[el.dataset.i18n];
            });
            document.getElementById('header-title').innerText = "🎨 " + t.title;
        }

        const PLAYERS = [
            { name: 'P1', theme: 'team-0' }, { name: 'P2', theme: 'team-1' },
            { name: 'P3', theme: 'team-2' }, { name: 'P4', theme: 'team-3' },
            { name: 'P5', theme: 'team-4' }, { name: 'P6', theme: 'team-5' }
        ];
        
        const COLORS = ['#000000', '#e74c3c', '#3498db', '#2ecc71', '#f1c40f', '#ffffff'];

        const SUBJECTS = [
            "사과", "바나나", "포도", "수박", "딸기", "나무", "꽃", "해바라기", "별", "달",
            "자동차", "자전거", "비행기", "배", "기차", "고양이", "강아지", "토끼", "사자", "코끼리",
            "집", "학교", "안경", "모자", "가방", "신발", "시계", "우산", "의자", "책상",
            "피자", "햄버거", "아이스크림", "케이크", "사탕", "컴퓨터", "스마트폰", "텔레비전", "마이크", "기타",
            "축구공", "농구공", "야구방망이", "눈사람", "구름", "무지개", "태양", "물고기", "나비", "거미",
            "피아노", "바이올린", "드럼", "칫솔", "치약", "거울", "빗", "가위", "풀", "연필",
            "지우개", "공책", "책", "컵", "접시", "숟가락", "젓가락", "포크", "냄비", "프라이팬",
            "냉장고", "세탁기", "에어컨", "선풍기", "청소기", "침대", "소파", "장롱", "휴지", "수건",
            "비누", "샴푸", "양말", "바지", "치마", "티셔츠", "코트", "패딩", "장갑", "목도리",
            "귀마개", "반지", "목걸이", "귀걸이", "팔찌", "시소", "그네", "미끄럼틀", "모래성", "튜브"
        ];

        let config = { playerCount: 4, gameTime: 60 };
        let state = { isPlaying: false, timeLeft: 60, timerInterval: null, currentSubject: "", canvases: [] };

        let activeApiKey = "";

        let savedCount = localStorage.getItem('drawKingPlayerCount');
        if (savedCount) {
            config.playerCount = parseInt(savedCount);
        }
        document.querySelectorAll('#player-options .btn-option').forEach(b => {
            b.classList.remove('selected');
            if (parseInt(b.dataset.value) === config.playerCount) {
                b.classList.add('selected');
            }
        });

        let savedApiKey = localStorage.getItem('drawKingApiKey');
        if (savedApiKey) {
            document.getElementById('api-key-input').value = savedApiKey;
        }

        document.getElementById('btn-open-api-guide').addEventListener('click', () => {
            const frame = document.getElementById('apiGuideFrame');
            
            if (!frame.src || frame.src === window.location.href) {
                frame.src = 'api.html';
                
                frame.onload = function() {
                    try {
                        const iframeDoc = frame.contentWindow.document;
                        const buttons = iframeDoc.querySelectorAll('button');
                        buttons.forEach(btn => {
                            btn.addEventListener('click', () => {
                                frame.classList.add('hidden');
                            });
                        });
                    } catch (e) {
                        console.log("iframe 내부 접근 시 보안 정책(CORS) 오류 발생 가능성이 있습니다.");
                    }
                };
            }
            frame.classList.remove('hidden');
        });

        function checkAllFinished() {
            if (state.canvases.every(board => board.isFinished)) {
                if(state.isPlaying) {
                    state.timeLeft = 0;
                    endDrawingPhase();
                }
            }
        }

        class DrawingBoard {
            constructor(index) {
                this.index = index;
                this.color = COLORS[0];
                // 멀티터치 최적화를 위해 활성 포인터 맵 사용
                this.activePointers = new Map(); 
                this.isFinished = false;
                this.lineWidth = 10;
                this.element = this.createUI();
                this.initCanvas();
            }

            createUI() {
                const div = document.createElement('div');
                div.className = `team-card ${PLAYERS[this.index].theme}`;
                
                let colorsHtml = COLORS.map((c, i) => 
                    `<div class="color-btn ${i===0?'active':''}" style="background-color:${c}" data-color="${c}" title="${c==='#ffffff'?'지우개':'색상'}"></div>`
                ).join('');

                const widths = [4, 10, 16, 24, 32];
                let thicknessHtml = widths.map((w, i) => 
                    `<div class="thickness-btn ${i===1?'active':''}" data-width="${w}" title="${i+1}단계">
                        <div class="thickness-dot" style="width:${w}px; height:${w}px;"></div>
                    </div>`
                ).join('');

                div.innerHTML = `
                    <div class="player-header">
                        <span class="player-label">${PLAYERS[this.index].name}</span>
                        <span id="badge-${this.index}" class="result-badge" style="display:none;"></span>
                    </div>
                    <div class="canvas-container">
                        <canvas id="canvas-${this.index}"></canvas>
                    </div>
                    <div class="tools-area">
                        <div class="tools-row">
                            <div class="color-palette">${colorsHtml}</div>
                            <div class="action-btns">
                                <button class="tool-btn btn-clear">🔄</button>
                            </div>
                        </div>
                        <div class="tools-row thickness-row">
                            <span class="thickness-label">굵기</span>
                            <div class="thickness-palette">${thicknessHtml}</div>
                        </div>
                    </div>
                    <button id="finish-btn-${this.index}" class="btn-individual-finish">✅ 완료</button>
                `;

                // 터치 꼬임 방지를 위해 preventDefault() 추가
                div.querySelectorAll('.color-btn').forEach(btn => {
                    btn.addEventListener('pointerdown', (e) => {
                        e.preventDefault();
                        const targetBtn = e.target.closest('.color-btn');
                        div.querySelectorAll('.color-btn').forEach(b => b.classList.remove('active'));
                        targetBtn.classList.add('active');
                        this.color = targetBtn.dataset.color;
                    });
                });

                div.querySelectorAll('.thickness-btn').forEach(btn => {
                    btn.addEventListener('pointerdown', (e) => {
                        e.preventDefault();
                        const targetBtn = e.target.closest('.thickness-btn');
                        div.querySelectorAll('.thickness-btn').forEach(b => b.classList.remove('active'));
                        targetBtn.classList.add('active');
                        this.lineWidth = parseInt(targetBtn.dataset.width);
                    });
                });

                div.querySelector('.btn-clear').addEventListener('pointerdown', (e) => {
                    e.preventDefault();
                    this.clearCanvas();
                });

                div.querySelector(`#finish-btn-${this.index}`).addEventListener('pointerdown', (e) => {
                    e.preventDefault();
                    if(!state.isPlaying || this.isFinished) return;
                    this.isFinished = true;
                    e.currentTarget.disabled = true;
                    e.currentTarget.innerText = "대기중...";
                    checkAllFinished(); 
                });

                return div;
            }

            initCanvas() {
                setTimeout(() => {
                    this.canvas = document.getElementById(`canvas-${this.index}`);
                    this.ctx = this.canvas.getContext('2d', { willReadFrequently: true });
                    
                    this.canvas.width = this.canvas.offsetWidth;
                    this.canvas.height = this.canvas.offsetHeight;
                    
                    this.clearCanvas();

                    // 각 캔버스는 독립적인 이벤트 리스너를 가짐
                    this.canvas.addEventListener('pointerdown', this.startDrawing.bind(this));
                    this.canvas.addEventListener('pointermove', this.draw.bind(this));
                    this.canvas.addEventListener('pointerup', this.stopDrawing.bind(this));
                    this.canvas.addEventListener('pointercancel', this.stopDrawing.bind(this));
                    this.canvas.addEventListener('pointerout', this.stopDrawing.bind(this));
                }, 100);
            }

            clearCanvas() {
                if(!this.ctx) return;
                this.ctx.fillStyle = '#ffffff';
                this.ctx.fillRect(0, 0, this.canvas.width, this.canvas.height);
            }

            startDrawing(e) {
                if (!state.isPlaying || this.isFinished) return;
                e.preventDefault(); 
                
                // 해당 터치를 캔버스에 잠금 (손가락이 밖으로 나가도 인식됨)
                this.canvas.setPointerCapture(e.pointerId);

                const pos = this.getPointerPos(e);
                // 현재 포인터 ID별로 위치 저장
                this.activePointers.set(e.pointerId, { x: pos.x, y: pos.y });
            }

            draw(e) {
                if (!state.isPlaying || this.isFinished) return;
                if (!this.activePointers.has(e.pointerId)) return;
                e.preventDefault();
                
                const lastPos = this.activePointers.get(e.pointerId);
                const newPos = this.getPointerPos(e);
                
                this.ctx.beginPath();
                this.ctx.lineWidth = this.lineWidth;
                this.ctx.lineCap = 'round';
                this.ctx.lineJoin = 'round';
                this.ctx.strokeStyle = this.color;

                this.ctx.moveTo(lastPos.x, lastPos.y);
                this.ctx.lineTo(newPos.x, newPos.y);
                this.ctx.stroke();

                // 새로운 위치 업데이트
                this.activePointers.set(e.pointerId, newPos);
            }

            stopDrawing(e) {
                if (this.activePointers.has(e.pointerId)) {
                    this.activePointers.delete(e.pointerId);
                    // 터치 잠금 해제
                    this.canvas.releasePointerCapture(e.pointerId);
                }
            }

            getPointerPos(e) {
                const rect = this.canvas.getBoundingClientRect();
                return {
                    x: (e.clientX - rect.left) * (this.canvas.width / rect.width),
                    y: (e.clientY - rect.top) * (this.canvas.height / rect.height)
                };
            }

            showResult(score, rank) {
                const badge = document.querySelector(`#badge-${this.index}`);
                let medal = '';
                let displayScore = '';
                
                if (rank === '실격' || score === 0) {
                    medal = '💀';
                    displayScore = '실격';
                } else {
                    displayScore = score + '점';
                    if (rank === 1) medal = '🥇';
                    else if (rank === 2) medal = '🥈';
                    else if (rank === 3) medal = '🥉';
                    else medal = '👍';
                }
                
                badge.innerText = `${medal} ${displayScore}`;
                badge.style.display = 'inline-block';

                const finishBtn = document.getElementById(`finish-btn-${this.index}`);
                if (finishBtn) {
                    finishBtn.innerText = "✅ 채점 완료";
                    finishBtn.style.background = "#27ae60"; 
                    finishBtn.style.borderColor = "#2ecc71";
                    finishBtn.style.color = "white";
                }
            }
        }

        document.querySelectorAll('#player-options .btn-option').forEach(btn => {
            btn.addEventListener('click', () => {
                document.querySelectorAll('#player-options .btn-option').forEach(b => b.classList.remove('selected'));
                btn.classList.add('selected');
                config.playerCount = parseInt(btn.dataset.value);
                localStorage.setItem('drawKingPlayerCount', config.playerCount); 
            });
        });

        document.getElementById('btn-start').addEventListener('click', () => {
            const inputKey = document.getElementById('api-key-input').value.trim();
            if (!inputKey) {
                alert("원활한 AI 채점을 위해 선생님의 Gemini API 키를 입력해주세요!\n(입력창 하단의 링크에서 무료로 발급받을 수 있습니다)");
                return;
            }
            
            activeApiKey = inputKey;
            localStorage.setItem('drawKingApiKey', activeApiKey);

            document.getElementById('setup-screen').style.display = 'none';
            document.getElementById('langSelectorContainer').style.display = 'none';
            
            state.currentSubject = SUBJECTS[Math.floor(Math.random() * SUBJECTS.length)];
            const t = i18n[currentLang] || i18n['ko'];
            
            const bigSubject = document.getElementById('big-subject-display');
            bigSubject.innerText = t.subject_prefix + state.currentSubject;
            bigSubject.style.display = 'block';

            document.getElementById('header-info').style.display = 'flex';

            const board = document.getElementById('game-board');
            board.innerHTML = '';
            board.style.display = 'flex';

            state.canvases = [];

            let minCols = Math.max(4, config.playerCount);

            for (let i = 0; i < config.playerCount; i++) {
                const boardUI = new DrawingBoard(i);
                boardUI.element.style.flex = '1';
                boardUI.element.style.maxWidth = `calc(100% / ${minCols} - 10px)`; 
                state.canvases.push(boardUI);
                board.appendChild(boardUI.element);
            }

            state.timeLeft = config.gameTime;
            state.isPlaying = true;
            document.getElementById('timer-display').innerText = state.timeLeft;
            document.getElementById('timer-display').classList.remove('urgent');

            state.timerInterval = setInterval(() => {
                state.timeLeft--;
                document.getElementById('timer-display').innerText = state.timeLeft;
                
                if(state.timeLeft <= 10) document.getElementById('timer-display').classList.add('urgent');

                if (state.timeLeft <= 0) {
                    endDrawingPhase();
                }
            }, 1000);
        });

        function endDrawingPhase() {
            state.isPlaying = false;
            clearInterval(state.timerInterval);
            document.getElementById('timer-display').innerText = "종료!";
            document.getElementById('timer-display').classList.remove('urgent');
            
            state.canvases.forEach(board => {
                board.isFinished = true;
                const btn = document.getElementById(`finish-btn-${board.index}`);
                if (btn && btn.innerText !== "대기중...") {
                    btn.disabled = true;
                    btn.innerText = "채점 중...";
                }
            });
            
            const controls = document.getElementById('game-over-controls');
            controls.style.display = 'flex';
            document.getElementById('btn-grade').style.display = 'block';
            document.getElementById('btn-restart').style.display = 'none';

            document.getElementById('btn-grade').click();
        }

        document.getElementById('btn-grade').addEventListener('click', async () => {
            document.getElementById('btn-grade').style.display = 'none';
            
            const bigSubject = document.getElementById('big-subject-display');
            bigSubject.innerText = "🤖 AI가 채점하고 있습니다... 🤖";
            
            try {
                const mergedCanvas = document.createElement('canvas');
                const singleWidth = state.canvases[0].canvas.width;
                const singleHeight = state.canvases[0].canvas.height;
                
                mergedCanvas.width = singleWidth * config.playerCount;
                mergedCanvas.height = singleHeight;
                const mCtx = mergedCanvas.getContext('2d');
                
                mCtx.fillStyle = '#ffffff';
                mCtx.fillRect(0, 0, mergedCanvas.width, mergedCanvas.height);

                state.canvases.forEach((board, index) => {
                    mCtx.drawImage(board.canvas, index * singleWidth, 0, singleWidth, singleHeight);
                    
                    if (index > 0) {
                        mCtx.beginPath();
                        mCtx.moveTo(index * singleWidth, 0);
                        mCtx.lineTo(index * singleWidth, singleHeight);
                        mCtx.strokeStyle = '#ff0000';
                        mCtx.lineWidth = 10;
                        mCtx.stroke();
                    }
                });

                const mergedBase64 = mergedCanvas.toDataURL('image/jpeg', 0.8).split(',')[1];
                
                const imageParts = [{
                    "inlineData": {
                        "mimeType": "image/jpeg",
                        "data": mergedBase64
                    }
                }];

                const promptText = `
                너는 미술 선생님이자 냉정한 심사위원이야. 제시어는 '${state.currentSubject}'야.
                내가 첨부한 '1장의 그림' 안에는 ${config.playerCount}명의 플레이어가 그린 그림이 굵은 빨간색 선으로 구분되어 왼쪽에서 오른쪽으로 나란히 붙어있어.
                왼쪽부터 차례대로 1번째, 2번째, ... ${config.playerCount}번째 그림이야.
                
                각 영역(그림)을 살펴보고, 제시어와 가장 비슷하고 창의적으로 그려졌는지 0~100점 사이의 점수(score)로 매겨줘. 그리고 그 점수를 바탕으로 1등부터 ${config.playerCount}등까지 상대평가 순위(rank)를 매겨줘. (공동 등수 없음)
                
                단, 그림을 아예 그리지 않았거나, 제시어의 특징이나 의도가 전혀 보이지 않는 형편없는 낙서는 순위에서 제외하고 score는 0, rank는 "실격"으로 줘.
                
                결과는 반드시 왼쪽부터 오른쪽 그림 순서와 동일하게 아래의 JSON 배열 형식으로만 대답해야 해. 코멘트나 다른 부연 설명은 절대 하지 말고 오직 score와 rank 데이터만 줘.
                [
                  {"score": 85, "rank": 2},
                  {"score": 95, "rank": 1},
                  {"score": 0, "rank": "실격"}
                ]
                `;

                const requestBody = {
                    "contents": [{
                        "parts": [
                            {"text": promptText},
                            ...imageParts
                        ]
                    }],
                    "generationConfig": {
                        "response_mime_type": "application/json",
                        "temperature": 0.4
                    }
                };

                const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${activeApiKey}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(requestBody)
                });

                const data = await response.json();
                
                if (data.error) {
                    throw new Error(data.error.message);
                }

                let resultText = data.candidates[0].content.parts[0].text;
                const results = JSON.parse(resultText);

                bigSubject.innerText = "🎨 채점 결과 🎨";
                
                state.canvases.forEach((board, index) => {
                    if(results[index] && results[index].score !== undefined) {
                        board.showResult(results[index].score, results[index].rank);
                    } else {
                        board.showResult(0, "실격");
                    }
                });

                document.getElementById('btn-restart').style.display = 'block';

            } catch (error) {
                console.error("API 에러 상세 원인:", error);
                
                let errorMsg = `현재 접속이 많아 AI 채점이 지연되고 있어요!\n또는 입력하신 API 키가 유효하지 않을 수 있습니다.\n\n잠시 후 다시 확인 버튼을 눌러주세요 😅\n\n(상세 원인: ${error.message})`;
                alert(errorMsg);
                
                bigSubject.innerText = `제시어: ${state.currentSubject}`;
                document.getElementById('btn-grade').style.display = 'block';
                document.getElementById('btn-grade').innerText = '🔄 다시 채점하기';
            }
        });

        document.getElementById('btn-restart').addEventListener('click', () => location.reload());
        document.getElementById('btn-home').addEventListener('click', () => location.reload());
        document.getElementById('btn-fullscreen').addEventListener('click', () => {
            if (!document.fullscreenElement) document.documentElement.requestFullscreen();
            else if (document.exitFullscreen) document.exitFullscreen();
        });

        window.addEventListener('DOMContentLoaded', applyLanguageUI);
    </script>
</body>
</html>
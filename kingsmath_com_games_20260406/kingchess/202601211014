    <style>
        @import url('https://fonts.googleapis.com/css2?family=Jua&display=swap');

        :root {
            --bg-color: #1a1a1d;
            --board-dark-bg: #2c2c2c;
            --text-color: #fff;
            
            /* 동물 색상 테마 */
            --color-dog: #00FFFF;     /* 시안 */
            --color-cat: #FF00FF;     /* 핫 핑크 */
            --color-rabbit: #FFFF00;  /* 옐로우 */
            --color-hamster: #FF9900; /* 네온 오렌지 */
            --color-monkey: #39FF14;  /* 라임 그린 */
            --color-panda: #FF3333;   /* 비비드 레드 */

            /* 체스판 컬러 */
            --board-dark: #222;
            --board-light: #444;
            --active-glow: rgba(255, 255, 255, 0.5);
            --p1-color: #fff; /* 동적 변경 */
            --p2-color: #fff; /* 동적 변경 */
        }

        body {
            margin: 0;
            padding: 0;
            background-color: var(--bg-color);
            color: var(--text-color);
            font-family: 'Jua', sans-serif;
            font-weight: 400;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            height: 100vh;
            touch-action: none; 
            overscroll-behavior: none;
            user-select: none;
            -webkit-user-select: none;
            -webkit-tap-highlight-color: transparent;
        }

        h1, h2, h3, button, .win-msg, .start-main-btn, a {
            font-family: 'Jua', sans-serif !important;
            font-weight: 400 !important;
        }

        /* --- 언어 선택기 --- */
        .lang-switcher {
            position: fixed; top: 15px; right: 15px; z-index: 2000;
            background: #aaaaaa52; border-radius: 30px; padding: 5px 10px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.3); display: flex; gap: 8px;
            backdrop-filter: blur(5px); white-space: nowrap; flex-wrap: nowrap;
            max-width: 90vw; overflow-x: auto;
            -ms-overflow-style: none; scrollbar-width: none;
        }
        .lang-switcher::-webkit-scrollbar { display: none; }
        .lang-btn {
            background: none; border: none; font-size: 1.6rem; cursor: pointer;
            padding: 0 2px; transition: transform 0.2s; line-height: 1;
            /* 최적화: filter 제거 */
            opacity: 0.7;
        }
        .lang-btn:hover, .lang-btn.active { transform: scale(1.2); opacity: 1; }

        /* --- 시작 화면 --- */
        #start-screen {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: linear-gradient(135deg, #2c3e50, #000000);
            display: flex; flex-direction: column; justify-content: center; align-items: center;
            z-index: 200; transition: opacity 0.5s ease;
        }
        #start-screen h1 {
            font-size: 4.5rem; color: #f1c40f; margin: 0 0 15px 0;
            text-shadow: 3px 3px 0 #d35400, 6px 6px 15px rgba(0,0,0,0.5);
            animation: bounce 2s infinite; letter-spacing: -3px; line-height: 1.1;
            text-align: center; padding: 0 20px;
        }
        #start-screen h1.long-text { font-size: 3rem; }
        .rules-box {
            background: rgba(255, 255, 255, 0.1); padding: 30px; border-radius: 20px;
            border: 2px solid rgba(255, 255, 255, 0.2); text-align: center;
            max-width: 700px; width: 80%; margin-bottom: 40px;
        }
        .rules-box h3 { font-size: 2.5rem; margin-top: 0; color: #4facfe; }
        .rules-box p { font-size: 1.5rem; line-height: 1.6; color: #ddd; white-space: pre-line; }
        .rules-box p.long-text { font-size: 1.2rem; }
        .start-btn-group { display: flex; gap: 30px; flex-wrap: wrap; justify-content: center; }
        .start-main-btn {
            padding: 20px 40px; font-size: 2.5rem; background: #ff4757; color: white;
            border: none; border-radius: 50px; cursor: pointer;
            box-shadow: 0 10px 0 #c0392b, 0 20px 20px rgba(0,0,0,0.4);
            transition: transform 0.1s, box-shadow 0.1s;
        }
        .start-main-btn.long-text { font-size: 1.8rem; padding: 20px 30px; }
        .start-main-btn:active { transform: translateY(10px); box-shadow: 0 0 0 #c0392b, 0 0 0 rgba(0,0,0,0); }
        .start-sub-link {
            margin-top: 30px; font-size: 1.5rem; color: #4facfe; text-decoration: none;
            transition: all 0.3s; padding: 10px;
        }
        .start-sub-link:hover { color: #fff; transform: scale(1.1); }

        /* --- 게임 컨테이너 --- */
        #game-container {
            display: none; flex: 1; flex-direction: column; opacity: 0;
            transition: opacity 1s ease; position: relative;
        }
        header {
            height: 8vh; display: flex; justify-content: center; align-items: center;
            background: rgba(0,0,0,0.3); border-bottom: 1px solid rgba(255,255,255,0.1);
            padding: 0 20px; box-sizing: border-box; position: relative; flex-shrink: 0;
        }
        .home-link {
            position: absolute; left: 20px; font-size: 1.2rem; color: #fff;
            text-decoration: none; transition: color 0.3s; z-index: 10;
        }
        .home-link:hover { color: #FFDD00; }
        .header-title h2 {
            font-size: 2rem; margin: 0; color: #FFDD00; letter-spacing: 2px;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
        }

        #clock-wrapper {
            width: 100%; display: flex; justify-content: center; padding: 10px 0;
            background: rgba(0,0,0,0.1); flex-shrink: 0;
        }
        .clock-container {
            text-align: center; background: rgba(255, 255, 255, 0.05); padding: 15px 50px;
            border-radius: 25px; border: 2px solid rgba(255, 255, 255, 0.2);
            display: flex; flex-direction: column; gap: 8px; align-items: center;
        }
        .clock-date { font-size: 2.3rem; color: #eee; margin: 0; line-height: 1.2; }
        .clock-time {
            font-size: 4rem; color: #fff; font-weight: bold; line-height: 1.1;
            text-shadow: 0 0 15px rgba(255,255,255,0.4);
        }
        .clock-link {
            display: inline-block; margin-top: 15px; padding: 10px 25px;
            background: linear-gradient(90deg, #4facfe 0%, #00f2fe 100%);
            color: #fff !important; font-size: 1.3rem; text-decoration: none;
            border-radius: 30px; box-shadow: 0 4px 15px rgba(79, 172, 254, 0.4);
            transition: all 0.3s ease; font-weight: bold; border: 2px solid rgba(255,255,255,0.3);
        }
        .clock-link:hover {
            transform: scale(1.05); box-shadow: 0 6px 20px rgba(79, 172, 254, 0.6);
            background: linear-gradient(90deg, #00f2fe 0%, #4facfe 100%);
        }

        .boards-wrapper { display: flex; flex: 1; width: 100%; overflow: hidden; }
        .game-station {
            position: relative; flex: 1; display: flex; flex-direction: column;
            align-items: center; justify-content: center; border-right: 1px solid rgba(255,255,255,0.1);
            overflow: hidden;
        }
        .game-station:last-child { border-right: none; }

        /* --- 캐릭터 선택 --- */
        .selection-screen {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(20, 20, 20, 0.95); z-index: 50;
            display: flex; flex-direction: column; justify-content: center; align-items: center;
        }
        .select-title { font-size: 2.2rem; margin-bottom: 20px; color: #fff; text-align: center; }
        .animal-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; }
        .animal-card {
            width: 90px; height: 110px; background: rgba(255,255,255,0.1);
            border-radius: 15px; display: flex; flex-direction: column;
            justify-content: center; align-items: center; cursor: pointer;
            transition: transform 0.2s, background 0.2s; border: 2px solid transparent;
        }
        .animal-card:active { transform: scale(0.95); background: rgba(255,255,255,0.3); } /* Active state for fast touch */
        .animal-card.disabled { opacity: 0.3; cursor: not-allowed; filter: grayscale(100%); pointer-events: none; }
        .animal-icon { font-size: 2.5rem; margin-bottom: 5px; }
        .animal-name { font-size: 1rem; }

        /* --- 룰렛 --- */
        .roulette-screen {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.9); z-index: 60;
            display: none; flex-direction: column; justify-content: center; align-items: center;
        }
        .roulette-msg { font-size: 2.5rem; color: #fff; margin-bottom: 20px; text-align: center; }
        .roulette-display { font-size: 5rem; animation: pop 0.2s infinite alternate; }

        /* --- 메인 게임 UI --- */
        .game-ui { display: none; width: 100%; height: 100%; position: relative; }

        /* 플레이어 패널 */
        .player-info {
            width: 95px; display: flex; flex-direction: column; align-items: center;
            opacity: 0.5; transition: all 0.3s; position: absolute; z-index: 10; gap: 8px;
        }
        .player-info.p1-pos { bottom: 2%; left: 3%; }
        .player-info.p2-pos { top: 2%; right: 3%; }

        .info-bg {
            background: rgba(0,0,0,0.5); padding: 10px 5px; border-radius: 15px;
            text-align: center; border: 2px solid #555; width: 100%; box-sizing: border-box;
            position: relative;
        }

        /* 턴 활성화 효과 */
        .player-info.active-turn { opacity: 1; transform: scale(1.05); }
        .player-info.active-turn .info-bg {
            box-shadow: 0 0 20px var(--glow-color); border: 3px solid var(--glow-color);
            background: rgba(50, 50, 50, 0.9); animation: panel-pulse 1.5s infinite;
        }
        @keyframes panel-pulse {
            0%, 100% { box-shadow: 0 0 5px var(--active-glow); border-color: var(--active-glow); }
            50% { box-shadow: 0 0 25px var(--active-glow); border-color: var(--active-glow); }
        }

        .p-icon { font-size: 2.5rem; display: block; margin-bottom: 5px; }
        .p-name { font-size: 1rem; display: block; margin-bottom: 5px; white-space: nowrap; }

        /* 결과 배지 중앙 정렬 수정 */
        .result-badge {
            position: absolute; top: 50%; left: 50%; 
            transform: translate(-50%, -50%) scale(0);
            font-size: 2rem; font-weight: 900; text-align: center; z-index: 999;
            white-space: nowrap; pointer-events: none; transition: transform 0.5s;
            color: #FFD700; -webkit-text-stroke: 2px #FF4500; text-shadow: 0 0 15px rgba(255,0,0,0.8);
            background: rgba(0,0,0,0.9); padding: 5px 15px; border-radius: 50px;
            border: 3px solid #FFD700; box-shadow: 0 5px 15px rgba(0,0,0,0.5);
        }
        /* 애니메이션 수정: 중앙 정렬 유지하며 바운스 */
        .player-info.winner .result-badge { 
            animation: badge-bounce 1s infinite;
            transform: translate(-50%, -50%) scale(1) rotate(-10deg); 
        }
        .player-info.loser .result-badge { 
            transform: translate(-50%, -50%) scale(0.8); 
            color: #ccc; -webkit-text-stroke: 1px #555; border-color: #888; text-shadow: none; 
        }

        @keyframes badge-bounce {
            0%, 100% { transform: translate(-50%, -50%) scale(1) rotate(-10deg); }
            50% { transform: translate(-50%, -70%) scale(1.1) rotate(-10deg); }
        }

        /* 기물 리스트 */
        .captured-list {
            display: grid; grid-template-columns: repeat(5, 1fr); gap: 0px;
            width: 100%; min-height: 25px;
            background: rgba(0,0,0,0.3); border-radius: 8px; padding: 1px;
            justify-items: center; font-size: 1.2rem;
        }
        .captured-list.p1-loot { color: var(--p2-color); text-shadow: 0 0 5px var(--p2-color); }
        .captured-list.p2-loot { color: var(--p1-color); text-shadow: 0 0 5px var(--p1-color); }

        /* 타이머 & 무르기 */
        .timer-display {
            font-size: 1.5rem; font-weight: bold; color: #fff; background: #333;
            padding: 0px 0px; border-radius: 20px; border: 2px solid #666; width: 80%;
            text-align: center; box-shadow: inset 0 0 10px #000;
        }
        .player-info.active-turn .timer-display { color: #55ff55; border-color: #55ff55; }
        .player-info.active-turn.low-time .timer-display { color: #ff3333; border-color: #ff3333; animation: blink 0.5s infinite; }

        .undo-btn {
            background: #4facfe; color: white; border: none; padding: 8px 0; width: 80%;
            border-radius: 15px; font-size: 1rem; cursor: pointer; box-shadow: 0 4px 0 #2c82c9;
        }
        .undo-btn:active { transform: translateY(2px); box-shadow: 0 2px 0 #2c82c9; }
        
        /* 체스판 */
        .board-container-center {
            position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
            display: flex; flex-direction: column; align-items: center;
        }
        .chess-board {
            width: 55vh; height: 55vh; max-width: 80vw; max-height: 80vw;
            background-color: var(--board-dark-bg); border-radius: 10px;
            box-shadow: 0 15px 40px rgba(0,0,0,0.9); padding: 5px;
            display: grid; grid-template-columns: repeat(8, 1fr); grid-template-rows: repeat(8, 1fr);
            border: 6px solid #444; position: relative; box-sizing: border-box;
            transition: border-color 0.3s, box-shadow 0.3s;
        }
        .game-station.turn-p1 .chess-board { border-color: var(--p1-color); box-shadow: 0 0 20px var(--p1-color); }
        .game-station.turn-p2 .chess-board { border-color: var(--p2-color); box-shadow: 0 0 20px var(--p2-color); }

        .square {
            position: relative; cursor: pointer; display: flex;
            justify-content: center; align-items: center;
            font-size: clamp(1rem, 4vw, 3rem);
        }
        .square.dark { background-color: var(--board-dark); }
        .square.light { background-color: var(--board-light); }
        .square.last-move { box-shadow: inset 0 0 15px rgba(255,255,255,0.6); }

        /* 최적화: drop-shadow 대신 text-shadow 사용 (성능 개선) */
        .piece {
            z-index: 2; line-height: 1; width: 100%; height: 100%;
            display: flex; justify-content: center; align-items: center;
            text-shadow: 0 0 2px rgba(0,0,0,0.8); /* CSS 최적화 */
            /* 부드러운 이동 애니메이션 */
            transition: transform 0.25s ease-in-out; 
            pointer-events: none; /* 클릭 이벤트는 square에서 처리 */
        }
        .piece.white { color: var(--p1-color); text-shadow: 0 0 5px var(--p1-color); }
        .piece.black { color: var(--p2-color); text-shadow: 0 0 5px var(--p2-color); }

        .game-station.turn-p1 .piece.white.can-move { animation: active-piece-pulse 0.5s infinite alternate; }
        .game-station.turn-p2 .piece.black.can-move { animation: active-piece-pulse 0.5s infinite alternate; }

        @keyframes active-piece-pulse {
            from { text-shadow: 0 0 5px currentColor; transform: scale(1); }
            to { text-shadow: 0 0 15px currentColor; transform: scale(1.1); }
        }

        /* 킹 체크 효과 (붉은 오라) */
        .piece.king-check {
            text-shadow: 0 0 15px red, 0 0 30px red !important;
            animation: shake 0.5s infinite !important;
        }
        @keyframes shake {
            0% { transform: translate(1px, 1px) rotate(0deg); }
            10% { transform: translate(-1px, -2px) rotate(-1deg); }
            20% { transform: translate(-3px, 0px) rotate(1deg); }
            30% { transform: translate(3px, 2px) rotate(0deg); }
            40% { transform: translate(1px, -1px) rotate(1deg); }
            50% { transform: translate(-1px, 2px) rotate(-1deg); }
            60% { transform: translate(-3px, 1px) rotate(0deg); }
            70% { transform: translate(3px, 1px) rotate(-1deg); }
            80% { transform: translate(-1px, -1px) rotate(1deg); }
            90% { transform: translate(1px, 2px) rotate(0deg); }
            100% { transform: translate(1px, -2px) rotate(-1deg); }
        }

        .square.selected .piece {
            transform: scale(1.2) !important;
            animation: piece-bounce 0.5s infinite alternate !important;
        }
        @keyframes piece-bounce {
            from { transform: scale(1.2); text-shadow: 0 0 15px currentColor; }
            to { transform: scale(1.3); text-shadow: 0 0 30px currentColor; }
        }

        /* 이동 마커 */
        .valid-marker {
            position: absolute; width: 30%; height: 30%; border-radius: 50%;
            background-color: rgba(255,255,255,0.7); box-shadow: 0 0 5px #fff;
            pointer-events: none; animation: marker-pulse 1s infinite;
        }
        .valid-capture {
            position: absolute; width: 80%; height: 80%; border-radius: 50%;
            border: 4px solid #fff; box-shadow: 0 0 10px #fff;
            pointer-events: none; animation: marker-pulse 0.5s infinite;
        }
        @keyframes marker-pulse {
            0%, 100% { opacity: 0.5; transform: scale(0.9); }
            50% { opacity: 1; transform: scale(1.1); }
        }

        .restart-btn {
            position: absolute; top: 2%; left: 50%; transform: translateX(-50%);
            padding: 5px 20px; border-radius: 20px; background: #ff4757; color: white;
            border: none; font-size: 1rem; cursor: pointer;
            box-shadow: 0 3px 6px rgba(0,0,0,0.5); z-index: 20; white-space: nowrap;
        }
        .restart-btn:active { transform: translateX(-50%) scale(0.95); }

        .float-btn {
            width: 60px; height: 60px; border-radius: 50%;
            background: rgba(255, 255, 255, 0.1); border: 2px solid rgba(255, 255, 255, 0.3);
            color: white; font-size: 1.5rem; cursor: pointer; backdrop-filter: blur(5px);
            display: flex; justify-content: center; align-items: center; transition: all 0.3s;
        }
        .float-btn:hover { background: rgba(255, 255, 255, 0.3); transform: scale(1.1); }
        #floating-btn-container { position: fixed; bottom: 30%; right: 20px; z-index: 999; }
        #home-btn-container { position: fixed; bottom: 30%; left: 20px; z-index: 999; }

        @keyframes bounce { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-20px); } }
        @keyframes pop { 0% { transform: scale(1); } 100% { transform: scale(1.1); } }
        @keyframes blink { 50% { opacity: 0.5; } }

        /* 승급 모달 */
        .promotion-modal {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.85); z-index: 200;
            display: none; flex-direction: column; justify-content: center; align-items: center;
        }
        .promotion-title { font-size: 2rem; color: #fff; margin-bottom: 20px; }
        .promotion-options { display: flex; gap: 20px; }
        .promo-piece {
            font-size: 4rem; cursor: pointer; background: rgba(255,255,255,0.1);
            padding: 10px; border-radius: 10px; border: 2px solid transparent;
            transition: transform 0.2s;
        }
        .promo-piece:hover { transform: scale(1.2); background: rgba(255,255,255,0.3); border-color: #fff; }

    </style>
</head>
<body>

    <div class="lang-switcher">
        <button class="lang-btn" onclick="setLanguage('ko')" title="한국어">🇰🇷</button>
        <button class="lang-btn" onclick="setLanguage('en')" title="English">🇺🇸</button>
        <button class="lang-btn" onclick="setLanguage('zh')" title="中文">🇨🇳</button>
        <button class="lang-btn" onclick="setLanguage('ja')" title="日本語">🇯🇵</button>
        <button class="lang-btn" onclick="setLanguage('es')" title="Español">🇪🇸</button>
        <button class="lang-btn" onclick="setLanguage('fr')" title="Français">🇫🇷</button>
        <button class="lang-btn" onclick="setLanguage('ru')" title="Русский">🇷🇺</button>
    </div>

    <div id="start-screen">
        <h1 data-i18n="gameTitle">체스킹 동물 배틀</h1>
        <div class="rules-box">
            <h3 data-i18n="rulesTitle">게임 규칙</h3>
            <p data-i18n="rulesText">1. 짝을 지어 동물을 선택하세요.\n2. 선택한 동물의 색깔이 내 기물의 색이 됩니다.\n3. 왼쪽(1P)이 먼저 시작합니다.\n4. 상대방의 킹(King)을 잡으면 승리! 👑</p>
        </div>
        <div class="start-btn-group">
            <button class="start-main-btn" id="btn-start-1" data-i18n="btnOneBoard">게임판 1개</button>
            <button class="start-main-btn" id="btn-start-2" data-i18n="btnTwoBoards">게임판 2개</button>
        </div>
        <a href="/" class="start-sub-link" id="start-link" data-i18n="linkMoreGames">🎮 다른 게임 고르기</a>
    </div>

    <div id="game-container">
        <header>
            <a href="https://킹수학.com" class="home-link" id="header-link" data-i18n="homeLinkText">게임으로 수학의 킹이 되어라. 킹수학.com</a>
            <div class="header-title">
                <h2 data-i18n="gameTitleDecorated">👑 체스킹 동물 배틀 👑</h2>
            </div>
        </header>
        <div id="clock-wrapper">
            <div class="clock-container" id="live-clock"></div>
        </div>

        <div class="boards-wrapper">

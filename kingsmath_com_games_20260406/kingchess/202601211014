    let currentLang = 'en';

    // Helper for fast touch events
    function addFastClick(element, callback) {
        if (!element) return;
        element.addEventListener('pointerdown', function(e) {
            e.preventDefault();
            callback(e);
        }, { passive: false });
    }

    function detectLanguage() {
        const urlParams = new URLSearchParams(window.location.search);
        const langParam = urlParams.get('lang');
        if (langParam && translations[langParam]) return langParam;
        const storedLang = localStorage.getItem('kingsmath_lang');
        if (storedLang && translations[storedLang]) return storedLang;
        const browserLang = navigator.language.slice(0, 2);
        if (translations[browserLang]) return browserLang;
        return 'en';
    }

    function setLanguage(lang) {
        if (!translations[lang]) return;
        currentLang = lang;
        localStorage.setItem('kingsmath_lang', lang);
        updateContent();
        document.querySelectorAll('.lang-btn').forEach(btn => {
            if(btn.onclick.toString().includes(lang)) btn.classList.add('active');
            else btn.classList.remove('active');
        });
    }

    function updateContent() {
        const t = translations[currentLang];
        document.querySelectorAll('[data-i18n]').forEach(el => {
            const key = el.getAttribute('data-i18n');
            if(t[key]) {
                el.innerText = t[key];
                if (['ru', 'fr', 'es'].includes(currentLang) && el.tagName === 'H1') el.classList.add('long-text');
                else if (el.tagName === 'H1') el.classList.remove('long-text');
                if (['ru', 'fr'].includes(currentLang) && el.classList.contains('rules-text')) el.classList.add('long-text');
            }
        });
        document.getElementById('page-title').innerText = t.pageTitle;
        document.getElementById('meta-desc').setAttribute('content', t.metaDesc);
        document.getElementById('meta-keywords').setAttribute('content', t.metaKeywords);
        document.getElementById('og-title').setAttribute('content', t.ogTitle);
        document.getElementById('og-desc').setAttribute('content', t.ogDesc);

        const headerLink = document.getElementById('header-link');
        const startLink = document.getElementById('start-link');
        if (currentLang === 'ko') headerLink.href = "https://킹수학.com";
        else headerLink.href = "http://www.kingsmath.com";
        startLink.href = "/";

        if(games[1].state.includes('select')) renderSelection(1);
        if(games[2].state.includes('select')) renderSelection(2);
    }


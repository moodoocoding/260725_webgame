    function goHome() {
        if(games[1].timerId) clearInterval(games[1].timerId);
        if(games[2].timerId) clearInterval(games[2].timerId);
        
        document.getElementById('game-container').style.display = 'none';
        document.getElementById('start-screen').style.display = 'flex';
        setTimeout(()=>document.getElementById('start-screen').style.opacity = '1', 50);
    }

    function initGame(id) {
        games[id].state = 'select_p1';
        games[id].isAnimating = false;
        document.getElementById(`ui-${id}`).style.display = 'none';
        document.getElementById(`roulette-${id}`).style.display = 'none';
        document.getElementById(`select-${id}`).style.display = 'flex';
        renderSelection(id);
    }

    function renderSelection(id) {
        const grid = document.getElementById(`grid-${id}`);
        grid.innerHTML = '';
        const t = translations[currentLang];
        const isP1 = games[id].state === 'select_p1';
        document.getElementById(`select-title-${id}`).innerText = isP1 ? t.selectP1 : t.selectP2;

        ANIMALS.forEach(animal => {
            const card = document.createElement('div');
            card.className = 'animal-card';
            card.style.borderColor = animal.color;
            card.style.boxShadow = `0 0 10px ${animal.color}`;
            if (!isP1 && games[id].p1 && games[id].p1.id === animal.id) {
                card.classList.add('disabled');
            }
            card.innerHTML = `<div class="animal-icon">${animal.icon}</div><div class="animal-name" style="color:${animal.color}">${t[animal.id]}</div>`;
            addFastClick(card, () => selectAnimal(id, animal));

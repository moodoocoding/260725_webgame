    function selectAnimal(id, animal) {
        playSound('select');
        if (games[id].state === 'select_p1') {
            games[id].p1 = animal;
            games[id].state = 'select_p2';
            renderSelection(id);
        } else {
            games[id].p2 = animal;
            startRoulette(id);
        }
    }

    function startRoulette(id) {
        games[id].state = 'roulette';
        document.getElementById(`select-${id}`).style.display = 'none';
        document.getElementById(`roulette-${id}`).style.display = 'flex';
        
        const disp = document.getElementById(`roulette-disp-${id}`);
        const res = document.getElementById(`roulette-res-${id}`);
        res.innerText = "";
        
        let count = 0;
        const interval = setInterval(() => {
            playSound('tick');
            disp.innerText = (count % 2 === 0) ? games[id].p1.icon : games[id].p2.icon;
            count++;
            if (count > 12) {
                clearInterval(interval);
                disp.innerText = games[id].p1.icon; 
                res.innerText = `${translations[currentLang][games[id].p1.id]} ${translations[currentLang].goesFirst}`;
                playSound('start');
                setTimeout(() => startGame(id), 1500);

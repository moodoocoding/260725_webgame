<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>명화킹</title>

<script src="https://cdn.tailwindcss.com"></script>
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;700;900&display=swap" rel="stylesheet">

<style>
    :root {
        --app-height: 100vh;
        --primary-gold: #c5a059;
        --bg-dark: #121212;
        --panel-bg: rgba(30, 30, 30, 0.95);
    }

    html, body {
        margin: 0; padding: 0; overflow: hidden;
        background-color: var(--bg-dark);
        font-family: 'Noto Sans KR', sans-serif;
        width: 100%; height: 100vh; height: var(--app-height);
        
        touch-action: none; 
        -webkit-user-select: none; user-select: none;
        -webkit-touch-callout: none; -webkit-tap-highlight-color: transparent;
    }

    body { display: flex; flex-direction: column; color: #fff; }

    /* --- 상단 정보 영역 --- */
    #top-area {
        flex: 0 0 25%; min-height: 120px;
        background: linear-gradient(180deg, #1a1a1a 0%, #0d0d0d 100%);
        border-bottom: 4px solid var(--primary-gold);
        display: flex; justify-content: center; align-items: center;
        position: relative; z-index: 10; box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }

    #scoreboard-row {
        display: flex; justify-content: space-between; align-items: center;
        width: 100%; padding: 0 20px; height: 100%;
    }

    .player-group { display: flex; align-items: center; gap: 15px; height: 100%; flex: 1; }
    .p1-group { justify-content: center; } /* 왼쪽 정렬 */
    .p2-group { justify-content: center; }   /* 오른쪽 정렬 */

    .ref-img-large { 
        height: 85%; max-height: 120px; min-height: 90px; aspect-ratio: auto;
        border: 4px solid var(--primary-gold); border-radius: 8px; 
        background: #000; overflow: hidden; box-shadow: 0 5px 15px rgba(0,0,0,0.5);
        display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .ref-img-large img { width: 100%; height: 100%; object-fit: contain; }

    .player-zone {
        display: flex; align-items: center; gap: 15px; padding: 10px 20px;
        border-radius: 16px; background: rgba(255,255,255,0.05);
        min-width: 200px; justify-content: center; box-shadow: 0 5px 15px rgba(0,0,0,0.3);
    }
    .p1-zone { border: 3px solid #ff4d4d; color: #ff4d4d; }
    .p2-zone { border: 3px solid #4d88ff; color: #4d88ff; flex-direction: row-reverse; } /* 텍스트와 점수 좌우반전 */
    .player-label { font-size: clamp(20px, 2.5vw, 30px); font-weight: 700; }
    .score { font-size: clamp(40px, 4vw, 60px); font-weight: 900; margin: 0 10px; line-height: 1; }
    
    .center-info {
        flex: 0 0 auto; display: flex; align-items: center; justify-content: center; padding: 0 20px;
    }

    .timer-container { text-align: center; width: 150px; }
    .timer-label { color: #ffcc00; font-size: clamp(18px, 2vw, 26px); margin-bottom: 8px; font-weight: 700; text-shadow: 0 2px 4px rgba(0,0,0,0.8); }
    #timer-bar { width: 100%; height: 16px; background: #333; border-radius: 8px; overflow: hidden; border: 2px solid #555; }
    #timer-fill { width: 0%; height: 100%; background: linear-gradient(90deg, #ff3b30, #ffcc00, #4cd964); transition: width 1s linear; }

    /* --- 하단 게임 영역 --- */
    #game-area-wrapper {
        flex: 1; display: flex; justify-content: center; align-items: center;
        padding: 15px; background-color: #0d0d0d; position: relative; overflow: hidden;
    }

    #game-area { width: 100%; height: 100%; display: flex; position: relative; gap: 15px; }

    .table-bg {
        flex: 1; border-radius: 15px; border: 10px solid #3e2723;
        box-shadow: inset 0 0 60px rgba(0,0,0,0.8), 0 5px 20px rgba(0,0,0,0.5);
        position: relative; display: flex; justify-content: center; align-items: center; 
    }
    .left-table { background: radial-gradient(circle at 30% 30%, #1a5e2e 0%, #0a3315 90%); }
    .right-table { background: radial-gradient(circle at 70% 30%, #005c4b 0%, #002e26 90%); }

    .divider {
        position: absolute; left: 50%; top: 10px; bottom: 10px; width: 4px; 
        background: rgba(255, 215, 0, 0.3); transform: translateX(-50%); z-index: 4; border-radius: 2px;
    }

    /* --- 퍼즐 조각 --- */
    .board { 
        position: relative; background: rgba(0, 0, 0, 0.4); box-shadow: 0 10px 30px rgba(0,0,0,0.8); 
        border: 4px solid var(--primary-gold); box-sizing: content-box;
    }
    .puzzle-piece {
        position: absolute; box-sizing: border-box; border: 1px solid rgba(0, 0, 0, 0.4);
        background-repeat: no-repeat; transition: left 0.15s ease-out, top 0.15s ease-out;
        touch-action: none; cursor: grab;
    }
    .puzzle-piece.dragging {
        transition: none; z-index: 100; outline: 4px solid #ffcc00; box-shadow: 0 20px 40px rgba(0,0,0,0.6); cursor: grabbing; opacity: 0.95;
    }

    /* 플로팅 버튼 */
    .float-btn {
        position: fixed; bottom: 20px; width: 50px; height: 50px;
        background: rgba(255, 255, 255, 0.15); border: 2px solid rgba(255, 255, 255, 0.4);
        border-radius: 50%; cursor: pointer; z-index: 1000; display: flex; justify-content: center; align-items: center;
        color: white; font-size: 24px; transition: all 0.2s; backdrop-filter: blur(4px);
    }
    .float-btn:hover { background: rgba(255, 255, 255, 0.3); transform: scale(1.1); }
    .float-btn:active { transform: scale(0.95); }
    #fullscreen-btn { right: 20px; }
    #home-btn { left: 20px; }

    /* --- 모달 (세로 크기 최적화) --- */
    .overlay {
        position: absolute; top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0,0,0,0.85); display: flex; flex-direction: column; 
        justify-content: center; align-items: center; z-index: 100; backdrop-filter: blur(8px);
    }
    .modal-content {
        background: var(--panel-bg); padding: 20px 30px; border-radius: 24px; 
        border: 2px solid rgba(197, 160, 89, 0.5); display: flex; flex-direction: column; align-items: center; 
        max-width: 900px; width: 95%; max-height: 95vh; overflow-y: auto; box-shadow: 0 20px 60px rgba(0,0,0,0.9);
    }
    .modal-content::-webkit-scrollbar { width: 8px; }
    .modal-content::-webkit-scrollbar-thumb { background: #555; border-radius: 4px; }

    h1 { 
        font-size: clamp(35px, 5vw, 55px) !important; margin: 0 0 15px 0; font-weight: 900;
        background: linear-gradient(to bottom, #fff8e1, var(--primary-gold));
        -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        filter: drop-shadow(0 0 15px rgba(197, 160, 89, 0.5)); line-height: 1.2; word-break: keep-all; text-align: center;
    }

    /* 탭 UI */
    .tab-container {
        display: flex; background: rgba(0,0,0,0.5); border-radius: 30px; padding: 6px; margin-bottom: 15px; width: 100%; max-width: 600px;
    }
    .tab-btn {
        flex: 1; padding: 10px; font-size: clamp(15px, 2vw, 18px); font-weight: 700; color: #aaa; background: transparent; 
        border: none; border-radius: 25px; cursor: pointer; transition: all 0.3s;
    }
    .tab-btn.active { background: var(--primary-gold); color: #111; box-shadow: 0 4px 10px rgba(197, 160, 89, 0.4); }
    .tab-content { width: 100%; display: none; flex-direction: column; align-items: center; margin-bottom: 20px; }
    .tab-content.active { display: flex; animation: fadeIn 0.3s ease-in-out; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

    /* 갤러리 탭 (세로 사이즈 축소) */
    .gallery-wrapper {
        width: 100%; max-width: 800px; background: rgba(0,0,0,0.3); padding: 15px; border-radius: 16px; border: 1px solid #444;
    }
    .gallery-grid {
        display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 10px;
        max-height: 25vh; overflow-y: auto; padding-right: 5px;
    }
    .gallery-grid::-webkit-scrollbar { width: 6px; }
    .gallery-grid::-webkit-scrollbar-thumb { background: var(--primary-gold); border-radius: 4px; }
    
    .gallery-item {
        position: relative; border-radius: 10px; overflow: hidden; border: 3px solid transparent; cursor: pointer; transition: all 0.2s;
        background: #222; display: flex; flex-direction: column; height: 115px;
    }
    .gallery-item img { width: 100%; height: 80px; object-fit: cover; }
    .gallery-item .g-title { padding: 4px; font-size: 13px; text-align: center; color: #ddd; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .gallery-item:hover { transform: translateY(-3px); border-color: rgba(197, 160, 89, 0.5); }
    .gallery-item.active { border-color: #ffcc00; box-shadow: 0 0 15px rgba(255, 204, 0, 0.6); }

    /* 랜덤 탭 / 업로드 탭 */
    .random-box, .upload-box {
        width: 100%; max-width: 500px; border-radius: 24px; padding: 25px 20px;
        display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px;
    }
    .random-box { border: 3px dashed var(--primary-gold); background: rgba(197, 160, 89, 0.05); }
    .random-mark {
        font-size: 80px; font-weight: 900; color: #ffcc00; line-height: 1; text-shadow: 0 0 30px rgba(255, 204, 0, 0.6);
        animation: floatRandom 2s ease-in-out infinite;
    }
    @keyframes floatRandom { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }

    .upload-box { border: 3px dashed #666; background: rgba(255,255,255,0.02); cursor: pointer; transition: all 0.3s; }
    .upload-box:hover { border-color: var(--primary-gold); background: rgba(197, 160, 89, 0.05); }
    .upload-box i { font-size: 50px; color: #888; transition: color 0.3s; }
    .upload-box:hover i { color: var(--primary-gold); }
    .upload-text { font-size: 18px; color: #aaa; font-weight: 700; text-align: center; }

    /* 보안 텍스트 */
    .security-notice {
        margin-top: 10px; color: #4cd964; font-size: 13px; text-align: center; line-height: 1.4;
    }

    /* 설정 영역 (시간, 난이도 한 줄 배치 최적화) */
    .settings-row { 
        display: flex; flex-direction: row; flex-wrap: wrap; gap: 15px; justify-content: center; 
        width: 100%; margin-bottom: 20px; 
    }
    .setting-group { 
        display: flex; flex-direction: row; align-items: center; gap: 10px; 
        background: rgba(0,0,0,0.4); padding: 6px 15px; border-radius: 30px; 
    }
    .setting-title { font-size: 16px; color: #ffcc00; font-weight: 700; white-space: nowrap; }
    .opt-group { display: flex; gap: 6px; flex-wrap: wrap; justify-content: center; }
    .opt-btn {
        padding: 6px 12px; font-size: 15px; font-weight: 700; background: rgba(255, 255, 255, 0.1); 
        border: 2px solid #555; border-radius: 10px; color: #ccc; cursor: pointer; transition: all 0.2s;
    }
    .opt-btn:hover { background: rgba(255, 255, 255, 0.2); }
    .opt-btn.active { background: #ffcc00; color: #111; border-color: #ffcc00; box-shadow: 0 0 10px rgba(255, 204, 0, 0.5); }

    .start-game-btn {
        padding: 12px 80px; font-size: 28px; font-weight: 900; background: linear-gradient(to bottom, #ffd700, #ff8c00);
        border: 3px solid #fff; border-radius: 60px; color: #222; cursor: pointer;
        box-shadow: 0 10px 30px rgba(255, 140, 0, 0.5); transition: transform 0.1s, box-shadow 0.2s;
    }
    .start-game-btn:hover { transform: scale(1.05); box-shadow: 0 15px 40px rgba(255, 140, 0, 0.7); }
    .start-game-btn:active { transform: scale(0.95); }

    .other-game-link {
        margin-top: 15px; color: #aaa; text-decoration: none; font-size: 15px; border-bottom: 1px solid #777; 
        padding-bottom: 2px; transition: color 0.2s;
    }
    .other-game-link:hover { color: #fff; border-color: #fff; }

    /* 결과 모달 */
    #end-artwork {
        max-height: 45vh; max-width: 100%; object-fit: contain; border: 8px solid var(--primary-gold); 
        border-radius: 10px; box-shadow: 0 20px 50px rgba(0,0,0,0.8); margin-bottom: 20px;
    }
    .diff-btn { padding: 12px 30px; font-size: 20px; font-weight: 700; background: #333; border: 2px solid #666; border-radius: 15px; color: #fff; cursor: pointer; transition: all 0.2s; }
    .diff-btn:hover { border-color: #ffcc00; transform: scale(1.05); }

    .loading-spinner {
        border: 6px solid #333; border-top: 6px solid var(--primary-gold); border-radius: 50%;
        width: 60px; height: 60px; animation: spin 1s linear infinite; margin: 20px auto;
    }
    @keyframes spin { 0% { transform: rotate(0) } 100% { transform: rotate(360deg) } }
    .hidden { display: none !important; }
</style>
</head>
<body>

    <div id="top-area">
        <div id="scoreboard-row">
            <div class="player-group p1-group">
                <div class="ref-img-large">
                    <img class="ref-image" src="" alt="정답 그림">
                </div>
                <div class="player-zone p1-zone">
                    <div class="player-label">빨강팀</div>
                    <div class="score" id="score-p1">0%</div>
                </div>
            </div>
            
            <div class="center-info">
                <div class="timer-container">
                    <div class="timer-label" id="txt-timer">진행 시간</div>
                    <div id="timer-bar"><div id="timer-fill"></div></div>
                </div>
            </div>

            <div class="player-group p2-group">
                <div class="player-zone p2-zone">
                    <div class="player-label">파랑팀</div>
                    <div class="score" id="score-p2">0%</div>
                </div>
                <div class="ref-img-large">
                    <img class="ref-image" src="" alt="정답 그림">
                </div>
            </div>
        </div>
    </div>

    <div id="game-area-wrapper">
        <div id="game-area">
            <div class="table-bg left-table">
                <div id="board-p1" class="board"></div>
            </div>
            <div class="divider"></div>
            <div class="table-bg right-table">
                <div id="board-p2" class="board"></div>
            </div>
        </div>
    </div>

    <div id="home-btn" class="float-btn" onclick="location.reload()" title="처음으로">🏠</div>
    <div id="fullscreen-btn" class="float-btn" onclick="toggleFullscreen()" title="전체화면">⛶</div>

    <div id="overlay-start" class="overlay">
        <div class="modal-content">
            <h1>명화킹</h1>
            
            <div class="tab-container">
                <button class="tab-btn" data-tab="tab-gallery" onclick="switchTab('tab-gallery')">명화 고르기</button>
                <button class="tab-btn active" data-tab="tab-random" onclick="switchTab('tab-random')">랜덤 선택</button>
                <button class="tab-btn" data-tab="tab-upload" onclick="switchTab('tab-upload')">파일 업로드</button>
            </div>

            <div id="tab-gallery" class="tab-content">
                <div class="gallery-wrapper">
                    <div class="gallery-grid" id="gallery-grid">
                        </div>
                </div>
            </div>

            <div id="tab-random" class="tab-content active">
                <div class="random-box">
                    <div class="random-mark">?</div>
                    <div style="font-size: 20px; color: #ddd; font-weight: 700;">어떤 명화가 나올까요?</div>
                </div>
            </div>

            <div id="tab-upload" class="tab-content">
                <div class="upload-box" onclick="document.getElementById('upload-input').click()">
                    <i class="fas fa-cloud-upload-alt"></i>
                    <div class="upload-text">이곳을 터치하여 사진을 선택하세요</div>
                    <input type="file" id="upload-input" accept="image/*" class="hidden" onchange="handleImageUpload(event)">
                </div>
                <div class="security-notice">
                    <i class="fa-solid fa-shield-check"></i> 업로드한 사진은 기기 내에서만 처리되며,<br>외부 서버로 전송되거나 저장되지 않아 안전합니다.
                </div>
            </div>

            <div class="settings-row">
                <div class="setting-group">
                    <div class="setting-title">제한 시간</div>
                    <div class="opt-group" id="time-options">
                        <button class="opt-btn" onclick="selectTime(60, this)">1분</button>
                        <button class="opt-btn" onclick="selectTime(120, this)">2분</button>
                        <button class="opt-btn active" onclick="selectTime(180, this)">3분</button>
                        <button class="opt-btn" onclick="selectTime(300, this)">5분</button>
                        <button class="opt-btn" onclick="selectTime(0, this)">무제한</button>
                    </div>
                </div>
                <div class="setting-group">
                    <div class="setting-title">난이도</div>
                    <div class="opt-group" id="grid-options">
                        <button class="opt-btn active" onclick="selectGrid(3, this)">3x3</button>
                        <button class="opt-btn" onclick="selectGrid(5, this)">5x5</button>
                        <button class="opt-btn" onclick="selectGrid(7, this)">7x7</button>
                        <button class="opt-btn" onclick="selectGrid(10, this)">10x10</button>
                    </div>
                </div>
            </div>

            <button class="start-game-btn" onclick="startSequence()">게임 시작</button>
            <a href="/" class="other-game-link">다른 게임 고르기</a>
        </div>
    </div>

    <div id="overlay-countdown" class="overlay hidden">
        <div class="modal-content" style="background: transparent; border: none; box-shadow: none;">
            <div id="countdown-text" style="font-size: 32px; color: #ffcc00; margin-bottom: 20px; font-weight: 700;">게임 준비! (이미지 로딩 중...)</div>
            <div id="countdown-number" style="font-size: 150px; font-weight: 900; color: white; text-shadow: 0 10px 30px rgba(0,0,0,0.8);">5</div>
            <div id="loading-indicator" class="loading-spinner hidden"></div>
        </div>
    </div>

    <div id="overlay-end" class="overlay hidden">
        <div class="modal-content" style="max-width: 90vw; padding: 30px;">
            <h1 id="win-title" style="font-size: 60px; margin-bottom: 20px;">빨강팀 승리!</h1>
            <img id="end-artwork" src="" alt="완성된 그림">
            <div id="end-title" style="font-size: 32px; color: #fff; font-weight: 700; margin-bottom: 5px;">작품명</div>
            <div id="end-artist" style="font-size: 24px; color: #aaa; margin-bottom: 30px;">작가 (연도)</div>
            <button class="diff-btn" onclick="location.reload()">다시하기</button>
        </div>
    </div>

<script>
    // --- 23개 명화 데이터 ---
    const artworksDB = [
        { "title": "야간 순찰", "artist": "렘브란트 판 레인", "year": "1642년", "description": "빛과 어둠의 강한 대비를 사용하여 대원들이 출동하는 긴박한 순간을 그렸습니다.", "url": "https://kingsmath.com/kingmh/img800/960px-The_Night_Watch_-_HD.jpg", "thumbnail": "https://kingsmath.com/kingmh/img100/960px-The_Night_Watch_-_HD.jpg" },
        { "title": "그랑드 자트 섬의 일요일 오후", "artist": "조르주 쇠라", "year": "1884년", "description": "수많은 점을 찍어 형태를 만드는 점묘법으로 평화로운 공원 풍경을 그렸습니다.", "url": "https://kingsmath.com/kingmh/img800/A_Sunday_on_La_Grande_Jatte,_Georges_Seurat,_1884.jpg", "thumbnail": "https://kingsmath.com/kingmh/img100/A_Sunday_on_La_Grande_Jatte,_Georges_Seurat,_1884.jpg" },
        { "title": "안개 바다 위의 방랑자", "artist": "카스파르 다비드 프리드리히", "year": "1818년", "description": "거대한 자연 앞에서 안개를 내려다보는 뒷모습을 통해 신비로움과 경외감을 줍니다.", "url": "https://kingsmath.com/kingmh/img800/Caspar_David_Friedrich_-_Wanderer_above_the_sea_of_fog.jpg", "thumbnail": "https://kingsmath.com/kingmh/img100/Caspar_David_Friedrich_-_Wanderer_above_the_sea_of_fog.jpg" },
        { "title": "수련", "artist": "클로드 모네", "year": "1916년", "description": "빛에 따라 시시각각 변하는 물 위의 수련과 반사광을 아름답게 그렸습니다.", "url": "https://kingsmath.com/kingmh/img800/Claude_Monet_-_Water_Lilies_-_Google_Art_Project.jpg", "thumbnail": "https://kingsmath.com/kingmh/img100/Claude_Monet_-_Water_Lilies_-_Google_Art_Project.jpg" },
        { "title": "아담의 창조", "artist": "미켈란젤로 부오나로티", "year": "1512년", "description": "신의 손가락과 아담의 손가락이 맞닿으려는 찰나의 긴장감을 표현했습니다.", "url": "https://kingsmath.com/kingmh/img800/Creación_de_Adán.jpg", "thumbnail": "https://kingsmath.com/kingmh/img100/Creación_de_Adán.jpg" },
        { "title": "씨름", "artist": "김홍도", "year": "18세기", "description": "조선 시대 서민들이 씨름을 즐기는 역동적인 순간을 생동감 있게 그렸습니다.", "url": "https://kingsmath.com/kingmh/img800/Danwon-Ssireum.jpg", "thumbnail": "https://kingsmath.com/kingmh/img100/Danwon-Ssireum.jpg" },
        { "title": "무대 위의 무용수", "artist": "에드가 드가", "year": "1878년", "description": "화려한 무대 위 발레리나의 순간적인 움직임을 파스텔로 부드럽게 그렸습니다.", "url": "https://kingsmath.com/kingmh/img800/Edgar_Degas_-_The_Star_-_Google_Art_Project.jpg", "thumbnail": "https://kingsmath.com/kingmh/img100/Edgar_Degas_-_The_Star_-_Google_Art_Project.jpg" },
        { "title": "절규", "artist": "에드바르 뭉크", "year": "1893년", "description": "불안과 공포를 일렁이는 곡선과 강렬한 색채로 드라마틱하게 담아냈습니다.", "url": "https://kingsmath.com/kingmh/img800/Edvard_Munch_-_The_Scream_-_Google_Art_Project.jpg", "thumbnail": "https://kingsmath.com/kingmh/img100/Edvard_Munch_-_The_Scream_-_Google_Art_Project.jpg" },
        { "title": "민중을 이끄는 자유의 여신", "artist": "외젠 들라크루아", "year": "1830년", "description": "자유를 위해 나아가는 민중의 열정을 역동적인 구도로 그린 역사화입니다.", "url": "https://kingsmath.com/kingmh/img800/Eugène_Delacroix_-_Le_28_Juillet._La_Liberté_guidant_le_peuple.jpg", "thumbnail": "https://kingsmath.com/kingmh/img100/Eugène_Delacroix_-_Le_28_Juillet._La_Liberté_guidant_le_peuple.jpg" },
        { "title": "아메리칸 고딕", "artist": "그랜트 우드", "year": "1930년", "description": "미국 농촌 부부의 엄격하고 근면한 삶을 상징적으로 보여주는 작품입니다.", "url": "https://kingsmath.com/kingmh/img800/Grant_Wood_-_American_Gothic_-_Google_Art_Project.jpg", "thumbnail": "https://kingsmath.com/kingmh/img100/Grant_Wood_-_American_Gothic_-_Google_Art_Project.jpg" },
        { "title": "비 오는 날의 파리 거리", "artist": "구스타브 카유보트", "year": "1877년", "description": "비 내리는 파리 시가지의 풍경과 사람들의 모습을 사실적으로 묘사했습니다.", "url": "https://kingsmath.com/kingmh/img800/Gustave_Caillebotte_-_Paris_Street;_Rainy_Day_-_Google_Art_Project.jpg", "thumbnail": "https://kingsmath.com/kingmh/img100/Gustave_Caillebotte_-_Paris_Street;_Rainy_Day_-_Google_Art_Project.jpg" },
        { "title": "대사들", "artist": "한스 홀바인", "year": "1533년", "description": "두 인물 사이에 배치된 여러 도구와 바닥의 왜곡된 해골 그림이 특징입니다.", "url": "https://kingsmath.com/kingmh/img800/Hans_Holbein_the_Younger_-_The_Ambassadors_-_Google_Art_Project.jpg", "thumbnail": "https://kingsmath.com/kingmh/img100/Hans_Holbein_the_Younger_-_The_Ambassadors_-_Google_Art_Project.jpg" },
        { "title": "이삭 줍는 사람들", "artist": "장 프랑수아 밀레", "year": "1857년", "description": "노동하는 농민들의 모습을 통해 평범한 일상의 숭고함을 표현한 작품입니다.", "url": "https://kingsmath.com/kingmh/img800/Jean-François_Millet_-_Gleaners_-_Google_Art_Project_2.jpg", "thumbnail": "https://kingsmath.com/kingmh/img100/Jean-François_Millet_-_Gleaners_-_Google_Art_Project_2.jpg" },
        { "title": "건초 마차", "artist": "존 컨스터블", "year": "1821년", "description": "영국 시골 마을의 평화롭고 정겨운 풍경을 사실적으로 담아낸 풍경화입니다.", "url": "https://kingsmath.com/kingmh/img800/John_Constable_-_The_Hay_Wain.jpg", "thumbnail": "https://kingsmath.com/kingmh/img100/John_Constable_-_The_Hay_Wain.jpg" },
        { "title": "눈보라", "artist": "조지프 말러드 윌리엄 터너", "year": "1842년", "description": "거친 바다 위에서 눈보라와 싸우는 증기선의 역동적인 모습을 물감의 번짐으로 표현했습니다.", "url": "https://kingsmath.com/kingmh/img800/Joseph_Mallord_William_Turner_-_Snow_Storm_-_Steam-Boat_off_a_Harbour's_Mouth_-_WGA23178.jpg", "thumbnail": "https://kingsmath.com/kingmh/img100/Joseph_Mallord_William_Turner_-_Snow_Storm_-_Steam-Boat_off_a_Harbour's_Mouth_-_WGA23178.jpg" },
        { "title": "시녀들", "artist": "디에고 벨라스케스", "year": "1656년", "description": "공주와 시녀들, 그리고 그림을 그리는 화가 자신의 모습을 복합적으로 담았습니다.", "url": "https://kingsmath.com/kingmh/img800/Las_Meninas,_by_Diego_Velázquez,_from_Prado_in_Google_Earth.jpg", "thumbnail": "https://kingsmath.com/kingmh/img100/Las_Meninas,_by_Diego_Velázquez,_from_Prado_in_Google_Earth.jpg" },
        { "title": "진주 귀걸이를 한 소녀", "artist": "요하네스 베르메르", "year": "1665년", "description": "소녀의 맑은 눈망울과 반짝이는 진주 귀걸이가 신비로운 분위기를 자아냅니다.", "url": "https://kingsmath.com/kingmh/img800/Meisje_met_de_parel.jpg", "thumbnail": "https://kingsmath.com/kingmh/img100/Meisje_met_de_parel.jpg" },
        { "title": "물랭 드 라 갈레트의 무도회", "artist": "오귀스트 르누아르", "year": "1876년", "description": "나무 사이로 비치는 햇살과 즐겁게 춤추는 사람들의 활기찬 순간을 담았습니다.", "url": "https://kingsmath.com/kingmh/img800/Pierre-Auguste_Renoir,_Le_Moulin_de_la_Galette.jpg", "thumbnail": "https://kingsmath.com/kingmh/img100/Pierre-Auguste_Renoir,_Le_Moulin_de_la_Galette.jpg" },
        { "title": "비너스의 탄생", "artist": "산드로 보티첼리", "year": "1485년경", "description": "바다 거품에서 태어난 사랑의 여신 비너스가 해변에 도착하는 장면입니다.", "url": "https://kingsmath.com/kingmh/img800/Sandro_Botticelli_-_La_nascita_di_Venere_-_Google_Art_Project_-_edited.jpg", "thumbnail": "https://kingsmath.com/kingmh/img100/Sandro_Botticelli_-_La_nascita_di_Venere_-_Google_Art_Project_-_edited.jpg" },
        { "title": "전함 테메레르", "artist": "조지프 말러드 윌리엄 터너", "year": "1839년", "description": "역할을 다하고 퇴역하는 거대한 전함의 마지막 항해를 장엄하게 그렸습니다.", "url": "https://kingsmath.com/kingmh/img800/The_Fighting_Temeraire,_JMW_Turner,_National_Gallery.jpg", "thumbnail": "https://kingsmath.com/kingmh/img100/The_Fighting_Temeraire,_JMW_Turner,_National_Gallery.jpg" },
        { "title": "키스", "artist": "구스타프 클림트", "year": "1908년", "description": "금박을 사용한 화려한 장식 속에서 연인의 사랑을 상징적으로 담았습니다.", "url": "https://kingsmath.com/kingmh/img800/The_Kiss_-_Gustav_Klimt_-_Google_Cultural_Institute.jpg", "thumbnail": "https://kingsmath.com/kingmh/img100/The_Kiss_-_Gustav_Klimt_-_Google_Cultural_Institute.jpg" },
        { "title": "별이 빛나는 밤", "artist": "빈센트 반 고흐", "year": "1889년", "description": "밤하늘의 소용돌이와 빛나는 별을 통해 화가의 강렬한 감정을 표현했습니다.", "url": "https://kingsmath.com/kingmh/img800/Van_Gogh_-_Starry_Night_-_Google_Art_Project.jpg", "thumbnail": "https://kingsmath.com/kingmh/img100/Van_Gogh_-_Starry_Night_-_Google_Art_Project.jpg" },
        { "title": "걸프 스트림", "artist": "윈슬로 호머", "year": "1899년", "description": "거친 바다 위 조난당한 배와 상어들 사이에서 사투를 벌이는 긴장감을 그렸습니다.", "url": "https://kingsmath.com/kingmh/img800/Winslow_Homer_-_The_Gulf_Stream_-_Metropolitan_Museum_of_Art.jpg", "thumbnail": "https://kingsmath.com/kingmh/img100/Winslow_Homer_-_The_Gulf_Stream_-_Metropolitan_Museum_of_Art.jpg" }
    ];

    // --- 유틸리티 및 오디오 엔진 ---
    const AudioEngine = {
        ctx: null,
        init: function() {
            if (!this.ctx) {
                window.AudioContext = window.AudioContext || window.webkitAudioContext;
                this.ctx = new AudioContext();
            } else if (this.ctx.state === 'suspended') { this.ctx.resume(); }
        },
        playTone: function(freq, type, duration, vol=0.3, startTime=null) {
            if (!this.ctx) this.init();
            if (this.ctx.state === 'suspended') this.ctx.resume();
            const now = startTime || this.ctx.currentTime;
            const osc = this.ctx.createOscillator();
            const gain = this.ctx.createGain();
            osc.type = type; osc.frequency.setValueAtTime(freq, now);
            gain.gain.setValueAtTime(vol, now); gain.gain.exponentialRampToValueAtTime(0.01, now + duration);
            osc.connect(gain); gain.connect(this.ctx.destination);
            osc.start(now); osc.stop(now + duration);
        },
        playClack: function() { this.playTone(300, 'triangle', 0.05, 0.2); },
        playStart: function() { this.playTone(800, 'square', 0.3, 0.4); },
        playFanfare: function() {
            if (!this.ctx) return;
            const now = this.ctx.currentTime;
            [523, 659, 783, 1046].forEach((freq, i) => { this.playTone(freq, 'square', 0.2, 0.3, now + i*0.15); });
        }
    };

    function toggleFullscreen() {
        if (!document.fullscreenElement) { document.documentElement.requestFullscreen().catch(err => console.log(err)); } 
        else if (document.exitFullscreen) { document.exitFullscreen(); }
    }

    const setAppHeight = () => {
        document.documentElement.style.setProperty('--app-height', `${window.innerHeight}px`);
        if(gameState.isPlaying || document.getElementById('overlay-start').classList.contains('hidden')) resizeBoards();
    }
    window.addEventListener('resize', setAppHeight);
    window.addEventListener('orientationchange', setAppHeight);

    // --- 게임 상태 및 모드 관리 ---
    let gameState = {
        gridSize: 3, p1: { boardId: 'board-p1', pieces: [], domElements: [], isWinner: false },
        p2: { boardId: 'board-p2', pieces: [], domElements: [], isWinner: false },
        imgData: null, imgReady: false, imgRatio: 1, isPlaying: false,
        timeLimit: 180, timeRemaining: 180, timeElapsed: 0, timerIntv: null
    };

    let selectedTime = 180;
    let selectedGrid = 3;

    let currentMode = 'random'; 
    let selectedGalleryItem = artworksDB[0];
    let uploadedItem = null;

    function selectTime(seconds, btn) {
        selectedTime = seconds;
        document.querySelectorAll('#time-options .opt-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
    }

    function selectGrid(size, btn) {
        selectedGrid = size;
        document.querySelectorAll('#grid-options .opt-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
    }

    // --- 탭 UI 전환 로직 ---
    function switchTab(tabId) {
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
        document.querySelector(`.tab-btn[data-tab="${tabId}"]`).classList.add('active');
        document.getElementById(tabId).classList.add('active');
        
        currentMode = tabId.replace('tab-', '');
    }

    function initGallery() {
        const container = document.getElementById('gallery-grid');
        container.innerHTML = ''; 
        artworksDB.forEach((art, idx) => {
            const el = document.createElement('div');
            el.className = 'gallery-item' + (idx === 0 ? ' active' : '');
            el.id = 'gallery-item-' + idx;
            el.innerHTML = `
                <img src="${art.thumbnail}" alt="${art.title}">
                <div class="g-title">${art.title}</div>
            `;
            el.onclick = () => selectArtwork(idx);
            container.appendChild(el);
        });
    }

    function selectArtwork(idx) {
        document.querySelectorAll('.gallery-item').forEach(el => el.classList.remove('active'));
        const activeItem = document.getElementById('gallery-item-' + idx);
        if(activeItem) activeItem.classList.add('active');
        selectedGalleryItem = artworksDB[idx];
    }

    function handleImageUpload(event) {
        const file = event.target.files[0];
        if (file) {
            const url = URL.createObjectURL(file);
            uploadedItem = {
                title: file.name.split('.')[0], artist: "내 사진", year: "",
                url: url, thumbnail: url 
            };
            document.querySelector('.upload-text').innerHTML = `<span style="color:#4cd964;">${file.name}</span><br>업로드 완료!`;
        }
    }

    function setGameImageAndStart(item) {
        gameState.imgReady = false;
        gameState.imgData = item;
        
        const img = new Image();
        img.onload = () => {
            gameState.imgRatio = img.naturalWidth / img.naturalHeight;
            document.querySelectorAll('.ref-image').forEach(el => el.src = item.url);
            
            document.getElementById('end-artwork').src = item.url;
            document.getElementById('end-title').textContent = item.title;
            document.getElementById('end-artist').textContent = `${item.artist} ${item.year ? '('+item.year+')' : ''}`;
            gameState.imgReady = true;
        };
        img.onerror = () => {
            console.error("이미지 로드 실패.");
            alert("이미지 다운로드에 실패했습니다. (인터넷 연결 등을 확인해주세요)");
        };
        img.src = item.url;
    }

    // --- 시퀀스 및 게임 로직 ---
    function startSequence() {
        let targetItem = null;
        if (currentMode === 'random') {
            const idx = Math.floor(Math.random() * artworksDB.length);
            targetItem = artworksDB[idx];
        } else if (currentMode === 'gallery') {
            targetItem = selectedGalleryItem;
        } else if (currentMode === 'upload') {
            if (!uploadedItem) return alert("사진 파일을 업로드해 주세요!");
            targetItem = uploadedItem;
        }

        setGameImageAndStart(targetItem);

        AudioEngine.init();
        gameState.gridSize = selectedGrid; gameState.timeLimit = selectedTime; gameState.timeRemaining = selectedTime;

        document.getElementById('overlay-start').classList.add('hidden');
        const countOverlay = document.getElementById('overlay-countdown');
        countOverlay.classList.remove('hidden');

        let count = 5;
        const countNum = document.getElementById('countdown-number');
        const spinner = document.getElementById('loading-indicator');
        countNum.textContent = count; countNum.classList.remove('hidden'); spinner.classList.add('hidden');

        const intv = setInterval(() => {
            count--;
            if (count > 0) {
                countNum.textContent = count; AudioEngine.playTone(1000, 'sine', 0.1, 0.2);
            } else {
                if (gameState.imgReady) {
                    clearInterval(intv); countOverlay.classList.add('hidden'); startGame();
                } else {
                    countNum.classList.add('hidden'); spinner.classList.remove('hidden');
                    document.getElementById('countdown-text').textContent = "고화질 이미지를 렌더링 중입니다...";
                }
            }
        }, 1000);

        const checkReadyIntv = setInterval(() => {
            if(count <= 0 && gameState.imgReady) {
                clearInterval(checkReadyIntv); clearInterval(intv);
                countOverlay.classList.add('hidden'); startGame();
            }
        }, 200);
    }

    function startGame() {
        AudioEngine.playStart();
        initBoard('p1'); initBoard('p2'); resizeBoards();
        gameState.isPlaying = true; gameState.timeElapsed = 0; updateScores();

        clearInterval(gameState.timerIntv);
        const timerFill = document.getElementById('timer-fill');
        const txtTimer = document.getElementById('txt-timer');
        
        if (gameState.timeLimit > 0) {
            timerFill.style.width = '100%'; timerFill.style.transition = 'width 1s linear';
            gameState.timerIntv = setInterval(() => {
                gameState.timeRemaining--;
                const m = String(Math.floor(gameState.timeRemaining / 60)).padStart(2, '0');
                const s = String(gameState.timeRemaining % 60).padStart(2, '0');
                txtTimer.textContent = `${m}:${s}`;
                const pct = (gameState.timeRemaining / gameState.timeLimit) * 100;
                timerFill.style.width = `${pct}%`;

                if (gameState.timeRemaining <= 10) {
                    timerFill.style.background = '#ff3b30';
                    if(gameState.timeRemaining > 0) AudioEngine.playTone(1200, 'sine', 0.1, 0.2);
                } else if (pct <= 30) { timerFill.style.background = '#ffcc00'; } 
                else { timerFill.style.background = 'linear-gradient(90deg, #ff3b30, #ffcc00, #4cd964)'; }

                if (gameState.timeRemaining <= 0) { clearInterval(gameState.timerIntv); handleTimeOut(); }
            }, 1000);
        } else {
            timerFill.style.width = '100%'; timerFill.style.background = '#4cd964';
            gameState.timerIntv = setInterval(() => {
                gameState.timeElapsed++;
                const m = String(Math.floor(gameState.timeElapsed / 60)).padStart(2, '0');
                const s = String(gameState.timeElapsed % 60).padStart(2, '0');
                txtTimer.textContent = `${m}:${s}`;
            }, 1000);
        }
    }

    function handleTimeOut() {
        gameState.isPlaying = false;
        let p1Score = getProgress(gameState.p1), p2Score = getProgress(gameState.p2);
        if (p1Score > p2Score) endGame('빨강팀 (시간 종료)', true);
        else if (p2Score > p1Score) endGame('파랑팀 (시간 종료)', true);
        else endGame('무승부 (시간 종료)', true);
    }

    function resizeBoards() {
        ['p1', 'p2'].forEach(player => {
            const pState = gameState[player];
            const container = document.querySelector(player === 'p1' ? '.left-table' : '.right-table');
            
            const maxW = container.clientWidth - 50, maxH = container.clientHeight - 50;
            const containerRatio = maxW / maxH, imgRatio = gameState.imgRatio; 
            let boardW, boardH;

            if (imgRatio > containerRatio) { boardW = maxW; boardH = maxW / imgRatio; } 
            else { boardH = maxH; boardW = maxH * imgRatio; }
            
            const boardEl = document.getElementById(pState.boardId);
            boardEl.style.width = boardW + 'px'; boardEl.style.height = boardH + 'px';
            updateVisuals(pState, boardW, boardH);
        });
    }

    function initBoard(playerKey) {
        const pState = gameState[playerKey];
        const boardEl = document.getElementById(pState.boardId);
        boardEl.innerHTML = ''; pState.pieces = []; pState.domElements = []; pState.isWinner = false;
        const total = gameState.gridSize * gameState.gridSize;

        for (let i = 0; i < total; i++) pState.pieces.push(i);
        do { pState.pieces.sort(() => Math.random() - 0.5); } while (pState.pieces.every((val, i) => val === i));

        for (let pieceId = 0; pieceId < total; pieceId++) {
            const pieceEl = document.createElement('div');
            pieceEl.className = 'puzzle-piece'; pieceEl.dataset.player = playerKey; pieceEl.dataset.pieceId = pieceId;

            const origRow = Math.floor(pieceId / gameState.gridSize), origCol = pieceId % gameState.gridSize;
            const bgPosX = gameState.gridSize > 1 ? (origCol / (gameState.gridSize - 1)) * 100 : 0;
            const bgPosY = gameState.gridSize > 1 ? (origRow / (gameState.gridSize - 1)) * 100 : 0;

            pieceEl.style.backgroundImage = `url(${gameState.imgData.url})`;
            pieceEl.style.backgroundSize = `${gameState.gridSize * 100}% ${gameState.gridSize * 100}%`;
            pieceEl.style.backgroundPosition = `${bgPosX}% ${bgPosY}%`;

            attachDragEvents(pieceEl, pState);
            pState.domElements[pieceId] = pieceEl; boardEl.appendChild(pieceEl);
        }
    }

    function updateVisuals(pState, boardW, boardH) {
        if (!pState.domElements || pState.domElements.length === 0) return;
        const boardEl = document.getElementById(pState.boardId);
        const currentBoardW = boardW || boardEl.clientWidth, currentBoardH = boardH || boardEl.clientHeight;
        const pieceW = currentBoardW / gameState.gridSize, pieceH = currentBoardH / gameState.gridSize;

        for (let slotIndex = 0; slotIndex < pState.pieces.length; slotIndex++) {
            const pieceId = pState.pieces[slotIndex], pieceEl = pState.domElements[pieceId];
            const row = Math.floor(slotIndex / gameState.gridSize), col = slotIndex % gameState.gridSize;
            pieceEl.style.width = pieceW + 'px'; pieceEl.style.height = pieceH + 'px';
            pieceEl.style.left = (col * pieceW) + 'px'; pieceEl.style.top = (row * pieceH) + 'px';
            pieceEl.dataset.slotIndex = slotIndex;
        }
    }

    let activeDrags = {};
    function attachDragEvents(pieceEl, pState) {
        pieceEl.addEventListener('pointerdown', (e) => {
            if (!gameState.isPlaying) return;
            e.preventDefault();
            const slotIndex = parseInt(pieceEl.dataset.slotIndex);
            pieceEl.setPointerCapture(e.pointerId); pieceEl.classList.add('dragging');
            activeDrags[e.pointerId] = { el: pieceEl, pState: pState, slotIndex: slotIndex, startX: e.clientX, startY: e.clientY };
        });
        pieceEl.addEventListener('pointermove', (e) => {
            const drag = activeDrags[e.pointerId];
            if (!drag) return;
            const dx = e.clientX - drag.startX, dy = e.clientY - drag.startY;
            drag.el.style.transform = `translate(${dx}px, ${dy}px) scale(1.05)`;
        });
        pieceEl.addEventListener('pointerup', handleDragEnd);
        pieceEl.addEventListener('pointercancel', handleDragEnd);
    }

    function handleDragEnd(e) {
        const drag = activeDrags[e.pointerId];
        if (!drag) return;
        drag.el.releasePointerCapture(e.pointerId); drag.el.style.transform = ''; drag.el.classList.remove('dragging');

        const pState = drag.pState, boardEl = document.getElementById(pState.boardId), boardRect = boardEl.getBoundingClientRect();
        const dropX = e.clientX - boardRect.left, dropY = e.clientY - boardRect.top;
        const pieceW = boardEl.clientWidth / gameState.gridSize, pieceH = boardEl.clientHeight / gameState.gridSize;

        let targetCol = Math.floor(dropX / pieceW), targetRow = Math.floor(dropY / pieceH);
        targetCol = Math.max(0, Math.min(gameState.gridSize - 1, targetCol));
        targetRow = Math.max(0, Math.min(gameState.gridSize - 1, targetRow));

        const targetSlotIndex = targetRow * gameState.gridSize + targetCol;
        if (targetSlotIndex !== drag.slotIndex) {
            const arr = pState.pieces, temp = arr[targetSlotIndex];
            arr[targetSlotIndex] = arr[drag.slotIndex]; arr[drag.slotIndex] = temp;
            AudioEngine.playClack();
        }
        updateVisuals(pState); checkProgress(pState);
        delete activeDrags[e.pointerId];
    }

    function getProgress(pState) {
        let correctCount = 0; const total = pState.pieces.length;
        for (let i = 0; i < total; i++) { if (pState.pieces[i] === i) correctCount++; }
        return Math.floor((correctCount / total) * 100);
    }

    function checkProgress(pState) {
        const percentage = getProgress(pState), isP1 = pState.boardId === 'board-p1';
        document.getElementById(isP1 ? 'score-p1' : 'score-p2').textContent = `${percentage}%`;
        if (percentage === 100) { pState.isWinner = true; endGame(isP1 ? '빨강팀' : '파랑팀', false); }
    }

    function updateScores() { document.getElementById('score-p1').textContent = '0%'; document.getElementById('score-p2').textContent = '0%'; }

    function endGame(winnerName, isTimeOver = false) {
        gameState.isPlaying = false; clearInterval(gameState.timerIntv); AudioEngine.playFanfare();
        const endOverlay = document.getElementById('overlay-end'), winTitle = document.getElementById('win-title');
        
        if (winnerName.includes('무승부')) { winTitle.textContent = isTimeOver ? '무승부! (시간 종료)' : '무승부!'; winTitle.style.webkitTextFillColor = '#ffffff'; } 
        else { winTitle.textContent = isTimeOver ? `${winnerName} 승리!` : `${winnerName} 승리!`; winTitle.style.webkitTextFillColor = winnerName.includes('빨강팀') ? '#ff6b6b' : '#6b9fff'; }
        endOverlay.classList.remove('hidden');
    }

    // 초기화 실행
    setAppHeight();
    initGallery();
</script>
</body>
</html>
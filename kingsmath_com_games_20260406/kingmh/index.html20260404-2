        gridSize: 3, p1: { boardId: 'board-p1', pieces: [], domElements: [], isWinner: false },
        p2: { boardId: 'board-p2', pieces: [], domElements: [], isWinner: false },
        imgData: null, imgReady: false, imgRatio: 1, isPlaying: false, timeLimit: 180, timeRemaining: 180, timeElapsed: 0, timerIntv: null
    };

    let selectedTime = 180; let selectedGrid = 3; let currentMode = 'random'; 
    let selectedGalleryItem = artworksDB[0]; let uploadedItem = null;

    function selectTime(seconds, btn) {
        selectedTime = seconds;
        document.querySelectorAll('#time-options .opt-btn').forEach(b => b.classList.remove('active')); btn.classList.add('active');
    }
    function selectGrid(size, btn) {
        selectedGrid = size;
        document.querySelectorAll('#grid-options .opt-btn').forEach(b => b.classList.remove('active')); btn.classList.add('active');
    }
    function switchTab(tabId) {
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
        document.querySelector(`.tab-btn[data-tab="${tabId}"]`).classList.add('active');
        document.getElementById(tabId).classList.add('active');
        currentMode = tabId.replace('tab-', '');
    }

    function initGallery() {
        const container = document.getElementById('gallery-grid');
        container.innerHTML = ''; 
        artworksDB.forEach((art, idx) => {
            const el = document.createElement('div');
            el.className = 'gallery-item' + (idx === 0 ? ' active' : ''); el.id = 'gallery-item-' + idx;
            // 명화 데이터 설명은 제외하고 타이틀과 그림만 세팅
            el.innerHTML = `<img src="${art.thumbnail}" alt="Art"><div class="g-title resize-text">${art.title}</div>`;
            el.onclick = () => selectArtwork(idx);
            container.appendChild(el);
        });
    }

    function selectArtwork(idx) {
        document.querySelectorAll('.gallery-item').forEach(el => el.classList.remove('active'));
        document.getElementById('gallery-item-' + idx).classList.add('active');
        selectedGalleryItem = artworksDB[idx];
    }

    function handleImageUpload(event) {
        const file = event.target.files[0];
        if (file) {
            const url = URL.createObjectURL(file);
            uploadedItem = { title: file.name.split('.')[0], artist: "", year: "", url: url, thumbnail: url };
            document.querySelector('.upload-text').innerHTML = `<span style="color:#4cd964;">${file.name}</span>`;
        }
    }

    function setGameImageAndStart(item) {
        gameState.imgReady = false; gameState.imgData = item;
        const img = new Image();
        img.onload = () => {
            gameState.imgRatio = img.naturalWidth / img.naturalHeight;
            document.querySelectorAll('.ref-image').forEach(el => el.src = item.url);
            document.getElementById('end-artwork').src = item.url;
            document.getElementById('end-title').textContent = item.title;
            
            // 한국어가 아닐때는 작가/연도 등 기타 설명 무시하고 제목만 출력
            if(currentGlobalLang === 'ko') {
                document.getElementById('end-artist').textContent = `${item.artist} ${item.year ? '('+item.year+')' : ''}`;
            } else {
                document.getElementById('end-artist').textContent = "";
            }
            gameState.imgReady = true;
        };
        img.src = item.url;
    }

    function startSequence() {
        let targetItem = null;
        if (currentMode === 'random') targetItem = artworksDB[Math.floor(Math.random() * artworksDB.length)];
        else if (currentMode === 'gallery') targetItem = selectedGalleryItem;
        else if (currentMode === 'upload') { if (!uploadedItem) return; targetItem = uploadedItem; }

        setGameImageAndStart(targetItem);
        AudioEngine.init();
        gameState.gridSize = selectedGrid; gameState.timeLimit = selectedTime; gameState.timeRemaining = selectedTime;

        // 시작 시 언어 모달 숨김 처리 (게임 몰입)
        document.getElementById('langSelectorContainer').style.display = 'none';
        document.getElementById('overlay-start').classList.add('hidden');
        
        const countOverlay = document.getElementById('overlay-countdown'); countOverlay.classList.remove('hidden');
        let count = 5;
        const countNum = document.getElementById('countdown-number');
        const spinner = document.getElementById('loading-indicator');
        countNum.textContent = count; countNum.classList.remove('hidden'); spinner.classList.add('hidden');

        const intv = setInterval(() => {
            count--;
            if (count > 0) { countNum.textContent = count; AudioEngine.playTone(1000, 'sine', 0.1, 0.2); } 
            else {
                if (gameState.imgReady) { clearInterval(intv); countOverlay.classList.add('hidden'); startGame(); } 
                else { countNum.classList.add('hidden'); spinner.classList.remove('hidden'); }
            }
        }, 1000);

        const checkReadyIntv = setInterval(() => {
            if(count <= 0 && gameState.imgReady) {
                clearInterval(checkReadyIntv); clearInterval(intv);
                countOverlay.classList.add('hidden'); startGame();
            }
        }, 200);
    }

    function startGame() {
        AudioEngine.playStart();
        initBoard('p1'); initBoard('p2'); resizeBoards();
        gameState.isPlaying = true; gameState.timeElapsed = 0;
        document.getElementById('score-p1').textContent = '0%'; document.getElementById('score-p2').textContent = '0%';

        if(gameState.timerIntv) clearInterval(gameState.timerIntv);
        const timerFill = document.getElementById('timer-fill'); const txtTimer = document.getElementById('txt-timer');
        
        if (gameState.timeLimit > 0) {
            timerFill.style.width = '100%'; timerFill.style.transition = 'width 1s linear';
            gameState.timerIntv = setInterval(() => {
                gameState.timeRemaining--;
                const m = String(Math.floor(gameState.timeRemaining / 60)).padStart(2, '0');
                const s = String(gameState.timeRemaining % 60).padStart(2, '0');
                txtTimer.textContent = `${m}:${s}`;
                const pct = (gameState.timeRemaining / gameState.timeLimit) * 100;
                timerFill.style.width = `${pct}%`;

                if (gameState.timeRemaining <= 10) {
                    timerFill.style.background = '#ff3b30';
                    if(gameState.timeRemaining > 0) AudioEngine.playTone(1200, 'sine', 0.1, 0.2);
                } else if (pct <= 30) { timerFill.style.background = '#ffcc00'; } 
                else { timerFill.style.background = 'linear-gradient(90deg, #ff3b30, #ffcc00, #4cd964)'; }

                if (gameState.timeRemaining <= 0) { clearInterval(gameState.timerIntv); handleTimeOut(); }
            }, 1000);
        } else {
            timerFill.style.width = '100%'; timerFill.style.background = '#4cd964';
            gameState.timerIntv = setInterval(() => {
                gameState.timeElapsed++;
                const m = String(Math.floor(gameState.timeElapsed / 60)).padStart(2, '0');
                const s = String(gameState.timeElapsed % 60).padStart(2, '0');
                txtTimer.textContent = `${m}:${s}`;
            }, 1000);
        }
    }

    function handleTimeOut() {
        gameState.isPlaying = false;
        let p1Score = getProgress(gameState.p1), p2Score = getProgress(gameState.p2);
        if (p1Score > p2Score) endGame('p1'); else if (p2Score > p1Score) endGame('p2'); else endGame('draw');
    }

    function resizeBoards() {
        ['p1', 'p2'].forEach(player => {
            const pState = gameState[player];
            const container = document.querySelector(player === 'p1' ? '.left-table' : '.right-table');
            const maxW = container.clientWidth - 50, maxH = container.clientHeight - 50;
            const containerRatio = maxW / maxH, imgRatio = gameState.imgRatio; 
            let boardW, boardH;
            if (imgRatio > containerRatio) { boardW = maxW; boardH = maxW / imgRatio; } else { boardH = maxH; boardW = maxH * imgRatio; }
            const boardEl = document.getElementById(pState.boardId);
            boardEl.style.width = boardW + 'px'; boardEl.style.height = boardH + 'px';
            updateVisuals(pState, boardW, boardH);
        });
    }

    function initBoard(playerKey) {
        const pState = gameState[playerKey]; const boardEl = document.getElementById(pState.boardId);
        boardEl.innerHTML = ''; pState.pieces = []; pState.domElements = []; pState.isWinner = false;
        const total = gameState.gridSize * gameState.gridSize;
        for (let i = 0; i < total; i++) pState.pieces.push(i);
        do { pState.pieces.sort(() => Math.random() - 0.5); } while (pState.pieces.every((val, i) => val === i));

        for (let pieceId = 0; pieceId < total; pieceId++) {
            const pieceEl = document.createElement('div');
            pieceEl.className = 'puzzle-piece'; pieceEl.dataset.player = playerKey; pieceEl.dataset.pieceId = pieceId;
            const origRow = Math.floor(pieceId / gameState.gridSize), origCol = pieceId % gameState.gridSize;
            const bgPosX = gameState.gridSize > 1 ? (origCol / (gameState.gridSize - 1)) * 100 : 0;
            const bgPosY = gameState.gridSize > 1 ? (origRow / (gameState.gridSize - 1)) * 100 : 0;
            pieceEl.style.backgroundImage = `url(${gameState.imgData.url})`;
            pieceEl.style.backgroundSize = `${gameState.gridSize * 100}% ${gameState.gridSize * 100}%`;
            pieceEl.style.backgroundPosition = `${bgPosX}% ${bgPosY}%`;
            attachDragEvents(pieceEl, pState);
            pState.domElements[pieceId] = pieceEl; boardEl.appendChild(pieceEl);
        }
    }

    function updateVisuals(pState, boardW, boardH) {
        if (!pState.domElements || pState.domElements.length === 0) return;
        const boardEl = document.getElementById(pState.boardId);
        const currentBoardW = boardW || boardEl.clientWidth, currentBoardH = boardH || boardEl.clientHeight;
        const pieceW = currentBoardW / gameState.gridSize, pieceH = currentBoardH / gameState.gridSize;
        for (let slotIndex = 0; slotIndex < pState.pieces.length; slotIndex++) {
            const pieceEl = pState.domElements[pState.pieces[slotIndex]];
            pieceEl.style.width = pieceW + 'px'; pieceEl.style.height = pieceH + 'px';
            pieceEl.style.left = ((slotIndex % gameState.gridSize) * pieceW) + 'px'; 
            pieceEl.style.top = (Math.floor(slotIndex / gameState.gridSize) * pieceH) + 'px';
            pieceEl.dataset.slotIndex = slotIndex;
        }
    }

    let activeDrags = {};
    function attachDragEvents(pieceEl, pState) {
        pieceEl.addEventListener('pointerdown', (e) => {
            if (!gameState.isPlaying) return; e.preventDefault();
            pieceEl.setPointerCapture(e.pointerId); pieceEl.classList.add('dragging');
            activeDrags[e.pointerId] = { el: pieceEl, pState: pState, slotIndex: parseInt(pieceEl.dataset.slotIndex), startX: e.clientX, startY: e.clientY };
        });
        pieceEl.addEventListener('pointermove', (e) => {
            const drag = activeDrags[e.pointerId]; if (!drag) return;
            drag.el.style.transform = `translate(${e.clientX - drag.startX}px, ${e.clientY - drag.startY}px) scale(1.05)`;
        });
        const drop = (e) => {
            const drag = activeDrags[e.pointerId]; if (!drag) return;
            drag.el.releasePointerCapture(e.pointerId); drag.el.style.transform = ''; drag.el.classList.remove('dragging');
            const boardEl = document.getElementById(pState.boardId), rect = boardEl.getBoundingClientRect();
            let targetCol = Math.max(0, Math.min(gameState.gridSize - 1, Math.floor((e.clientX - rect.left) / (boardEl.clientWidth / gameState.gridSize))));
            let targetRow = Math.max(0, Math.min(gameState.gridSize - 1, Math.floor((e.clientY - rect.top) / (boardEl.clientHeight / gameState.gridSize))));
            const tIdx = targetRow * gameState.gridSize + targetCol;
            if (tIdx !== drag.slotIndex) {
                const temp = pState.pieces[tIdx]; pState.pieces[tIdx] = pState.pieces[drag.slotIndex]; pState.pieces[drag.slotIndex] = temp;
                AudioEngine.playClack();
            }
            updateVisuals(pState); checkProgress(pState); delete activeDrags[e.pointerId];
        };
        pieceEl.addEventListener('pointerup', drop); pieceEl.addEventListener('pointercancel', drop);
    }

    function getProgress(pState) {
        let correctCount = 0; for (let i = 0; i < pState.pieces.length; i++) { if (pState.pieces[i] === i) correctCount++; }
        return Math.floor((correctCount / pState.pieces.length) * 100);
    }

    function checkProgress(pState) {
        const percentage = getProgress(pState), isP1 = pState.boardId === 'board-p1';
        document.getElementById(isP1 ? 'score-p1' : 'score-p2').textContent = `${percentage}%`;
        if (percentage === 100) { pState.isWinner = true; endGame(isP1 ? 'p1' : 'p2'); }
    }

    function endGame(winnerCode) {
        gameState.isPlaying = false; if(gameState.timerIntv) clearInterval(gameState.timerIntv); AudioEngine.playFanfare();
        const endOverlay = document.getElementById('overlay-end');
        const winTitle = document.getElementById('win-title');
        
        // 다국어 텍스트 조립
        let teamStr = "";
        let endStr = "";
        
        if (winnerCode === 'draw') {
            endStr = i18n[currentGlobalLang].draw;
            winTitle.textContent = endStr;
            winTitle.style.webkitTextFillColor = '#ffffff';
        } else {
            teamStr = winnerCode === 'p1' ? i18n[currentGlobalLang].red_team : i18n[currentGlobalLang].blue_team;
            endStr = i18n[currentGlobalLang].win;
            winTitle.textContent = `${teamStr} ${endStr}`;
            winTitle.style.webkitTextFillColor = winnerCode === 'p1' ? '#ff6b6b' : '#6b9fff';
        }
        
        document.getElementById('langSelectorContainer').style.display = 'block'; // 종료 시 다시 보여줌
        endOverlay.classList.remove('hidden');
    }

    // --- 수정 요청된 홈 버튼 로직 (전체화면 대응) ---
    document.getElementById('btn-home').addEventListener('click', () => {
        if (document.fullscreenElement) {
            // 새로고침 대신 화면 초기화 로직 실행 (전체화면 유지)
            gameState.isPlaying = false;
            if(gameState.timerIntv) clearInterval(gameState.timerIntv);
            document.getElementById('langSelectorContainer').style.display = 'block';
            document.getElementById('overlay-start').classList.remove('hidden');
            document.getElementById('overlay-end').classList.add('hidden');
            document.getElementById('overlay-countdown').classList.add('hidden');
            
            // 보드 초기화
            document.getElementById('board-p1').innerHTML = '';
            document.getElementById('board-p2').innerHTML = '';
            document.getElementById('score-p1').textContent = '0%';
            document.getElementById('score-p2').textContent = '0%';
        } else {
            location.reload();
        }
    });

    // 앱 초기화 구동
    applyLanguage(detectLanguage());
    setAppHeight();
    initGallery();
</script>
</body>
</html>
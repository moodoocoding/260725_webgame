    let currentGlobalLang = 'en';

    function detectLanguage() {
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.has('lang')) return urlParams.get('lang');
        const localLang = localStorage.getItem('kingsmath_lang');
        if (localLang) return localLang;
        const browserLang = navigator.language.split('-')[0].toLowerCase();
        if (browserLang === 'pt' && navigator.language.toLowerCase().includes('br')) return 'pt-br';
        if (languages.some(l => l.code === browserLang)) return browserLang;
        return 'en';
    }

    function applyLanguage(langCode) {
        if (!i18n[langCode]) langCode = 'en';
        currentGlobalLang = langCode;
        
        // 데이터 치환
        document.querySelectorAll('[data-i18n]').forEach(el => {
            const key = el.getAttribute('data-i18n');
            if (i18n[langCode][key]) el.textContent = i18n[langCode][key];
        });

        // SEO 연동
        document.title = i18n[langCode].title;
        document.querySelector('meta[name="description"]').content = `${i18n[langCode].title} - Puzzle Game`;

        // 상단 버튼 업데이트
        const langObj = languages.find(l => l.code === langCode);
        document.getElementById('currentFlag').src = `https://flagcdn.com/w40/${langObj.country}.png`;
        document.getElementById('currentLangName').textContent = langObj.name;

        // URL 및 저장
        localStorage.setItem('kingsmath_lang', langCode);
        const newUrl = window.location.protocol + "//" + window.location.host + window.location.pathname + '?lang=' + langCode;
        window.history.pushState({path:newUrl}, '', newUrl);

        autoResizeText();
        renderLanguages(); // 닫힌 모달 안에서도 선택 표기를 위해 새로고침
    }

    function autoResizeText() {
        setTimeout(() => {
            document.querySelectorAll('.resize-text').forEach(el => {
                el.style.fontSize = ''; 
                let fontSize = parseInt(window.getComputedStyle(el).fontSize);
                while (el.scrollWidth > el.clientWidth && fontSize > 10) {
                    fontSize -= 1;
                    el.style.fontSize = fontSize + 'px';
                }
            });
        }, 50);
    }

    // 모달 로직
    const triggerBtn = document.getElementById('langTriggerBtn');
    const modal = document.getElementById('langModal');
    const closeBtn = document.getElementById('closeModalBtn');
    const searchInput = document.getElementById('searchInput');
    const grid = document.getElementById('languageGrid');
    const noResult = document.getElementById('noResult');

    function renderLanguages(filterText = '') {
        grid.innerHTML = '';
        const lowerFilter = filterText.toLowerCase();
        const filteredLangs = languages.filter(lang => 
            lang.name.toLowerCase().includes(lowerFilter) || 
            lang.enName.toLowerCase().includes(lowerFilter) ||
            lang.code.toLowerCase().includes(lowerFilter)
        );

        if (filteredLangs.length === 0) {
            grid.classList.add('hidden'); noResult.classList.remove('hidden'); noResult.classList.add('flex');
        } else {
            grid.classList.remove('hidden'); noResult.classList.add('hidden'); noResult.classList.remove('flex');
            filteredLangs.forEach(lang => {
                const isSelected = lang.code === currentGlobalLang;
                const baseClasses = "flex items-center gap-3 p-3 rounded-xl border cursor-pointer transition-all duration-200 group relative overflow-hidden";
                const stateClasses = isSelected ? "bg-gray-800 border-yellow-500 ring-1 ring-yellow-500/50" : "bg-gray-800/40 border-gray-700 hover:bg-gray-700 hover:border-gray-500";
                
                const btn = document.createElement('div');
                btn.className = `${baseClasses} ${stateClasses}`;
                btn.innerHTML = `
                    <div class="shrink-0 w-8 h-6 rounded overflow-hidden shadow-sm border border-gray-700/50">
                        <img src="https://flagcdn.com/w40/${lang.country}.png" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300">
                    </div>
                    <div class="flex-1 min-w-0 flex flex-col items-start">
                        <span class="text-sm font-medium text-white truncate w-full ${isSelected ? 'text-yellow-400' : ''}">${lang.name}</span>
                        <span class="text-xs text-gray-400 truncate w-full">${lang.enName}</span>
                    </div>
                    ${isSelected ? '<i class="fa-solid fa-circle-check text-yellow-500 text-lg ml-2"></i>' : ''}
                `;
                btn.addEventListener('click', () => {
                    applyLanguage(lang.code);
                    closeModal();
                });
                grid.appendChild(btn);
            });
        }
    }

    function openModal() { modal.classList.add('active'); setTimeout(() => searchInput.focus(), 100); }
    function closeModal() { modal.classList.remove('active'); }
    triggerBtn.addEventListener('click', openModal);
    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
    searchInput.addEventListener('input', (e) => renderLanguages(e.target.value));


   

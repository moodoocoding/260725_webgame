<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>명화킹</title>
<meta name="description" content="명화와 함께하는 두뇌 퍼즐 게임">
<meta name="keywords" content="명화, 퍼즐, 게임, 수학, 아트">

<script src="https://cdn.tailwindcss.com"></script>
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;700;900&display=swap" rel="stylesheet">

<style>
    :root {
        --app-height: 100vh;
        --primary-gold: #c5a059;
        --bg-dark: #121212;
        --panel-bg: rgba(30, 30, 30, 0.95);
    }

    html, body {
        margin: 0; padding: 0; overflow: hidden;
        background-color: var(--bg-dark);
        font-family: 'Noto Sans KR', sans-serif;
        width: 100%; height: 100vh; height: var(--app-height);
        touch-action: none; 
        -webkit-user-select: none; user-select: none;
        -webkit-touch-callout: none; -webkit-tap-highlight-color: transparent;
    }

    body { display: flex; flex-direction: column; color: #fff; }

    /* =========================================
       다국어 UI 독립 CSS (충돌 방지 및 박스사이징)
    ========================================= */
    #langSelectorContainer {
        position: absolute; top: 15px; right: 15px; z-index: 99999 !important;
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; /* 한국어 외 일반 무난한 폰트 */
    }
    #langSelectorContainer * {
        box-sizing: border-box !important;
    }
    /* 폰트 어썸 아이콘 깨짐 철저 방지 */
    #langSelectorContainer i, 
    #langSelectorContainer .fa-solid, 
    #langSelectorContainer .fa-regular {
        font-family: "Font Awesome 6 Free" !important;
        font-weight: 900;
    }
    .custom-scrollbar::-webkit-scrollbar { width: 8px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: rgba(31, 41, 55, 0.5); border-radius: 4px; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #4b5563; border-radius: 4px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #6b7280; }
    
    .lang-modal-overlay {
        opacity: 0; visibility: hidden; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .lang-modal-overlay.active { opacity: 1; visibility: visible; }
    .lang-modal-content {
        transform: scale(0.95) translateY(-10px); opacity: 0; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .lang-modal-overlay.active .lang-modal-content { transform: scale(1) translateY(0); opacity: 1; }

    /* 텍스트 자동 축소 클래스 */
    .resize-text { white-space: nowrap; transition: font-size 0.2s ease;     padding-bottom: 10px;
 }

    /* --- 기존 게임 CSS 유지 (절대 수정 금지) --- */
    #top-area {
        flex: 0 0 25%; min-height: 120px;
        background: linear-gradient(180deg, #1a1a1a 0%, #0d0d0d 100%);
        border-bottom: 4px solid var(--primary-gold);
        display: flex; justify-content: center; align-items: center;
        position: relative; z-index: 10; box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }
    #scoreboard-row { display: flex; justify-content: space-between; align-items: center; width: 100%; padding: 0 20px; height: 100%; }
    .player-group { display: flex; align-items: center; gap: 15px; height: 100%; flex: 1; }
    .p1-group { justify-content: flex-start; } 
    .p2-group { justify-content: flex-end; }   
    .ref-img-large { 
        height: 85%; max-height: 120px; min-height: 90px; aspect-ratio: auto;
        border: 4px solid var(--primary-gold); border-radius: 8px; 
        background: #000; overflow: hidden; box-shadow: 0 5px 15px rgba(0,0,0,0.5);
        display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .ref-img-large img { width: 100%; height: 100%; object-fit: contain; }
    .player-zone {
        display: flex; align-items: center; gap: 15px; padding: 10px 20px;
        border-radius: 16px; background: rgba(255,255,255,0.05);
        min-width: 200px; justify-content: center; box-shadow: 0 5px 15px rgba(0,0,0,0.3);
    }
    .p1-zone { border: 3px solid #ff4d4d; color: #ff4d4d; }
    .p2-zone { border: 3px solid #4d88ff; color: #4d88ff; flex-direction: row-reverse; } 
    .player-label { font-size: clamp(20px, 2.5vw, 30px); font-weight: 700; }
    .score { font-size: clamp(40px, 4vw, 60px); font-weight: 900; margin: 0 10px; line-height: 1; }
    .center-info { flex: 0 0 auto; display: flex; align-items: center; justify-content: center; padding: 0 20px; }
    .timer-container { text-align: center; width: 150px; }
    .timer-label { color: #ffcc00; font-size: clamp(18px, 2vw, 26px); margin-bottom: 8px; font-weight: 700; text-shadow: 0 2px 4px rgba(0,0,0,0.8); }
    #timer-bar { width: 100%; height: 16px; background: #333; border-radius: 8px; overflow: hidden; border: 2px solid #555; }
    #timer-fill { width: 0%; height: 100%; background: linear-gradient(90deg, #ff3b30, #ffcc00, #4cd964); transition: width 1s linear; }

    #game-area-wrapper { flex: 1; display: flex; justify-content: center; align-items: center; padding: 15px; background-color: #0d0d0d; position: relative; overflow: hidden; }
    #game-area { width: 100%; height: 100%; display: flex; position: relative; gap: 15px; }
    .table-bg { flex: 1; border-radius: 15px; border: 10px solid #3e2723; box-shadow: inset 0 0 60px rgba(0,0,0,0.8), 0 5px 20px rgba(0,0,0,0.5); position: relative; display: flex; justify-content: center; align-items: center; }
    .left-table { background: radial-gradient(circle at 30% 30%, #1a5e2e 0%, #0a3315 90%); }
    .right-table { background: radial-gradient(circle at 70% 30%, #005c4b 0%, #002e26 90%); }
    .divider { position: absolute; left: 50%; top: 10px; bottom: 10px; width: 4px; background: rgba(255, 215, 0, 0.3); transform: translateX(-50%); z-index: 4; border-radius: 2px; }

    .board { position: relative; background: rgba(0, 0, 0, 0.4); box-shadow: 0 10px 30px rgba(0,0,0,0.8); border: 4px solid var(--primary-gold); box-sizing: content-box; }
    .puzzle-piece { position: absolute; box-sizing: border-box; border: 1px solid rgba(0, 0, 0, 0.4); background-repeat: no-repeat; transition: left 0.15s ease-out, top 0.15s ease-out; touch-action: none; cursor: grab; }
    .puzzle-piece.dragging { transition: none; z-index: 100; outline: 4px solid #ffcc00; box-shadow: 0 20px 40px rgba(0,0,0,0.6); cursor: grabbing; opacity: 0.95; }

    .float-btn { position: fixed; bottom: 20px; width: 50px; height: 50px; background: rgba(255, 255, 255, 0.15); border: 2px solid rgba(255, 255, 255, 0.4); border-radius: 50%; cursor: pointer; z-index: 1000; display: flex; justify-content: center; align-items: center; color: white; font-size: 24px; transition: all 0.2s; backdrop-filter: blur(4px); }
    .float-btn:hover { background: rgba(255, 255, 255, 0.3); transform: scale(1.1); }
    .float-btn:active { transform: scale(0.95); }
    #fullscreen-btn { right: 20px; }
    #btn-home { left: 20px; }

    .overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); display: flex; flex-direction: column; justify-content: center; align-items: center; z-index: 100; backdrop-filter: blur(8px); }
    .modal-content { background: var(--panel-bg); padding: 20px 30px; border-radius: 24px; border: 2px solid rgba(197, 160, 89, 0.5); display: flex; flex-direction: column; align-items: center; max-width: 900px; width: 95%; max-height: 95vh; overflow-y: auto; box-shadow: 0 20px 60px rgba(0,0,0,0.9); }
    .modal-content::-webkit-scrollbar { width: 8px; }
    .modal-content::-webkit-scrollbar-thumb { background: #555; border-radius: 4px; }

    h1 { font-size: clamp(35px, 5vw, 55px) !important; margin: 0 0 15px 0; font-weight: 900; background: linear-gradient(to bottom, #fff8e1, var(--primary-gold)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; filter: drop-shadow(0 0 15px rgba(197, 160, 89, 0.5)); line-height: 1.2; word-break: keep-all; text-align: center; }

    .tab-container { display: flex; background: rgba(0,0,0,0.5); border-radius: 30px; padding: 6px; margin-bottom: 15px; width: 100%; max-width: 600px; }
    .tab-btn { flex: 1; padding: 10px; font-size: clamp(15px, 2vw, 18px); font-weight: 700; color: #aaa; background: transparent; border: none; border-radius: 25px; cursor: pointer; transition: all 0.3s; }
    .tab-btn.active { background: var(--primary-gold); color: #111; box-shadow: 0 4px 10px rgba(197, 160, 89, 0.4); }
    .tab-content { width: 100%; display: none; flex-direction: column; align-items: center; margin-bottom: 20px; }
    .tab-content.active { display: flex; animation: fadeIn 0.3s ease-in-out; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

    .gallery-wrapper { width: 100%; max-width: 800px; background: rgba(0,0,0,0.3); padding: 15px; border-radius: 16px; border: 1px solid #444; }
    .gallery-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 10px; max-height: 25vh; overflow-y: auto; padding-right: 5px; }
    .gallery-grid::-webkit-scrollbar { width: 6px; }
    .gallery-grid::-webkit-scrollbar-thumb { background: var(--primary-gold); border-radius: 4px; }
    
    .gallery-item { position: relative; border-radius: 10px; overflow: hidden; border: 3px solid transparent; cursor: pointer; transition: all 0.2s; background: #222; display: flex; flex-direction: column; height: 115px; }
    .gallery-item img { width: 100%; height: 80px; object-fit: cover; }
    .gallery-item .g-title { padding: 4px; font-size: 13px; text-align: center; color: #ddd; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .gallery-item:hover { transform: translateY(-3px); border-color: rgba(197, 160, 89, 0.5); }
    .gallery-item.active { border-color: #ffcc00; box-shadow: 0 0 15px rgba(255, 204, 0, 0.6); }

    .random-box, .upload-box { width: 100%; max-width: 500px; border-radius: 24px; padding: 25px 20px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; }
    .random-box { border: 3px dashed var(--primary-gold); background: rgba(197, 160, 89, 0.05); }
    .random-mark { font-size: 80px; font-weight: 900; color: #ffcc00; line-height: 1; text-shadow: 0 0 30px rgba(255, 204, 0, 0.6); animation: floatRandom 2s ease-in-out infinite; }
    @keyframes floatRandom { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }

    .upload-box { border: 3px dashed #666; background: rgba(255,255,255,0.02); cursor: pointer; transition: all 0.3s; }
    .upload-box:hover { border-color: var(--primary-gold); background: rgba(197, 160, 89, 0.05); }
    .upload-box i { font-size: 50px; color: #888; transition: color 0.3s; }
    .upload-text { font-size: 18px; color: #aaa; font-weight: 700; text-align: center; }
    .security-notice { margin-top: 10px; color: #4cd964; font-size: 13px; text-align: center; line-height: 1.4; }

    .settings-row { display: flex; flex-direction: row; flex-wrap: wrap; gap: 15px; justify-content: center; width: 100%; margin-bottom: 20px; }
    .setting-group { display: flex; flex-direction: row; align-items: center; gap: 10px; background: rgba(0,0,0,0.4); padding: 6px 15px; border-radius: 30px; }
    .setting-title { font-size: 16px; color: #ffcc00; font-weight: 700; white-space: nowrap; }
    .opt-group { display: flex; gap: 6px; flex-wrap: wrap; justify-content: center; }
    .opt-btn { padding: 6px 12px; font-size: 15px; font-weight: 700; background: rgba(255, 255, 255, 0.1); border: 2px solid #555; border-radius: 10px; color: #ccc; cursor: pointer; transition: all 0.2s; }
    .opt-btn:hover { background: rgba(255, 255, 255, 0.2); }
    .opt-btn.active { background: #ffcc00; color: #111; border-color: #ffcc00; box-shadow: 0 0 10px rgba(255, 204, 0, 0.5); }

    .start-game-btn { padding: 12px 80px; font-size: 28px; font-weight: 900; background: linear-gradient(to bottom, #ffd700, #ff8c00); border: 3px solid #fff; border-radius: 60px; color: #222; cursor: pointer; box-shadow: 0 10px 30px rgba(255, 140, 0, 0.5); transition: transform 0.1s, box-shadow 0.2s; }
    .start-game-btn:hover { transform: scale(1.05); box-shadow: 0 15px 40px rgba(255, 140, 0, 0.7); }
    .start-game-btn:active { transform: scale(0.95); }

    .other-game-link { margin-top: 15px; color: #aaa; text-decoration: none; font-size: 15px; border-bottom: 1px solid #777; padding-bottom: 2px; transition: color 0.2s; }
    .other-game-link:hover { color: #fff; border-color: #fff; }

    #end-artwork { max-height: 45vh; max-width: 100%; object-fit: contain; border: 8px solid var(--primary-gold); border-radius: 10px; box-shadow: 0 20px 50px rgba(0,0,0,0.8); margin-bottom: 20px; }
    .diff-btn { padding: 12px 30px; font-size: 20px; font-weight: 700; background: #333; border: 2px solid #666; border-radius: 15px; color: #fff; cursor: pointer; transition: all 0.2s; }
    .diff-btn:hover { border-color: #ffcc00; transform: scale(1.05); }

    .loading-spinner { border: 6px solid #333; border-top: 6px solid var(--primary-gold); border-radius: 50%; width: 60px; height: 60px; animation: spin 1s linear infinite; margin: 20px auto; }
    @keyframes spin { 0% { transform: rotate(0) } 100% { transform: rotate(360deg) } }
    .hidden { display: none !important; }
</style>
</head>
<body>

    <div id="langSelectorContainer">
        <button id="langTriggerBtn" class="flex items-center gap-2 bg-gray-800 border border-gray-600 hover:border-yellow-500 rounded-full px-4 py-2 transition-all duration-200 text-sm font-medium shadow-lg">
            <i class="fa-solid fa-globe text-gray-400"></i>
            <img id="currentFlag" src="https://flagcdn.com/w40/kr.png" alt="KR" class="w-5 h-auto rounded-[2px] shadow-sm">
            <span id="currentLangName" class="hidden sm:inline-block text-white">한국어</span>
            <i class="fa-solid fa-chevron-down text-gray-400 ml-1 text-xs"></i>
        </button>

        <div id="langModal" class="lang-modal-overlay fixed inset-0 flex items-start sm:items-center justify-center bg-black/80 backdrop-blur-sm pt-16 sm:pt-0 px-4">
            <div class="lang-modal-content bg-gray-900 border border-gray-700 rounded-2xl shadow-2xl w-full max-w-4xl max-h-[85vh] flex flex-col overflow-hidden">
                <div class="flex items-center justify-between p-5 border-b border-gray-800 bg-gray-900/95 sticky top-0 z-10">
                    <div>
                        <h2 class="text-xl font-bold text-white flex items-center gap-2">
                            <i class="fa-solid fa-language text-yellow-500"></i>
                            <span>Language / 언어</span>
                        </h2>
                    </div>
                    <button id="closeModalBtn" class="w-10 h-10 rounded-full bg-gray-800 hover:bg-gray-700 flex items-center justify-center text-gray-400 hover:text-white transition-colors">
                        <i class="fa-solid fa-xmark text-lg"></i>
                    </button>
                </div>
                <div class="p-5 pb-2 bg-gray-900">
                    <div class="relative">
                        <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                        <input type="text" id="searchInput" placeholder="Search / 검색 ..." 
                            class="w-full bg-gray-800 border border-gray-700 text-white text-sm rounded-xl focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500 block pl-11 p-3.5 outline-none transition-all placeholder-gray-500">
                    </div>
                </div>
                <div class="p-5 overflow-y-auto custom-scrollbar flex-1">
                    <div id="languageGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3"></div>
                    <div id="noResult" class="hidden flex-col items-center justify-center py-12 text-gray-500">
                        <i class="fa-regular fa-face-frown-open text-4xl mb-3"></i>
                        <p>No results / 검색 결과 없음</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="top-area">
        <div id="scoreboard-row">
            <div class="player-group p1-group">
                <div class="ref-img-large"><img class="ref-image" src="" alt="Image"></div>
                <div class="player-zone p1-zone">
                    <div class="player-label resize-text" data-i18n="red_team">빨강팀</div>
                    <div class="score" id="score-p1">0%</div>
                </div>
            </div>
            <div class="center-info">
                <div class="timer-container">
                    <div class="timer-label resize-text" id="txt-timer" data-i18n="timer_label">진행 시간</div>
                    <div id="timer-bar"><div id="timer-fill"></div></div>
                </div>
            </div>
            <div class="player-group p2-group">
                <div class="player-zone p2-zone">
                    <div class="player-label resize-text" data-i18n="blue_team">파랑팀</div>
                    <div class="score" id="score-p2">0%</div>
                </div>
                <div class="ref-img-large"><img class="ref-image" src="" alt="Image"></div>
            </div>
        </div>
    </div>

    <div id="game-area-wrapper">
        <div id="game-area">
            <div class="table-bg left-table"><div id="board-p1" class="board"></div></div>
            <div class="divider"></div>
            <div class="table-bg right-table"><div id="board-p2" class="board"></div></div>
        </div>
    </div>

    <div id="btn-home" class="float-btn" title="처음으로">🏠</div>
    <div id="fullscreen-btn" class="float-btn" onclick="toggleFullscreen()" title="전체화면">⛶</div>

    <div id="overlay-start" class="overlay">
        <div class="modal-content">
            <h1 class="resize-text" data-i18n="title">명화킹</h1>
            
            <div class="tab-container">
                <button class="tab-btn resize-text" data-tab="tab-gallery" onclick="switchTab('tab-gallery')" data-i18n="tab_gallery">명화 고르기</button>
                <button class="tab-btn active resize-text" data-tab="tab-random" onclick="switchTab('tab-random')" data-i18n="tab_random">랜덤 선택</button>
                <button class="tab-btn resize-text" data-tab="tab-upload" onclick="switchTab('tab-upload')" data-i18n="tab_upload">파일 업로드</button>
            </div>

            <div id="tab-gallery" class="tab-content">
                <div class="gallery-wrapper">
                    <div class="gallery-grid" id="gallery-grid"></div>
                </div>
            </div>

            <div id="tab-random" class="tab-content active">
                <div class="random-box">
                    <div class="random-mark">?</div>
                    <div style="font-size: 20px; color: #ddd; font-weight: 700;" class="resize-text" data-i18n="random_desc">어떤 명화가 나올까요?</div>
                </div>
            </div>

            <div id="tab-upload" class="tab-content">
                <div class="upload-box" onclick="document.getElementById('upload-input').click()">
                    <i class="fas fa-cloud-upload-alt"></i>
                    <div class="upload-text resize-text" data-i18n="upload_text">이곳을 터치하여 사진을 선택하세요</div>
                    <input type="file" id="upload-input" accept="image/*" class="hidden" onchange="handleImageUpload(event)">
                </div>
                <div class="security-notice resize-text" data-i18n="security_notice">
                    <i class="fa-solid fa-shield-check"></i> 외부 서버로 전송되거나 저장되지 않아 안전합니다.
                </div>
            </div>

            <div class="settings-row">
                <div class="setting-group">
                    <div class="setting-title resize-text" data-i18n="setting_time">제한 시간</div>
                    <div class="opt-group" id="time-options">
                        <button class="opt-btn resize-text" onclick="selectTime(60, this)" data-i18n="time_1">1분</button>
                        <button class="opt-btn resize-text" onclick="selectTime(120, this)" data-i18n="time_2">2분</button>
                        <button class="opt-btn active resize-text" onclick="selectTime(180, this)" data-i18n="time_3">3분</button>
                        <button class="opt-btn resize-text" onclick="selectTime(300, this)" data-i18n="time_5">5분</button>
                        <button class="opt-btn resize-text" onclick="selectTime(0, this)" data-i18n="time_unlimited">무제한</button>
                    </div>
                </div>
                <div class="setting-group">
                    <div class="setting-title resize-text" data-i18n="setting_diff">난이도</div>
                    <div class="opt-group" id="grid-options">
                        <button class="opt-btn active" onclick="selectGrid(3, this)">3x3</button>
                        <button class="opt-btn" onclick="selectGrid(5, this)">5x5</button>
                        <button class="opt-btn" onclick="selectGrid(7, this)">7x7</button>
                        <button class="opt-btn" onclick="selectGrid(10, this)">10x10</button>
                    </div>
                </div>
            </div>

            <button class="start-game-btn resize-text" onclick="startSequence()" data-i18n="btn_start">게임 시작</button>
            <a href="/" class="other-game-link resize-text" data-i18n="btn_other">다른 게임 고르기</a>
        </div>
    </div>

    <div id="overlay-countdown" class="overlay hidden">
        <div class="modal-content" style="background: transparent; border: none; box-shadow: none;">
            <div id="countdown-text" class="resize-text" style="font-size: 32px; color: #ffcc00; margin-bottom: 20px; font-weight: 700;" data-i18n="loading">게임 준비! (이미지 로딩 중...)</div>
            <div id="countdown-number" style="font-size: 150px; font-weight: 900; color: white; text-shadow: 0 10px 30px rgba(0,0,0,0.8);">5</div>
            <div id="loading-indicator" class="loading-spinner hidden"></div>
        </div>
    </div>

    <div id="overlay-end" class="overlay hidden">
        <div class="modal-content" style="max-width: 90vw; padding: 30px;">
            <h1 id="win-title" style="font-size: 60px; margin-bottom: 20px;"></h1>
            <img id="end-artwork" src="" alt="완성된 그림">
            <div id="end-title" style="font-size: 32px; color: #fff; font-weight: 700; margin-bottom: 5px;">작품명</div>

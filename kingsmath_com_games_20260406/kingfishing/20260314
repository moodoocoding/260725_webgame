                el.dataset.id = item.id;
                // 내용물이 길어져도 잘 보이도록 스타일을 조정
                el.innerHTML = `<div class="lvl-icon">${item.icon}</div><div class="lvl-desc" style="font-size: 0.95rem; text-align: center; word-break: keep-all; line-height: 1.2;">${item.desc}</div>`;
                el.onclick = () => {
                    CONFIG.level = item.id;
                    document.querySelectorAll('.level-btn').forEach(b => b.classList.remove('selected'));
                    el.classList.add('selected');
                    document.getElementById('btn-start').disabled = false;
                    saveSettings();
                };
                grid.appendChild(el);
            });

            if(!data.find(i => i.id === CONFIG.level)) {
                CONFIG.level = '';
                document.getElementById('btn-start').disabled = true;
            } else {
                document.getElementById('btn-start').disabled = false;
            }
        }

        function startGame() {
            if (!CONFIG.level) return;
            initAudio();
            if (gameState.animFrame) cancelAnimationFrame(gameState.animFrame);
            if (gameState.interval) clearInterval(gameState.interval);

            document.getElementById('start-screen').classList.add('hidden');
            document.getElementById('langTriggerContainer').style.display = 'none';

            const scoreBoard = document.getElementById('score-board');
            scoreBoard.innerHTML = '';
            for(let i=1; i<=CONFIG.playerCount; i++) {
                const team = TEAMS[i];
                scoreBoard.innerHTML += `<div class="player-score" style="border-color:${team.color}; color:${team.color}"><div class="player-label">${team.emoji}</div><div id="score-p${i}" class="score-display">0</div></div>`;
            }

            const splitView = document.getElementById('game-split-view');
            splitView.innerHTML = '';
            splitView.classList.remove('hidden');
            document.getElementById('game-header').classList.remove('hidden');
            document.getElementById('game-footer').classList.remove('hidden');
            if(CONFIG.playerCount >= 3) splitView.classList.add('small-text'); else splitView.classList.remove('small-text');

            for(let i=1; i<=CONFIG.playerCount; i++) createPlayerArea(i, splitView);

            const footer = document.getElementById('game-footer');
            footer.innerHTML = '';
            for(let i=1; i<=CONFIG.playerCount; i++) {
                const team = TEAMS[i];
                const btn = document.createElement('div');
                btn.className = 'btn-container';
                btn.innerHTML = `<button class="stop-btn" style="background:${team.color}; box-shadow:0 6px 0 rgba(0,0,0,0.3);" onpointerdown="handleStop(${i}, event)" ontouchstart="handleStop(${i}, event)"><i class="fa-solid fa-hand-pointer"></i> <span>STOP</span></button>`;
                footer.appendChild(btn);
            }

            gameState.active = true; gameState.timer = 60; gameState.players = {};
            for(let i=1; i<=CONFIG.playerCount; i++) {
                gameState.players[i] = { score: 0, count: 0, hookPos: Math.random()*90, hookDir: 1, hookSpeed: 0.5, locked: false, answer: '', zones: [], history: [] };
                nextProblem(i);
            }
            startTimer(); loop();
        }

        function createPlayerArea(id, container) {
            const team = TEAMS[id];
            const div = document.createElement('div');
            div.className = `player-area ${team.bg}`;
            div.innerHTML = `
                <div class="fish-tank">
                    <div class="fish-wrapper" id="fish-l-${id}"><div class="fish-body">🐟</div><div class="fish-number" id="num-l-${id}">?</div></div>
                    <div class="vs-circle" id="circle-${id}"></div>
                    <div class="fish-wrapper" id="fish-r-${id}"><div class="fish-body" style="transform: scaleX(-1);">🐠</div><div class="fish-number" id="num-r-${id}">?</div></div>
                </div>
                <div class="feedback-msg" id="msg-${id}"></div>
                <div class="hook-area"><div class="zone-container" id="zones-${id}"></div><div class="hook" id="hook-${id}"><i class="fa-solid fa-anchor"></i></div></div>
            `;
            container.appendChild(div);
        }

        function startTimer() {
            document.getElementById('timer').innerText = 60;
            document.getElementById('timer-box').classList.remove('urgent');
            if(gameState.interval) clearInterval(gameState.interval);
            gameState.interval = setInterval(() => {
                gameState.timer--;
                document.getElementById('timer').innerText = gameState.timer;
                if(gameState.timer <= 5) { document.getElementById('timer-box').classList.add('urgent'); playSound('tick'); }
                if(gameState.timer <= 0) endGame();
            }, 1000);
        }

        function loop() {
            if(!gameState.active) return;
            for(let i=1; i<=CONFIG.playerCount; i++) {
                const p = gameState.players[i];
                if(p.locked) continue;
                p.hookPos += p.hookSpeed * p.hookDir;
                if(p.hookPos >= 92 || p.hookPos <= 0) p.hookDir *= -1;
                const el = document.getElementById(`hook-${i}`);
                if(el) el.style.left = p.hookPos + '%';
            }
            gameState.animFrame = requestAnimationFrame(loop);
        }

        // --- 수정된 난이도 및 카테고리 로직 적용 (14단계 제거 적용됨) ---
        function nextProblem(id) {
            const p = gameState.players[id];
            p.hookSpeed = Math.min(4, 0.5 + (p.count * 0.1)); p.locked = false;
            let v1, v2, d1, d2; const lv = CONFIG.level;
            
            if (lv === 'n1') { v1 = rand(1, 9); v2 = rand(1, 9); d1 = v1; d2 = v2; }
            else if (lv === 'n2') { v1 = rand(1, 99); v2 = rand(1, 99); d1 = v1; d2 = v2; }
            else if (lv === 'n3') { v1 = rand(1, 999); v2 = rand(1, 999); d1 = v1; d2 = v2; }
            else if (lv === 'n4') { v1 = rand(1, 9999); v2 = rand(1, 9999); d1 = v1; d2 = v2; }
            else if (lv === 'n5') { 
                // 4자리 ~ 8자리 (1000 ~ 99999999)
                v1 = rand(1000, 99999999); v2 = rand(1000, 99999999); 
                d1 = v1.toLocaleString(); d2 = v2.toLocaleString();
            }
            else if (lv === 'n6') { 
                // 최대 천조 언저리 난수
                v1 = Math.floor(Math.random() * 999999999999999) + 1;
                v2 = Math.floor(Math.random() * 999999999999999) + 1;
                d1 = v1.toLocaleString(); d2 = v2.toLocaleString();
            }
            else if (lv === 'd1') { v1 = rand(1, 9)/10; v2 = rand(1, 9)/10; d1 = v1.toFixed(1); d2 = v2.toFixed(1); }
            else if (lv === 'd2') { v1 = rand(1, 99)/100; v2 = rand(1, 99)/100; d1 = v1.toFixed(2); d2 = v2.toFixed(2); }
            else if (lv === 'd3') { v1 = rand(1, 999)/1000; v2 = rand(1, 999)/1000; d1 = v1.toFixed(3); d2 = v2.toFixed(3); }
            else {
                let num1 = 0, den1 = 1, int1 = 0;
                let num2 = 0, den2 = 1, int2 = 0;

                if (lv === 'f1') {
                    den1 = rand(2, 10); den2 = den1;
                    num1 = rand(1, den1*2); num2 = rand(1, den1*2);
                } else if (lv === 'f2') {
                    den1 = rand(2, 9); den2 = den1;
                    num1 = rand(1, den1 - 1); num2 = rand(1, den1 - 1);
                    
                    let r = Math.random();
                    if (r < 0.2) {
                        int1 = rand(1, 5); int2 = 0;
                        if (Math.random() < 0.5) { let temp = int1; int1 = int2; int2 = temp; }
                    } else if (r < 0.4) {
                        int1 = rand(1, 5); int2 = int1;
                    } else {
                        int1 = rand(1, 5);
                        int2 = int1 + rand(1, 4) * (Math.random() < 0.5 ? 1 : -1);
                        if (int2 <= 0) int2 = rand(1, 5);
                    }
                } else if (lv === 'f3') {
                    den1 = rand(2, 9); den2 = rand(2, 9);
                    while (den1 === den2) den2 = rand(2, 9);
                    num1 = rand(1, den1 - 1); num2 = rand(1, den2 - 1);
                } else if (lv === 'f4') {
                    den1 = rand(2, 9); den2 = rand(2, 9);
                    while (den1 === den2) den2 = rand(2, 9);
                    num1 = rand(1, den1 - 1); num2 = rand(1, den2 - 1);

                    if (Math.random() < 0.2) { int1 = rand(1, 5); int2 = int1; } 
                    else { int1 = rand(1, 5); int2 = rand(1, 5); }
                } else if (lv === 'm1') {
                    let isDecimalFirst = Math.random() < 0.5;
                    let decValue = rand(1, 99) / 100;
                    let fDen = rand(2, 9);
                    let fNum = rand(1, fDen - 1);
                    let fracValue = fNum / fDen;

                    if (isDecimalFirst) {
                        v1 = decValue; v2 = fracValue;
                        d1 = decValue.toString();
                        if (d1.length > 4) d1 = decValue.toFixed(2);
                        d2 = makeFrac(fNum, fDen);
                    } else {
                        v1 = fracValue; v2 = decValue;
                        d1 = makeFrac(fNum, fDen);
                        d2 = decValue.toString();
                        if (d2.length > 4) d2 = decValue.toFixed(2);
                    }
                } else if (lv === 'm2') {
                    // 대분수 vs 소수 (13단계)
                    let intPart1 = rand(1, 9);
                    let intPart2 = rand(1, 9);
                    // 50% 확률로 자연수 부분이 같게 설정
                    if (Math.random() < 0.5) intPart2 = intPart1;

                    let fDen = rand(2, 9);
                    let fNum = rand(1, fDen - 1);
                    let fracValue = intPart1 + (fNum / fDen);

                    let decPlaces = rand(1, 3);
                    let decBase = Math.pow(10, decPlaces);
                    let decFractional = rand(1, decBase - 1) / decBase; 
                    let decValue = intPart2 + decFractional;

                    let isDecimalFirst = Math.random() < 0.5;

                    const formatMixedFrac = (i, n, d) => {
                        return `<div style="display:inline-flex; align-items:center;"><span style="font-size:1.5rem; margin-right:4px;">${i}</span>${makeFrac(n, d)}</div>`;
                    };

                    if (isDecimalFirst) {
                        v1 = decValue; v2 = fracValue;
                        d1 = decValue.toFixed(decPlaces);
                        d2 = formatMixedFrac(intPart1, fNum, fDen);
                    } else {
                        v1 = fracValue; v2 = decValue;
                        d1 = formatMixedFrac(intPart1, fNum, fDen);
                        d2 = decValue.toFixed(decPlaces);
                    }
                }

                if (lv.startsWith('f')) {
                    v1 = int1 + (num1 / den1);
                    v2 = int2 + (num2 / den2);

                    const formatFrac = (i, n, d) => {
                        if (i === 0) return makeFrac(n, d);
                        return `<div style="display:inline-flex; align-items:center;"><span style="font-size:1.5rem; margin-right:4px;">${i}</span>${makeFrac(n, d)}</div>`;
                    };

                    d1 = formatFrac(int1, num1, den1);
                    d2 = formatFrac(int2, num2, den2);
                }
            }

            document.getElementById(`num-l-${id}`).innerHTML = d1; document.getElementById(`num-r-${id}`).innerHTML = d2; document.getElementById(`circle-${id}`).innerText = '';
            const diff = v1 - v2;
            if(Math.abs(diff) < 0.000001) p.answer = 'eq'; else if(diff > 0) p.answer = 'gt'; else p.answer = 'lt';

            const zones = ['gt', 'eq', 'lt'];
            if(CONFIG.difficulty === 'hard') shuffle(zones);
            p.zones = zones;
            const zoneContainer = document.getElementById(`zones-${id}`); zoneContainer.innerHTML = '';
            zones.forEach(z => {
                const div = document.createElement('div'); div.className = `zone ${z}`; div.innerText = z === 'gt' ? '>' : z === 'lt' ? '<' : '='; zoneContainer.appendChild(div);
            });
            document.querySelector(`#fish-l-${id} .fish-body`).innerText = randItem(FISH_EMOJIS);
            document.querySelector(`#fish-r-${id} .fish-body`).innerText = randItem(FISH_EMOJIS);
        }

        function handleStop(id, event) {
            if(event) event.preventDefault();
            const p = gameState.players[id];
            if(p.locked || !gameState.active) return;
            p.locked = true;

            let idx = 0; const pos = p.hookPos + 4; 
            if(pos > 33.33) idx = 1; if(pos > 66.66) idx = 2;
            const selected = p.zones[idx];
            const isCorrect = selected === p.answer;
            const sym = selected === 'gt' ? '>' : selected === 'lt' ? '<' : '=';
            document.getElementById(`circle-${id}`).innerText = sym;

            const msgEl = document.getElementById(`msg-${id}`);
            const t = TRANSLATIONS[currentLang] || TRANSLATIONS.en;

            if(isCorrect) {
                p.score += 200; p.count++; playSound('success');
                msgEl.innerText = t.msg_correct; msgEl.style.color = '#4ade80';
            } else {
                p.score = Math.max(0, p.score - 50); playSound('fail');
                msgEl.innerText = t.msg_wrong; msgEl.style.color = '#f87171';
            }
            document.getElementById(`score-p${id}`).innerText = p.score;
            msgEl.style.display = 'block';

            setTimeout(() => {
                msgEl.style.display = 'none';
                if(gameState.active) nextProblem(id);
            }, 1000);
        }

        function endGame() {
            gameState.active = false; clearInterval(gameState.interval); cancelAnimationFrame(gameState.animFrame); playSound('end');
            document.getElementById('end-screen').classList.remove('hidden');
            const grid = document.getElementById('result-grid'); grid.innerHTML = '';
            
            const tempScores = [];
            for(let i=1; i<=CONFIG.playerCount; i++) tempScores.push({ id: i, score: gameState.players[i].score });
            tempScores.sort((a,b) => b.score - a.score);

            const rankMap = {};
            tempScores.forEach((p, idx) => {
                let rank = idx + 1;
                if(idx > 0 && p.score === tempScores[idx-1].score) rank = rankMap[tempScores[idx-1].id];
                rankMap[p.id] = rank;
            });

            const t = TRANSLATIONS[currentLang] || TRANSLATIONS.en;
            for(let i=1; i<=CONFIG.playerCount; i++) {
                const p = gameState.players[i]; const team = TEAMS[i]; const myRank = rankMap[i];
                let rankText = t[`rank_${myRank}`] || `${myRank}`;
                let fishHTML = '';
                for(let k=0; k<p.count; k++) fishHTML += `<span class="mini-fish">${randItem(FISH_EMOJIS)}</span>`;

                const borderStyle = myRank === 1 ? `4px solid ${team.color}` : `2px solid #555`;
                const glowStyle = myRank === 1 ? `box-shadow: 0 0 20px ${team.color};` : ``;

                const card = document.createElement('div');
                card.className = 'result-card';
                card.style.cssText = `border: ${borderStyle}; ${glowStyle}`;
                card.innerHTML = `
                    <div class="result-rank" style="color:${team.color}; font-size: 2.5rem;">${rankText}</div>
                    <div style="font-size:1.5rem; margin-top:10px;">${team.emoji} ${t[team.labelKey]}</div>
                    <div class="result-score" style="font-size: 3.5rem;">${p.score}</div>
                    <div class="result-count">${p.count} ${t.unit_count}</div>
                    <div class="result-collection">${fishHTML}</div>
                `;
                grid.appendChild(card);
            }
        }

        // --- 유틸 ---
        function rand(min, max) { return Math.floor(Math.random() * (max - min + 1)) + min; }
        function randItem(arr) { return arr[Math.floor(Math.random() * arr.length)]; }
        function makeFrac(n, d) { return `<div class="fraction"><span class="top">${n}</span><span class="bottom">${d}</span></div>`; }
        function shuffle(a) { for(let i=a.length-1; i>0; i--){ const j=Math.floor(Math.random()*(i+1)); [a[i],a[j]]=[a[j],a[i]]; } }

        function initAudio() { if(!audioCtx) audioCtx = new (window.AudioContext||window.webkitAudioContext)(); }
        function playSound(type) {
            if(!audioCtx) return;
            if(audioCtx.state === 'suspended') audioCtx.resume();
            const osc = audioCtx.createOscillator(); const gain = audioCtx.createGain();
            osc.connect(gain); gain.connect(audioCtx.destination);
            const now = audioCtx.currentTime;
            
            if(type === 'tick') {
                osc.frequency.setValueAtTime(800, now); gain.gain.setValueAtTime(0.05, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now+0.1); osc.start(now); osc.stop(now+0.1);
            } else if(type === 'success') {
                osc.frequency.setValueAtTime(523, now); osc.frequency.setValueAtTime(659, now+0.1);
                gain.gain.setValueAtTime(0.1, now); gain.gain.linearRampToValueAtTime(0, now+0.3); osc.start(now); osc.stop(now+0.3);
            } else if(type === 'fail') {
                osc.type = 'sawtooth'; osc.frequency.setValueAtTime(150, now); osc.frequency.linearRampToValueAtTime(100, now+0.3);
                gain.gain.setValueAtTime(0.1, now); gain.gain.linearRampToValueAtTime(0, now+0.3); osc.start(now); osc.stop(now+0.3);
            } else if(type === 'end') {
                osc.frequency.setValueAtTime(600, now); gain.gain.setValueAtTime(0.3, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now+1.5); osc.start(now); osc.stop(now+1.5);
            } else if (type === 'click') {
                osc.frequency.setValueAtTime(400, now); gain.gain.setValueAtTime(0.05, now);
                gain.gain.exponentialRampToValueAtTime(0.001, now+0.1); osc.start(now); osc.stop(now+0.1);
            }
        }

        function goHome() {
            if (document.fullscreenElement) {
                gameState.active = false;
                if(gameState.interval) clearInterval(gameState.interval);
                if(gameState.animFrame) cancelAnimationFrame(gameState.animFrame);
                
                document.getElementById('langTriggerContainer').style.display = 'block';
                document.getElementById('game-split-view').classList.add('hidden');
                document.getElementById('game-header').classList.add('hidden');
                document.getElementById('game-footer').classList.add('hidden');
                document.getElementById('end-screen').classList.add('hidden');
                document.getElementById('start-screen').classList.remove('hidden');
                
                if(window.playSound) window.playSound('click');
            } else {
                location.reload();
            }
        }
        
        function toggleFullScreen() {
            if(!document.fullscreenElement) document.documentElement.requestFullscreen();
            else if(document.exitFullscreen) document.exitFullscreen();
        }
    </script>
</body>

        let toastTimeout;

        function updateUIText(langCode) {
            const t = uiTranslations[langCode] || uiTranslations['en'];
            document.getElementById('ui-title').textContent = t.title;
            document.getElementById('ui-desc').textContent = t.desc;
            document.getElementById('searchInput').placeholder = t.search;
            document.getElementById('ui-empty').textContent = t.empty;
            document.getElementById('ui-toast').textContent = t.toast;
        }

        function renderLanguages(filterText = '') {
            grid.innerHTML = '';
            const lowerFilter = filterText.toLowerCase();
            const filteredLangs = languages.filter(lang => 
                lang.name.toLowerCase().includes(lowerFilter) || 
                lang.enName.toLowerCase().includes(lowerFilter) ||
                lang.code.toLowerCase().includes(lowerFilter)
            );

            if (filteredLangs.length === 0) {
                grid.classList.add('hidden');
                noResult.classList.remove('hidden');
                noResult.classList.add('flex');
            } else {
                grid.classList.remove('hidden');
                noResult.classList.add('hidden');
                noResult.classList.remove('flex');

                filteredLangs.forEach(lang => {
                    const isSelected = lang.code === currentLang;
                    const baseClasses = "flex items-center gap-3 p-3 rounded-xl border cursor-pointer transition-all duration-200 group relative overflow-hidden";
                    const stateClasses = isSelected 
                        ? "bg-gray-800 border-yellow-500 ring-1 ring-yellow-500/50" 
                        : "bg-gray-800/40 border-gray-700 hover:bg-gray-700 hover:border-gray-500";

                    const btn = document.createElement('div');
                    btn.className = `${baseClasses} ${stateClasses}`;
                    btn.innerHTML = `
                        <div class="shrink-0 w-8 h-6 rounded overflow-hidden shadow-sm border border-gray-700/50">
                            <img src="https://flagcdn.com/w40/${lang.country}.png" alt="${lang.country}" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300">
                        </div>
                        <div class="flex-1 min-w-0 flex flex-col items-start">
                            <span class="text-sm font-medium text-white truncate w-full ${isSelected ? 'text-yellow-400' : ''}">${lang.name}</span>
                            <span class="text-xs text-gray-400 truncate w-full">${lang.enName}</span>
                        </div>
                        ${isSelected ? '<i class="fa-solid fa-circle-check text-yellow-500 text-lg ml-2"></i>' : ''}
                    `;
                    btn.addEventListener('click', () => selectLanguage(lang));
                    grid.appendChild(btn);
                });
            }
        }

        function selectLanguage(langObj) {
            changeLanguage(langObj.code);
            closeModal();
            showToast(langObj.name);
            renderLanguages(searchInput.value);
        }

        function changeLanguage(langCode) {
            currentLang = langCode;
            try { localStorage.setItem('kingsmath_lang', langCode); } catch(e) {}

            const newUrl = new URL(window.location);
            newUrl.searchParams.set('lang', langCode);
            window.history.pushState({}, '', newUrl);

            const langObj = languages.find(l => l.code === langCode) || languages[0];
            currentFlagImg.src = `https://flagcdn.com/w40/${langObj.country}.png`;
            currentLangSpan.textContent = langObj.name;
            updateUIText(langCode);

            const t = TRANSLATIONS[langCode] || TRANSLATIONS.en;
            
            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if(t[key]) el.innerHTML = t[key];
            });

            const titleEl = document.querySelector('.main-title');
            if(t.game_title.length > 10) titleEl.style.fontSize = '2.5rem';
            else titleEl.style.fontSize = '3.5rem';

            document.getElementById('page-title').textContent = t.game_title;
            document.getElementById('meta-desc').content = t.seo_desc;
            document.getElementById('og-title').content = t.game_title;
            document.getElementById('og-desc').content = t.seo_desc;
            document.getElementById('tw-title').content = t.game_title;
            document.getElementById('tw-desc').content = t.seo_desc;

            const otherLink = document.getElementById('link-other-game');
            otherLink.href = "/";
            
            renderLevelGrid(); 
        }

        function openModal() {
            modal.classList.add('active');
            document.body.style.overflow = 'hidden';

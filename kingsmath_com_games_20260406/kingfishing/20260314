    <style>
        /* [기본 설정] */
        * { 
            box-sizing: border-box; 
            user-select: none; -webkit-user-select: none;
            -webkit-touch-callout: none;
            -webkit-tap-highlight-color: transparent;
            touch-action: none;
        }
        
        body {
            margin: 0; padding: 0; overflow: hidden;
            font-family: 'Jua', sans-serif;
            background-color: #1e1e2e;
            color: #ecf0f1;
            height: 100vh;
            display: flex; flex-direction: column;
        }

        /* 폰트어썸 아이콘 깨짐 방지용 예외 처리 */
        i[class^="fa-"] {
            font-family: "Font Awesome 6 Free" !important;
            font-weight: 900 !important;
        }

        /* 커스텀 스크롤바 (모달 내부 스크롤용) */
        .custom-scrollbar::-webkit-scrollbar { width: 8px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: rgba(31, 41, 55, 0.5); border-radius: 4px; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #4b5563; border-radius: 4px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #6b7280; }

        /* 모달 등장 애니메이션 */
        .modal-overlay {
            opacity: 0; visibility: hidden; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .modal-overlay.active { opacity: 1; visibility: visible; }
        .modal-content { transform: scale(0.95) translateY(-10px); opacity: 0; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .modal-overlay.active .modal-content { transform: scale(1) translateY(0); opacity: 1; }

        /* 토스트 알림 애니메이션 */
        .toast { transform: translateY(100%); opacity: 0; transition: all 0.3s ease; }
        .toast.show { transform: translateY(0); opacity: 1; }

        /* --- 상단 헤더 --- */
        header {
            height: 18%; 
            display: flex;
            flex-direction: column;
            justify-content: center; 
            align-items: center;
            padding: 5px 20px;
            background: #2b2b3b;
            border-bottom: 3px solid #444;
            z-index: 10;
            position: relative;
        }

        /* 점수판 컨테이너 */
        .score-board-container { display: flex; width: 100%; height: auto; flex: 1; justify-content: space-around; align-items: center; order: 2; }
        .player-score { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 5px 10px; border-radius: 15px; background: #363646; border: 3px solid #555; min-width: 100px; width: 18%; height: 90%; transition: transform 0.2s; position: relative; }
        .p1-board { border-color: #3b82f6; color: #60a5fa; }
        .p2-board { border-color: #ef4444; color: #f87171; }
        .p3-board { border-color: #d946ef; color: #e879f9; }
        .p4-board { border-color: #22c55e; color: #4ade80; }
        .player-label { font-size: 1.2rem; font-weight: bold; white-space: nowrap; margin-bottom: 5px; }
        .score-display { font-size: 2.8rem; font-weight: bold; font-family: 'Poppins', sans-serif; line-height: 1; color: white; }

        /* 타이머 */
        .timer-wrapper { position: relative; top: auto; left: auto; transform: none; z-index: 20; order: 1; margin-bottom: 5px; }
        .timer-container { text-align: center; background: #2d3436; padding: 2px 20px; border-radius: 40px; border: 4px solid #fbbf24; box-shadow: 0 4px 10px rgba(0,0,0,0.5); min-width: 120px; }
        .timer-container.urgent { animation: pulse 0.5s infinite alternate; border-color: #ff5252; background: #4a1c1c; }
        @keyframes pulse { from { transform: scale(1); } to { transform: scale(1.05); } }
        .timer-label { font-size: 0.8rem; color: #b2bec3; display: block; }
        #timer { font-size: 2.0rem; font-weight: bold; color: #f1c40f; font-family: 'Poppins', sans-serif; line-height: 1; }
        .urgent #timer { color: #ff6b6b; }

        /* --- 메인 게임 영역 --- */
        #game-split-view { flex-grow: 1; display: flex; width: 100%; height: 62%; position: relative; background: #1e1e2e; }
        .player-area { flex: 1; position: relative; display: flex; flex-direction: column; justify-content: flex-start; align-items: center; padding-top: 10px; overflow: hidden; border-right: 2px solid #444; }
        .player-area:last-child { border-right: none; }
        .area-p1 { background: linear-gradient(180deg, #172554 0%, #1e1e2e 100%); }
        .area-p2 { background: linear-gradient(180deg, #450a0a 0%, #1e1e2e 100%); }
        .area-p3 { background: linear-gradient(180deg, #4a044e 0%, #1e1e2e 100%); }
        .area-p4 { background: linear-gradient(180deg, #052e16 0%, #1e1e2e 100%); }

        .fish-tank { width: 100%; height: 60%; display: flex; justify-content: space-evenly; align-items: flex-end; padding-bottom: 10px; position: relative; }
        .fish-wrapper { position: relative; transition: transform 0.5s; display: flex; flex-direction: column; align-items: center; justify-content: center; width: 45%; max-width: 200px; }
        .vs-circle { position: absolute; left: 50%; transform: translateX(-50%); width: 68px; height: 68px; background: #2d3436; border: 3px solid #636e72; border-radius: 50%; display: flex; justify-content: center; align-items: center; font-size: 30px; font-family: Arial, sans-serif; color: #f1c40f; z-index: 5; box-shadow: 0 4px 6px rgba(0,0,0,0.3); }
        .fish-body { font-size: 5rem; filter: drop-shadow(0 5px 5px rgba(0,0,0,0.5)); z-index: 1; margin-bottom: 5px; line-height: 1; transition: all 0.3s; }
        .fish-number { font-size: 1.5rem; font-weight: bold; color: #ffffff; background: #374151; padding: 5px 10px; border-radius: 30px; z-index: 2; font-family: 'Poppins', sans-serif; min-width: 60px; text-align: center; white-space: nowrap; box-shadow: 0 4px 10px rgba(0,0,0,0.3); border: 2px solid #6b7280; }
        .fraction { display: inline-block; vertical-align: middle; font-size: 0.8em; margin: 0 2px; }
        .fraction > span { display: block; text-align: center; line-height: 1; }
        .fraction span.top { border-bottom: 2px solid #fff; padding: 0 2px 2px 2px; }
        .fraction span.bottom { padding: 2px 2px 0 2px; }

        .hook-area { width: 90%; height: 70px; margin-top: auto; margin-bottom: 20px; position: relative; background: #1e293b; border-radius: 15px; border: 3px solid #475569; overflow: hidden; box-shadow: 0 5px 15px rgba(0,0,0,0.4); }
        .zone-container { display: flex; width: 100%; height: 100%; }
        .zone { flex: 1; display: flex; align-items: center; justify-content: center; font-size: 28px; color: white; font-family: Arial, sans-serif; font-weight: 300; border-right: 1px solid rgba(255,255,255,0.1); }
        .zone:last-child { border-right: none; }
        .zone.gt { background-color: #0369a1; }
        .zone.eq { background-color: #1d4ed8; }
        .zone.lt { background-color: #0c4a6e; }
        .hook { position: absolute; top: -5px; left: 0; width: 40px; height: 80px; display: flex; flex-direction: column; align-items: center; transform: translateX(0); z-index: 5; pointer-events: none; }
        .hook i { font-size: 35px; color: #facc15; filter: drop-shadow(0 2px 2px rgba(0,0,0,0.5)); }
        .hook::before { content: ''; width: 2px; height: 1000px; background: #94a3b8; position: absolute; bottom: 25px; left: 50%; transform: translateX(-50%); }
        .feedback-msg { position: absolute; top: 72%; left: 50%; transform: translate(-50%, -50%); font-size: 2.5rem; font-weight: bold; text-shadow: 0 0 10px rgba(0,0,0,0.8); z-index: 20; display: none; white-space: nowrap; }

        /* --- 하단 버튼 --- */
        footer { height: 20%; display: flex; padding: 0; background: #111827; border-top: 2px solid #374151; }
        .btn-container { flex: 1; display: flex; justify-content: center; align-items: center; padding: 10px; border-right: 1px solid #374151; }
        .btn-container:last-child { border-right: none; }
        .stop-btn { width: 90%; height: 70%; font-size: 1.5rem; font-weight: bold; font-family: 'Jua', sans-serif; border: none; border-radius: 20px; cursor: pointer; color: white; display: flex; flex-direction: column; justify-content: center; align-items: center; position: relative; top: 0; transition: all 0.1s; }
        .stop-btn span { margin-top: 5px; }

        /* --- 오버레이 (메뉴/결과) --- */
        .overlay { position: fixed; inset: 0; background: rgba(15, 23, 42, 0.98); display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 100; color: white; padding: 20px; overflow-y: auto; }
        .hidden { display: none !important; }
        
        /* 메뉴 영역을 기존보다 가로로 50% 확장 (500px -> 750px) */
        .menu-section { background: rgba(255,255,255,0.05); padding: 10px 20px; border-radius: 15px; margin-bottom: 15px; width: 100%; max-width: 750px; text-align: center; border: 1px solid rgba(255,255,255,0.1); }
        
        .section-title { font-size: 1.1rem; color: #94a3b8; margin-bottom: 8px; display: block; }
        .option-row { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
        .option-btn { padding: 10px 20px; font-size: 1.1rem; background: transparent; color: #cbd5e1; border: 2px solid #475569; border-radius: 12px; cursor: pointer; font-family: 'Jua', sans-serif; transition: all 0.2s; }
        .option-btn:hover { background: rgba(255,255,255,0.05); }
        .option-btn.selected { background: #3b82f6; color: white; border-color: #3b82f6; box-shadow: 0 0 15px rgba(59, 130, 246, 0.4); }
        .tab-menu { display: flex; gap: 10px; margin-bottom: 10px;  justify-content: center;}
        .tab-btn { padding: 10px 25px; font-size: 1.2rem; background: rgba(255,255,255,0.05); color: #94a3b8; border: 2px solid transparent; border-radius: 30px; cursor: pointer; font-family: 'Jua', sans-serif; transition: all 0.2s; }
        .tab-btn.active { background: #3b82f6; color: white; box-shadow: 0 4px 10px rgba(59, 130, 246, 0.4); }
        
        /* 버튼형 레벨 그리드 (직관적 클릭) */
        .level-grid { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; width: 100%; }
        .level-btn { padding: 10px; background: #1e293b; border: 2px solid #334155; border-radius: 12px; cursor: pointer; display: flex; flex-direction: column; align-items: center; gap: 4px; color: #cbd5e1; transition: 0.2s; min-width: 120px; flex: 1; max-width: 230px; }
        .level-btn.selected { background: #0f172a; border-color: #facc15; color: white; transform: scale(1.05); }
        .lvl-icon { font-size: 1.4rem; }
        
        .start-btn-large { padding: 15px 80px; font-size: 2.2rem; background: #10b981; color: white; border: none; border-radius: 50px; cursor: pointer; font-family: 'Jua', sans-serif; box-shadow: 0 8px 0 #047857; margin-top: 15px; transition: transform 0.1s; }
        .start-btn-large:active { transform: scale(0.95); box-shadow: 0 4px 0 #047857; }
        .start-btn-large:disabled { background: #334155; color: #64748b; box-shadow: none; cursor: not-allowed; }
        .main-title-container { text-align: center; margin-bottom: 15px; }
        .main-title { font-size: 3.5rem; color: #facc15; text-shadow: 3px 3px 0 #b45309; margin: 0; line-height: 1.2; }

        /* 결과 화면 */
        .result-grid { display: flex; gap: 10px; width: 98%; height: 60vh; justify-content: space-between; align-items: stretch; margin-bottom: 20px; }
        .result-card { flex: 1; background: rgba(0,0,0,0.7); border-radius: 15px; border: 4px solid #444; display: flex; flex-direction: column; align-items: center; padding: 15px; position: relative; overflow: hidden; }
        .result-rank { font-size: 2rem; position: absolute; top: 10px; left: 10px; text-shadow: 0 2px 2px rgba(0,0,0,0.5); }
        .result-score { font-size: 3rem; font-weight: bold; margin: 10px 0; color: white; }
        .result-count { font-size: 1.2rem; color: #cbd5e1; margin-bottom: 10px; }
        .result-collection { flex: 1; width: 100%; background: rgba(255,255,255,0.05); border-radius: 10px; overflow-y: auto; padding: 5px; display: flex; flex-wrap: wrap; align-content: flex-start; justify-content: center; gap: 2px; }
        .mini-fish { font-size: 24px; }

        /* 플로팅 버튼 */
        .floating-btn { position: fixed; bottom: 50%; width: 50px; height: 50px; background: rgba(255,255,255,0.1); border-radius: 50%; display: flex; justify-content: center; align-items: center; color: white; cursor: pointer; z-index: 9000; border: 1px solid rgba(255,255,255,0.2); }
        .floating-home { left: 20px; }
        .floating-full { right: 20px; }

        .small-text .fish-number { font-size: 2.2rem; min-width: 50px; padding: 5px 8px; }
        .small-text .fish-body { font-size: 5rem; }

        .other-game-btn { display: inline-block; margin-top: 15px; padding: 12px 25px; background: rgba(255, 255, 255, 0.1); border: 2px solid #facc15; border-radius: 30px; color: #facc15; text-decoration: none; font-size: 1.2rem; font-weight: bold; transition: all 0.2s; box-shadow: 0 4px 6px rgba(0,0,0,0.2); font-family: 'Jua', sans-serif; }
        .other-game-btn:hover { background: rgba(255, 204, 21, 0.2); transform: translateY(-2px); box-shadow: 0 6px 12px rgba(0,0,0,0.4); color: #fff; border-color: #fff; }
    </style>
</head>

            modal.classList.remove('active');
            document.body.style.overflow = '';
        }

        function showToast(langName) {
            toastLangName.textContent = langName;
            toast.classList.add('show');
            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => toast.classList.remove('show'), 3000);
        }

        modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && modal.classList.contains('active')) closeModal(); });
        searchInput.addEventListener('input', (e) => renderLanguages(e.target.value));

        window.onload = () => {
            const urlParams = new URLSearchParams(window.location.search);
            const langParam = urlParams.get('lang');
            let storedLang = null;
            try { storedLang = localStorage.getItem('kingsmath_lang'); } catch(e) {}
            
            let browserLang = navigator.language.toLowerCase();
            if(browserLang.includes('zh')) browserLang = 'zh';
            else if(browserLang !== 'pt-br') browserLang = browserLang.split('-')[0];

            let targetLang = 'en';

            if (langParam && TRANSLATIONS[langParam]) { targetLang = langParam; } 
            else if (storedLang && TRANSLATIONS[storedLang]) { targetLang = storedLang; } 
            else if (TRANSLATIONS[browserLang]) { targetLang = browserLang; } 
            else if (browserLang === 'ko') { targetLang = 'ko'; }

            changeLanguage(targetLang);
            renderLanguages();
            loadSettings();
        };

        // --- 기존 설정 및 게임 로직 변수 (레벨 14 임시 제거 반영, 문자열 ID 적용) ---

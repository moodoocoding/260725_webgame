<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>낚시킹 비교킹</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Jua&family=Poppins:wght@300;400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <style>
        /* [터치 및 오작동 방지 최적화] */
        * { 
            box-sizing: border-box; 
            user-select: none; -webkit-user-select: none; /* 텍스트 선택 방지 */
            -webkit-touch-callout: none; /* 롱터치 메뉴 방지 */
            -webkit-tap-highlight-color: transparent; /* 터치 하이라이트 제거 */
            touch-action: manipulation; /* 더블탭 확대 방지 및 터치 반응 개선 */
        }
        
        body {
            margin: 0;
            padding: 0;
            overflow: hidden;
            font-family: 'Jua', sans-serif;
            background-color: #f0f9ff;
            height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* 1. 상단 헤더 - 높이 확대 (15% -> 22%) */
        header {
            height: 22%; 
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 40px;
            background: #fff;
            border-bottom: 3px solid #cbd5e1;
            z-index: 10;
        }

        /* 점수판 스타일 - 크기 2배 확대 */
        .player-score {
            display: flex;
            flex-direction: column;
            align-items: center;
            min-width: 280px;
            padding: 10px 40px;
            border-radius: 20px;
            background: #f8fafc;
            border: 4px solid #e2e8f0;
        }
        .p1-board { color: #2563eb; border-color: #2563eb; }
        .p2-board { color: #dc2626; border-color: #dc2626; }

        .player-label { 
            font-size: 32px;
            font-weight: bold; 
            margin-bottom: 5px;
        }
        .score-display { 
            font-size: 80px;
            font-weight: bold; 
            font-family: 'Poppins', sans-serif; 
            line-height: 1;
        }

        /* 타이머 스타일 - 크기 2배 확대 */
        .timer-container {
            text-align: center;
            background: #fff;
            padding: 10px 50px;
            border-radius: 60px;
            border: 6px solid #fbbf24;
            transition: transform 0.2s;
        }
        .timer-container.urgent {
            animation: pulse 0.5s infinite alternate;
            border-color: #ef4444;
            background: #fee2e2;
        }
        @keyframes pulse { from { transform: scale(1); } to { transform: scale(1.1); } }

        .timer-label { 
            font-size: 24px;
            color: #888; 
            margin-bottom: 5px;
        }
        #timer { 
            font-size: 90px;
            font-weight: bold; 
            color: #d97706; 
            font-family: 'Poppins', sans-serif; 
            line-height: 1; 
        }
        .urgent #timer { color: #dc2626; }

        /* 2. 메인 게임 영역 - 높이 조정 (65% -> 58%) */
        #game-split-view {
            flex-grow: 1;
            display: flex;
            width: 100%;
            height: 58%;
            position: relative;
        }

        .divider { width: 4px; background: #cbd5e1; height: 100%; z-index: 5; }

        .player-area {
            flex: 1;
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
            align-items: center;
            padding-top: 10px;
            overflow: hidden;
        }

        .area-p1 { background: linear-gradient(180deg, #eff6ff 0%, #dbeafe 100%); }
        .area-p2 { background: linear-gradient(180deg, #fef2f2 0%, #fee2e2 100%); }

        /* 물고기/해산물 영역 */
        .fish-tank {
            width: 100%;
            height: 65%;
            display: flex;
            justify-content: space-evenly;
            align-items: flex-end; 
            padding-bottom: 20px; 
            position: relative;
        }

        .fish-wrapper {
            position: relative;
            transition: transform 0.5s;
            display: flex;
            flex-direction: column; 
            align-items: center;
            justify-content: center;
            width: 270px;
        }

        /* 중앙 원 (부등호 표시) */
        .vs-circle {
            width: 120px;
            height: 120px;
            background: #fff;
            border: 6px solid #cbd5e1;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 80px;
            font-family: Arial, Helvetica, sans-serif; 
            font-weight: 300; 
            color: #334155;
            margin-bottom: 35px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            z-index: 2;
        }

        /* 물고기 이모지 */
        .fish-body {
            font-size: 135px;
            filter: drop-shadow(0 5px 5px rgba(0,0,0,0.1));
            z-index: 1;
            margin-bottom: 15px; 
            line-height: 1;
        }

        /* 숫자 */
        .fish-number {
            font-size: 48px;
            font-weight: bold;
            color: #1e293b;
            background: rgba(255,255,255,0.95);
            padding: 10px 35px;
            border-radius: 60px;
            z-index: 2;
            font-family: 'Poppins', sans-serif;
            min-width: 140px;
            text-align: center;
            white-space: nowrap;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            border: 4px solid #cbd5e1;
        }
        
        /* 분수 스타일 */
        .fraction { display: inline-block; vertical-align: middle; font-size: 0.9em; margin: 0 2px; }
        .fraction > span { display: block; text-align: center; line-height: 1; }
        .fraction span.top { border-bottom: 2px solid #000; padding: 0 2px 2px 2px; }
        .fraction span.bottom { padding: 2px 2px 0 2px; }
        .mixed-int { font-size: 1.1em; margin-right: 4px; vertical-align: middle; }

        /* 낚시바 영역 */
        .hook-area {
            width: 90%;
            height: 100px;
            margin-top: auto;
            margin-bottom: 40px;
            position: relative;
            background: #334155;
            border-radius: 15px;
            border: 4px solid #fff;
            overflow: hidden;
            box-shadow: 0 10px 15px rgba(0,0,0,0.1);
        }

        .zone-container { display: flex; width: 100%; height: 100%; }

        .zone {
            flex: 1; display: flex; align-items: center; justify-content: center;
            font-size: 40px; 
            color: white; 
            font-family: Arial, Helvetica, sans-serif; 
            font-weight: 300;
            border-right: 1px solid rgba(255,255,255,0.2);
        }
        .zone:last-child { border-right: none; }
        .zone.gt { background-color: #0ea5e9; }
        .zone.eq { background-color: #3b82f6; }
        .zone.lt { background-color: #0284c7; }

        .hook {
            position: absolute; top: -5px; left: 0; width: 60px; height: 110px;
            display: flex; flex-direction: column; align-items: center;
            transform: translateX(0); z-index: 5; pointer-events: none;
        }
        .hook i { font-size: 60px; color: #facc15; filter: drop-shadow(0 2px 0 #b45309); }
        .hook::before {
            content: ''; width: 3px; height: 1000px; background: #cbd5e1;
            position: absolute; bottom: 45px; left: 50%; transform: translateX(-50%);
        }

        /* 피드백 메시지 */
        .feedback-msg {
            position: absolute; 
            top: 65%; /* 원 아래, 바 위쪽 */
            left: 50%; 
            transform: translate(-50%, -50%);
            font-size: 70px; 
            font-weight: bold; text-shadow: 2px 2px 5px rgba(0,0,0,0.3);
            z-index: 20; display: none; white-space: nowrap;
        }

        /* 3. 하단 컨트롤 - 높이 유지 (20%) */
        footer {
            height: 20%; display: flex; justify-content: space-between; align-items: center;
            padding: 0; background: #fff;
        }
        .btn-container {
            flex: 1; height: 100%; display: flex; justify-content: center; align-items: center; padding: 20px;
        }
        .stop-btn {
            width: 50%; height: 80%; font-size: 36px; font-weight: bold; font-family: 'Jua', sans-serif;
            border: none; border-radius: 25px; cursor: pointer; color: white; transition: all 0.1s;
            position: relative; top: 0; display: flex; justify-content: center; align-items: center; gap: 10px;
            /* 터치 반응성 최적화 */
            touch-action: manipulation;
        }
        .btn-p1 { background: linear-gradient(to bottom, #60a5fa, #2563eb); box-shadow: 0 8px 0 #1e40af; }
        .btn-p1:active { top: 8px; box-shadow: 0 0 0 #1e40af; }
        .btn-p2 { background: linear-gradient(to bottom, #f87171, #dc2626); box-shadow: 0 8px 0 #991b1b; }
        .btn-p2:active { top: 8px; box-shadow: 0 0 0 #991b1b; }

        /* 오버레이 */
        .overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(15, 23, 42, 0.98);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 100;
            color: white;
            padding: 40px;
        }
        .hidden { display: none !important; }

        .main-title-container { text-align: center; margin-bottom: 30px; }
        .main-title { font-size: 80px; color: #facc15; text-shadow: 4px 4px 0 #b45309; margin: 0; line-height: 1.2; }
        .sub-title { font-size: 30px; color: #94a3b8; margin-top: 5px; }

        /* 킹수학 링크 스타일 */
        .king-math-link {
            font-size: 24px;
            color: #e2e8f0;
            margin-bottom: 10px;
            font-family: 'Jua', sans-serif;
        }
        .king-math-link a {
            color: #facc15;
            text-decoration: none;
            font-weight: bold;
            border-bottom: 2px solid #facc15;
            transition: color 0.2s;
        }
        .king-math-link a:hover {
            color: #fff;
            border-color: #fff;
        }

        .tab-menu {
            display: flex; gap: 15px; margin-bottom: 25px; background: rgba(255,255,255,0.1);
            padding: 10px; border-radius: 50px;
        }
        .tab-btn {
            padding: 15px 40px; font-size: 28px; background: transparent; color: #cbd5e1;
            border: 2px solid transparent; border-radius: 40px; cursor: pointer;
            font-family: 'Jua', sans-serif; transition: all 0.2s;
        }
        .tab-btn:hover { color: white; background: rgba(255,255,255,0.05); }
        .tab-btn.active { background: #0ea5e9; color: white; box-shadow: 0 4px 15px rgba(14, 165, 233, 0.4); }

        .tab-content { display: none; width: 100%; max-width: 1000px; justify-content: center; }
        .tab-content.active { display: flex; flex-wrap: wrap; gap: 20px; }

        .level-card {
            background: #1e293b; width: 220px; height: 160px; border: 3px solid #334155;
            border-radius: 20px; display: flex; flex-direction: column; align-items: center; justify-content: center;
            cursor: pointer; transition: all 0.2s; position: relative;
        }
        .level-card:hover { transform: translateY(-5px); border-color: #64748b; background: #334155; }
        .level-card.selected { background: #0f172a; border-color: #facc15; box-shadow: 0 0 0 4px rgba(250, 204, 21, 0.3); transform: scale(1.05); }

        .card-icon { font-size: 40px; margin-bottom: 10px; }
        .card-title { font-size: 24px; font-weight: bold; color: white; font-family: 'Jua', sans-serif; }
        .card-desc { font-size: 16px; color: #94a3b8; margin-top: 5px; font-family: 'Poppins', sans-serif; }

        .start-action-area { margin-top: 40px; }
        .start-btn {
            padding: 15px 60px; font-size: 40px; background: #10b981; color: white; border: none;
            border-radius: 50px; cursor: pointer; font-family: 'Jua', sans-serif;
            box-shadow: 0 8px 0 #047857; transition: transform 0.1s;
        }
        .start-btn:active { transform: scale(0.95); box-shadow: 0 4px 0 #047857; }
        .start-btn:disabled { background: #64748b; box-shadow: none; cursor: not-allowed; opacity: 0.5; }

        @keyframes catchFish {
            0% { transform: translateY(0); }
            50% { transform: translateY(-20px) rotate(10deg); }
            100% { transform: translateY(-300px) rotate(-10deg); opacity: 0; }
        }
        @keyframes dropFish {
            0% { transform: translateY(0); }
            100% { transform: translateY(100px); opacity: 0; }
        }
        .caught-anim { animation: catchFish 0.8s forwards; }
        .dropped-anim { animation: dropFish 0.6s forwards; }

        /* 결과 화면 스타일 */
        .result-container {
            display: flex;
            flex-direction: column;
            width: 90%;
            gap: 20px;
            margin-bottom: 20px;
            background: rgba(0, 0, 0, 0.4);
            padding: 30px;
            border-radius: 20px;
        }

        .result-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
        }

        .res-col-p1, .res-col-p2 {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }
        
        .res-col-mid {
            width: 100px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 80px;
            color: #facc15;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
            font-family: Arial, Helvetica, sans-serif; 
            font-weight: 300;
        }

        /* 점수 섹션 */
        .score-title { font-size: 24px; font-weight: bold; margin-bottom: 5px; }
        .final-score { 
            font-size: 70px; 
            font-weight: bold; 
            color: white; 
            text-shadow: 3px 3px 6px rgba(0,0,0,0.5);
            line-height: 1;
        }

        /* 물고기 수조 섹션 */
        .fish-collection-box {
            background: rgba(255, 255, 255, 0.1);
            border-radius: 15px;
            width: 90%;
            height: 180px;
            overflow-y: auto;
            padding: 10px;
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            align-content: flex-start;
            gap: 5px;
            border: 2px solid rgba(255,255,255,0.2);
            margin-bottom: 10px;
        }
        .mini-fish { font-size: 30px; animation: popUp 0.3s backwards; margin: 2px; }

        /* 마리 수 섹션 */
        .count-label { font-size: 20px; color: #cbd5e1; margin-bottom: 0px; }
        .final-count { 
            font-size: 40px; 
            font-weight: bold; 
            color: #fff;
        }

        @keyframes popUp {
            0% { transform: scale(0); } 80% { transform: scale(1.2); } 100% { transform: scale(1); }
        }

        /* [플로팅 버튼 스타일] */
        .floating-btn {
            position: fixed;
            bottom: 20px;
            width: 60px;
            height: 60px;
            background: rgba(0,0,0,0.3);
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            color: white;
            font-size: 24px;
            cursor: pointer;
            z-index: 9999;
            transition: background 0.2s;
            border: 2px solid rgba(255,255,255,0.5);
        }
        .floating-btn:hover { background: rgba(0,0,0,0.6); }
        .floating-btn:active { transform: scale(0.95); }
        .floating-home { left: 20px; }
        .floating-fullscreen { right: 20px; }

    </style>
</head>
<body>

    <header>
        <div class="player-score p1-board">
            <div class="player-label">1P (Blue)</div>
            <div id="score-p1" class="score-display">0</div>
        </div>
        <div class="timer-container" id="timer-box">
            <div class="timer-label">TIME</div>
            <div id="timer">60</div>
        </div>
        <div class="player-score p2-board">
            <div class="player-label">2P (Red)</div>
            <div id="score-p2" class="score-display">0</div>
        </div>
    </header>

    <div id="game-split-view">
        <div class="player-area area-p1">
            <div class="fish-tank">
                <div class="fish-wrapper" id="p1-fish-l">
                    <div class="fish-body">🐟</div>
                    <div class="fish-number" id="p1-num-l">?</div>
                </div>
                <div class="vs-circle" id="p1-circle"></div>
                <div class="fish-wrapper" id="p1-fish-r">
                    <div class="fish-body" style="transform: scaleX(-1);">🐠</div>
                    <div class="fish-number" id="p1-num-r">?</div>
                </div>
            </div>
            <div class="feedback-msg" id="p1-feedback">성공!</div>
            <div class="hook-area">
                <div class="zone-container" id="p1-zones"></div>
                <div class="hook" id="p1-hook"><i class="fa-solid fa-anchor"></i></div>
            </div>
        </div>
        <div class="divider"></div>
        <div class="player-area area-p2">
            <div class="fish-tank">
                <div class="fish-wrapper" id="p2-fish-l">
                    <div class="fish-body">🐡</div>
                    <div class="fish-number" id="p2-num-l">?</div>
                </div>
                <div class="vs-circle" id="p2-circle"></div>
                <div class="fish-wrapper" id="p2-fish-r">
                    <div class="fish-body" style="transform: scaleX(-1);">🦈</div>
                    <div class="fish-number" id="p2-num-r">?</div>
                </div>
            </div>
            <div class="feedback-msg" id="p2-feedback">성공!</div>
            <div class="hook-area">
                <div class="zone-container" id="p2-zones"></div>
                <div class="hook" id="p2-hook"><i class="fa-solid fa-anchor"></i></div>
            </div>
        </div>
    </div>

    <footer>
        <div class="btn-container" style="background: #eff6ff;">
            <button class="stop-btn btn-p1" ontouchstart="event.preventDefault(); handleStop(1)" onmousedown="handleStop(1)">
                <i class="fa-solid fa-hand-pointer"></i> 1P STOP
            </button>
        </div>
        <div class="btn-container" style="background: #fef2f2;">
            <button class="stop-btn btn-p2" ontouchstart="event.preventDefault(); handleStop(2)" onmousedown="handleStop(2)">
                <i class="fa-solid fa-hand-pointer"></i> 2P STOP
            </button>
        </div>
    </footer>

    <div class="floating-btn floating-home" onclick="goHome()" title="홈 화면">
        <i class="fa-solid fa-house"></i>
    </div>
    
    <div class="floating-btn floating-fullscreen" onclick="toggleFullScreen()" title="전체 화면">
        <i class="fa-solid fa-expand"></i>
    </div>

    <div id="start-screen" class="overlay">
        <div class="main-title-container">
            <div class="king-math-link">
                게임으로 수학의 킹이 되어라. <a href="http://킹수학.com" target="_blank">킹수학.com</a>
            </div>
            <h1 class="main-title">🎣 낚시킹 비교킹</h1>
        </div>
        <div class="tab-menu">
            <button class="tab-btn active" onclick="switchTab('natural', this)">🌱 자연수</button>
            <button class="tab-btn" onclick="switchTab('decimal', this)">💧 소수</button>
            <button class="tab-btn" onclick="switchTab('fraction', this)">🍰 분수 & 혼합</button>
        </div>
        <div id="tab-natural" class="tab-content active">
            <div class="level-card" onclick="selectLevel(1, this)">
                <div class="card-icon">🐠</div>
                <div class="card-title">1단계</div>
                <div class="card-desc">1 ~ 9</div>
            </div>
            <div class="level-card" onclick="selectLevel(2, this)">
                <div class="card-icon">🐟</div>
                <div class="card-title">2단계</div>
                <div class="card-desc">1 ~ 99</div>
            </div>
            <div class="level-card" onclick="selectLevel(3, this)">
                <div class="card-icon">🐡</div>
                <div class="card-title">3단계</div>
                <div class="card-desc">1 ~ 999</div>
            </div>
            <div class="level-card" onclick="selectLevel(4, this)">
                <div class="card-icon">🐋</div>
                <div class="card-title">4단계</div>
                <div class="card-desc">1 ~ 9999</div>
            </div>
        </div>
        <div id="tab-decimal" class="tab-content">
            <div class="level-card" onclick="selectLevel(5, this)">
                <div class="card-icon">💧</div>
                <div class="card-title">5단계</div>
                <div class="card-desc">소수 첫째 (0.1)</div>
            </div>
            <div class="level-card" onclick="selectLevel(6, this)">
                <div class="card-icon">💦</div>
                <div class="card-title">6단계</div>
                <div class="card-desc">소수 둘째 (0.01)</div>
            </div>
            <div class="level-card" onclick="selectLevel(7, this)">
                <div class="card-icon">🌊</div>
                <div class="card-title">7단계</div>
                <div class="card-desc">소수 셋째 (0.001)</div>
            </div>
        </div>
        <div id="tab-fraction" class="tab-content">
            <div class="level-card" onclick="selectLevel(8, this)">
                <div class="card-icon">🍰</div>
                <div class="card-title">8단계</div>
                <div class="card-desc">분모가 같은 분수</div>
            </div>
            <div class="level-card" onclick="selectLevel(9, this)">
                <div class="card-icon">🍕</div>
                <div class="card-title">9단계</div>
                <div class="card-desc">분모가 다른 분수</div>
            </div>
            <div class="level-card" onclick="selectLevel(10, this)">
                <div class="card-icon">🥞</div>
                <div class="card-title">10단계</div>
                <div class="card-desc">대분수 비교</div>
            </div>
            <div class="level-card" onclick="selectLevel(11, this)">
                <div class="card-icon">🏆</div>
                <div class="card-title">11단계</div>
                <div class="card-desc">소수 vs 분수 대결</div>
            </div>
        </div>
        <div class="start-action-area">
            <button class="start-btn" id="btn-start-game" disabled onclick="gameStart()">게임 시작 하기</button>
        </div>
    </div>

    <div id="end-screen" class="overlay hidden">
        <div id="winner-msg" style="font-size: 70px; color: #facc15; margin-bottom: 20px;">게임 종료!</div>
        
        <div class="result-container">
            <div class="result-row">
                <div class="res-col-p1">
                    <div class="score-title" style="color: #60a5fa;">1P SCORE</div>
                    <div id="final-p1" class="final-score">0</div>
                </div>
                <div class="res-col-mid" id="score-symbol">=</div>
                <div class="res-col-p2">
                    <div class="score-title" style="color: #f87171;">2P SCORE</div>
                    <div id="final-p2" class="final-score">0</div>
                </div>
            </div>

            <div class="result-row" style="align-items: stretch;">
                <div class="res-col-p1">
                    <div class="fish-collection-box" id="collection-p1"></div>
                </div>
                <div class="res-col-mid"></div> <div class="res-col-p2">
                    <div class="fish-collection-box" id="collection-p2"></div>
                </div>
            </div>

            <div class="result-row">
                <div class="res-col-p1">
                    <div class="count-label">잡은 물고기</div>
                    <div id="count-p1" class="final-count">0 마리</div>
                </div>
                <div class="res-col-mid" id="count-symbol" style="font-size: 50px;">=</div>
                <div class="res-col-p2">
                    <div class="count-label">잡은 물고기</div>
                    <div id="count-p2" class="final-count">0 마리</div>
                </div>
            </div>
        </div>

        <button class="start-btn" onclick="location.reload()" style="margin-top: 10px;">다시 하기</button>
    </div>

    <script>
        // 우클릭 방지 (오작동 방지)
        document.addEventListener('contextmenu', event => event.preventDefault());

        // 더블클릭/탭 줌 방지 (추가 안전장치)
        document.addEventListener('dblclick', function(event) {
            event.preventDefault();
        }, { passive: false });

        function toggleFullScreen() {
            if (!document.fullscreenElement) {
                document.documentElement.requestFullscreen().catch((e) => {
                    console.log("전체화면 실패:", e);
                });
            } else {
                if (document.exitFullscreen) {
                    document.exitFullscreen();
                }
            }
        }

        // 새로 추가된 함수: 홈으로 돌아가기 (새로고침 없이 상태 리셋)
        function goHome() {
            // 게임 루프 정지
            isGameActive = false;
            clearInterval(timerInterval);
            cancelAnimationFrame(animationFrameId);

            // 화면 상태 초기화
            document.getElementById('start-screen').classList.remove('hidden');
            document.getElementById('end-screen').classList.add('hidden');
            document.getElementById('timer-box').classList.remove('urgent');
            
            // 타이머 및 점수 시각적 초기화 (필수는 아니지만 깔끔함을 위해)
            document.getElementById('timer').innerText = GAME_DURATION;
            document.getElementById('score-p1').innerText = "0";
            document.getElementById('score-p2').innerText = "0";
        }

        const GAME_DURATION = 60;
        const FISH_EMOJIS = ['🐟', '🐠', '🐡', '🦈', '🐳', '🐋', '🦐', '🦑', '🐙', '🦞', '🦀', '🐬'];
        let selectedGameLevel = 0;
        
        let audioCtx = null;
        function initAudio() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
        }
        function playSound(type) {
            if (!audioCtx) initAudio();
            if (audioCtx.state === 'suspended') audioCtx.resume();

            const oscillator = audioCtx.createOscillator();
            const gainNode = audioCtx.createGain();
            oscillator.connect(gainNode);
            gainNode.connect(audioCtx.destination);

            if (type === 'success') {
                const now = audioCtx.currentTime;
                oscillator.type = 'sine';
                oscillator.frequency.setValueAtTime(523.25, now); 
                oscillator.frequency.setValueAtTime(659.25, now + 0.1); 
                oscillator.frequency.setValueAtTime(783.99, now + 0.2); 
                gainNode.gain.setValueAtTime(0.1, now);
                gainNode.gain.exponentialRampToValueAtTime(0.01, now + 0.4);
                oscillator.start(now);
                oscillator.stop(now + 0.4);
            } else if (type === 'fail') {
                const now = audioCtx.currentTime;
                oscillator.type = 'sawtooth';
                oscillator.frequency.setValueAtTime(150, now);
                oscillator.frequency.linearRampToValueAtTime(100, now + 0.3);
                gainNode.gain.setValueAtTime(0.1, now);
                gainNode.gain.linearRampToValueAtTime(0.01, now + 0.3);
                oscillator.start(now);
                oscillator.stop(now + 0.3);
            } else if (type === 'tick') {
                const now = audioCtx.currentTime;
                oscillator.type = 'square';
                oscillator.frequency.setValueAtTime(800, now);
                gainNode.gain.setValueAtTime(0.05, now);
                gainNode.gain.exponentialRampToValueAtTime(0.001, now + 0.1);
                oscillator.start(now);
                oscillator.stop(now + 0.1);
            } else if (type === 'end') {
                const now = audioCtx.currentTime;
                oscillator.type = 'triangle';
                oscillator.frequency.setValueAtTime(800, now);
                oscillator.frequency.exponentialRampToValueAtTime(100, now + 1.0);
                gainNode.gain.setValueAtTime(0.2, now);
                gainNode.gain.linearRampToValueAtTime(0.01, now + 1.0);
                oscillator.start(now);
                oscillator.stop(now + 1.0);
            }
        }

        function switchTab(tabName, btn) {
            document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
            document.getElementById(`tab-${tabName}`).classList.add('active');
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
        }

        function selectLevel(level, cardElement) {
            selectedGameLevel = level;
            document.querySelectorAll('.level-card').forEach(c => c.classList.remove('selected'));
            cardElement.classList.add('selected');
            document.getElementById('btn-start-game').disabled = false;
        }

        const players = {
            1: {
                score: 0, problemCount: 0, fishCaught: 0, hookPos: 0, hookDir: 1, hookSpeed: 0.5,
                isInputLocked: false, currentAnswer: '', zones: [], 
                elHook: document.getElementById('p1-hook'), elFeedback: document.getElementById('p1-feedback')
            },
            2: {
                score: 0, problemCount: 0, fishCaught: 0, hookPos: 0, hookDir: 1, hookSpeed: 0.5,
                isInputLocked: false, currentAnswer: '', zones: [],
                elHook: document.getElementById('p2-hook'), elFeedback: document.getElementById('p2-feedback')
            }
        };

        let timer = GAME_DURATION;
        let isGameActive = false;
        let timerInterval = null;
        let animationFrameId = null;

        function gameStart() {
            if(selectedGameLevel === 0) return;
            initAudio(); 
            document.getElementById('start-screen').classList.add('hidden');
            document.getElementById('end-screen').classList.add('hidden');
            document.getElementById('timer-box').classList.remove('urgent');

            timer = GAME_DURATION;
            isGameActive = true;
            
            [1, 2].forEach(id => {
                const p = players[id];
                p.score = 0; p.problemCount = 0; p.fishCaught = 0;
                p.hookPos = Math.random() * 90; p.hookSpeed = 0.5;
                p.isInputLocked = false;
                nextProblem(id);
            });

            updateScoreBoard();
            document.getElementById('timer').innerText = timer;
            timerInterval = setInterval(() => {
                timer--;
                document.getElementById('timer').innerText = timer;
                if (timer <= 5 && timer > 0) {
                    document.getElementById('timer-box').classList.add('urgent');
                    playSound('tick');
                }
                if(timer <= 0) gameOver();
            }, 1000);
            animateLoop();
        }

        function animateLoop() {
            if(!isGameActive) return;
            [1, 2].forEach(id => {
                const p = players[id];
                if(p.isInputLocked) return;
                p.hookPos += (p.hookSpeed * p.hookDir);
                // 92 is right edge limit approx
                if (p.hookPos >= 92) { p.hookDir = -1; p.hookPos = 92; } 
                else if (p.hookPos <= 0) { p.hookDir = 1; p.hookPos = 0; }
                p.elHook.style.left = p.hookPos + '%';
            });
            animationFrameId = requestAnimationFrame(animateLoop);
        }

        function shuffleArray(array) {
            for (let i = array.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [array[i], array[j]] = [array[j], array[i]];
            }
            return array;
        }

        function randInt(min, max) { return Math.floor(Math.random() * (max - min + 1)) + min; }
        function makeFraction(n, d) { return `<div class="fraction"><span class="top">${n}</span><span class="bottom">${d}</span></div>`; }
        function makeMixed(intVal, n, d) { return `<span class="mixed-int">${intVal}</span>` + makeFraction(n, d); }

        function nextProblem(playerId) {
            const p = players[playerId];
            p.problemCount++;
            // Increased speed increment: 0.15 * 1.5 = 0.225
            p.hookSpeed = 0.5 + (p.problemCount * 0.225); 
            if(p.hookSpeed > 4.0) p.hookSpeed = 4.0;

            let displayL, displayR, valL, valR;

            switch(selectedGameLevel) {
                case 1: valL = randInt(1, 9); valR = randInt(1, 9); displayL = valL; displayR = valR; break;
                case 2: valL = randInt(1, 99); valR = randInt(1, 99); displayL = valL; displayR = valR; break;
                case 3: valL = randInt(1, 999); valR = randInt(1, 999); displayL = valL; displayR = valR; break;
                case 4: valL = randInt(1, 9999); valR = randInt(1, 9999); displayL = valL; displayR = valR; break;
                case 5: 
                    {
                        if (Math.random() < 0.5) {
                            let intPart = randInt(0, 9);
                            valL = intPart + randInt(1, 9)/10; valR = intPart + randInt(1, 9)/10;
                        } else {
                            valL = randInt(1, 99)/10; valR = randInt(1, 99)/10;
                        }
                        displayL = parseFloat(valL.toFixed(1)); displayR = parseFloat(valR.toFixed(1));
                    }
                    break;
                case 6: 
                    {
                        if (Math.random() < 0.5) {
                            let intPart = randInt(0, 9);
                            valL = intPart + randInt(1, 99)/100; valR = intPart + randInt(1, 99)/100;
                        } else {
                            valL = randInt(1, 999)/100; valR = randInt(1, 999)/100;
                        }
                        displayL = parseFloat(valL.toFixed(2)); displayR = parseFloat(valR.toFixed(2));
                    }
                    break;
                case 7: 
                    {
                        if (Math.random() < 0.5) {
                            let intPart = randInt(0, 9);
                            valL = intPart + randInt(1, 999)/1000; valR = intPart + randInt(1, 999)/1000;
                        } else {
                            valL = randInt(1, 9999)/1000; valR = randInt(1, 9999)/1000;
                        }
                        displayL = parseFloat(valL.toFixed(3)); displayR = parseFloat(valR.toFixed(3));
                    }
                    break;
                case 8: 
                    {
                        let den = randInt(2, 20); let n1 = randInt(1, den * 2); let n2 = randInt(1, den * 2);
                        valL = n1/den; valR = n2/den; displayL = makeFraction(n1, den); displayR = makeFraction(n2, den);
                    } break;
                case 9:
                    {
                        let d1 = randInt(2, 12); let d2 = randInt(2, 12); let n1 = randInt(1, d1 * 2); let n2 = randInt(1, d2 * 2);
                        valL = n1/d1; valR = n2/d2; displayL = makeFraction(n1, d1); displayR = makeFraction(n2, d2);
                    } break;
                case 10:
                    {
                        let i1 = randInt(1, 5); let d1 = randInt(2, 9); let n1 = randInt(1, d1 - 1);
                        valL = i1 + (n1 / d1); displayL = makeMixed(i1, n1, d1);
                        let i2 = randInt(1, 5); let d2 = randInt(2, 9); let n2 = randInt(1, d2 - 1);
                        valR = i2 + (n2 / d2); displayR = makeMixed(i2, n2, d2);
                    } break;
                case 11:
                    {
                        let type = Math.random() > 0.5; let decVal = randInt(1, 30)/10; 
                        let den = randInt(2, 10); let num = randInt(1, den * 3); let fracVal = num/den;
                        if(type) { valL = decVal; valR = fracVal; displayL = parseFloat(decVal.toFixed(1)); displayR = makeFraction(num, den); }
                        else { valL = fracVal; valR = decVal; displayL = makeFraction(num, den); displayR = parseFloat(decVal.toFixed(1)); }
                    } break;
                default: valL=0; valR=0; displayL=0; displayR=0;
            }

            const diff = valL - valR;
            if (Math.abs(diff) < 0.000001) p.currentAnswer = 'eq';
            else if (diff > 0) p.currentAnswer = 'gt';
            else p.currentAnswer = 'lt';

            document.getElementById(`p${playerId}-num-l`).innerHTML = displayL;
            document.getElementById(`p${playerId}-num-r`).innerHTML = displayR;

            // 원 초기화
            document.getElementById(`p${playerId}-circle`).innerText = '';

            resetFishAnim(playerId);
            const bodyL = document.querySelector(`#p${playerId}-fish-l .fish-body`);
            const bodyR = document.querySelector(`#p${playerId}-fish-r .fish-body`);
            bodyL.innerText = FISH_EMOJIS[Math.floor(Math.random() * FISH_EMOJIS.length)];
            bodyR.innerText = FISH_EMOJIS[Math.floor(Math.random() * FISH_EMOJIS.length)];

            let zones = ['gt', 'eq', 'lt'];
            p.zones = shuffleArray(zones);
            const zc = document.getElementById(`p${playerId}-zones`);
            zc.innerHTML = '';
            p.zones.forEach(type => {
                let div = document.createElement('div'); div.className = `zone ${type}`;
                div.innerText = type === 'gt' ? '>' : (type === 'lt' ? '<' : '='); zc.appendChild(div);
            });
            p.isInputLocked = false;
        }

        function handleStop(id) {
            if(!isGameActive) return;
            const p = players[id];
            if(p.isInputLocked) return;

            // Use approximate center of hook. Hook is ~8% wide, so center is +4
            let centerPos = p.hookPos + 4;
            let selectedIndex = 0;
            // Zones are 0-33.3, 33.3-66.6, 66.6-100
            if (centerPos < 33.33) selectedIndex = 0;
            else if (centerPos < 66.66) selectedIndex = 1;
            else selectedIndex = 2;

            const selectedType = p.zones[selectedIndex];
            const isCorrect = (selectedType === p.currentAnswer);
            
            p.isInputLocked = true; // 입력 잠금

            // 1. 원에 기호 먼저 표시
            let symbolChar = '';
            if(selectedType === 'gt') symbolChar = '>';
            else if(selectedType === 'lt') symbolChar = '<';
            else symbolChar = '=';
            
            document.getElementById(`p${id}-circle`).innerText = symbolChar;

            // 2. 잠시 멈췄다가(0.5초) 결과 표시
            setTimeout(() => {
                showFeedback(id, isCorrect);
            }, 500);
        }

        function showFeedback(id, isCorrect) {
            const p = players[id];
            // p.isInputLocked는 handleStop에서 이미 true로 설정됨
            
            const elFb = p.elFeedback;
            const fL = document.getElementById(`p${id}-fish-l`);
            const fR = document.getElementById(`p${id}-fish-r`);

            if(isCorrect) {
                p.score += 200; p.fishCaught++;
                playSound('success'); 
                elFb.innerText = "유후! 잡았다!";
                elFb.style.color = "#2563eb"; // 1P blue color
                fL.classList.add('caught-anim'); fR.classList.add('caught-anim');
            } else {
                p.score -= 100; if(p.score < 0) p.score = 0;
                playSound('fail'); 
                elFb.innerText = "흑! 놓쳤다!";
                elFb.style.color = "#dc2626"; // 2P red color
                fL.classList.add('dropped-anim'); fR.classList.add('dropped-anim');
            }
            elFb.style.display = "block";
            updateScoreBoard();
            setTimeout(() => { elFb.style.display = "none"; nextProblem(id); }, 1000);
        }

        function resetFishAnim(id) {
            const fL = document.getElementById(`p${id}-fish-l`);
            const fR = document.getElementById(`p${id}-fish-r`);
            fL.classList.remove('caught-anim', 'dropped-anim');
            fR.classList.remove('caught-anim', 'dropped-anim');
        }

        function updateScoreBoard() {
            document.getElementById('score-p1').innerText = players[1].score;
            document.getElementById('score-p2').innerText = players[2].score;
        }

        function gameOver() {
            isGameActive = false;
            playSound('end');
            clearInterval(timerInterval);
            cancelAnimationFrame(animationFrameId);
            
            const p1Score = players[1].score; 
            const p2Score = players[2].score;
            const p1Count = players[1].fishCaught;
            const p2Count = players[2].fishCaught;

            // 승자 메시지
            const msg = document.getElementById('winner-msg');
            if(p1Score > p2Score) { msg.innerText = "🏆 1P (Blue) 승리!"; msg.style.color = "#3b82f6"; }
            else if(p2Score > p1Score) { msg.innerText = "🏆 2P (Red) 승리!"; msg.style.color = "#ef4444"; }
            else { msg.innerText = "🤝 무승부!"; msg.style.color = "#9ca3af"; }
            
            // 점수 표시 및 부등호
            document.getElementById('final-p1').innerText = p1Score;
            document.getElementById('final-p2').innerText = p2Score;
            
            const scoreSymbol = document.getElementById('score-symbol');
            if (p1Score > p2Score) { scoreSymbol.innerText = '>'; scoreSymbol.style.color = '#3b82f6'; }
            else if (p1Score < p2Score) { scoreSymbol.innerText = '<'; scoreSymbol.style.color = '#ef4444'; }
            else { scoreSymbol.innerText = '='; scoreSymbol.style.color = '#ccc'; }

            // 마리 수 표시 및 부등호
            document.getElementById('count-p1').innerText = p1Count + " 마리";
            document.getElementById('count-p2').innerText = p2Count + " 마리";

            const countSymbol = document.getElementById('count-symbol');
            if (p1Count > p2Count) { countSymbol.innerText = '>'; countSymbol.style.color = '#3b82f6'; }
            else if (p1Count < p2Count) { countSymbol.innerText = '<'; countSymbol.style.color = '#ef4444'; }
            else { countSymbol.innerText = '='; countSymbol.style.color = '#ccc'; }
            
            // 물고기 아이콘 채우기
            [1, 2].forEach(id => {
                const count = players[id].fishCaught;
                const container = document.getElementById(`collection-p${id}`);
                container.innerHTML = '';
                for(let i=0; i<count; i++) {
                    setTimeout(() => {
                        let s = document.createElement('span'); s.className = 'mini-fish';
                        s.innerText = FISH_EMOJIS[Math.floor(Math.random() * FISH_EMOJIS.length)];
                        container.appendChild(s);
                    }, i * 30); // 딜레이를 조금 줄임 (빠르게 채우기 위해)
                }
            });

            document.getElementById('end-screen').classList.remove('hidden');
        }
    </script>
    
</body>
</html>